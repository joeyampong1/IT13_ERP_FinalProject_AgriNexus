@page "/login"
@layout LandingLayout
@inject NavigationManager NavigationManager
@inject AgriNexus.Services.AuthService Auth
@inject AgriNexus.DataLayer.AgriNexusDbContext DbContext
@using Microsoft.EntityFrameworkCore
@using AgriNexus.DataLayer.Models

<div class="container-fluid p-0 min-vh-100" style="height: 100vh; overflow: hidden;">
    <div class="row g-0 h-100">

        <!-- LEFT SIDE: Visual Branding (60% width) -->
        <div class="col-lg-7 d-none d-lg-flex flex-column justify-content-between p-5 position-relative login-visual-panel h-100">
            <div class="login-blob-1"></div>
            <div class="login-blob-2"></div>

            <div class="position-relative" style="z-index: 2;">
                <a href="/" class="d-inline-flex align-items-center gap-2 text-decoration-none text-white hover-opacity mb-5">
                    <i class="bi bi-arrow-left fs-5"></i> Back to Home
                </a>
                <div class="d-flex align-items-center gap-3">
                    <img src="images/AgriNexus_finalogo.png" alt="AgriNexus" style="height: 50px; background: white; border-radius: 12px; padding: 5px;" />
                    <h3 class="text-white fw-bold mb-0">AgriNexus</h3>
                </div>
            </div>

            <div class="position-relative" style="z-index: 2; max-width: 80%;">
                <h2 class="text-white fw-bold mb-3 display-5" style="line-height: 1.3;">"Empowering agricultural businesses with data-driven decisions."</h2>
                <p class="text-white text-opacity-75 fs-4">Manage your farms, track inventory, and sync seamlessly—whether you're online or offline.</p>
            </div>

            <div class="position-relative text-white text-opacity-50 small" style="z-index: 2;">
                © 2026 AgriNexus ERP. All rights reserved.
            </div>
        </div>

        <!-- RIGHT SIDE: Login Form Card (40% width) -->
        <div class="col-12 col-lg-5 d-flex align-items-center justify-content-center bg-light p-3 p-md-4 h-100">

            <!-- Scrollable Card -->
            <div class="card border-0 shadow-lg rounded-4 w-100" style="max-height: 95vh; overflow-y: auto;">
                <div class="card-body p-4 p-md-5">

                    <a href="/" class="d-lg-none text-decoration-none text-muted mb-4 d-inline-block fw-bold">
                        <i class="bi bi-arrow-left me-2"></i> Back to Home
                    </a>

                    <div class="text-center mb-4 mt-3">
                        <img src="images/AgriNexus_finalogo.png" alt="AgriNexus Logo" style="height: 80px; object-fit: contain;" />
                    </div>

                    <!-- BRANDED TEXT HEADER (CENTERED) -->
                    <div class="text-center mb-4 mt-2">
                        <h2 class="fw-bolder mb-2" style="letter-spacing: -0.5px; font-size: 1.8rem;">
                            <span style="color: #0A2B1D;">Welcome</span>
                            <span style="color: var(--primary-green);">Back</span>
                        </h2>
                        <p class="text-muted small mb-3" style="letter-spacing: 0.3px; font-size: 0.9rem; line-height: 1.5;">
                            Sign in to manage your farm operations.
                        </p>

                        <!-- Tagline with Lines (Centered) -->
                        <div class="d-flex align-items-center justify-content-center gap-2 mt-4">
                            <hr class="m-0" style="width: 25px; border-top: 2px solid var(--primary-green); opacity: 1;">
                            <span class="text-uppercase fw-bold" style="color: var(--primary-green); font-size: 0.6rem; letter-spacing: 1.2px;">
                                One Platform. Multiple Farms. Smarter Operations.
                            </span>
                            <hr class="m-0" style="width: 25px; border-top: 2px solid var(--primary-green); opacity: 1;">
                        </div>
                    </div>

                    @if (NavigationManager.Uri.Contains("registered=true"))
                    {
                        <div class="alert alert-success p-3 small rounded-3 mb-4 text-center">
                            <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i>
                            <strong>Application Submitted!</strong><br />
                            Please wait for the Super Admin to approve your account before logging in.
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger p-2 small rounded-3">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
                        </div>
                    }

                    <form>
                        <!-- Section: Account Details -->
                        <div class="d-flex align-items-center gap-2 mb-3 mt-4">
                            <div class="bg-success bg-opacity-10 text-success rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 30px; height: 30px;">
                                <i class="bi bi-shield-lock"></i>
                            </div>
                            <h6 class="fw-bold text-dark mb-0 text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">Account Details</h6>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Email Address</label>
                            <div class="input-group modern-input">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input type="email" class="form-control" placeholder="admin@agrinexus.com" @bind="email" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label fw-bold small text-muted mb-0">Password</label>
                                <a href="/forgot-password" class="text-success text-decoration-none small fw-bold hover-green">Forgot password?</a>
                            </div>
                            <div class="input-group modern-input">
                                <span class="input-group-text"><i class="bi bi-lock"></i></span>

                                <!-- Password Input with Toggle Logic -->
                                <input type="@(showPassword ? "text" : "password")" class="form-control" placeholder="••••••••" @bind="password" />

                                <span class="input-group-text" style="cursor: pointer; border-left: none;" @onclick="TogglePassword">
                                    <i class="bi @(showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                </span>
                            </div>
                        </div>

                        <div class="form-check mb-4 mt-2">
                            <input class="form-check-input" type="checkbox" id="rememberMe" />
                            <label class="form-check-label text-muted small" for="rememberMe">
                                Keep me signed in on this device
                            </label>
                        </div>

                        <!-- Sign In Button -->
                        <button type="button" @onclick="LoginUser" disabled="@isProcessing" class="btn btn-primary btn-lg w-100 py-3 fw-bold rounded-3 shadow-sm btn-hover-effect mb-3">
                            @if (isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Signing in...</span>
                            }
                            else
                            {
                                <span>Sign In to Dashboard</span>
                            }
                        </button>

                        <div class="text-center mt-4">
                            <p class="text-muted small mb-0">
                                Don't have an account?
                                <a href="/register" class="text-success text-decoration-none fw-bold hover-green">Register your business</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    private string errorMessage = "";
    private bool showPassword = false;
    private bool isProcessing = false;

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }

    private async Task LoginUser()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Please enter both email and password.";
            return;
        }

        isProcessing = true;

        try
        {
            // 1. Query the database and INCLUDE the Business para makita ang status
            var user = await DbContext.Users
                .Include(u => u.Business)
                .FirstOrDefaultAsync(u => u.Email == email);

            // 2. Check if user exists and password matches
            if (user == null || user.PasswordHash != password)
            {
                errorMessage = "Invalid email or password.";
                isProcessing = false;
                return;
            }

            if (user.Status != "Active")
            {
                errorMessage = "Your account is inactive.";
                isProcessing = false;
                return;
            }

            // 3. IMPORTANTE: I-check kung Trial pa ang Business sa Tenant Admin
            if (user.Role == "TenantAdmin" && user.Business != null && user.Business.Status == "Trial")
            {
                errorMessage = "Your business application is still pending approval by the Super Admin.";
                isProcessing = false;
                return;
            }

            // 4. Pass the actual User object to AuthService
            Auth.Login(user);

            // 5. Redirect based on the actual role from the database
            if (user.Role == "TenantAdmin")
            {
                NavigationManager.NavigateTo("/business-dashboard");
            }
            else if (user.Role == "SuperAdmin")
            {
                NavigationManager.NavigateTo("/dashboard");
            }
            else if (user.Role == "BranchManager")
            {
                NavigationManager.NavigateTo("/branch-dashboard");
            }
            else
            {
                NavigationManager.NavigateTo("/dashboard");
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Login failed: " + ex.Message;
        }
        finally
        {
            isProcessing = false;
        }
    }
}