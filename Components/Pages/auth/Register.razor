@page "/register"
@layout LandingLayout
@inject NavigationManager NavigationManager
@inject AgriNexus.DataLayer.AgriNexusDbContext DbContext
@using AgriNexus.DataLayer.Models
@using Microsoft.EntityFrameworkCore
@inject AgriNexus.Services.RegistrationStateService RegState

<div class="container-fluid p-0 min-vh-100" style="height: 100vh; overflow: hidden;">
    <div class="row g-0 h-100">

        <!-- LEFT SIDE: Visual Branding (60% width) -->
        <div class="col-lg-7 d-none d-lg-flex flex-column justify-content-between p-5 position-relative login-visual-panel h-100">
            <div class="login-grid-overlay"></div>
            <div class="login-blob-1"></div>
            <div class="login-blob-2"></div>

            <!-- Top Navigation & Brand -->
            <div class="position-relative" style="z-index: 2;">
                <a href="/" class="d-inline-flex align-items-center gap-2 text-decoration-none text-white-50 hover-white mb-4 small fw-semibold">
                    <i class="bi bi-arrow-left fs-6"></i> Back to Home
                </a>
                <div class="d-flex align-items-center gap-3 mt-2">
                    <div class="brand-logo-box shadow-sm">
                        <img src="images/AgriNexus_finalogo.png" alt="AgriNexus" style="height: 42px; object-fit: contain;" />
                    </div>
                    <div>
                        <h3 class="text-white fw-bolder mb-0" style="letter-spacing: -0.5px;">AgriNexus</h3>
                        <span class="text-uppercase fw-bold" style="color: #6EE7B7; font-size: 0.65rem; letter-spacing: 1.5px;">Enterprise Resource Planning</span>
                    </div>
                </div>
            </div>

            <!-- Center Value Proposition -->
            <div class="position-relative my-auto" style="z-index: 2; max-width: 85%;">
                <span class="badge rounded-pill px-3 py-2 mb-3 fw-bold small" style="background: rgba(16, 185, 129, 0.15); color: #6EE7B7; border: 1px solid rgba(110, 231, 183, 0.25);">
                    <i class="bi bi-rocket-takeoff me-1"></i> 14-DAY FREE TRIAL AVAILABLE
                </span>
                <h2 class="text-white fw-bolder mb-3 display-5" style="line-height: 1.25; letter-spacing: -0.8px;">
                    Start your journey to smarter farming today.
                </h2>
                <p class="text-white text-opacity-75 fs-5 mb-4" style="line-height: 1.6;">
                    Join modern agricultural businesses in managing operations, tracking inventory, and growing yields with confidence.
                </p>

                <!-- Feature Pills -->
                <div class="d-flex flex-wrap gap-2 pt-2">
                    <span class="glass-pill"><i class="bi bi-check2-circle me-2" style="color: #6EE7B7;"></i>No Credit Card for Trial</span>
                    <span class="glass-pill"><i class="bi bi-diagram-3 me-2 text-warning"></i>Multi-Farm Ready</span>
                    <span class="glass-pill"><i class="bi bi-cloud-check me-2 text-info"></i>Offline & Cloud Sync</span>
                </div>
            </div>

            <!-- Footer -->
            <div class="position-relative d-flex justify-content-between align-items-center text-white text-opacity-50 small" style="z-index: 2;">
                <span>© 2026 AgriNexus ERP. All rights reserved.</span>
                <span>Agri-Tech Operations Platform</span>
            </div>
        </div>

        <!-- RIGHT SIDE: Registration Form Card (40% width) -->
        <div class="col-12 col-lg-5 d-flex align-items-center justify-content-center login-right-surface p-3 p-md-4 h-100">

            <!-- Scrollable Card -->
            <div class="card login-form-card rounded-4 w-100" style="max-height: 95vh; overflow-y: auto;">
                <div class="card-body p-4 p-md-5">

                    <a href="/" class="d-lg-none text-decoration-none text-muted mb-3 d-inline-flex align-items-center gap-1 small fw-bold">
                        <i class="bi bi-arrow-left"></i> Back to Home
                    </a>

                    <div class="text-center mb-3 mt-1">
                        <div class="d-inline-flex align-items-center justify-content-center p-2 rounded-4" style="background: #F0F7F3; border: 1px solid #D8E8DF;">
                            <img src="images/AgriNexus_finalogo.png" alt="AgriNexus Logo" style="height: 68px; object-fit: contain;" />
                        </div>
                    </div>

                    <!-- BRANDED TEXT HEADER (CENTERED) -->
                    <div class="text-center mb-4">
                        <h2 class="fw-bolder mb-1 branded-title">
                            <span class="text-dark-green">Register Your</span>
                            <span style="color: #1B5E34;">Business</span>
                        </h2>
                        <p class="text-muted small mb-3 branded-subtitle">
                            Create an owner account to start managing your farm operations.
                        </p>

                        <!-- Tagline with Lines (Centered) -->
                        <div class="d-flex align-items-center justify-content-center gap-2 mt-3">
                            <hr class="m-0 branded-line">
                            <span class="text-uppercase fw-bold branded-tagline">
                                One Platform. Multiple Farms. Smarter Operations.
                            </span>
                            <hr class="m-0 branded-line">
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger border-0 p-3 small rounded-3 mb-3" style="background-color: #FEF2F2; color: #991B1B;">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
                        </div>
                    }

                    <form>
                        <!-- Section 1: Business Info -->
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; background-color: #E8F3EC; color: #1B5E34;">
                                <i class="bi bi-building small"></i>
                            </div>
                            <h6 class="fw-bold mb-0 text-uppercase" style="color: #0A2B1D; font-size: 0.72rem; letter-spacing: 1px;">Business Information</h6>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted">Business Name</label>
                            <div class="input-group modern-input">
                                <span class="input-group-text"><i class="bi bi-shop"></i></span>
                                <input type="text" class="form-control" placeholder="e.g. Verdant Agri Ventures" @bind="RegState.BusinessName" />
                            </div>
                        </div>

                        <!-- Section 2: Owner Info -->
                        <div class="d-flex align-items-center gap-2 mb-3 mt-4">
                            <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; background-color: #E8F3EC; color: #1B5E34;">
                                <i class="bi bi-person-fill small"></i>
                            </div>
                            <h6 class="fw-bold mb-0 text-uppercase" style="color: #0A2B1D; font-size: 0.72rem; letter-spacing: 1px;">Owner Details</h6>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label class="form-label fw-bold small text-muted">First Name</label>
                                <div class="input-group modern-input">
                                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                                    <input type="text" class="form-control" placeholder="Juan" @bind="RegState.FirstName" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted">Last Name</label>
                                <div class="input-group modern-input">
                                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                                    <input type="text" class="form-control" placeholder="Dela Cruz" @bind="RegState.LastName" />
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Email Address</label>
                            <div class="input-group modern-input">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input type="email" class="form-control" placeholder="owner@agribusiness.com" @bind="RegState.Email" />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label class="form-label fw-bold small text-muted">Password</label>
                                <div class="input-group modern-input">
                                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                    <input type="password" class="form-control" placeholder="••••••••" @bind="RegState.Password" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted">Confirm Password</label>
                                <div class="input-group modern-input">
                                    <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                                    <input type="password" class="form-control" placeholder="••••••••" @bind="confirmPassword" />
                                </div>
                            </div>
                        </div>

                        <!-- Terms and Conditions -->
                        <div class="form-check mb-4 mt-2">
                            <input class="form-check-input" type="checkbox" id="terms" @bind="RegState.AgreeToTerms" />
                            <label class="form-check-label text-muted" style="font-size: 0.8rem;" for="terms">
                                I agree to the <a href="#" class="text-decoration-none fw-bold hover-green" style="color: #1B5E34;">Terms of Service</a> and <a href="#" class="text-decoration-none fw-bold hover-green" style="color: #1B5E34;">Privacy Policy</a>.
                            </label>
                        </div>

                        @if (!RegState.HasSelectedPlan)
                        {
                            <!-- NEXT BUTTON (if plan is not yet selected) -->
                            <button type="button" @onclick="GoToSelectPlan" disabled="@isProcessing" class="btn btn-agrinexus-primary btn-lg w-100 py-3 fw-bold rounded-3 shadow-sm mb-3">
                                @if (isProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Validating...</span>
                                }
                                else
                                {
                                    <span>Next <i class="bi bi-arrow-right ms-2"></i></span>
                                }
                            </button>
                        }
                        else
                        {
                            <!-- CREATE ACCOUNT BUTTON (after SelectPlan / PaymentPlan) -->
                            <button type="button" @onclick="RegisterAccount" disabled="@isProcessing" class="btn btn-agrinexus-primary btn-lg w-100 py-3 fw-bold rounded-3 shadow-sm mb-3">
                                @if (isProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Creating Account...</span>
                                }
                                else
                                {
                                    <span>Create Account <i class="bi bi-check2-circle ms-1"></i></span>
                                }
                            </button>
                        }

                        <div class="text-center mt-3 pt-2 border-top" style="border-color: #EDF2EF !important;">
                            <p class="text-muted small mb-0">
                                Already have an account?
                                <a href="/login" class="text-decoration-none fw-bold hover-green" style="color: #1B5E34;">Sign In here</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string confirmPassword = "";
    private bool isProcessing = false;
    private string errorMessage = "";

    protected override void OnInitialized()
    {
        // Restore confirmPassword when returning from SelectPlan / PaymentPlan
        if (!string.IsNullOrEmpty(RegState.Password))
        {
            confirmPassword = RegState.Password;
        }
    }

    private async Task GoToSelectPlan()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(RegState.BusinessName) || string.IsNullOrWhiteSpace(RegState.FirstName) ||
            string.IsNullOrWhiteSpace(RegState.LastName) || string.IsNullOrWhiteSpace(RegState.Email) || string.IsNullOrWhiteSpace(RegState.Password))
        {
            errorMessage = "Please fill in all the required fields.";
            return;
        }

        if (RegState.Password != confirmPassword)
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        if (!RegState.AgreeToTerms)
        {
            errorMessage = "You must agree to the Terms of Service.";
            return;
        }

        isProcessing = true;

        try
        {
            var cleanEmail = RegState.Email.Trim();
            var existingUser = await DbContext.Users
                .FirstOrDefaultAsync(u => u.Email.ToLower() == cleanEmail.ToLower());

            if (existingUser != null)
            {
                errorMessage = "An account with this email already exists.";
                return;
            }

            // Proceed to SelectPlan without saving to database yet
            NavigationManager.NavigateTo("/select-plan");
        }
        catch (Exception ex)
        {
            errorMessage = "Validation error: " + ex.Message;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task RegisterAccount()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(RegState.BusinessName) || string.IsNullOrWhiteSpace(RegState.FirstName) ||
            string.IsNullOrWhiteSpace(RegState.LastName) || string.IsNullOrWhiteSpace(RegState.Email) || string.IsNullOrWhiteSpace(RegState.Password))
        {
            errorMessage = "Please fill in all the required fields.";
            return;
        }

        if (RegState.Password != confirmPassword)
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        if (!RegState.AgreeToTerms)
        {
            errorMessage = "You must agree to the Terms of Service.";
            return;
        }

        if (!RegState.HasSelectedPlan)
        {
            errorMessage = "Please select a subscription plan first.";
            return;
        }

        isProcessing = true;

        try
        {
            var cleanEmail = RegState.Email.Trim();

            var existingUser = await DbContext.Users
                .FirstOrDefaultAsync(u => u.Email.ToLower() == cleanEmail.ToLower());

            if (existingUser != null)
            {
                errorMessage = "An account with this email already exists.";
                return;
            }

            // 1. CREATE BUSINESS
            var newBusiness = new Business
            {
                BusinessName = RegState.BusinessName.Trim(),
                Email = cleanEmail,
                Status = RegState.IsFreeTrial ? "Trial" : "Active",
                SyncStatus = "Synced",
                PlanName = RegState.IsFreeTrial ? "Free Trial (14 Days)" : (RegState.SelectedPlan?.Name ?? "Starter"),
                RegisteredAt = DateTime.Today
            };

            DbContext.Businesses.Add(newBusiness);
            await DbContext.SaveChangesAsync();

            // 2. CREATE USER (Default Role: TenantAdmin)
            var newUser = new User
            {
                BusinessId = newBusiness.BusinessId,
                Role = "TenantAdmin",
                FName = RegState.FirstName.Trim(),
                MName = "",
                LName = RegState.LastName.Trim(),
                Email = cleanEmail,
                PasswordHash = RegState.Password,
                IsTempPassword = false,
                Status = "Active",
                CreatedAt = DateTime.Now
            };

            DbContext.Users.Add(newUser);

            // 3. CREATE SUBSCRIPTION RECORD (Paid Plan or Free Trial)
            if (RegState.SelectedPlan != null)
            {
                int days = RegState.IsFreeTrial
                    ? 14
                    : (string.Equals(RegState.SelectedPlan.Cycle, "yearly", StringComparison.OrdinalIgnoreCase) ? 365 : 30);

                var subscription = new Subscription
                {
                    BusinessId = newBusiness.BusinessId,
                    SubscriptionPlanId = RegState.SelectedPlan.PlanId,
                    Amount = RegState.IsFreeTrial ? 0m : RegState.SelectedPlan.Price,
                    Cycle = RegState.IsFreeTrial ? "trial" : RegState.SelectedPlan.Cycle,
                    RenewalDate = DateTime.Today.AddDays(days),
                    PaymentStatus = RegState.IsFreeTrial ? "Trial" : "Paid",
                    Status = "Active",
                    AutoRenew = true
                };

                DbContext.Subscriptions.Add(subscription);
            }

            await DbContext.SaveChangesAsync();

            // Clear temporary registration state
            RegState.Reset();

            // Redirect to Login page
            NavigationManager.NavigateTo("/login?registered=true");
        }
        catch (Exception ex)
        {
            errorMessage = "Registration failed: " + ex.Message;
        }
        finally
        {
            isProcessing = false;
        }
    }
}