@page "/register"
@layout LandingLayout
@inject NavigationManager NavigationManager

<div class="container-fluid p-0 min-vh-100">
    <div class="row g-0 min-vh-100">

        <!-- LEFT SIDE: Visual Branding -->
        <div class="col-lg-5 d-none d-lg-flex flex-column justify-content-between p-5 position-relative login-visual-panel">
            <div class="login-blob-1"></div>
            <div class="login-blob-2"></div>

            <div class="position-relative" style="z-index: 2;">
                <a href="/" class="d-inline-flex align-items-center gap-2 text-decoration-none text-white hover-opacity mb-5">
                    <i class="bi bi-arrow-left fs-5"></i> Back to Home
                </a>
                <div class="d-flex align-items-center gap-3">
                    <img src="images/AgriNexus_finalogo.png" alt="AgriNexus" style="height: 50px; background: white; border-radius: 12px; padding: 5px;" />
                    <h3 class="text-white fw-bold mb-0">AgriNexus</h3>
                </div>
            </div>

            <div class="position-relative" style="z-index: 2; max-width: 90%;">
                <h2 class="text-white fw-bold mb-3" style="line-height: 1.3;">Start your journey to smarter farming today.</h2>
                <p class="text-white text-opacity-75 fs-5">Join modern agricultural businesses in managing operations, tracking inventory, and growing yields with confidence.</p>
            </div>

            <div class="position-relative text-white text-opacity-50 small" style="z-index: 2;">
                © 2026 AgriNexus ERP. All rights reserved.
            </div>
        </div>

        <!-- RIGHT SIDE: Registration Form -->
        <div class="col-12 col-lg-7 d-flex align-items-center justify-content-center bg-white p-4 p-md-5">
            <div class="w-100 py-4" style="max-width: 550px;">

                <a href="/" class="d-lg-none text-decoration-none text-muted mb-4 d-inline-block fw-bold">
                    <i class="bi bi-arrow-left me-2"></i> Back to Home
                </a>

                <div class="mb-5">
                    <h2 class="fw-bolder mb-2" style="color: #0A2B1D; letter-spacing: -0.5px;">Register Your Business</h2>
                    <p class="text-muted">Create an owner account to start managing your farm operations.</p>
                </div>

                <form>
                    <!-- Section 1: Business Info -->
                    <div class="d-flex align-items-center gap-2 mb-4">
                        <div class="bg-success bg-opacity-10 text-success rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;">
                            <i class="bi bi-building"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-0 text-uppercase" style="font-size: 0.8rem; letter-spacing: 1px;">Business Information</h6>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold small text-muted">Business Name</label>
                        <div class="input-group modern-input">
                            <span class="input-group-text"><i class="bi bi-shop"></i></span>
                            <input type="text" class="form-control" placeholder="e.g. Verdant Agri Ventures" />
                        </div>
                    </div>

                    <!-- Section 2: Owner Info -->
                    <div class="d-flex align-items-center gap-2 mb-4 mt-5">
                        <div class="bg-success bg-opacity-10 text-success rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;">
                            <i class="bi bi-person"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-0 text-uppercase" style="font-size: 0.8rem; letter-spacing: 1px;">Owner Details</h6>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <label class="form-label fw-bold small text-muted">First Name</label>
                            <div class="input-group modern-input">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <input type="text" class="form-control" placeholder="Juan" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">Last Name</label>
                            <div class="input-group modern-input">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <input type="text" class="form-control" placeholder="Dela Cruz" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold small text-muted">Email Address</label>
                        <div class="input-group modern-input">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input type="email" class="form-control" placeholder="owner@agribusiness.com" />
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <label class="form-label fw-bold small text-muted">Password</label>
                            <div class="input-group modern-input">
                                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                <input type="password" class="form-control" placeholder="••••••••" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">Confirm Password</label>
                            <div class="input-group modern-input">
                                <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                                <input type="password" class="form-control" placeholder="••••••••" />
                            </div>
                        </div>
                    </div>

                    <!-- Terms and Conditions -->
                    <div class="form-check mb-5 mt-4">
                        <input class="form-check-input" type="checkbox" id="terms" />
                        <label class="form-check-label text-muted small" for="terms">
                            I agree to the <a href="#" class="text-success text-decoration-none fw-bold">Terms of Service</a> and <a href="#" class="text-success text-decoration-none fw-bold">Privacy Policy</a>.
                        </label>
                    </div>

                    <button type="button" @onclick="GoToLogin" class="btn btn-primary btn-lg w-100 py-3 fw-bold rounded-3 shadow-sm btn-hover-effect mb-4">
                        Create Account
                    </button>

                    <div class="text-center">
                        <p class="text-muted small mb-0">
                            Already have an account?
                            <a href="/login" class="text-success text-decoration-none fw-bold hover-green">Sign In here</a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@code {
    private void GoToLogin()
    {
        NavigationManager.NavigateTo("/login");
    }
}