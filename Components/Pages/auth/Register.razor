@page "/register"
@layout LandingLayout
@inject NavigationManager NavigationManager
@inject AgriNexus.DataLayer.AgriNexusDbContext DbContext
@using AgriNexus.DataLayer.Models
@using Microsoft.EntityFrameworkCore

<div class="container-fluid p-0 min-vh-100" style="height: 100vh; overflow: hidden;">
    <div class="row g-0 h-100">

        <!-- LEFT SIDE: Visual Branding (60% width) -->
        <div class="col-lg-7 d-none d-lg-flex flex-column justify-content-between p-5 position-relative login-visual-panel h-100">
            <div class="login-blob-1"></div>
            <div class="login-blob-2"></div>

            <div class="position-relative" style="z-index: 2;">
                <a href="/" class="d-inline-flex align-items-center gap-2 text-decoration-none text-white hover-opacity mb-5">
                    <i class="bi bi-arrow-left fs-5"></i> Back to Home
                </a>
                <div class="d-flex align-items-center gap-3">
                    <img src="images/AgriNexus_finalogo.png" alt="AgriNexus" style="height: 50px; background: white; border-radius: 12px; padding: 5px;" />
                    <h3 class="text-white fw-bold mb-0">AgriNexus</h3>
                </div>
            </div>

            <div class="position-relative" style="z-index: 2; max-width: 80%;">
                <h2 class="text-white fw-bold mb-3 display-5" style="line-height: 1.3;">Start your journey to smarter farming today.</h2>
                <p class="text-white text-opacity-75 fs-4">Join modern agricultural businesses in managing operations, tracking inventory, and growing yields with confidence.</p>
            </div>

            <div class="position-relative text-white text-opacity-50 small" style="z-index: 2;">
                © 2026 AgriNexus ERP. All rights reserved.
            </div>
        </div>

        <!-- RIGHT SIDE: Registration Form Card (40% width) -->
        <div class="col-12 col-lg-5 d-flex align-items-center justify-content-center bg-light p-3 p-md-4 h-100">

            <!-- Scrollable Card -->
            <div class="card border-0 shadow-lg rounded-4 w-100" style="max-height: 95vh; overflow-y: auto;">
                <div class="card-body p-4 p-md-5">

                    <a href="/" class="d-lg-none text-decoration-none text-muted mb-4 d-inline-block fw-bold">
                        <i class="bi bi-arrow-left me-2"></i> Back to Home
                    </a>

                    <div class="text-center mb-4 mt-3">
                        <img src="images/AgriNexus_finalogo.png" alt="AgriNexus Logo" style="height: 80px; object-fit: contain;" />
                    </div>


                    <!-- BRANDED TEXT HEADER (CENTERED) -->
                    <div class="text-center mb-4 mt-2">
                        <h2 class="fw-bolder mb-2" style="letter-spacing: -0.5px; font-size: 1.8rem;">
                            <span style="color: #0A2B1D;">Register Your</span>
                            <span style="color: var(--primary-green);">Business</span>
                        </h2>
                        <p class="text-muted small mb-3" style="letter-spacing: 0.3px; font-size: 0.9rem; line-height: 1.5;">
                            Create an owner account to start managing your farm operations.
                        </p>

                        <!-- Tagline with Lines (Centered) -->
                        <div class="d-flex align-items-center justify-content-center gap-2 mt-4">
                            <hr class="m-0" style="width: 25px; border-top: 2px solid var(--primary-green); opacity: 1;">
                            <span class="text-uppercase fw-bold" style="color: var(--primary-green); font-size: 0.6rem; letter-spacing: 1.2px;">
                                One Platform. Multiple Farms. Smarter Operations.
                            </span>
                            <hr class="m-0" style="width: 25px; border-top: 2px solid var(--primary-green); opacity: 1;">
                        </div>
                    </div>


                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger p-2 small rounded-3">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
                        </div>
                    }

                    <form>
                        <!-- Section 1: Business Info -->
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <div class="bg-success bg-opacity-10 text-success rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 30px; height: 30px;">
                                <i class="bi bi-building"></i>
                            </div>
                            <h6 class="fw-bold text-dark mb-0 text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">Business Information</h6>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted">Business Name</label>
                            <div class="input-group modern-input">
                                <span class="input-group-text"><i class="bi bi-shop"></i></span>
                                <input type="text" class="form-control" placeholder="e.g. Verdant Agri Ventures" @bind="businessName" />
                            </div>
                        </div>

                        <!-- Section 2: Owner Info -->
                        <div class="d-flex align-items-center gap-2 mb-3 mt-4">
                            <div class="bg-success bg-opacity-10 text-success rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 30px; height: 30px;">
                                <i class="bi bi-person"></i>
                            </div>
                            <h6 class="fw-bold text-dark mb-0 text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">Owner Details</h6>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label class="form-label fw-bold small text-muted">First Name</label>
                                <div class="input-group modern-input">
                                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                                    <input type="text" class="form-control" placeholder="Juan" @bind="firstName" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted">Last Name</label>
                                <div class="input-group modern-input">
                                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                                    <input type="text" class="form-control" placeholder="Dela Cruz" @bind="lastName" />
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Email Address</label>
                            <div class="input-group modern-input">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input type="email" class="form-control" placeholder="owner@agribusiness.com" @bind="email" />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label class="form-label fw-bold small text-muted">Password</label>
                                <div class="input-group modern-input">
                                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                    <input type="password" class="form-control" placeholder="••••••••" @bind="password" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted">Confirm Password</label>
                                <div class="input-group modern-input">
                                    <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                                    <input type="password" class="form-control" placeholder="••••••••" @bind="confirmPassword" />
                                </div>
                            </div>
                        </div>

                        <!-- Terms and Conditions -->
                        <div class="form-check mb-4 mt-2">
                            <input class="form-check-input" type="checkbox" id="terms" @bind="agreeToTerms" />
                            <label class="form-check-label text-muted" style="font-size: 0.8rem;" for="terms">
                                I agree to the <a href="#" class="text-success text-decoration-none fw-bold">Terms of Service</a> and <a href="#" class="text-success text-decoration-none fw-bold">Privacy Policy</a>.
                            </label>
                        </div>

                        <button type="button" @onclick="RegisterAccount" disabled="@isProcessing" class="btn btn-primary btn-lg w-100 py-3 fw-bold rounded-3 shadow-sm btn-hover-effect mb-3">
                            @if (isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Creating Account...</span>
                            }
                            else
                            {
                                <span>Create Account</span>
                            }
                        </button>

                        <div class="text-center">
                            <p class="text-muted small mb-0">
                                Already have an account?
                                <a href="/login" class="text-success text-decoration-none fw-bold hover-green">Sign In here</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string businessName = "";
    private string firstName = "";
    private string lastName = "";
    private string email = "";
    private string password = "";
    private string confirmPassword = "";
    private bool agreeToTerms = false;
    private bool isProcessing = false;
    private string errorMessage = "";

    private async Task RegisterAccount()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(businessName) || string.IsNullOrWhiteSpace(firstName) ||
            string.IsNullOrWhiteSpace(lastName) || string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Please fill in all the required fields.";
            return;
        }

        if (password != confirmPassword)
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        if (!agreeToTerms)
        {
            errorMessage = "You must agree to the Terms of Service.";
            return;
        }

        isProcessing = true;

        try
        {
            var existingUser = await DbContext.Users.FirstOrDefaultAsync(u => u.Email == email);
            if (existingUser != null)
            {
                errorMessage = "An account with this email already exists.";
                isProcessing = false;
                return;
            }

            // CREATE BUSINESS (Removed OwnerName)
            var newBusiness = new Business
            {
                BusinessName = businessName,
                Email = email,
                Status = "Trial",
                SyncStatus = "Synced",
                PlanName = "Starter",
                RegisteredAt = DateTime.Today
            };

            DbContext.Businesses.Add(newBusiness);
            await DbContext.SaveChangesAsync();

            // CREATE USER (Replaced FullName with FName, MName, LName)
            var newUser = new User
            {
                BusinessId = newBusiness.BusinessId,
                Role = "TenantAdmin",
                FName = firstName,
                MName = "", 
                LName = lastName,
                Email = email,
                PasswordHash = password,
                Status = "Active",
                CreatedAt = DateTime.Now
            };

            DbContext.Users.Add(newUser);
            await DbContext.SaveChangesAsync();

            // Redirect to Plan Selection page, passing the newly created BusinessId
            NavigationManager.NavigateTo($"/select-plan?businessId={newBusiness.BusinessId}");
        }
        catch (Exception ex)
        {
            errorMessage = "Registration failed: " + ex.Message;
        }
        finally
        {
            isProcessing = false;
        }
    }
}