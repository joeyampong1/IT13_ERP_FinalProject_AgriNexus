@page "/forgot-password"
@layout LandingLayout
@inject NavigationManager NavigationManager

<div class="container-fluid p-0 min-vh-100">
    <div class="row g-0 min-vh-100">

        <!-- LEFT SIDE: Visual Branding -->
        <div class="col-lg-6 d-none d-lg-flex flex-column justify-content-between p-5 position-relative login-visual-panel">
            <div class="login-blob-1"></div>
            <div class="login-blob-2"></div>

            <div class="position-relative" style="z-index: 2;">
                <a href="/" class="d-inline-flex align-items-center gap-2 text-decoration-none text-white hover-opacity mb-5">
                    <i class="bi bi-arrow-left fs-5"></i> Back to Home
                </a>
                <div class="d-flex align-items-center gap-3">
                    <img src="images/AgriNexus_finalogo.png" alt="AgriNexus" style="height: 50px; background: white; border-radius: 12px; padding: 5px;" />
                    <h3 class="text-white fw-bold mb-0">AgriNexus</h3>
                </div>
            </div>

            <div class="position-relative" style="z-index: 2; max-width: 80%;">
                <h2 class="text-white fw-bold mb-3" style="line-height: 1.3;">Don't worry, we've got you covered.</h2>
                <p class="text-white text-opacity-75 fs-5">Recover your account securely and get back to managing your farm operations.</p>
            </div>

            <div class="position-relative text-white text-opacity-50 small" style="z-index: 2;">
                © 2026 AgriNexus ERP. All rights reserved.
            </div>
        </div>

        <!-- RIGHT SIDE: Forgot Password Form -->
        <div class="col-12 col-lg-6 d-flex align-items-center justify-content-center bg-white p-4 p-md-5">
            <div class="w-100 py-4" style="max-width: 420px;">

                <a href="/login" class="d-inline-flex text-decoration-none text-muted mb-4 fw-bold hover-green">
                    <i class="bi bi-arrow-left me-2"></i> Back to Login
                </a>

                @if (!isSubmitted)
                {
                    <div class="mb-5">
                        <h2 class="fw-bolder mb-2" style="color: #0A2B1D; letter-spacing: -0.5px;">Forgot Password?</h2>
                        <p class="text-muted">Enter the email address associated with your account, and we'll send you a link to reset your password.</p>
                    </div>

                    <form>
                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted">Email Address</label>
                            <div class="input-group modern-input">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input type="email" class="form-control" placeholder="admin@agrinexus.com" @bind="email" />
                            </div>
                        </div>

                        <button type="button" @onclick="HandleResetRequest" class="btn btn-primary btn-lg w-100 py-3 fw-bold rounded-3 shadow-sm btn-hover-effect mb-4">
                            Send Reset Link
                        </button>
                    </form>
                }
                else
                {
                    <div class="text-center mb-5">
                        <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success rounded-circle mb-4" style="width: 80px; height: 80px;">
                            <i class="bi bi-envelope-check" style="font-size: 2.5rem;"></i>
                        </div>
                        <h2 class="fw-bolder mb-2" style="color: #0A2B1D; letter-spacing: -0.5px;">Check your email</h2>
                        <p class="text-muted">We have sent a password reset link to <strong>@email</strong>. Please check your inbox and spam folder.</p>
                    </div>

                    <button type="button" @onclick="GoToLogin" class="btn btn-outline-secondary btn-lg w-100 py-3 fw-bold rounded-3 shadow-sm">
                        Return to Login
                    </button>
                }

            </div>
        </div>
    </div>
</div>

@code {
    private string email = "";
    private bool isSubmitted = false;

    private void HandleResetRequest()
    {
        if (!string.IsNullOrEmpty(email))
        {
            isSubmitted = true;
        }
    }

    private void GoToLogin()
    {
        NavigationManager.NavigateTo("/login");
    }
}