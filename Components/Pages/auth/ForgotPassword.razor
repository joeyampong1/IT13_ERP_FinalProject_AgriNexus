@page "/forgot-password"
@layout LandingLayout
@inject NavigationManager NavigationManager
@inject AgriNexus.DataLayer.AgriNexusDbContext DbContext
@using Microsoft.EntityFrameworkCore
@using AgriNexus.DataLayer.Models

<div class="container-fluid p-0 min-vh-100" style="height: 100vh; overflow: hidden;">
    <div class="row g-0 h-100">

        <!-- LEFT SIDE: Visual Branding (60% width) -->
        <div class="col-lg-7 d-none d-lg-flex flex-column justify-content-between p-5 position-relative login-visual-panel h-100">
            <div class="login-blob-1"></div>
            <div class="login-blob-2"></div>

            <div class="position-relative" style="z-index: 2;">
                <a href="/" class="d-inline-flex align-items-center gap-2 text-decoration-none text-white hover-opacity mb-5">
                    <i class="bi bi-arrow-left fs-5"></i> Back to Home
                </a>
                <div class="d-flex align-items-center gap-3">
                    <img src="images/AgriNexus_finalogo.png" alt="AgriNexus" style="height: 50px; background: white; border-radius: 12px; padding: 5px;" />
                    <h3 class="text-white fw-bold mb-0">AgriNexus</h3>
                </div>
            </div>

            <div class="position-relative" style="z-index: 2; max-width: 80%;">
                <h2 class="text-white fw-bold mb-3 display-5" style="line-height: 1.3;">Don't worry, we've got you covered.</h2>
                <p class="text-white text-opacity-75 fs-4">Recover your account securely and get back to managing your farm operations with confidence.</p>
            </div>

            <div class="position-relative text-white text-opacity-50 small" style="z-index: 2;">
                © 2026 AgriNexus ERP. All rights reserved.
            </div>
        </div>

        <!-- RIGHT SIDE: Forgot Password Form Card (40% width) -->
        <div class="col-12 col-lg-5 d-flex align-items-center justify-content-center bg-light p-3 p-md-4 h-100">

            <!-- Scrollable Card -->
            <div class="card border-0 shadow-lg rounded-4 w-100" style="max-height: 95vh; overflow-y: auto;">
                <div class="card-body p-4 p-md-5">

                    <a href="/" class="d-lg-none text-decoration-none text-muted mb-4 d-inline-block fw-bold">
                        <i class="bi bi-arrow-left me-2"></i> Back to Home
                    </a>

                    <div class="text-center mb-4 mt-3">
                        <img src="images/AgriNexus_finalogo.png" alt="AgriNexus Logo" style="height: 80px; object-fit: contain;" />
                    </div>

                    <!-- Form State -->
                    @if (!isSubmitted)
                    {
                        <!-- BRANDED TEXT HEADER (CENTERED) -->
                        <div class="text-center mb-4 mt-2">
                            <h2 class="fw-bolder mb-2" style="letter-spacing: -0.5px; font-size: 1.8rem;">
                                <span style="color: #0A2B1D;">Forgot</span>
                                <span style="color: var(--primary-green);">Password?</span>
                            </h2>
                            <p class="text-muted small mb-3" style="letter-spacing: 0.3px; font-size: 0.9rem; line-height: 1.5;">
                                Enter the email address associated with your account, and we'll send you a link to reset your password.
                            </p>

                            <!-- Tagline with Lines (Centered) -->
                            <div class="d-flex align-items-center justify-content-center gap-2 mt-4">
                                <hr class="m-0" style="width: 25px; border-top: 2px solid var(--primary-green); opacity: 1;">
                                <span class="text-uppercase fw-bold" style="color: var(--primary-green); font-size: 0.6rem; letter-spacing: 1.2px;">
                                    Secure Account Recovery
                                </span>
                                <hr class="m-0" style="width: 25px; border-top: 2px solid var(--primary-green); opacity: 1;">
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger p-2 small rounded-3">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
                            </div>
                        }

                        <form>
                            <!-- Section: Account Recovery -->
                            <div class="d-flex align-items-center gap-2 mb-3 mt-4">
                                <div class="bg-success bg-opacity-10 text-success rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 30px; height: 30px;">
                                    <i class="bi bi-envelope-at"></i>
                                </div>
                                <h6 class="fw-bold text-dark mb-0 text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">Account Details</h6>
                            </div>

                            <div class="mb-4 mt-4">
                                <label class="form-label fw-bold small text-muted">Email Address</label>
                                <div class="input-group modern-input">
                                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                    <input type="email" class="form-control" placeholder="owner@agribusiness.com" @bind="email" />
                                </div>
                            </div>

                            <button type="button" @onclick="HandleResetRequest" disabled="@isProcessing" class="btn btn-primary btn-lg w-100 py-3 fw-bold rounded-3 shadow-sm btn-hover-effect mb-3">
                                @if (isProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Processing...</span>
                                }
                                else
                                {
                                    <span>Send Reset Link</span>
                                }
                            </button>

                            <div class="text-center mt-4">
                                <p class="text-muted small mb-0">
                                    Remember your password?
                                    <a href="/login" class="text-success text-decoration-none fw-bold hover-green">Sign In here</a>
                                </p>
                            </div>
                        </form>
                    }
                    else
                    {
                        <!-- Success State -->
                        <div class="text-center mb-5 mt-4">
                            <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success rounded-circle mb-4" style="width: 80px; height: 80px;">
                                <i class="bi bi-envelope-check" style="font-size: 2.5rem;"></i>
                            </div>
                            <h2 class="fw-bolder mb-2" style="color: #0A2B1D; letter-spacing: -0.5px;">Check your email</h2>
                            <p class="text-muted small" style="line-height: 1.5;">We have sent a password reset link to <strong>@email</strong>. Please check your inbox and spam folder.</p>
                        </div>

                        <button type="button" @onclick="GoToLogin" class="btn btn-outline-secondary btn-lg w-100 py-3 fw-bold rounded-3 shadow-sm bg-white hover-green mb-3">
                            Return to Login
                        </button>
                    }

                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string email = "";
    private string errorMessage = "";
    private bool isSubmitted = false;
    private bool isProcessing = false;

    private async Task HandleResetRequest()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(email))
        {
            errorMessage = "Please enter your email address.";
            return;
        }

        isProcessing = true;

        try
        {
            // 1. Check if the user exists in the database
            var user = await DbContext.Users.FirstOrDefaultAsync(u => u.Email == email);

            if (user == null)
            {
                errorMessage = "No account found with this email address.";
                isProcessing = false;
                return;
            }

            // 2. Generate a secure reset token
            var resetToken = new PasswordResetToken
            {
                UserId = user.UserId,
                Token = Guid.NewGuid().ToString(), // Generate a random GUID token
                ExpiryDate = DateTime.Now.AddHours(1), // Valid for 1 hour
                IsUsed = false
            };

            // 3. Save the token to the database
            DbContext.PasswordResetTokens.Add(resetToken);
            await DbContext.SaveChangesAsync();

            isSubmitted = true;
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred: " + ex.Message;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void GoToLogin()
    {
        NavigationManager.NavigateTo("/login");
    }
}