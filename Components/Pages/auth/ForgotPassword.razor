@page "/forgot-password"
@layout LandingLayout
@inject NavigationManager NavigationManager
@inject AgriNexus.DataLayer.AgriNexusDbContext DbContext
@using Microsoft.EntityFrameworkCore
@using AgriNexus.DataLayer.Models

<div class="container-fluid p-0 min-vh-100" style="height: 100vh; overflow: hidden;">
    <div class="row g-0 h-100">

        <!-- LEFT SIDE: Visual Branding (60% width) -->
        <div class="col-lg-7 d-none d-lg-flex flex-column justify-content-between p-5 position-relative login-visual-panel h-100">
            <div class="login-grid-overlay"></div>
            <div class="login-blob-1"></div>
            <div class="login-blob-2"></div>

            <div class="position-relative" style="z-index: 2;">
                <a href="/" class="d-inline-flex align-items-center gap-2 text-decoration-none text-white-50 hover-white mb-4 small fw-semibold">
                    <i class="bi bi-arrow-left fs-6"></i> Back to Home
                </a>
                <div class="d-flex align-items-center gap-3 mt-2">
                    <div class="brand-logo-box shadow-sm">
                        <img src="images/AgriNexus_finalogo.png" alt="AgriNexus" style="height: 42px; object-fit: contain;" />
                    </div>
                    <div>
                        <h3 class="text-white fw-bolder mb-0" style="letter-spacing: -0.5px;">Agri<span class="auth-brand-nexus">Nexus</span></h3>
                        <span class="text-uppercase fw-bold auth-erp-label">Enterprise Resource Planning</span>
                    </div>
                </div>
            </div>

            <div class="position-relative my-auto" style="z-index: 2; max-width: 85%;">
                <span class="badge rounded-pill px-3 py-2 mb-3 fw-bold small auth-hero-badge">
                    <i class="bi bi-shield-lock me-1"></i> SECURE ACCOUNT RECOVERY
                </span>
                <h2 class="text-white fw-bolder mb-3 display-5" style="line-height: 1.25; letter-spacing: -0.8px;">
                    Don't worry, we've got you covered.
                </h2>
                <p class="text-white text-opacity-75 fs-5 mb-4" style="line-height: 1.6;">
                    Recover your account securely and get back to managing your farm operations with confidence.
                </p>

                <div class="d-flex flex-wrap gap-2 pt-2">
                    <span class="glass-pill"><i class="bi bi-key me-2"></i>1-Hour Token Validity</span>
                    <span class="glass-pill"><i class="bi bi-envelope-check me-2"></i>Verified Email Reset</span>
                </div>
            </div>

            <div class="position-relative d-flex justify-content-between align-items-center text-white text-opacity-50 small" style="z-index: 2;">
                <span>© 2026 AgriNexus ERP. All rights reserved.</span>
                <span>Agri-Tech Operations Platform</span>
            </div>
        </div>

        <!-- RIGHT SIDE: Forgot Password Form Card (40% width) -->
        <div class="col-12 col-lg-5 d-flex align-items-center justify-content-center login-right-surface p-3 p-md-4 h-100">

            <!-- Scrollable Card -->
            <div class="card login-form-card rounded-4 w-100" style="max-width: 470px; max-height: 95vh; overflow-y: auto;">
                <div class="card-body p-4 p-md-5">

                    <a href="/" class="d-lg-none text-decoration-none text-muted mb-3 d-inline-flex align-items-center gap-1 small fw-bold">
                        <i class="bi bi-arrow-left"></i> Back to Home
                    </a>

                    <div class="text-center mb-3 mt-1">
                        <div class="d-inline-flex align-items-center justify-content-center p-2 rounded-4" style="background: #F0F7F3; border: 1px solid #D8E8DF;">
                            <img src="images/AgriNexus_finalogo.png" alt="AgriNexus Logo" style="height: 68px; object-fit: contain;" />
                        </div>
                    </div>

                    <!-- Form State -->
                    @if (!isSubmitted)
                    {
                        <!-- BRANDED TEXT HEADER (CENTERED) -->
                        <div class="text-center mb-4">
                            <h2 class="fw-bolder mb-2" style="letter-spacing: -0.6px; font-size: 1.85rem;">
                                <span style="color: #0A2B1D;">Forgot</span>
                                <span style="color: #1B5E34;">Password?</span>
                            </h2>
                            <p class="text-muted small mb-3" style="letter-spacing: 0.2px; font-size: 0.9rem; line-height: 1.5;">
                                Enter the email address associated with your account, and we'll send you a link to reset your password.
                            </p>

                            <!-- Tagline with Lines (Centered) -->
                            <div class="d-flex align-items-center justify-content-center gap-2 mt-3">
                                <hr class="m-0" style="width: 24px; border-top: 2px solid #1B5E34; opacity: 0.6;">
                                <span class="text-uppercase fw-bold" style="color: #1B5E34; font-size: 0.6rem; letter-spacing: 1.2px;">
                                    Secure Account Recovery
                                </span>
                                <hr class="m-0" style="width: 24px; border-top: 2px solid #1B5E34; opacity: 0.6;">
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger border-0 p-3 small rounded-3 mb-3" style="background-color: #FEF2F2; color: #991B1B;">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
                            </div>
                        }

                        <form>
                            <!-- Section: Account Recovery -->
                            <div class="d-flex align-items-center gap-2 mb-3 mt-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; background-color: #E8F3EC; color: #1B5E34;">
                                    <i class="bi bi-envelope-at-fill small"></i>
                                </div>
                                <h6 class="fw-bold mb-0 text-uppercase" style="color: #0A2B1D; font-size: 0.72rem; letter-spacing: 1px;">Account Details</h6>
                            </div>

                            <div class="mb-4 mt-3">
                                <label class="form-label fw-bold small text-muted">Email Address</label>
                                <div class="input-group modern-input">
                                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                    <input type="email" class="form-control" placeholder="owner@agribusiness.com" @bind="email" />
                                </div>
                            </div>

                            <button type="button" @onclick="HandleResetRequest" disabled="@isProcessing" class="btn btn-agrinexus-primary btn-lg w-100 py-3 fw-bold rounded-3 shadow-sm mb-3">
                                @if (isProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Processing...</span>
                                }
                                else
                                {
                                    <span>Send Reset Link <i class="bi bi-arrow-right ms-1"></i></span>
                                }
                            </button>

                            <div class="text-center mt-4 pt-2 border-top" style="border-color: #EDF2EF !important;">
                                <p class="text-muted small mb-0">
                                    Remember your password?
                                    <a href="/login" class="text-decoration-none fw-bold hover-green" style="color: #1B5E34;">Sign In here</a>
                                </p>
                            </div>
                        </form>
                    }
                    else
                    {
                        <!-- Success State -->
                        <div class="text-center mb-4 mt-3">
                            <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 76px; height: 76px; background-color: #ECFDF5; color: #1B5E34; border: 1px solid #A7F3D0;">
                                <i class="bi bi-envelope-check-fill" style="font-size: 2.3rem;"></i>
                            </div>
                            <h2 class="fw-bolder mb-2" style="color: #0A2B1D; letter-spacing: -0.5px;">Check your email</h2>
                            <p class="text-muted small" style="line-height: 1.6;">
                                We have sent a password reset link to <strong class="text-dark">@email</strong>. Please check your inbox and spam folder.
                            </p>
                        </div>

                        <button type="button" @onclick="GoToLogin" class="btn btn-agrinexus-primary btn-lg w-100 py-3 fw-bold rounded-3 shadow-sm mb-3">
                            <i class="bi bi-arrow-left me-2"></i> Return to Login
                        </button>
                    }

                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string email = "";
    private string errorMessage = "";
    private bool isSubmitted = false;
    private bool isProcessing = false;

    private async Task HandleResetRequest()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(email))
        {
            errorMessage = "Please enter your email address.";
            return;
        }

        isProcessing = true;

        try
        {
            // 1. Check if the user exists in the database
            var user = await DbContext.Users.FirstOrDefaultAsync(u => u.Email == email);

            if (user == null)
            {
                errorMessage = "No account found with this email address.";
                isProcessing = false;
                return;
            }

            // 2. Generate a secure reset token
            var resetToken = new PasswordResetToken
            {
                UserId = user.UserId,
                Token = Guid.NewGuid().ToString(), // Generate a random GUID token
                ExpiryDate = DateTime.Now.AddHours(1), // Valid for 1 hour
                IsUsed = false
            };

            // 3. Save the token to the database
            DbContext.PasswordResetTokens.Add(resetToken);
            await DbContext.SaveChangesAsync();

            isSubmitted = true;
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred: " + ex.Message;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void GoToLogin()
    {
        NavigationManager.NavigateTo("/login");
    }
}