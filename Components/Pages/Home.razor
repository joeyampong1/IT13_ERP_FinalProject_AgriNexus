@page "/"
@layout LandingLayout
@inject IJSRuntime JS

<!-- =========================================
     NAVBAR (Glassmorphism Effect)
     ========================================= -->
<nav class="landing-navbar" id="top">
    <div class="container-fluid px-4 px-md-5 d-flex flex-wrap justify-content-between align-items-center py-3 gap-2">

        <!-- Logo -->
        <a href="/" class="d-flex align-items-center gap-2 text-decoration-none">
            <img src="images/AgriNexus_finalogo.png" alt="AgriNexus"
                 style="height: 40px; object-fit: contain; border-radius: 10px; background-color: white; padding: 3px; box-shadow: 0 2px 10px rgba(10,43,29,0.08); border: 1px solid #E2ECE6;" />
            <h4 class="mb-0 fw-bolder" style="color: #0A2B1D; letter-spacing: -0.5px;">Agri<span style="color: #1B5E34;">Nexus</span></h4>
        </a>

        <!-- Links & Actions -->
        <div class="d-flex align-items-center gap-4">
            <a href="#features" class="text-decoration-none fw-semibold hover-green d-none d-md-block" style="color: #0A2B1D;">Features</a>
            <a href="#stats" class="text-decoration-none fw-semibold hover-green d-none d-md-block" style="color: #0A2B1D;">Why Us?</a>
            <div class="vr d-none d-md-block text-muted"></div>
            <a href="/login" class="text-decoration-none fw-semibold hover-green" style="color: #0A2B1D;">Log In</a>
            <a href="/register" class="btn btn-agrinexus-primary px-4 py-2 rounded-3 fw-bold shadow-sm btn-hover-effect">
                Get Started
            </a>
        </div>
    </div>
</nav>

<!-- =========================================
     HERO SECTION (Split Layout with Mockup)
     ========================================= -->
<section class="hero-section position-relative overflow-hidden">
    <!-- Background Accents -->
    <div class="bg-grid"></div>
    <div class="glow-blob glow-green"></div>
    <div class="glow-blob glow-dark"></div>

    <div class="container-fluid px-4 px-md-5 position-relative" style="z-index: 2;">
        <div class="row align-items-center min-vh-100 py-5">

            <!-- Left: Typography & CTA -->
            <div class="col-lg-6 mb-5 mb-lg-0 pe-lg-4">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-2 mb-4 rounded-pill shadow-sm" style="background: rgba(255,255,255,0.92); border: 1px solid #D5E6DC; backdrop-filter: blur(10px);">
                    <span class="badge rounded-circle p-1" style="background-color: #1B5E34; color: #FFFFFF;"><i class="bi bi-stars"></i></span>
                    <span class="fw-bold small text-uppercase" style="color: #1B5E34; letter-spacing: 1px;">V2.0 Now Available</span>
                </div>

                <h1 class="display-2 fw-bolder mb-3" style="line-height: 1.05; color: #0A2B1D; letter-spacing: -1px;">
                    The ERP Built for <br />
                    <span class="text-gradient-green">Modern Agriculture.</span>
                </h1>

                <p class="lead text-muted mb-5" style="font-size: 1.15rem; max-width: 90%;">
                    Centralize your farm operations. From crop planning and inventory to labor tracking and cloud sync—AgriNexus keeps your business running, even offline.
                </p>

                <div class="d-flex flex-wrap gap-3 mb-4">
                    <a href="/register" class="btn btn-agrinexus-primary btn-lg px-5 py-3 rounded-3 fw-bold shadow-lg btn-hover-effect">
                        Start Free Trial
                    </a>
                    <a href="#features" class="btn btn-white-forest btn-lg px-5 py-3 rounded-3 fw-bold shadow-sm">
                        See How It Works
                    </a>
                </div>

                <div class="d-flex align-items-center gap-4 text-muted small fw-medium mt-4">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-check-circle-fill me-2" style="color: #1B5E34;"></i>
                        <span>No credit card required</span>
                    </div>
                    <div class="d-flex align-items-center">
                        <i class="bi bi-shield-lock-fill me-2" style="color: #1B5E34;"></i>
                        <span>Enterprise-grade security</span>
                    </div>
                </div>
            </div>

            <!-- Right: 3D UI Mockup (Pure CSS) -->
            <div class="col-lg-6 text-center position-relative">
                <div class="mockup-window shadow-2xl">
                    <!-- Mockup Header -->
                    <div class="mockup-header d-flex align-items-center gap-2 px-3 py-2 border-bottom">
                        <div class="mockup-dot bg-danger"></div>
                        <div class="mockup-dot bg-warning"></div>
                        <div class="mockup-dot" style="background-color: #1B5E34;"></div>
                        <div class="ms-auto text-muted small fw-bold"><i class="bi bi-lock-fill me-1" style="color: #1B5E34;"></i> agrinexus.app</div>
                    </div>
                    <!-- Mockup Body (Dashboard Preview) -->
                    <div class="mockup-body p-4 d-flex gap-3" style="background-color: #F4F7F5;">
                        <!-- Sidebar -->
                        <div class="mockup-sidebar rounded-3 d-none d-sm-flex flex-column gap-2 p-3" style="background: linear-gradient(180deg, #071E14 0%, #0A2B1D 100%); width: 60px;">
                            <div class="rounded-circle mx-auto" style="background-color: #2E8B57; width: 25px; height: 25px;"></div>
                            <div class="bg-white rounded mx-auto mt-2" style="width: 30px; height: 5px; opacity: 0.35;"></div>
                            <div class="bg-white rounded mx-auto" style="width: 30px; height: 5px; opacity: 0.25;"></div>
                            <div class="bg-white rounded mx-auto" style="width: 30px; height: 5px; opacity: 0.25;"></div>
                        </div>
                        <!-- Content Area -->
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between mb-3">
                                <div class="bg-white rounded px-3 py-2 shadow-sm" style="width: 40%; border: 1px solid #E2ECE6;"></div>
                                <div class="rounded-pill px-3 py-2 text-white small fw-bold" style="background-color: #1B5E34;">Sync: ON</div>
                            </div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <div class="bg-white p-3 rounded-3 shadow-sm" style="border: 1px solid #E2ECE6;">
                                        <div class="text-muted small fw-bold mb-1">TOTAL SALES</div>
                                        <div class="fs-5 fw-bolder" style="color: #0A2B1D;">₱123,280</div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="bg-white p-3 rounded-3 shadow-sm" style="border: 1px solid #E2ECE6;">
                                        <div class="text-muted small fw-bold mb-1">HARVEST</div>
                                        <div class="fs-5 fw-bolder" style="color: #1B5E34;">2,760 kg</div>
                                    </div>
                                </div>
                                <div class="col-12 mt-3">
                                    <div class="bg-white p-3 rounded-3 shadow-sm d-flex align-items-end gap-2" style="height: 100px; border: 1px solid #E2ECE6;">
                                        <div class="rounded-top w-100" style="height: 40%; background-color: #D1E5D9;"></div>
                                        <div class="rounded-top w-100" style="height: 70%; background-color: #6FA886;"></div>
                                        <div class="rounded-top w-100" style="height: 90%; background-color: #1B5E34;"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Floating Element -->
                <div class="floating-badge shadow-lg d-none d-md-flex align-items-center gap-3 px-3 py-2 bg-white rounded-4" style="border: 1px solid #D5E6DC;">
                    <div class="rounded-circle p-2 d-flex align-items-center justify-content-center" style="background-color: #E8F3EC; color: #1B5E34; width: 38px; height: 38px;">
                        <i class="bi bi-arrow-repeat fs-5"></i>
                    </div>
                    <div class="text-start">
                        <div class="fw-bold small" style="color: #0A2B1D;">Cloud Sync</div>
                        <div class="text-muted" style="font-size: 0.7rem;">Just now</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================
     STATS SECTION (Trust Builders)
     ========================================= -->
<section id="stats" class="py-5 bg-white" style="border-top: 1px solid #E2ECE6; border-bottom: 1px solid #E2ECE6;">
    <div class="container-fluid px-4 px-md-5">
        <div class="row text-center justify-content-center align-items-center">
            <div class="col-6 col-md-3 mb-4 mb-md-0 border-end-md">
                <h2 class="fw-bolder mb-1" style="color: #0A2B1D;">100%</h2>
                <p class="text-muted small fw-bold text-uppercase mb-0" style="letter-spacing: 1px;">Offline Capable</p>
            </div>
            <div class="col-6 col-md-3 mb-4 mb-md-0 border-end-md">
                <h2 class="fw-bolder mb-1" style="color: #1B5E34;">0ms</h2>
                <p class="text-muted small fw-bold text-uppercase mb-0" style="letter-spacing: 1px;">Local Latency</p>
            </div>
            <div class="col-6 col-md-3 border-end-md">
                <h2 class="fw-bolder mb-1" style="color: #0A2B1D;">24/7</h2>
                <p class="text-muted small fw-bold text-uppercase mb-0" style="letter-spacing: 1px;">Cloud Sync</p>
            </div>
            <div class="col-6 col-md-3">
                <h2 class="fw-bolder mb-1" style="color: #1B5E34;">Multi</h2>
                <p class="text-muted small fw-bold text-uppercase mb-0" style="letter-spacing: 1px;">Branch Support</p>
            </div>
        </div>
    </div>
</section>

<!-- =========================================
     FEATURES SECTION (Bento Box Layout)
     ========================================= -->
<section id="features" class="py-5" style="background-color: #F4F7F5;">
    <div class="container-fluid px-4 px-md-5 py-5">

        <div class="text-center mb-5 max-w-700 mx-auto">
            <span class="badge rounded-pill px-3 py-2 mb-2 fw-bold text-uppercase" style="background-color: #E8F3EC; color: #1B5E34; letter-spacing: 1.5px; font-size: 0.72rem;">Core Modules</span>
            <h2 class="fw-bolder mb-3 display-5" style="color: #0A2B1D; letter-spacing: -1px;">Everything you need to grow.</h2>
            <p class="text-muted fs-5">Built specifically for agricultural businesses with multiple branches and unreliable internet connectivity.</p>
        </div>

        <!-- Bento Grid -->
        <div class="bento-grid">

            <!-- Box 1: Large (Offline) -->
            <div class="bento-item bento-large bg-white rounded-4 p-4 p-md-5 shadow-sm d-flex flex-column justify-content-between position-relative overflow-hidden" style="border: 1px solid #E2ECE6;">
                <div class="position-relative" style="z-index: 2;">
                    <div class="icon-box mb-4 rounded-3 d-inline-flex align-items-center justify-content-center" style="background-color: #E8F3EC; color: #1B5E34;">
                        <i class="bi bi-cloud-slash fs-2"></i>
                    </div>
                    <h3 class="fw-bold mb-3" style="color: #0A2B1D;">Offline-First Architecture</h3>
                    <p class="text-muted mb-0 fs-6">Continue recording harvests, sales, and expenses even without internet. Your data is safely stored locally and syncs automatically once connectivity is restored.</p>
                </div>
                <div class="bento-bg-decor position-absolute bottom-0 end-0">
                    <i class="bi bi-wifi-off"></i>
                </div>
            </div>

            <!-- Box 2: Small (Multi-Branch) -->
            <div class="bento-item bg-white rounded-4 p-4 shadow-sm" style="border: 1px solid #E2ECE6;">
                <div class="icon-box mb-3 rounded-3 d-inline-flex align-items-center justify-content-center" style="background-color: #EDF2F7; color: #0A2B1D;">
                    <i class="bi bi-diagram-3 fs-3"></i>
                </div>
                <h4 class="fw-bold mb-2" style="color: #0A2B1D;">Multi-Branch</h4>
                <p class="text-muted small mb-0">Manage multiple farms from one centralized platform with strict role-based access.</p>
            </div>

            <!-- Box 3: Small (Inventory) -->
            <div class="bento-item bg-white rounded-4 p-4 shadow-sm" style="border: 1px solid #E2ECE6;">
                <div class="icon-box mb-3 rounded-3 d-inline-flex align-items-center justify-content-center" style="background-color: #FEF3C7; color: #B45309;">
                    <i class="bi bi-box-seam fs-3"></i>
                </div>
                <h4 class="fw-bold mb-2" style="color: #0A2B1D;">Smart Inventory</h4>
                <p class="text-muted small mb-0">Track supplies, stock movements, and farm inputs with precision.</p>
            </div>

            <!-- Box 4: Large (Reports) -->
            <div class="bento-item bento-large rounded-4 p-4 p-md-5 shadow-sm text-white position-relative overflow-hidden" style="background: linear-gradient(145deg, #071E14 0%, #0A2B1D 55%, #164A2B 100%);">
                <div class="position-relative" style="z-index: 2;">
                    <div class="icon-box mb-4 rounded-3 d-inline-flex align-items-center justify-content-center" style="background-color: rgba(255,255,255,0.12); color: #6EE7B7;">
                        <i class="bi bi-bar-chart-line fs-2"></i>
                    </div>
                    <h3 class="fw-bold mb-3">Comprehensive Reports</h3>
                    <p class="text-white text-opacity-75 mb-0 fs-6">Monitor harvested produce, sales transactions, labor expenses, and estimated production costs in real-time with beautiful dashboards.</p>
                </div>
                <div class="bento-bg-decor-dark position-absolute bottom-0 end-0">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
            </div>

        </div>

        <div class="text-center mt-5 pt-4">
            <button @onclick="ScrollToTop" class="btn btn-white-forest rounded-3 px-4 py-2 fw-bold shadow-sm">
                <i class="bi bi-arrow-up me-2"></i> Back to Top
            </button>
        </div>

    </div>
</section>

<!-- =========================================
     CTA SECTION (High Impact)
     ========================================= -->
<section class="py-5 position-relative overflow-hidden" style="background: linear-gradient(135deg, #0A2B1D 0%, #1B5E34 100%);">
    <div class="container-fluid px-4 px-md-5 py-4 text-center position-relative" style="z-index: 2;">
        <span class="badge rounded-pill px-3 py-2 mb-3 fw-bold small" style="background: rgba(255,255,255,0.12); color: #6EE7B7; border: 1px solid rgba(110, 231, 183, 0.25);">
            GET STARTED TODAY
        </span>
        <h2 class="display-5 fw-bolder text-white mb-4">Ready to modernize your farm?</h2>
        <p class="text-white text-opacity-75 fs-5 mb-5 max-w-600 mx-auto">Join forward-thinking agricultural businesses using AgriNexus to streamline operations.</p>
        <a href="/register" class="btn btn-light btn-lg px-5 py-3 rounded-3 fw-bold shadow-lg btn-hover-effect" style="color: #0A2B1D;">
            Register Your Business Now <i class="bi bi-arrow-right ms-2"></i>
        </a>
    </div>
</section>

<!-- =========================================
     FOOTER
     ========================================= -->
<footer class="py-4 border-top" style="background-color: #071E14; border-color: rgba(255,255,255,0.08) !important;">
    <div class="container-fluid px-4 px-md-5 d-flex flex-column flex-md-row justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2 mb-3 mb-md-0">
            <img src="images/AgriNexus_finalogo.png" alt="Logo" style="height: 30px; border-radius: 6px; background: white; padding: 2px;" />
            <span class="fw-bold text-white fs-5">AgriNexus</span>
        </div>
        <p class="mb-0 small text-white text-opacity-50">© 2026 AgriNexus ERP. All rights reserved.</p>
    </div>
</footer>

@code {
    private async Task ScrollToTop()
    {
        await JS.InvokeVoidAsync("eval", "document.querySelector('.landing-page').scrollTo({top: 0, behavior: 'smooth'})");
    }
}