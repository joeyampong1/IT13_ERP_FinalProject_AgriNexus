@page "/reports"

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <h2 class="page-title">Reports & Analytics</h2>
        <p class="text-muted mb-0 page-sub">Generate comprehensive reports and view platform-wide performance metrics.</p>
    </div>

    <!-- Quick Filter (Modern Design) -->
    <div class="d-flex align-items-center gap-2 bg-white border shadow-sm rounded-3 px-3 py-1" style="border-color: var(--border-color) !important;">
        <i class="bi bi-calendar3 text-success"></i>
        <select class="filter-select border-0 shadow-none bg-transparent fw-bold p-0 pe-4" style="min-width: 140px; font-size: 0.9rem; cursor: pointer;">
            <option>This Month</option>
            <option>Last 30 Days</option>
            <option>This Quarter</option>
            <option>Year to Date</option>
        </select>
    </div>
</div>

<!-- REPORT GENERATOR PANEL -->
<div class="card-box mb-4" style="background: linear-gradient(to right, #ffffff, #f8fafc); border-left: 4px solid var(--primary-green);">
    <div class="panel-title mb-3"><i class="bi bi-file-earmark-bar-graph text-success me-2"></i>Generate Custom Report</div>

    <div class="row g-3 align-items-end">
        <!-- Date Range -->
        <div class="col-md-3">
            <label class="form-label fw-semibold text-muted" style="font-size: 0.8rem;">Start Date</label>
            <input type="date" class="form-control" @bind="startDate" />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-semibold text-muted" style="font-size: 0.8rem;">End Date</label>
            <input type="date" class="form-control" @bind="endDate" />
        </div>

        <!-- Report Type (Multi-select via checkboxes in a dropdown-like box) -->
        <div class="col-md-3">
            <label class="form-label fw-semibold text-muted" style="font-size: 0.8rem;">Include Metrics</label>
            <div class="dropdown">
                <button class="btn btn-outline-secondary w-100 text-start d-flex justify-content-between align-items-center bg-white" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 0.9rem;">
                    <span>Select metrics...</span>
                    <i class="bi bi-chevron-down"></i>
                </button>
                <ul class="dropdown-menu w-100 shadow-sm border-0">
                    <li><label class="dropdown-item d-flex gap-2"><input type="checkbox" checked /> Total Revenue</label></li>
                    <li><label class="dropdown-item d-flex gap-2"><input type="checkbox" checked /> Active Tenants</label></li>
                    <li><label class="dropdown-item d-flex gap-2"><input type="checkbox" /> Module Usage</label></li>
                    <li><label class="dropdown-item d-flex gap-2"><input type="checkbox" /> Top Tenants</label></li>
                </ul>
            </div>
        </div>

        <!-- File Type & Button -->
        <div class="col-md-3">
            <label class="form-label fw-semibold text-muted" style="font-size: 0.8rem;">Format</label>
            <div class="d-flex gap-2">
                <select class="form-select" style="width: 100px;">
                    <option>PDF</option>
                    <option>Excel</option>
                    <option>Word</option>
                </select>
                <button class="btn btn-primary fw-bold flex-grow-1" @onclick="GenerateReport">
                    <i class="bi bi-download me-1"></i> Generate
                </button>
            </div>
        </div>
    </div>
</div>

<!-- STAT CARDS -->
<div class="row g-3 mb-4">
    @foreach (var s in Stats)
    {
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <span class="card-title">@s.Title</span>
                    <div class="stat-icon @s.IconClass"><i class="bi @s.Icon"></i></div>
                </div>
                <div class="mt-3">
                    <div class="card-value">@s.Value</div>
                    <div class="text-muted small mt-1">
                        <span class="@(s.Trend.StartsWith("+") ? "text-success" : "text-danger") fw-bold">
                            <i class="bi @(s.Trend.StartsWith("+") ? "bi-arrow-up-right" : "bi-arrow-down-right")"></i> @s.Trend
                        </span> vs last month
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- CHARTS ROW 1 -->
<div class="row g-4 mb-4">

    <!-- Revenue Trend (Area Chart) -->
    <div class="col-12 col-lg-8">
        <div class="stat-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <div class="panel-title">Revenue Growth</div>
                    <div class="panel-sub">Monthly recurring revenue (MRR) trend</div>
                </div>
                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-bold">+18.5%</span>
            </div>

            <svg viewBox="0 0 800 300" class="w-100" style="max-height: 320px;">
                <defs>
                    <!-- Gradient Fill para sa Area Chart -->
                    <linearGradient id="areaGradient" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#388E3C" stop-opacity="0.3" />
                        <stop offset="100%" stop-color="#388E3C" stop-opacity="0" />
                    </linearGradient>
                </defs>

                <!-- Grid Lines & Y-Axis -->
                @for (int i = 0; i <= 4; i++)
                {
                    var y = 20 + i * 60;
                    <g>
                        <line x1="50" x2="780" y1="@y" y2="@y" stroke="#E2E8F0" stroke-dasharray="4 4" />
                        <text x="40" y="@(y + 4)" text-anchor="end" font-size="11" fill="#64748B">@(20 - (i * 5))k</text>
                    </g>
                }

                <!-- Area Fill -->
                <path d="M 50,240 L 160,210 L 280,170 L 400,180 L 520,120 L 640,80 L 780,30 L 780,280 L 50,280 Z" fill="url(#areaGradient)" />

                <!-- Line Path -->
                <polyline points="50,240 160,210 280,170 400,180 520,120 640,80 780,30"
                          fill="none" stroke="#388E3C" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />

                <!-- Data Points -->
                <circle cx="160" cy="210" r="5" fill="white" stroke="#388E3C" stroke-width="3" />
                <circle cx="280" cy="170" r="5" fill="white" stroke="#388E3C" stroke-width="3" />
                <circle cx="400" cy="180" r="5" fill="white" stroke="#388E3C" stroke-width="3" />
                <circle cx="520" cy="120" r="5" fill="white" stroke="#388E3C" stroke-width="3" />
                <circle cx="640" cy="80" r="5" fill="white" stroke="#388E3C" stroke-width="3" />
                <circle cx="780" cy="30" r="6" fill="#388E3C" stroke="white" stroke-width="2" />

                <!-- X-Axis Labels -->
                <g>
                    <text x="50" y="295" text-anchor="middle" font-size="11" fill="#64748B">Jan</text>
                    <text x="160" y="295" text-anchor="middle" font-size="11" fill="#64748B">Feb</text>
                    <text x="280" y="295" text-anchor="middle" font-size="11" fill="#64748B">Mar</text>
                    <text x="400" y="295" text-anchor="middle" font-size="11" fill="#64748B">Apr</text>
                    <text x="520" y="295" text-anchor="middle" font-size="11" fill="#64748B">May</text>
                    <text x="640" y="295" text-anchor="middle" font-size="11" fill="#64748B">Jun</text>
                    <text x="780" y="295" text-anchor="middle" font-size="11" fill="#64748B">Jul</text>
                </g>
            </svg>
        </div>
    </div>

    <!-- Tenant Distribution (Donut Chart) -->
    <div class="col-12 col-lg-4">
        <div class="stat-card h-100">
            <div class="panel-title">Tenant Distribution</div>
            <div class="panel-sub">By subscription status</div>

            <div class="d-flex justify-content-center my-3 position-relative">
                <svg viewBox="0 0 200 200" width="180" height="180">
                    @{
                        double offset = 0;
                    }
                    @foreach (var s in TenantStatusSlices)
                    {
                        var len = s.Count / (double)TotalTenants * Circ;
                        var dash = Math.Max(len - 4, 0.5); // Gamay nga space tali sa slices
                                                           <circle cx="100" cy="100" r="@Radius" fill="none" stroke="@s.Color" stroke-width="25"
                                                                   stroke-dasharray="@($"{dash} {Circ - dash}")"
                                                                   stroke-dashoffset="@(-offset)"
                                                                   transform="rotate(-90 100 100)" />
                        offset += len;
                    }
                </svg>
                <!-- Center Text -->
                <div class="position-absolute top-50 start-50 translate-middle text-center">
                    <h3 class="fw-bold mb-0 text-dark">@TotalTenants</h3>
                    <span class="text-muted small">Total</span>
                </div>
            </div>

            <div class="d-flex justify-content-center gap-3 small fw-semibold text-muted flex-wrap mt-3">
                @foreach (var s in TenantStatusSlices)
                {
                    <span><span class="legend-dot" style="background:@s.Color"></span>@s.Label</span>
                }
            </div>
        </div>
    </div>
</div>

<!-- CHARTS ROW 2 -->
<div class="row g-4">
    <!-- Module Usage (Vertical Bar Chart) -->
    <div class="col-12 col-lg-5">
        <div class="stat-card h-100">
            <div class="panel-title mb-3">Module Transactions</div>

            <svg viewBox="0 0 400 250" class="w-100" style="max-height: 220px;">
                @for (int i = 0; i < ModuleUsage.Count; i++)
                {
                    var m = ModuleUsage[i];
                    var barHeight = (m.Count / 25000.0) * 180; // Scale height
                    var x = 30 + i * 90;
                    var y = 200 - barHeight;

                    <g>
                        <!-- Background Bar -->
                        <rect x="@x" y="20" width="50" height="180" fill="#F1F5F9" rx="4" />
                        <!-- Value Bar -->
                        <rect x="@x" y="@y" width="50" height="@barHeight" fill="@m.Color" rx="4" class="bar-animate" />
                        <!-- Label & Count -->
                        <text x="@(x + 25)" y="220" text-anchor="middle" font-size="11" fill="#64748B" font-weight="600">@m.Name.Split(' ')[0]</text>
                        <text x="@(x + 25)" y="@(y - 8)" text-anchor="middle" font-size="11" fill="#1E293B" font-weight="bold">@m.Count.ToString("N0")</text>
                    </g>
                }
            </svg>
        </div>
    </div>

    <!-- Top Performing Tenants Table -->
    <div class="col-12 col-lg-7">
        <div class="stat-card h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <div class="panel-title">Top Performing Tenants</div>
                    <div class="panel-sub">Ranked by total transaction volume</div>
                </div>
                <button class="btn btn-sm btn-outline-secondary rounded-3">View All</button>
            </div>

            <div class="table-responsive">
                <table class="table dash-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Business Name</th>
                            <th>Plan</th>
                            <th>Total Sales</th>
                            <th>Growth</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in TopTenants)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@t.Business</div>
                                    <div class="sub text-muted" style="font-size: 0.75rem;">@t.Code</div>
                                </td>
                                <td><span class="pill pill-gray">@t.Plan</span></td>
                                <td class="fw-semibold">@t.Sales</td>
                                <td class="text-success fw-bold"><i class="bi bi-graph-up-arrow me-1"></i> +@t.Growth%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Success Toast -->
@if (showToast)
{
    <div class="toast-note" style="position: fixed; bottom: 2rem; right: 2rem; z-index: 1050; background: #1B5E34; color: white; padding: 1rem 1.5rem; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.2); display: flex; align-items: center; gap: 10px;">
        <i class="bi bi-check-circle-fill fs-5"></i> <span class="fw-semibold">Report generated successfully!</span>
    </div>
}

@code {
    record Stat(string Title, string Value, string Trend, string Icon, string IconClass);
    record Module(string Name, int Count, string Color);
    record Tenant(string Business, string Code, string Plan, string Sales, double Growth);
    record DonutSlice(string Label, int Count, string Color);

    // Report Gen State
    private DateTime startDate = DateTime.Today.AddDays(-30);
    private DateTime endDate = DateTime.Today;
    private bool showToast = false;

    // Charts Data
    const double Radius = 70;
    static readonly double Circ = 2 * Math.PI * Radius;

    List<Stat> Stats => new() {
        new("TOTAL REVENUE", "₱185,400.00", "+12.5%", "bi-cash-stack", "stat-icon-blue"),
        new("ACTIVE TENANTS", "24", "+4", "bi-buildings", ""),
        new("TRANSACTIONS", "48,250", "+8.2%", "bi-receipt", "stat-icon-plain"),
        new("AVG HARVEST", "12.5K kg", "-1.1%", "bi-basket", "stat-icon-warn")
    };

    List<DonutSlice> TenantStatusSlices => new() {
        new("Active", 18, "#1B5E34"),
        new("Trial", 4, "#81C784"),
        new("Suspended", 2, "#F59E0B")
    };
    int TotalTenants => TenantStatusSlices.Sum(s => s.Count);

    List<Module> ModuleUsage => new() {
        new("Sales", 24500, "#1B5E34"),
        new("Inventory", 15200, "#4CAF50"),
        new("Harvest", 8100, "#81C784"),
        new("Labor", 4500, "#A5D6A7")
    };

    List<Tenant> TopTenants => new() {
        new("Harvest Hills Agri Corp", "HAR-002", "Enterprise", "₱450,000", 24.5),
        new("Verdant Agri Ventures", "AGV-001", "Growth", "₱320,000", 18.2),
        new("Sunrise Rice Farmers Coop", "SRF-003", "Coop Custom", "₱850,000", 12.0)
    };

    async Task GenerateReport()
    {
        // Simulate API call
        await Task.Delay(1500);
        showToast = true;
        StateHasChanged();
        await Task.Delay(3000);
        showToast = false;
        StateHasChanged();
    }
}