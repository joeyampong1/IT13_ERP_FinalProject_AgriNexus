@page "/reports"

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <h2 class="page-title">Reports & Analytics</h2>
        <p class="text-muted mb-0 page-sub">Platform-wide overview of SaaS revenue, tenant growth, and system health.</p>
    </div>

    <!-- Quick Filter -->
    <div class="d-flex align-items-center gap-2 bg-white border shadow-sm rounded-3 px-3 py-1" style="border-color: var(--border-color) !important;">
        <i class="bi bi-calendar3 text-success"></i>
        <select class="filter-select border-0 shadow-none bg-transparent fw-bold p-0 pe-4" style="min-width: 140px; font-size: 0.9rem; cursor: pointer;">
            <option>This Month</option>
            <option>Last 30 Days</option>
            <option>This Quarter</option>
            <option>Year to Date</option>
        </select>
    </div>
</div>

<!-- REPORT GENERATOR PANEL -->
<div class="card-box mb-4" style="background: linear-gradient(to right, #ffffff, #f8fafc); border-left: 4px solid var(--primary-green);">
    <div class="panel-title mb-3"><i class="bi bi-file-earmark-bar-graph text-success me-2"></i>Generate Custom Report</div>
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label fw-semibold text-muted" style="font-size: 0.8rem;">Start Date</label>
            <input type="date" class="form-control" @bind="startDate" />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-semibold text-muted" style="font-size: 0.8rem;">End Date</label>
            <input type="date" class="form-control" @bind="endDate" />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-semibold text-muted" style="font-size: 0.8rem;">Include Metrics</label>
            <div class="dropdown">
                <button class="btn btn-outline-secondary w-100 text-start d-flex justify-content-between align-items-center bg-white" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 0.9rem;">
                    <span>Select metrics...</span>
                    <i class="bi bi-chevron-down"></i>
                </button>
                <ul class="dropdown-menu w-100 shadow-sm border-0" style="padding: 0.5rem;">
                    <li><label class="dropdown-item d-flex gap-2 rounded" style="cursor:pointer;"><input type="checkbox" @bind="includeRevenue" /> SaaS Revenue</label></li>
                    <li><label class="dropdown-item d-flex gap-2 rounded" style="cursor:pointer;"><input type="checkbox" @bind="includeTenants" /> Tenant Growth</label></li>
                    <li><label class="dropdown-item d-flex gap-2 rounded" style="cursor:pointer;"><input type="checkbox" @bind="includeModules" /> Module Usage</label></li>
                    <li><label class="dropdown-item d-flex gap-2 rounded" style="cursor:pointer;"><input type="checkbox" @bind="includeSystem" /> System Health</label></li>
                </ul>
            </div>
        </div>
        <div class="col-md-3">
            <label class="form-label fw-semibold text-muted" style="font-size: 0.8rem;">Format</label>
            <div class="d-flex gap-2">
                <select class="form-select" style="width: 100px;">
                    <option>PDF</option>
                    <option>Excel</option>
                </select>
                <button class="btn btn-primary fw-bold flex-grow-1" @onclick="GenerateReport" disabled="@isGenerating">
                    @if (isGenerating)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        <span>Wait...</span>
                    }
                    else
                    {
                        <i class="bi bi-download me-1"></i> <span>Generate</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

<!-- MAIN KPI CARDS -->
<div class="row g-3 mb-3">
    @foreach (var s in MainStats)
    {
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <span class="card-title">@s.Title</span>
                    <div class="stat-icon @s.IconClass"><i class="bi @s.Icon"></i></div>
                </div>
                <div class="mt-3">
                    <div class="card-value">@s.Value</div>
                    <div class="text-muted small mt-1">
                        <span class="@(s.Trend.StartsWith("+") ? "text-success" : "text-danger") fw-bold">
                            <i class="bi @(s.Trend.StartsWith("+") ? "bi-arrow-up-right" : "bi-arrow-down-right")"></i> @s.Trend
                        </span> vs last month
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- MINI KPI BAR (SaaS Metrics) -->
<div class="row g-2 mb-4">
    <div class="col-6 col-md-3">
        <div class="card-box py-2 px-3 d-flex justify-content-between align-items-center" style="border-radius: 12px;">
            <span class="text-muted small fw-bold">ARPU</span>
            <span class="fw-bold text-dark">₱7,725</span>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card-box py-2 px-3 d-flex justify-content-between align-items-center" style="border-radius: 12px;">
            <span class="text-muted small fw-bold">Churn Rate</span>
            <span class="fw-bold text-danger">1.2%</span>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card-box py-2 px-3 d-flex justify-content-between align-items-center" style="border-radius: 12px;">
            <span class="text-muted small fw-bold">New Signups</span>
            <span class="fw-bold text-success">5</span>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card-box py-2 px-3 d-flex justify-content-between align-items-center" style="border-radius: 12px;">
            <span class="text-muted small fw-bold">System Uptime</span>
            <span class="fw-bold text-success">99.9%</span>
        </div>
    </div>
</div>

<!-- CHARTS ROW 1 -->
<div class="row g-4 mb-4">
    <!-- Platform Revenue Growth (Area Chart) -->
    <div class="col-12 col-lg-7">
        <div class="stat-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <div class="panel-title">Platform Revenue Growth</div>
                    <div class="panel-sub">Monthly recurring revenue (MRR) trend</div>
                </div>
                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-bold">+18.5%</span>
            </div>
            <svg viewBox="0 0 800 300" class="w-100" style="max-height: 280px;">
                <defs>
                    <linearGradient id="areaGradient" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#388E3C" stop-opacity="0.3" />
                        <stop offset="100%" stop-color="#388E3C" stop-opacity="0" />
                    </linearGradient>
                </defs>
                @for (int i = 0; i <= 4; i++)
                {
                    var y = 20 + i * 60;
                    <g>
                        <line x1="50" x2="780" y1="@y" y2="@y" stroke="#E2E8F0" stroke-dasharray="4 4" />
                        <text x="40" y="@(y + 4)" text-anchor="end" font-size="11" fill="#64748B">@(200 - (i * 50))k</text>
                    </g>
                }
                <path d="M 50,240 L 160,210 L 280,170 L 400,180 L 520,120 L 640,80 L 780,30 L 780,280 L 50,280 Z" fill="url(#areaGradient)" />
                <polyline points="50,240 160,210 280,170 400,180 520,120 640,80 780,30" fill="none" stroke="#388E3C" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
                <g>
                    <text x="50" y="295" text-anchor="middle" font-size="11" fill="#64748B">Jan</text>
                    <text x="160" y="295" text-anchor="middle" font-size="11" fill="#64748B">Feb</text>
                    <text x="280" y="295" text-anchor="middle" font-size="11" fill="#64748B">Mar</text>
                    <text x="400" y="295" text-anchor="middle" font-size="11" fill="#64748B">Apr</text>
                    <text x="520" y="295" text-anchor="middle" font-size="11" fill="#64748B">May</text>
                    <text x="640" y="295" text-anchor="middle" font-size="11" fill="#64748B">Jun</text>
                    <text x="780" y="295" text-anchor="middle" font-size="11" fill="#64748B">Jul</text>
                </g>
            </svg>
        </div>
    </div>

    <!-- Revenue by Plan (Donut Chart) -->
    <div class="col-12 col-lg-5">
        <div class="stat-card h-100">
            <div class="panel-title">Revenue by Subscription Plan</div>
            <div class="panel-sub">Distribution of MRR</div>
            <div class="d-flex justify-content-center my-3 position-relative">
                <svg viewBox="0 0 200 200" width="170" height="170">
                    @{
                        double offsetPlan = 0;
                    }
                    @foreach (var p in PlanRevenueSlices)
                    {
                        var len = p.Amount / TotalPlanRevenue * Circ;
                        var dash = Math.Max(len - 4, 0.5);
                        <circle cx="100" cy="100" r="@Radius" fill="none" stroke="@p.Color" stroke-width="25"
                                stroke-dasharray="@($"{dash} {Circ - dash}")"
                                stroke-dashoffset="@(-offsetPlan)"
                                transform="rotate(-90 100 100)" />
                        offsetPlan += len;
                    }
                </svg>
                <div class="position-absolute top-50 start-50 translate-middle text-center">
                    <h4 class="fw-bold mb-0 text-dark">₱185k</h4>
                    <span class="text-muted" style="font-size: 0.75rem;">Total MRR</span>
                </div>
            </div>
            <div class="d-flex justify-content-center gap-3 small fw-semibold text-muted flex-wrap mt-3">
                @foreach (var p in PlanRevenueSlices)
                {
                    <span><span class="legend-dot" style="background:@p.Color"></span>@p.Label</span>
                }
            </div>
        </div>
    </div>
</div>

<!-- CHARTS ROW 2 -->
<div class="row g-4 mb-4">
    <!-- System Health & Sync Status (Progress Bars) -->
    <div class="col-12 col-lg-5">
        <div class="stat-card h-100">
            <div class="panel-title mb-3">System Health & Sync Status</div>
            <div class="panel-sub mb-4">Tenant data synchronization overview</div>

            <div class="d-flex flex-column gap-4">
                <div>
                    <div class="d-flex justify-content-between small fw-bold mb-1">
                        <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>Synced Tenants</span>
                        <span>22 of 24 (91.6%)</span>
                    </div>
                    <div class="progress" style="height: 10px;"><div class="progress-bar bg-success" style="width: 91.6%;"></div></div>
                </div>
                <div>
                    <div class="d-flex justify-content-between small fw-bold mb-1">
                        <span class="text-warning"><i class="bi bi-arrow-repeat me-1"></i>Pending Sync</span>
                        <span>1 of 24 (4.2%)</span>
                    </div>
                    <div class="progress" style="height: 10px;"><div class="progress-bar bg-warning" style="width: 4.2%;"></div></div>
                </div>
                <div>
                    <div class="d-flex justify-content-between small fw-bold mb-1">
                        <span class="text-danger"><i class="bi bi-wifi-off me-1"></i>Offline Tenants</span>
                        <span>1 of 24 (4.2%)</span>
                    </div>
                    <div class="progress" style="height: 10px;"><div class="progress-bar bg-danger" style="width: 4.2%;"></div></div>
                </div>
            </div>
            <div class="mt-4 pt-3 border-top text-muted small">
                <i class="bi bi-info-circle me-1"></i> Last global sync check: 5 minutes ago.
            </div>
        </div>
    </div>

    <!-- Module Usage (Vertical Bar Chart) -->
    <div class="col-12 col-lg-7">
        <div class="stat-card h-100">
            <div class="panel-title mb-3">Module Transactions</div>
            <div class="panel-sub">Total system-wide activity per module</div>
            <svg viewBox="0 0 500 250" class="w-100" style="max-height: 230px;">
                @for (int i = 0; i < ModuleUsage.Count; i++)
                {
                    var m = ModuleUsage[i];
                    var barHeight = (m.Count / 25000.0) * 160;
                    var x = 40 + i * 110;
                    var y = 200 - barHeight;

                    <g>
                        <rect x="@x" y="20" width="60" height="180" fill="#F1F5F9" rx="6" />
                        <rect x="@x" y="@y" width="60" height="@barHeight" fill="@m.Color" rx="6" />
                        <text x="@(x + 30)" y="220" text-anchor="middle" font-size="11" fill="#64748B" font-weight="600">@m.Name</text>
                        <text x="@(x + 30)" y="@(y - 8)" text-anchor="middle" font-size="11" fill="#1E293B" font-weight="bold">@m.Count.ToString("N0")</text>
                    </g>
                }
            </svg>
        </div>
    </div>
</div>

<!-- TOP TENANTS TABLE -->
<div class="panel">
    <div class="panel-head d-flex justify-content-between align-items-center">
        <div>
            <div class="panel-title">Top Performing Tenants</div>
            <div class="panel-sub mb-0">Ranked by total transaction volume</div>
        </div>
        <button class="btn btn-sm btn-outline-secondary rounded-3">View All</button>
    </div>
    <div class="table-wrap">
        <table class="table data-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Business Name</th>
                    <th>Plan</th>
                    <th>Active Branches</th>
                    <th>Total Sales</th>
                    <th>Growth</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in TopTenants)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@t.Business</div>
                            <div class="sub text-muted" style="font-size: 0.75rem;">@t.Code</div>
                        </td>
                        <td><span class="pill pill-gray">@t.Plan</span></td>
                        <td>@t.Branches</td>
                        <td class="fw-semibold">@t.Sales</td>
                        <td class="text-success fw-bold"><i class="bi bi-graph-up-arrow me-1"></i> +@t.Growth%</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Success Toast -->
@if (showToast)
{
    <div class="toast-note" style="position: fixed; bottom: 2rem; right: 2rem; z-index: 1050; background: #1B5E34; color: white; padding: 1rem 1.5rem; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.2); display: flex; align-items: center; gap: 10px;">
        <i class="bi bi-check-circle-fill fs-5"></i> <span class="fw-semibold">Report generated successfully!</span>
    </div>
}

@code {
    record Stat(string Title, string Value, string Trend, string Icon, string IconClass);
    record PlanSlice(string Label, double Amount, string Color);
    record Module(string Name, int Count, string Color);
    record Tenant(string Business, string Code, string Plan, int Branches, string Sales, double Growth);

    // Report Gen State
    private DateTime startDate = DateTime.Today.AddDays(-30);
    private DateTime endDate = DateTime.Today;
    private bool showToast = false;
    private bool isGenerating = false;

    // Checkbox States
    private bool includeRevenue = true;
    private bool includeTenants = true;
    private bool includeModules = true;
    private bool includeSystem = true;

    // Charts Data
    const double Radius = 70;
    static readonly double Circ = 2 * Math.PI * Radius;

    List<Stat> MainStats => new() {
        new("MONTHLY RECURRING REVENUE", "₱185,400.00", "+12.5%", "bi-cash-stack", "stat-icon-blue"),
        new("ACTIVE SUBSCRIPTIONS", "24", "+4", "bi-buildings", ""),
        new("TOTAL TRANSACTIONS", "48,250", "+8.2%", "bi-receipt", "stat-icon-plain"),
        new("SYNC HEALTH", "99.8%", "+0.1%", "bi-cloud-check", "stat-icon-warn")
    };

    List<PlanSlice> PlanRevenueSlices => new() {
        new("Enterprise", 95000, "#1B5E34"),
        new("Growth", 65400, "#4CAF50"),
        new("Starter", 25000, "#81C784")
    };
    double TotalPlanRevenue => PlanRevenueSlices.Sum(p => p.Amount);

    List<Module> ModuleUsage => new() {
        new("Sales", 24500, "#1B5E34"),
        new("Inventory", 15200, "#4CAF50"),
        new("Harvest", 8100, "#81C784"),
        new("Labor", 4500, "#A5D6A7")
    };

    List<Tenant> TopTenants => new() {
        new("Harvest Hills Agri Corp", "HAR-002", "Enterprise", 12, "₱450,000", 24.5),
        new("Verdant Agri Ventures", "AGV-001", "Growth", 3, "₱320,000", 18.2),
        new("Sunrise Rice Farmers Coop", "SRF-003", "Coop Custom", 25, "₱850,000", 12.0)
    };

    async Task GenerateReport()
    {
        isGenerating = true;
        await Task.Delay(2000); // Simulate report generation time
        isGenerating = false;

        showToast = true;
        StateHasChanged();
        await Task.Delay(3000);
        showToast = false;
        StateHasChanged();
    }
}