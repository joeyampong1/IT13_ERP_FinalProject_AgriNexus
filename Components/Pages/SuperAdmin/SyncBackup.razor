@page "/sync-backup"

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <h2 class="page-title">Synchronization &amp; Backup</h2>
        <p class="text-muted mb-0 page-sub">Monitor push/pull sync, online backups, and compare device data against the server.</p>
    </div>
    <button type="button" class="btn-outline shadow-sm" @onclick="TestConnectionAsync" disabled="@testing">
        <i class="bi bi-hdd-network-fill text-success"></i> @(testing ? "Testing…" : "Test connection")
    </button>
</div>

<!-- STAT CARDS -->
<div class="row g-3 mb-4">
    @foreach (var s in Stats)
    {
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <span class="card-title">@s.Title</span>
                    <div class="stat-icon @s.IconClass"><i class="bi @s.Icon"></i></div>
                </div>
                <div class="mt-3">
                    <div class="card-value">@s.Value</div>
                    @if (!string.IsNullOrEmpty(s.Note))
                    {
                        <div class="text-muted small mt-1">@s.Note</div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- TABS -->
<div class="tabs mb-3">
    @foreach (var t in TabList)
    {
        <button type="button" class="tab-btn @(activeTab == t.Key ? "active" : "")" @onclick="() => SetTab(t.Key)">
            <i class="bi @t.Icon"></i> @t.Label
        </button>
    }
</div>

<!-- ======================= SYNCHRONIZATION ======================= -->
@if (activeTab == "sync")
{
    <div class="toolbar mb-3">
        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text" placeholder="Search tenants..." @bind="searchText" @bind:event="oninput" />
        </div>
        <select class="filter-select" @bind="statusFilter">
            <option value="">All statuses</option>
            <option>Synced</option>
            <option>Pending</option>
            <option>Offline</option>
        </select>
        <span class="badge rounded-pill px-3 py-2 fw-semibold" style="background-color: #FFFFFF; color: #0A2B1D; border: 1px solid #E2ECE6;">
            <i class="bi bi-buildings me-1 text-success"></i>@FilteredTenants.Count @(FilteredTenants.Count == 1 ? "tenant" : "tenants")
        </span>
        <button type="button" class="btn-new ms-auto shadow-sm" @onclick="SyncAllAsync" disabled="@busyAll">
            <i class="bi bi-arrow-repeat @(busyAll ? "spin" : "")"></i> Sync all pending
        </button>
    </div>

    <div class="panel">
        <div class="table-wrap">
            <table class="table table-hover data-table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="px-4">Business</th>
                        <th>Status</th>
                        <th>Last push</th>
                        <th>Last pull</th>
                        <th class="text-end">To push</th>
                        <th class="text-end">To pull</th>
                        <th class="text-end">Conflicts</th>
                        <th class="px-4"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in FilteredTenants)
                    {
                        var push = PushCount(t.Code);
                        var pull = PullCount(t.Code);
                        var conf = ConflictCount(t.Code);
                        <tr>
                            <td class="px-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="sync-avatar">
                                        <i class="bi bi-building"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold" style="color: #0A2B1D;">@t.Business</div>
                                        <div class="sub fw-semibold" style="color: #1B5E34;">@t.Code</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (t.Syncing)
                                {
                                    <span class="pill pill-leaf"><i class="bi bi-arrow-repeat spin me-1"></i> Syncing…</span>
                                }
                                else
                                {
                                    <span class="pill @StatusClass(t.Status)">
                                        <i class="bi @StatusIcon(t.Status) me-1"></i>@t.Status
                                    </span>
                                }
                            </td>
                            <td class="text-nowrap text-muted small">
                                <i class="bi bi-cloud-arrow-up text-success me-1"></i>@t.LastPush.ToString("MMM d, h:mm tt")
                            </td>
                            <td class="text-nowrap text-muted small">
                                <i class="bi bi-cloud-arrow-down text-success me-1"></i>@t.LastPull.ToString("MMM d, h:mm tt")
                            </td>
                            <td class="text-end @NumClass(push)">@push</td>
                            <td class="text-end @NumClass(pull)">@pull</td>
                            <td class="text-end @NumClass(conf)">@conf</td>
                            <td class="text-end text-nowrap px-4">
                                @if (t.Status != "Synced")
                                {
                                    <button type="button" class="btn-outline me-2" @onclick="() => RetrySyncAsync(t, false)" disabled="@t.Syncing">
                                        <i class="bi bi-arrow-clockwise text-success"></i> Retry sync
                                    </button>
                                }
                                <button type="button" class="btn-outline" @onclick="() => OpenCompare(t)">
                                    <i class="bi bi-arrow-left-right text-success"></i> Compare
                                </button>
                            </td>
                        </tr>
                    }
                    @if (FilteredTenants.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-3 d-block mb-2 opacity-50"></i>
                                No tenants found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- ======================= BACKUPS ======================= -->
@if (activeTab == "backups")
{
    <div class="row g-3 mb-4">
        <div class="col-12 col-lg-7">
            <div class="card-box h-100">
                <div class="d-flex justify-content-between align-items-start mb-3 gap-2 flex-wrap">
                    <div>
                        <div class="panel-title">Backup schedule</div>
                        <div class="panel-sub mb-0">Automatic online backups of the platform database.</div>
                    </div>
                    <button type="button" class="btn-new shadow-sm" @onclick="RunBackupAsync" disabled="@backupRunning">
                        <i class="bi bi-cloud-arrow-up @(backupRunning ? "spin" : "")"></i> @(backupRunning ? "Running…" : "Run backup now")
                    </button>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Frequency</label>
                        <select class="form-select" @bind="frequency">
                            <option>Daily</option>
                            <option>Weekly</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Run at</label>
                        <input type="time" class="form-control" @bind="backupTime" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Keep for (days)</label>
                        <input type="number" min="1" class="form-control" @bind="retentionDays" />
                    </div>
                </div>

                <div class="toggle-row mt-2">
                    <div>
                        <div class="fw-semibold" style="color: #0A2B1D;">Notify me when a backup fails</div>
                        <div class="sub">Shows a warning on the Dashboard and in Audit Logs.</div>
                    </div>
                    <label class="switch"><input type="checkbox" @bind="notifyOnFail" /><span class="slider"></span></label>
                </div>

                <div class="d-flex justify-content-end mt-3">
                    <button type="button" class="btn-new shadow-sm" @onclick="SaveSchedule">
                        <i class="bi bi-check2-circle"></i> Save schedule
                    </button>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-5">
            <div class="card-box h-100">
                <div class="d-flex justify-content-between align-items-start mb-1">
                    <div>
                        <div class="panel-title">Server storage</div>
                        <div class="panel-sub">Usage on the hosting server (sample values).</div>
                    </div>
                    <div class="stat-icon"><i class="bi bi-hdd-rack-fill"></i></div>
                </div>

                <div class="usage">
                    <div class="d-flex justify-content-between small fw-medium">
                        <span style="color: #0A2B1D;"><i class="bi bi-database-fill text-success me-1"></i>Database</span>
                        <span class="text-muted">@Size(dbUsedMb) of @Size(dbQuotaMb)</span>
                    </div>
                    <div class="bar-track"><div class="bar-fill" style="width:@Pct(dbUsedMb, dbQuotaMb)%"></div></div>
                </div>

                <div class="usage">
                    <div class="d-flex justify-content-between small fw-medium">
                        <span style="color: #0A2B1D;"><i class="bi bi-archive-fill text-success me-1"></i>Backup files</span>
                        <span class="text-muted">@Size(backupUsedMb) of @Size(backupQuotaMb)</span>
                    </div>
                    <div class="bar-track"><div class="bar-fill @(Pct(backupUsedMb, backupQuotaMb) >= 80 ? "earth" : "")" style="width:@Pct(backupUsedMb, backupQuotaMb)%"></div></div>
                </div>

                <div class="sub mt-3"><i class="bi bi-info-circle text-success me-1"></i>Old backups beyond the retention period are removed automatically.</div>
            </div>
        </div>
    </div>

    <div class="panel mb-4">
        <div class="panel-head">
            <div class="panel-title">Backup history</div>
            <div class="panel-sub mb-0">Latest platform and tenant backups</div>
        </div>
        <div class="table-wrap">
            <table class="table table-hover data-table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="px-4">ID</th>
                        <th>Scope</th>
                        <th>Type</th>
                        <th>Started</th>
                        <th>Size</th>
                        <th>Duration</th>
                        <th class="px-4">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in SortedBackups)
                    {
                        <tr>
                            <td class="fw-bold px-4" style="color: #1B5E34;">@b.Id</td>
                            <td class="fw-medium" style="color: #0A2B1D;">@b.Scope</td>
                            <td><span class="pill pill-sage">@b.Type</span></td>
                            <td class="text-nowrap text-muted small">
                                <i class="bi bi-clock text-success me-1"></i>@b.Started.ToString("MMM d, yyyy, h:mm tt")
                            </td>
                            <td class="fw-medium">@Size(b.SizeMb)</td>
                            <td class="text-muted">@(b.Status == "Running" ? "—" : Dur(b.DurationSec))</td>
                            <td class="px-4">
                                @if (b.Status == "Running")
                                {
                                    <span class="pill pill-leaf"><i class="bi bi-arrow-repeat spin me-1"></i> Running</span>
                                }
                                else
                                {
                                    <span class="pill @(b.Status == "Success" ? "pill-forest" : "pill-earth")">
                                        <i class="bi @(b.Status == "Success" ? "bi-check-circle-fill" : "bi-exclamation-circle-fill") me-1"></i>@b.Status
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="panel">
        <div class="panel-head">
            <div class="panel-title">Restore requests</div>
            <div class="panel-sub mb-0">Tenants asking to roll back to a backup point</div>
        </div>
        <div class="table-wrap">
            <table class="table table-hover data-table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="px-4">Business</th>
                        <th>Requested by</th>
                        <th>Backup point</th>
                        <th>Reason</th>
                        <th>Requested</th>
                        <th>Status</th>
                        <th class="px-4"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in restores)
                    {
                        <tr>
                            <td class="fw-bold px-4" style="color: #0A2B1D;">@r.Business</td>
                            <td class="text-dark">@r.RequestedBy</td>
                            <td class="text-nowrap fw-semibold" style="color: #1B5E34;">@r.BackupId</td>
                            <td class="reason">@r.Reason</td>
                            <td class="text-nowrap text-muted small">@r.Requested.ToString("MMM d, yyyy")</td>
                            <td>
                                <span class="pill @RestoreClass(r.Status)">
                                    <i class="bi @(r.Status == "Approved" ? "bi-check-circle-fill" : r.Status == "Pending" ? "bi-hourglass-split" : "bi-x-circle-fill") me-1"></i>@r.Status
                                </span>
                            </td>
                            <td class="text-end text-nowrap px-4">
                                @if (r.Status == "Pending")
                                {
                                    <button type="button" class="btn-outline me-2" @onclick="() => DecideRestore(r, true)">
                                        <i class="bi bi-check2 text-success"></i> Approve
                                    </button>
                                    <button type="button" class="btn-outline earth" @onclick="() => DecideRestore(r, false)">
                                        <i class="bi bi-x-lg"></i> Decline
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                    @if (restores.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-3 d-block mb-2 opacity-50"></i>
                                No restore requests.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- ======================= DATA COMPARISON ======================= -->
@if (activeTab == "compare")
{
    <div class="toolbar mb-3">
        <select class="filter-select wide" @bind="compareCode">
            @foreach (var t in tenants)
            {
                <option value="@t.Code">@t.Business (@t.Code)</option>
            }
        </select>
        <span class="text-muted small"><i class="bi bi-clock-history text-success me-1"></i>Last compared: @lastCompared.ToString("MMM d, h:mm tt")</span>
        <button type="button" class="btn-new ms-auto shadow-sm" @onclick="RunComparisonAsync" disabled="@comparing">
            <i class="bi bi-arrow-left-right @(comparing ? "spin" : "")"></i> @(comparing ? "Comparing…" : "Run comparison")
        </button>
    </div>

    <div class="note-banner mb-3">
        <i class="bi bi-shield-lock-fill text-success fs-5"></i>
        <span>Only record counts, checksums, and timestamps are compared. Tenant business data is never shown to the Super Admin.</span>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-6 col-lg-3">
            <div class="mini-stat">
                <div class="mini-label">On device</div>
                <div class="mini-value">@TotalLocal.ToString("N0")</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="mini-stat">
                <div class="mini-label">On server</div>
                <div class="mini-value">@TotalServer.ToString("N0")</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="mini-stat">
                <div class="mini-label">Tables out of sync</div>
                <div class="mini-value @(OutOfSync > 0 ? "text-earth" : "")">@OutOfSync <span class="of">of @Rows.Count</span></div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="mini-stat">
                <div class="mini-label">Match rate</div>
                <div class="mini-value">@MatchRate%</div>
                <div class="bar-track slim"><div class="bar-fill @(MatchRate < 100 ? "earth" : "")" style="width:@MatchRate%"></div></div>
            </div>
        </div>
    </div>

    <div class="panel">
        <div class="table-wrap">
            <table class="table table-hover data-table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="px-4">Table</th>
                        <th class="text-end">On device</th>
                        <th class="text-end">On server</th>
                        <th class="text-end">Difference</th>
                        <th>Device modified</th>
                        <th>Server modified</th>
                        <th>Checksum</th>
                        <th>Status</th>
                        <th class="px-4"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Rows)
                    {
                        var status = RowStatus(r);
                        var diff = r.Local - r.Server;
                        <tr>
                            <td class="fw-bold px-4" style="color: #0A2B1D;">
                                <i class="bi bi-table text-success me-2"></i>@r.Entity
                            </td>
                            <td class="text-end fw-medium">@r.Local.ToString("N0")</td>
                            <td class="text-end fw-medium">@r.Server.ToString("N0")</td>
                            <td class="text-end fw-bold @DiffClass(diff)">@DiffText(diff)</td>
                            <td class="text-nowrap text-muted small">@r.LocalMod.ToString("MMM d, h:mm tt")</td>
                            <td class="text-nowrap text-muted small">@r.ServerMod.ToString("MMM d, h:mm tt")</td>
                            <td>
                                @if (ChecksumOk(r))
                                {
                                    <span class="chk ok"><i class="bi bi-check-circle-fill"></i> Match</span>
                                }
                                else
                                {
                                    <span class="chk bad"><i class="bi bi-x-circle-fill"></i> Differs</span>
                                }
                            </td>
                            <td><span class="pill @RowClass(status)">@status</span></td>
                            <td class="text-end text-nowrap px-4">
                                @if (status != "Match" && status != "Queued")
                                {
                                    <button type="button" class="btn-outline" @onclick="() => QueueResync(r)">
                                        <i class="bi bi-arrow-repeat text-success"></i> Request re-sync
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td class="fw-bold px-4" style="color: #0A2B1D;">Total</td>
                        <td class="text-end fw-bold" style="color: #0A2B1D;">@TotalLocal.ToString("N0")</td>
                        <td class="text-end fw-bold" style="color: #0A2B1D;">@TotalServer.ToString("N0")</td>
                        <td class="text-end fw-bold @DiffClass(TotalLocal - TotalServer)">@DiffText(TotalLocal - TotalServer)</td>
                        <td colspan="5"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="legend mt-3">
        <span><span class="pill pill-moss me-1">Pending push</span> device has records the server doesn’t</span>
        <span><span class="pill pill-leaf me-1">Pending pull</span> server has records the device doesn’t</span>
        <span><span class="pill pill-earth me-1">Conflict</span> same count, different content</span>
    </div>
}

@if (!string.IsNullOrEmpty(toast))
{
    <div class="toast-note shadow-lg"><i class="bi bi-check-circle-fill"></i> @toast</div>
}

@code {
    // ---------- MODELS ----------
    class SyncTenant
    {
        public string Business { get; set; } = "";
        public string Code { get; set; } = "";
        public string Status { get; set; } = "Synced";
        public DateTime LastPush { get; set; }
        public DateTime LastPull { get; set; }
        public double Scale { get; set; } = 1;
        public bool Syncing { get; set; }
    }

    class CompareRow
    {
        public string Entity { get; set; } = "";
        public int Local { get; set; }
        public int Server { get; set; }
        public DateTime LocalMod { get; set; }
        public DateTime ServerMod { get; set; }
        public bool ContentOk { get; set; } = true;
        public bool Queued { get; set; }
    }

    class BackupRec
    {
        public string Id { get; set; } = "";
        public string Scope { get; set; } = "Platform-wide";
        public string Type { get; set; } = "Scheduled";
        public DateTime Started { get; set; }
        public double SizeMb { get; set; }
        public int DurationSec { get; set; }
        public string Status { get; set; } = "Success";
    }

    class RestoreReq
    {
        public string Business { get; set; } = "";
        public string RequestedBy { get; set; } = "";
        public string BackupId { get; set; } = "";
        public string Reason { get; set; } = "";
        public DateTime Requested { get; set; }
        public string Status { get; set; } = "Pending";
    }

    record Stat(string Title, string Value, string Note, string Icon, string IconClass);
    record TabItem(string Key, string Label, string Icon);

    // ---------- STATE ----------
    string activeTab = "sync";
    string searchText = "";
    string statusFilter = "";
    string toast = "";
    bool busyAll, testing, comparing, backupRunning;

    // Server (temporary values)
    bool serverOnline = true;
    int latencyMs = 42;
    double dbUsedMb = 612, dbQuotaMb = 2048;
    double backupUsedMb = 4512, backupQuotaMb = 10240;

    // Backup schedule
    string frequency = "Daily";
    TimeOnly backupTime = new(2, 0);
    int retentionDays = 30;
    bool notifyOnFail = true;
    int backupSeq = 118;

    // Comparison
    string compareCode = "AGV-001";
    DateTime lastCompared = DateTime.Now;

    // ---------- MOCK DATA ----------
    List<SyncTenant> tenants = new()
    {
        new() { Business = "Verdant Agri Ventures", Code = "AGV-001", Status = "Synced", LastPush = DateTime.Now.AddMinutes(-15), LastPull = DateTime.Now.AddMinutes(-10), Scale = 1 },
        new() { Business = "Sunrise Rice Farmers Coop", Code = "SRF-003", Status = "Pending", LastPush = DateTime.Now.AddHours(-2), LastPull = DateTime.Now.AddHours(-1), Scale = 1.5 },
        new() { Business = "Green Valley Farms", Code = "GRN-004", Status = "Offline", LastPush = DateTime.Now.AddDays(-1), LastPull = DateTime.Now.AddDays(-1), Scale = 0.8 }
    };

    List<BackupRec> backups = new()
    {
        new() { Id = "BKP-118", Type = "Manual", Started = DateTime.Now.AddHours(-1), SizeMb = 450, DurationSec = 120, Status = "Success" },
        new() { Id = "BKP-117", Type = "Scheduled", Started = DateTime.Now.AddDays(-1), SizeMb = 448, DurationSec = 115, Status = "Success" },
        new() { Id = "BKP-116", Type = "Scheduled", Started = DateTime.Now.AddDays(-2), SizeMb = 445, DurationSec = 110, Status = "Failed" }
    };

    List<RestoreReq> restores = new()
    {
        new() { Business = "Green Valley Farms", RequestedBy = "Teresa M. Lim", BackupId = "BKP-117", Reason = "Accidental data deletion", Requested = DateTime.Now.AddHours(-5), Status = "Pending" }
    };

    List<CompareRow> Rows = new()
    {
        new() { Entity = "Inventory Transactions", Local = 1205, Server = 1200, LocalMod = DateTime.Now, ServerMod = DateTime.Now.AddMinutes(-5), ContentOk = false },
        new() { Entity = "Sales Records", Local = 450, Server = 450, LocalMod = DateTime.Now, ServerMod = DateTime.Now, ContentOk = true },
        new() { Entity = "Harvest Logs", Local = 80, Server = 85, LocalMod = DateTime.Now.AddHours(-1), ServerMod = DateTime.Now, ContentOk = false }
    };

    // ---------- COMPUTED PROPERTIES ----------
    List<TabItem> TabList => new() {
        new("sync", "Synchronization", "bi-arrow-repeat"),
        new("backups", "Backups", "bi-cloud-arrow-up"),
        new("compare", "Data Comparison", "bi-arrow-left-right")
    };

    List<Stat> Stats => new() {
        new("SERVER STATUS", serverOnline ? "Online" : "Offline", $"Latency: {latencyMs}ms", serverOnline ? "bi-check-circle-fill" : "bi-x-circle-fill", serverOnline ? "" : "stat-icon-earth"),
        new("PENDING SYNCS", tenants.Count(t => t.Status != "Synced").ToString(), "Tenants not yet synced", "bi-arrow-repeat", "stat-icon-moss"),
        new("LAST BACKUP", "BKP-118", "1 hour ago", "bi-clock-history", ""),
        new("STORAGE USED", Size(backupUsedMb), $"of {Size(backupQuotaMb)}", "bi-hdd-fill", "")
    };

    List<SyncTenant> FilteredTenants => tenants
        .Where(t => string.IsNullOrEmpty(statusFilter) || t.Status == statusFilter)
        .Where(t => string.IsNullOrEmpty(searchText) || t.Business.Contains(searchText, StringComparison.OrdinalIgnoreCase))
        .ToList();

    List<BackupRec> SortedBackups => backups.OrderByDescending(b => b.Started).ToList();

    int TotalLocal => Rows.Sum(r => r.Local);
    int TotalServer => Rows.Sum(r => r.Server);
    int OutOfSync => Rows.Count(r => !ChecksumOk(r) || r.Local != r.Server);
    int MatchRate => Rows.Count == 0 ? 100 : (int)((Rows.Count - OutOfSync) / (double)Rows.Count * 100);

    // ---------- METHODS ----------
    void SetTab(string key) => activeTab = key;

    async Task TestConnectionAsync()
    {
        testing = true;
        await Task.Delay(1500);
        testing = false;
        Toast("Connection successful. Server is online.");
    }

    async Task SyncAllAsync()
    {
        busyAll = true;
        foreach (var t in tenants.Where(x => x.Status != "Synced")) { t.Syncing = true; }
        await Task.Delay(2500);
        foreach (var t in tenants) { t.Syncing = false; t.Status = "Synced"; t.LastPush = DateTime.Now; t.LastPull = DateTime.Now; }
        busyAll = false;
        Toast("All pending syncs completed.");
    }

    async Task RetrySyncAsync(SyncTenant t, bool isAll)
    {
        t.Syncing = true;
        await Task.Delay(1500);
        t.Syncing = false;
        t.Status = "Synced";
        t.LastPush = DateTime.Now;
        t.LastPull = DateTime.Now;
        Toast($"Sync successful for {t.Business}.");
    }

    void OpenCompare(SyncTenant t)
    {
        compareCode = t.Code;
        activeTab = "compare";
    }

    async Task RunBackupAsync()
    {
        backupRunning = true;
        await Task.Delay(3000);
        backupSeq++;
        backups.Insert(0, new BackupRec { Id = $"BKP-{backupSeq}", Type = "Manual", Started = DateTime.Now, SizeMb = 450, DurationSec = 120, Status = "Success" });
        backupRunning = false;
        Toast("Backup completed successfully.");
    }

    void SaveSchedule() => Toast("Backup schedule saved.");

    void DecideRestore(RestoreReq r, bool approve)
    {
        r.Status = approve ? "Approved" : "Declined";
        Toast($"Restore request {r.Status.ToLower()}.");
    }

    async Task RunComparisonAsync()
    {
        comparing = true;
        await Task.Delay(2000);
        lastCompared = DateTime.Now;
        comparing = false;
        Toast("Comparison completed.");
    }

    void QueueResync(CompareRow r)
    {
        r.Queued = true;
        Toast($"Re-sync requested for {r.Entity}.");
    }

    // ---------- HELPERS (AgriNexus Logo Palette: Forest, Leaf, Moss, Soil Brown) ----------
    int PushCount(string code) => code == "SRF-003" ? 15 : 0;
    int PullCount(string code) => code == "GRN-004" ? 8 : 0;
    int ConflictCount(string code) => code == "SRF-003" ? 2 : 0;

    string StatusClass(string status) => status switch
    {
        "Synced" => "pill-forest",
        "Pending" => "pill-moss",
        "Offline" => "pill-earth",
        _ => "pill-sage"
    };

    string StatusIcon(string status) => status switch
    {
        "Synced" => "bi-cloud-check-fill",
        "Pending" => "bi-hourglass-split",
        "Offline" => "bi-wifi-off",
        _ => "bi-dot"
    };

    string NumClass(int num) => num > 0 ? "text-earth fw-bold" : "text-muted";
    string RestoreClass(string status) => status switch
    {
        "Pending" => "pill-moss",
        "Approved" => "pill-forest",
        "Declined" => "pill-earth",
        _ => "pill-sage"
    };

    string RowStatus(CompareRow r)
    {
        if (r.Queued) return "Queued";
        if (!ChecksumOk(r)) return "Conflict";
        if (r.Local > r.Server) return "Pending push";
        if (r.Local < r.Server) return "Pending pull";
        return "Match";
    }

    string RowClass(string status) => status switch
    {
        "Match" => "pill-forest",
        "Pending push" => "pill-moss",
        "Pending pull" => "pill-leaf",
        "Conflict" => "pill-earth",
        "Queued" => "pill-sage",
        _ => "pill-sage"
    };

    string DiffClass(int diff) => diff != 0 ? "text-earth" : "text-muted";
    string DiffText(int diff) => diff > 0 ? $"+{diff}" : diff.ToString();
    bool ChecksumOk(CompareRow r) => r.ContentOk;

    int Pct(double used, double quota) => (int)Math.Min(100, (used / quota) * 100);
    string Size(double mb) => mb >= 1024 ? $"{mb / 1024:0.0} GB" : $"{mb:0} MB";
    string Dur(int sec) => $"{sec}s";

    async void Toast(string message)
    {
        toast = message;
        StateHasChanged();
        await Task.Delay(3000);
        toast = "";
        await InvokeAsync(StateHasChanged);
    }
}