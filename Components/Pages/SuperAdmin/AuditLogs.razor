@page "/audit-logs"

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="page-title">System-wide Audit Logs</h2>
        <p class="text-muted mb-0 page-sub">Every recorded platform activity — who acted, on which module, and when.</p>
    </div>
    <span class="badge rounded-pill px-3 py-2 fw-semibold" style="background-color: #E8F3EC; color: #1B5E34; border: 1px solid #C6DFCE;">
        <i class="bi bi-journal-check me-1"></i> Activity &amp; Security Trail
    </span>
</div>

<!-- TOOLBAR -->
<div class="toolbar mb-3">
    <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="text" placeholder="Search actor, module or detail..." @bind="searchText" @bind:event="oninput" />
    </div>

    <div class="filter-wrap">
        <i class="bi bi-funnel text-success"></i>
        <select class="filter-select" @bind="actionFilter">
            <option value="">All actions</option>
            @foreach (var a in ActionOptions)
            {
                <option value="@a">@a</option>
            }
        </select>
    </div>

    <span class="badge rounded-pill px-3 py-2 fw-semibold" style="background-color: #FFFFFF; color: #0A2B1D; border: 1px solid #E2ECE6;">
        <i class="bi bi-list-ul me-1 text-success"></i>@Filtered.Count @(Filtered.Count == 1 ? "entry" : "entries")
    </span>
</div>

<!-- TABLE -->
<div class="panel">
    <div class="table-wrap">
        <table class="table table-hover log-table align-middle mb-0">
            <thead>
                <tr>
                    <th class="px-4">When</th>
                    <th>Actor</th>
                    <th>Action</th>
                    <th>Module</th>
                    <th>Record</th>
                    <th class="px-4">Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Filtered)
                {
                    <tr>
                        <td class="when px-4 text-muted small fw-medium">
                            <i class="bi bi-clock text-success me-1"></i>@l.When.ToString("MMM d, yyyy, h:mm tt")
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="actor-avatar @(l.Actor == "System" ? "actor-system" : "")">
                                    <i class="bi @(l.Actor == "System" ? "bi-cpu-fill" : "bi-person-fill")"></i>
                                </div>
                                <div>
                                    <div class="fw-bold" style="color: #0A2B1D;">@l.Actor</div>
                                    <div class="sub">@l.Role</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="pill @ActionClass(l.Action)">
                                <i class="bi @ActionIcon(l.Action) me-1"></i>@l.Action
                            </span>
                        </td>
                        <td class="fw-semibold" style="color: #0A2B1D;">
                            <i class="bi @ModuleIcon(l.Module) text-success me-1"></i>@l.Module
                        </td>
                        <td class="record">
                            @if (!string.IsNullOrEmpty(l.Record))
                            {
                                <span class="record-badge">@l.Record</span>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td class="details px-4">@l.Details</td>
                    </tr>
                }
                @if (Filtered.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            <i class="bi bi-inbox fs-3 d-block mb-2 opacity-50"></i>
                            No matching entries.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    // ---------- MODEL ----------
    record LogEntry(DateTime When, string Actor, string Role, string Action, string Module, string Record, string Details);

    // ---------- STATE ----------
    string searchText = "";
    string actionFilter = "";

    // ---------- TEMPORARY DATA ----------
    readonly List<LogEntry> logs = new()
    {
        new(new(2026, 10, 24, 10, 41, 0), "Andres Villanueva", "Super Admin", "Create", "Businesses / Tenants", "SRF-003",
            "Registered new tenant Sunrise Rice Farmers Coop on the Cooperative Custom plan."),
        new(new(2026, 10, 24, 9, 20, 0), "Andres Villanueva", "Super Admin", "Update", "Subscription Plans", "PLAN-GROWTH",
            "Updated Growth plan: staff limit raised from 20 to 25 accounts."),
        new(new(2026, 10, 23, 4, 15, 0), "Rica Dela Cruz", "Billing Officer", "Renew", "Subscriptions", "SUB-0002",
            "Recorded renewal payment of ₱3,999.00 for Verdant Agri Ventures."),
        new(new(2026, 10, 22, 23, 0, 0), "Andres Villanueva", "Super Admin", "Login", "Platform", "",
            "Signed in from Cabarroguis, Quirino."),
        new(new(2026, 10, 22, 14, 10, 0), "System", "Automated", "Sync", "Synchronization", "GRN-004",
            "Flagged Green Valley Farms as offline after missed sync window."),
        new(new(2026, 10, 22, 9, 15, 0), "Rica Dela Cruz", "Billing Officer", "Update", "Subscriptions", "SUB-0004",
            "Marked payment for Green Valley Farms as pending."),
        new(new(2026, 10, 21, 11, 35, 0), "Andres Villanueva", "Super Admin", "Suspend", "Businesses / Tenants", "BRO-005",
            "Suspended Bicol River Organic Growers due to unpaid subscription."),
        new(new(2026, 10, 20, 17, 0, 0), "Andres Villanueva", "Super Admin", "Retire", "Subscription Plans", "PLAN-LEGACY",
            "Retired Legacy Lite plan. Existing tenants keep their current terms."),
        new(new(2026, 10, 20, 10, 5, 0), "Mark Reyes", "Platform Support", "Update", "Businesses / Tenants", "HAR-002",
            "Updated owner contact details for Harvest Hills Agri Corp."),
        new(new(2026, 10, 19, 15, 30, 0), "System", "Automated", "Sync", "Synchronization", "SRF-003",
            "Sunrise Rice Farmers Coop set to pending while sync is in progress."),
        new(new(2026, 10, 18, 8, 45, 0), "Andres Villanueva", "Super Admin", "Create", "Subscription Plans", "PLAN-COOP",
            "Created Cooperative Custom plan (yearly billing, 25 branches)."),
        new(new(2026, 10, 17, 13, 20, 0), "Mark Reyes", "Platform Support", "Login", "Platform", "",
            "Signed in from Manila, NCR."),
        new(new(2026, 10, 15, 9, 0, 0), "Rica Dela Cruz", "Billing Officer", "Renew", "Subscriptions", "SUB-0003",
            "Recorded renewal payment of ₱9,999.00 for Harvest Hills Agri Corp."),
    };

    // ---------- COMPUTED ----------
    IEnumerable<string> ActionOptions => logs.Select(l => l.Action).Distinct().OrderBy(a => a);

    List<LogEntry> Filtered => logs
        .Where(l => string.IsNullOrEmpty(actionFilter) || l.Action == actionFilter)
        .Where(l => string.IsNullOrWhiteSpace(searchText)
            || l.Actor.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || l.Module.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || l.Details.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || l.Record.Contains(searchText, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(l => l.When)
        .ToList();

    // Harmonized AgriNexus Logo Palette (Deep Forest, Leaf Green, & Earth Soil Brown)
    static string ActionClass(string a) => a switch
    {
        "Create" => "pill-forest",
        "Renew" => "pill-leaf",
        "Suspend" or "Delete" => "pill-earth",
        "Retire" or "Sync" => "pill-moss",
        _ => "pill-sage"
    };

    static string ActionIcon(string a) => a switch
    {
        "Create" => "bi-plus-circle-fill",
        "Renew" => "bi-arrow-repeat",
        "Update" => "bi-pencil-square",
        "Suspend" or "Delete" => "bi-slash-circle-fill",
        "Retire" => "bi-archive-fill",
        "Sync" => "bi-cloud-arrow-up-fill",
        "Login" => "bi-box-arrow-in-right",
        _ => "bi-dot"
    };

    static string ModuleIcon(string m) => m switch
    {
        "Businesses / Tenants" => "bi-buildings",
        "Subscription Plans" => "bi-wallet2",
        "Subscriptions" => "bi-credit-card",
        "Synchronization" => "bi-cloud-check",
        "Platform" => "bi-shield-lock",
        _ => "bi-grid"
    };
}