@page "/businesses"
@using Russkyc.Addressess.Philippines
@using Russkyc.Addressess.Philippines.Entities
@layout MainLayout
@inject AgriNexus.DataLayer.AgriNexusDbContext DbContext
@using Microsoft.EntityFrameworkCore
@using AgriNexus.DataLayer.Models
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components.Web

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="page-title">Business / Tenant Management</h2>
        <p class="text-muted mb-0 page-sub">Every registered agribusiness on the platform, its subscription plan, and synchronization state.</p>
    </div>
    <span class="badge rounded-pill px-3 py-2 fw-semibold" style="background-color: #E8F3EC; color: #1B5E34; border: 1px solid #C6DFCE;">
        <i class="bi bi-buildings-fill me-1"></i> Tenant Directory
    </span>
</div>

<!-- STAT CARDS -->
<div class="row g-3 mb-4">
    @foreach (var s in Stats)
    {
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <span class="card-title">@s.Title</span>
                    <div class="stat-icon @s.IconClass"><i class="bi @s.Icon"></i></div>
                </div>
                <div class="mt-3">
                    <div class="card-value">@s.Value</div>
                    @if (!string.IsNullOrEmpty(s.Note))
                    {
                        <div class="text-muted small mt-1">@s.Note</div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- TOOLBAR WITH TABS -->
<div class="toolbar mb-3 d-flex flex-wrap align-items-center gap-3">

    <!-- ACTIVE / ARCHIVED TABS -->
    <div class="btn-group shadow-sm" role="group" aria-label="View Tabs">
        <!-- Active Tab -->
        <input type="radio" class="btn-check" name="viewTabs" id="tabActive" autocomplete="off"
               checked="@(!showArchived)" @onchange="() => ToggleTab(false)">
        <label class="btn btn-outline-success fw-bold" for="tabActive">
            <i class="bi bi-check-circle-fill me-1"></i> Active
        </label>

        <!-- Archived Tab -->
        <input type="radio" class="btn-check" name="viewTabs" id="tabArchived" autocomplete="off"
               checked="@showArchived" @onchange="() => ToggleTab(true)">
        <label class="btn btn-outline-secondary fw-bold" for="tabArchived">
            <i class="bi bi-archive-fill me-1"></i> Archived
        </label>
    </div>

    <!-- SEARCH BOX -->
    <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="text" placeholder="Search tenants..."
               @bind="searchText"
               @bind:event="oninput"
               @bind:after="ResetPagination" />
    </div>

    <span class="badge rounded-pill px-3 py-2 fw-semibold count-label" style="background-color: #FFFFFF; color: #0A2B1D; border: 1px solid #E2ECE6;">
        <i class="bi bi-shop me-1 text-success"></i>@Filtered.Count @(Filtered.Count == 1 ? "business" : "businesses")
    </span>

    <!-- NEW BUTTON -->
    <button type="button" class="btn-new ms-auto shadow-sm" @onclick="OpenNew">
        <i class="bi bi-plus-lg"></i> New business
    </button>
</div>

<!-- TABLE (WITH SCROLL, PAGINATION & ROUNDED CORNERS) -->
<div class="panel shadow-sm bg-white d-flex flex-column" style="border-radius: 16px; border: 1px solid #E2ECE6; max-height: calc(100vh - 280px); overflow: hidden;">

    <div class="table-responsive" style="flex-grow: 1; overflow-y: auto;">
        <table class="table table-hover align-middle mb-0 biz-table" style="width: 100%;">
            <thead style="position: sticky; top: 0; z-index: 1; background-color: #F7FAF8;">
                <tr>
                    <th class="text-muted small fw-bold text-uppercase py-3 px-4">Business</th>
                    <th class="text-muted small fw-bold text-uppercase py-3">Owner</th>
                    <th class="text-muted small fw-bold text-uppercase py-3">Plan</th>
                    <th class="text-muted small fw-bold text-uppercase py-3">Status</th>
                    <th class="text-muted small fw-bold text-uppercase py-3">Sync</th>
                    <th class="text-muted small fw-bold text-uppercase py-3">Registered</th>
                    <th class="py-3"></th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < PaginatedTenants.Count(); i++)
                {
                    var t = PaginatedTenants.ElementAt(i);

                    <tr style="cursor: pointer;" @onclick="() => OpenDetails(t)">
                        <td class="px-4">
                            <div class="d-flex align-items-center gap-3">
                                <div class="biz-avatar">
                                    <i class="bi bi-building"></i>
                                </div>
                                <div>
                                    <div class="fw-bold" style="color: #0A2B1D;">@t.Name</div>
                                    <div class="text-muted small mt-1">
                                        <span class="fw-semibold" style="color: #1B5E34;">@t.Code</span>@(string.IsNullOrWhiteSpace(t.Province) ? "" : " · " + t.Province)
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="fw-semibold text-dark">@t.OwnerName</div>
                            <div class="text-muted small mt-1"><i class="bi bi-envelope me-1"></i>@t.Email</div>
                        </td>
                        <td class="fw-semibold" style="color: #0A2B1D;">
                            @if (string.IsNullOrEmpty(t.Plan))
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                <span><i class="bi bi-award text-success me-1"></i>@t.Plan</span>
                            }
                        </td>
                        <td>
                            <span class="pill @StatusClass(t.Status)">
                                <i class="bi @(t.Status == "Active" ? "bi-check-circle-fill" : t.Status == "Trial" ? "bi-hourglass-split" : "bi-slash-circle") me-1"></i>@t.Status
                            </span>
                        </td>
                        <td>
                            <span class="pill @SyncClass(t.Sync)">
                                <i class="bi @(t.Sync == "Synced" ? "bi-cloud-check-fill" : t.Sync == "Pending" ? "bi-arrow-repeat" : "bi-wifi-off") me-1"></i>@t.Sync
                            </span>
                        </td>
                        <td class="text-nowrap text-muted small fw-medium">
                            <i class="bi bi-calendar3 me-1 text-success"></i>@t.Registered.ToString("MMM d, yyyy")
                        </td>
                        <td class="text-end px-4 action-cell">
                            <button type="button" class="btn-dots"
                                    @onclick="(e) => ToggleMenuAsync(e, t.Id)"
                                    @onclick:stopPropagation="true" aria-label="Actions">
                                <i class="bi bi-three-dots"></i>
                            </button>
                        </td>
                    </tr>
                }
                @if (Filtered.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">
                            <i class="bi bi-inbox fs-3 d-block mb-2 opacity-50"></i>
                            No businesses found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- PAGINATION FOOTER -->
    @if (Filtered.Count > 0)
    {
        <div class="d-flex flex-wrap justify-content-between align-items-center p-3 border-top bg-white" style="flex-shrink: 0; border-color: #E2ECE6 !important; border-radius: 0 0 16px 16px;">
            <div class="text-muted small mb-2 mb-md-0">
                Showing <span class="fw-bold" style="color: #0A2B1D;">@StartItem</span> - <span class="fw-bold" style="color: #0A2B1D;">@EndItem</span> of <span class="fw-bold" style="color: #0A2B1D;">@Filtered.Count</span> businesses
            </div>

            <div class="d-flex gap-1">
                <button class="btn btn-sm btn-light border px-3 rounded-2 fw-medium" @onclick="PreviousPage" disabled="@(currentPage == 1)">
                    <i class="bi bi-chevron-left me-1"></i>Previous
                </button>

                @for (int i = 1; i <= TotalPages; i++)
                {
                    var pageNumber = i;
                    <button class="btn btn-sm px-3 rounded-2 fw-bold @(currentPage == pageNumber ? "btn-new text-white shadow-sm" : "btn-light border text-dark")"
                            @onclick="() => GoToPage(pageNumber)">
                        @pageNumber
                    </button>
                }

                <button class="btn btn-sm btn-light border px-3 rounded-2 fw-medium" @onclick="NextPage" disabled="@(currentPage == TotalPages)">
                    Next<i class="bi bi-chevron-right ms-1"></i>
                </button>
            </div>
        </div>
    }
</div>

<!-- ACTION MENU -->
@if (openMenuId != null)
{
    var menuTenant = tenants.FirstOrDefault(x => x.Id == openMenuId);
    if (menuTenant != null)
    {
        <div class="menu-backdrop" @onclick="CloseMenu" @onclick:stopPropagation="true"></div>

        <div class="vertical-action-menu shadow-lg" style="top:@(menuTop)px; left:@(menuLeft)px;">

            @if (!showArchived)
            {
                <button type="button" class="action-item"
                        @onclick="() => OpenEdit(menuTenant)"
                        @onclick:stopPropagation="true">
                    <i class="bi bi-pencil-square text-success"></i> Edit
                </button>

                @if (menuTenant.Status == "Trial")
                {
                    <button type="button" class="action-item"
                            @onclick="() => AcceptTenant(menuTenant)"
                            @onclick:stopPropagation="true">
                        <i class="bi bi-check-circle-fill" style="color: #1B5E34;"></i> Accept
                    </button>
                    <button type="button" class="action-item text-danger"
                            @onclick="() => Reject(menuTenant)"
                            @onclick:stopPropagation="true">
                        <i class="bi bi-x-circle"></i> Reject
                    </button>
                }
                else
                {
                    <button type="button" class="action-item text-danger"
                            @onclick="() => Archive(menuTenant)"
                            @onclick:stopPropagation="true">
                        <i class="bi bi-archive-fill"></i> Archive
                    </button>
                }
            }
            else
            {
                <button type="button" class="action-item text-success"
                        @onclick="() => RestoreTenant(menuTenant)"
                        @onclick:stopPropagation="true">
                    <i class="bi bi-arrow-counterclockwise"></i> Restore
                </button>
            }

        </div>
    }
}

<!-- DETAILS MODAL (MODERN UI) -->
@if (showDetailsModal && selectedTenant != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(10, 43, 29, 0.65); backdrop-filter: blur(5px); z-index: 1050;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation="true">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- Modern Header -->
                <div class="modal-header border-0 p-4 d-flex justify-content-between align-items-center" style="background-color: #F4F7F5;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; background-color: #E8F3EC; color: #1B5E34;">
                            <i class="bi bi-building-fill fs-4"></i>
                        </div>
                        <div>
                            <h4 class="modal-title fw-bolder mb-0" style="color: #0A2B1D;">@selectedTenant.Name</h4>
                            <span class="badge px-2 py-1 mt-1 rounded-pill" style="background-color: #FFFFFF; color: #1B5E34; border: 1px solid #C6DFCE;">
                                <i class="bi bi-upc-scan me-1"></i>@selectedTenant.Code
                            </span>
                        </div>
                    </div>
                    <button type="button" class="btn-close bg-white shadow-sm rounded-circle p-2" @onclick="CloseDetailsModal" aria-label="Close" style="width: 32px; height: 32px;"></button>
                </div>

                <div class="modal-body p-4" style="max-height: 70vh; overflow-y: auto;">

                    <!-- SECTION 1: Owner & Contact -->
                    <div class="mb-4">
                        <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                            <i class="bi bi-person-badge-fill me-2 text-success"></i>Owner & Contact Info
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="text-muted small fw-bold text-uppercase">Owner Name</label>
                                <p class="mb-0 fw-semibold fs-6 text-dark">@selectedTenant.OwnerName</p>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted small fw-bold text-uppercase">Owner Email</label>
                                <p class="mb-0 fw-semibold fs-6 text-dark">@selectedTenant.Email</p>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label class="text-muted small fw-bold text-uppercase">Owner Account Password</label>
                                <div class="mt-1">
                                    @if (selectedTenant.IsTempPassword)
                                    {
                                        <span class="badge px-3 py-2 rounded-3 fs-6 shadow-sm" style="background-color: #FEF3C7; color: #92400E; border: 1px solid #FDE68A;">
                                            <i class="bi bi-key-fill me-2"></i>@selectedTenant.Password
                                        </span>
                                        <div class="text-muted small mt-1"><i class="bi bi-info-circle me-1"></i>Temporary password (not yet changed by owner)</div>
                                    }
                                    else
                                    {
                                        <span class="badge px-3 py-2 rounded-3 fs-6" style="background-color: #F4F7F5; color: #0A2B1D; border: 1px solid #DCE6E0; letter-spacing: 2px;">
                                            <i class="bi bi-shield-lock-fill text-success me-2"></i>••••••••••••
                                        </span>
                                        <div class="text-success small mt-1 fw-medium"><i class="bi bi-check-circle-fill me-1"></i>Updated by business owner</div>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label class="text-muted small fw-bold text-uppercase">Contact Number</label>
                                <p class="mb-0 fw-semibold fs-6 text-dark">
                                    @(string.IsNullOrEmpty(selectedTenant.Contact) ? "N/A" : selectedTenant.Contact)
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 2: Location & Plan -->
                    <div class="mb-4">
                        <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                            <i class="bi bi-geo-alt-fill me-2 text-success"></i>Location & Subscription
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="text-muted small fw-bold text-uppercase">Province</label>
                                <p class="mb-0 fw-medium text-dark">
                                    <i class="bi bi-pin-map-fill text-success me-2"></i>@(string.IsNullOrEmpty(selectedTenant.Province) ? "N/A" : selectedTenant.Province)
                                </p>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted small fw-bold text-uppercase">Subscription Plan</label>
                                <p class="mb-0 fw-medium text-dark">
                                    <i class="bi bi-card-checklist text-success me-2"></i>@(string.IsNullOrEmpty(selectedTenant.Plan) ? "None" : selectedTenant.Plan)
                                </p>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label class="text-muted small fw-bold text-uppercase">Date Registered</label>
                                <p class="mb-0 fw-medium text-dark">
                                    <i class="bi bi-calendar-event-fill text-success me-2"></i>@selectedTenant.Registered.ToString("MMMM d, yyyy")
                                </p>
                            </div>
                            <div class="col-12 mt-3">
                                <label class="text-muted small fw-bold text-uppercase">Complete Address</label>
                                <p class="mb-0 text-muted fst-italic">@(string.IsNullOrEmpty(selectedTenant.Address) ? "No address provided." : selectedTenant.Address)</p>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 3: System Status & Notes -->
                    <div class="p-4 rounded-4" style="background-color: #F7FAF8; border: 1px dashed #C6DFCE;">
                        <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                            <i class="bi bi-gear-wide-connected me-2 text-success"></i>System Status & Notes
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="text-muted small fw-bold text-uppercase d-block mb-2">Account Status</label>
                                <span class="pill @StatusClass(selectedTenant.Status)">@selectedTenant.Status</span>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted small fw-bold text-uppercase d-block mb-2">Sync Status</label>
                                <span class="pill @SyncClass(selectedTenant.Sync)">@selectedTenant.Sync</span>
                            </div>

                            <div class="col-12 mt-3">
                                <label class="text-muted small fw-bold text-uppercase d-block mb-2">Internal Notes</label>
                                <div class="p-3 bg-white rounded-3 border" style="border-color: #E2ECE6 !important;">
                                    <p class="mb-0 text-muted small">@(string.IsNullOrEmpty(selectedTenant.Notes) ? "No notes available." : selectedTenant.Notes)</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer Actions -->
                <div class="modal-footer border-0 p-4 d-flex justify-content-between" style="background-color: #F4F7F5;">
                    <button type="button" class="btn btn-light border fw-bold px-4 rounded-3 shadow-sm" @onclick="CloseDetailsModal">Close</button>

                    <div class="d-flex gap-2">
                        @if (selectedTenant.Status == "Trial")
                        {
                            <button type="button" class="btn btn-success fw-bold px-4 rounded-3 shadow-sm" @onclick="() => AcceptTenant(selectedTenant)">
                                <i class="bi bi-check2-circle me-2"></i>Accept Request
                            </button>
                        }
                        <button type="button" class="btn-save px-5 shadow-sm" @onclick="() => OpenEdit(selectedTenant)">
                            <i class="bi bi-pencil-square me-2"></i>Edit Details
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- ADD / EDIT MODAL (MODERN UI) -->
@if (showModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(10, 43, 29, 0.65); backdrop-filter: blur(5px); z-index: 1050;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation="true">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- Modern Header -->
                <div class="modal-header border-0 p-4" style="background-color: #F4F7F5;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; background-color: #E8F3EC; color: #1B5E34;">
                            <i class="bi @(editingId == null ? "bi-shop" : "bi-pencil-square") fs-5"></i>
                        </div>
                        <div>
                            <h4 class="modal-title fw-bolder mb-0" style="color: #0A2B1D;">
                                @(editingId == null ? "Register New Business" : "Edit Business Details")
                            </h4>
                            <p class="text-muted small mb-0">Fill in the information below to @(editingId == null ? "onboard a new tenant" : "update the tenant").</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close bg-white shadow-sm rounded-circle p-2" @onclick="CloseModal" aria-label="Close" style="width: 32px; height: 32px;"></button>
                </div>

                <div class="modal-body p-4" style="max-height: 70vh; overflow-y: auto;">
                    <form>
                        <!-- SECTION 1: Business Information -->
                        <div class="mb-4">
                            <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                                <i class="bi bi-building-fill me-2 text-success"></i>Business Information
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label class="form-label fw-bold small text-muted">Business Name <span class="text-danger">*</span></label>
                                    <div class="input-group modern-input @(showErrors && string.IsNullOrWhiteSpace(form.Name) ? "border border-danger rounded-3" : "")">
                                        <span class="input-group-text bg-white"><i class="bi bi-shop text-success"></i></span>
                                        <input class="form-control" placeholder="e.g. Verdant Agri Ventures"
                                               @bind="form.Name"
                                               @bind:after="() => form.Name = CapitalizeWords(form.Name)" />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small text-muted">Tenant Code <span class="text-danger">*</span></label>
                                    <div class="input-group modern-input bg-light">
                                        <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-upc-scan text-success"></i></span>
                                        <input class="form-control bg-transparent border-start-0 text-muted fw-bold" readonly @bind="form.Code" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- SECTION 2: Owner Details -->
                        <div class="mb-4">
                            <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                                <i class="bi bi-person-badge-fill me-2 text-success"></i>Owner Details
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small text-muted">First Name</label>
                                    <div class="input-group modern-input">
                                        <span class="input-group-text bg-white"><i class="bi bi-person text-success"></i></span>
                                        <input class="form-control" @bind="form.FName"
                                               @bind:after="() => form.FName = CapitalizeWords(form.FName)"
                                               placeholder="Juan" />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small text-muted">Middle Name</label>
                                    <div class="input-group modern-input">
                                        <span class="input-group-text bg-white"><i class="bi bi-person text-success"></i></span>
                                        <input class="form-control" @bind="form.MName"
                                               @bind:after="() => form.MName = CapitalizeWords(form.MName)"
                                               placeholder="D." />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small text-muted">Last Name</label>
                                    <div class="input-group modern-input">
                                        <span class="input-group-text bg-white"><i class="bi bi-person text-success"></i></span>
                                        <input class="form-control" @bind="form.LName"
                                               @bind:after="() => form.LName = CapitalizeWords(form.LName)"
                                               placeholder="Dela Cruz" />
                                    </div>
                                </div>

                                <div class="col-md-6 mt-4">
                                    <label class="form-label fw-bold small text-muted">Owner Email</label>
                                    <div class="input-group modern-input @(!string.IsNullOrEmpty(emailError) ? "border border-danger rounded-3" : "")">
                                        <span class="input-group-text bg-white"><i class="bi bi-envelope text-success"></i></span>
                                        <input type="email" class="form-control" @bind="form.Email" placeholder="owner@email.com" />
                                    </div>
                                    @if (!string.IsNullOrEmpty(emailError))
                                    {
                                        <div class="text-danger small mt-1 fw-bold"><i class="bi bi-exclamation-triangle-fill me-1"></i>@emailError</div>
                                    }
                                </div>
                                <div class="col-md-6 mt-4">
                                    <label class="form-label fw-bold small text-muted">Contact Number</label>
                                    <div class="input-group modern-input">
                                        <span class="input-group-text bg-white"><i class="bi bi-telephone text-success"></i></span>
                                        <input type="tel" class="form-control"
                                               @bind="form.Contact"
                                               @bind:event="oninput"
                                               @bind:after="FormatContactNumber"
                                               placeholder="09XX XXX XXXX"
                                               spellcheck="false" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- SECTION 3: Location & Plan -->
                        <div class="mb-4">
                            <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                                <i class="bi bi-geo-alt-fill me-2 text-success"></i>Location & Subscription
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Region</label>
                                    <div class="input-group modern-input">
                                        <span class="input-group-text bg-white"><i class="bi bi-globe-asia-australia text-success"></i></span>
                                        <select class="form-select" @bind="selectedRegionCode" @bind:after="OnRegionChanged">
                                            <option value="">Select Region...</option>
                                            @foreach (var r in regions)
                                            {
                                                <option value="@r.Code">@r.Name</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Province</label>
                                    <div class="input-group modern-input">
                                        <span class="input-group-text bg-white"><i class="bi bi-pin-map text-success"></i></span>
                                        <select class="form-select" @bind="selectedProvinceCode" @bind:after="OnProvinceChanged">
                                            <option value="">Select Province...</option>
                                            @foreach (var p in provinces)
                                            {
                                                <option value="@p.Code">@p.Name</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-bold small text-muted">Complete Address</label>
                                    <div class="input-group modern-input">
                                        <span class="input-group-text bg-white"><i class="bi bi-geo text-success"></i></span>
                                        <input class="form-control" @bind="form.Address"
                                               @bind:after="() => form.Address = CapitalizeWords(form.Address)"
                                               placeholder="House No., Street, Barangay, City" />
                                    </div>
                                </div>

                                <div class="col-md-6 mt-4">
                                    <label class="form-label fw-bold small text-muted">Subscription Plan</label>
                                    <div class="input-group modern-input">
                                        <span class="input-group-text bg-white"><i class="bi bi-card-checklist text-success"></i></span>
                                        <select class="form-select" @bind="form.Plan">
                                            <option value="">Select Plan...</option>
                                            @foreach (var p in dbPlans)
                                            {
                                                <option value="@p.Name">@p.Name</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6 mt-4">
                                    <label class="form-label fw-bold small text-muted">Date Registered</label>
                                    <div class="input-group modern-input">
                                        <span class="input-group-text bg-white"><i class="bi bi-calendar-event text-success"></i></span>
                                        <input type="date" class="form-control" @bind="form.Registered" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- SECTION 4: System Status & Notes -->
                        <div class="p-4 rounded-4" style="background-color: #F7FAF8; border: 1px dashed #C6DFCE;">
                            <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                                <i class="bi bi-gear-wide-connected me-2 text-success"></i>System Status & Notes
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Account Status</label>
                                    <select class="form-select border-0 shadow-sm" @bind="form.Status">
                                        <option>Active</option>
                                        <option>Suspended</option>
                                        <option>Trial</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Sync Status</label>
                                    <select class="form-select border-0 shadow-sm" @bind="form.Sync">
                                        <option>Synced</option>
                                        <option>Pending</option>
                                        <option>Offline</option>
                                    </select>
                                </div>
                                <div class="col-12 mt-3">
                                    <label class="form-label fw-bold small text-muted">Internal Notes</label>
                                    <textarea class="form-control border-0 shadow-sm" rows="3" @bind="form.Notes" placeholder="Type any additional notes or instructions here..."></textarea>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="modal-footer border-0 p-4 d-flex justify-content-end gap-2" style="background-color: #F4F7F5;">
                    <button type="button" class="btn btn-light border fw-bold px-4 rounded-3 shadow-sm" @onclick="CloseModal">Cancel</button>
                    <button type="button" class="btn-save px-5 shadow-sm" @onclick="Save">
                        <i class="bi bi-check2-circle me-2"></i>@(editingId == null ? "Save Business" : "Update Business")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- SUCCESS CREDENTIALS MODAL -->
@if (showSuccessModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(10, 43, 29, 0.65); backdrop-filter: blur(4px); z-index: 1050;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 text-center">
                <div class="modal-body p-4 mt-2">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px; background-color: #E8F3EC; color: #1B5E34;">
                        <i class="bi bi-check-circle-fill" style="font-size: 2.5rem;"></i>
                    </div>
                    <h4 class="fw-bolder mb-1" style="color: #0A2B1D;">Account Created!</h4>
                    <p class="text-muted small mb-4">Please copy these temporary credentials and provide them to the business owner.</p>

                    <div class="text-start p-3 rounded-3 mb-4" style="background-color: #F7FAF8; border: 1px solid #E2ECE6;">
                        <div class="mb-2">
