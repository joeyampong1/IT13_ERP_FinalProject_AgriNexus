@code {
    // ---------- MODELS ----------
    class Tenant
    {
        public long Id { get; set; }
        public string Name { get; set; } = "";
        public string Code { get; set; } = "";

        // Name Properties for the User
        public string FName { get; set; } = "";
        public string MName { get; set; } = "";
        public string LName { get; set; } = "";

        // Computed Property for displaying Full Name safely
        public string OwnerName => $"{FName} {MName} {LName}".Replace("  ", " ").Trim();

        public string Email { get; set; } = "";

        // Property to hold the password for display
        public string Password { get; set; } = "";

        public string Contact { get; set; } = "";
        public string Province { get; set; } = "";
        public string Plan { get; set; } = "";
        public string Status { get; set; } = "Trial";
        public string Sync { get; set; } = "Synced";
        public DateTime Registered { get; set; } = DateTime.Today;
        public string Address { get; set; } = "";
        public string Notes { get; set; } = "";
        public bool IsTempPassword { get; set; } = true;

        public Tenant Clone() => (Tenant)MemberwiseClone();
    }

    record Stat(string Title, string Value, string Note, string Icon, string IconClass);

    class Viewport
    {
        public double W { get; set; }
        public double H { get; set; }
    }

    // ---------- STATE ----------
    string searchText = "";
    string emailError = "";
    bool showModal;
    bool showErrors;
    long? editingId;
    long? openMenuId;
    Tenant form = new();

    bool showDetailsModal;
    Tenant? selectedTenant;

    bool showSuccessModal;
    string generatedEmail = "";
    string generatedPassword = "";

    bool showRejectModal;
    Tenant? tenantToReject;

    bool showArchived = false;
    bool showArchiveModal;
    Tenant? tenantToArchive;

    List<Tenant> tenants = new();

    private List<Region> regions = new();
    private List<Province> provinces = new();
    private string selectedRegionCode = "";
    private string selectedProvinceCode = "";
    private List<AgriNexus.DataLayer.Models.SubscriptionPlan> dbPlans = new();

    private int currentPage = 1;
    private int pageSize = 5;

    private double menuTop;
    private double menuLeft;

    static readonly Dictionary<string, decimal> Plans = new()
    {
        ["Starter"] = 2998m,
        ["Growth"] = 3999m,
        ["Enterprise"] = 9999m,
        ["Cooperative Custom"] = 14999m,
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadTenantsAsync();

        regions = (await AddressProvider.GetRegionsAsync()).ToList();
        dbPlans = await DbContext.SubscriptionPlans.ToListAsync();
    }

    private async Task OnRegionChanged()
    {
        if (!string.IsNullOrEmpty(selectedRegionCode))
        {
            provinces = (await AddressProvider.GetProvincesByRegionCodeAsync(selectedRegionCode)).ToList();
        }
        else
        {
            provinces.Clear();
        }

        form.Province = "";
        selectedProvinceCode = "";
    }

    private void OnProvinceChanged()
    {
        var selectedProvince = provinces.FirstOrDefault(p => p.Code == selectedProvinceCode);
        if (selectedProvince != null)
        {
            form.Province = selectedProvince.Name;
        }
    }

    // Pagination Methods
    private void GoToPage(int page) => currentPage = page;
    private void PreviousPage() { if (currentPage > 1) currentPage--; }
    private void NextPage() { if (currentPage < TotalPages) currentPage++; }
    private void ResetPagination() => currentPage = 1;

    private async Task LoadTenantsAsync()
    {
        var query = DbContext.Businesses.Include(b => b.Users).AsQueryable();

        if (showArchived)
        {
            query = query.Where(b => b.IsArchived);
        }
        else
        {
            query = query.Where(b => !b.IsArchived && b.Status != "Incomplete");
        }

        var businesses = await query.ToListAsync();

        tenants = businesses.Select(b =>
        {
            var owner = b.Users?.FirstOrDefault(u => u.Role == "TenantAdmin");
            return new Tenant
            {
                Id = b.BusinessId,
                Name = b.BusinessName,
                Code = $"TEN-{b.BusinessId:000}",
                FName = owner?.FName ?? "",
                MName = owner?.MName ?? "",
                LName = owner?.LName ?? "",
                Email = b.Email,
                Password = owner?.PasswordHash ?? "",
                IsTempPassword = owner?.IsTempPassword ?? true,
                Plan = b.PlanName,
                Status = b.Status,
                Sync = b.SyncStatus,
                Registered = b.RegisteredAt,
                Contact = b.ContactNumber,
                Province = b.Province,
                Address = b.Address,
                Notes = b.Notes
            };
        }).ToList();
    }

    // ---------- COMPUTED ----------
    List<Tenant> Filtered => string.IsNullOrWhiteSpace(searchText)
        ? tenants
        : tenants.Where(t =>
            t.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            t.Code.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            t.OwnerName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            t.Province.Contains(searchText, StringComparison.OrdinalIgnoreCase)).ToList();

    private int TotalPages => (int)Math.Ceiling((double)Filtered.Count / pageSize);
    private int StartItem => Filtered.Count == 0 ? 0 : (currentPage - 1) * pageSize + 1;
    private int EndItem => Math.Min(currentPage * pageSize, Filtered.Count);
    private IEnumerable<Tenant> PaginatedTenants => Filtered.Skip((currentPage - 1) * pageSize).Take(pageSize);

    private async Task ToggleMenuAsync(MouseEventArgs e, long id)
    {
        if (openMenuId == id)
        {
            openMenuId = null;
            return;
        }

        var menuTenant = tenants.FirstOrDefault(x => x.Id == id);
        int itemCount = 1;

        if (!showArchived && menuTenant != null)
        {
            itemCount = menuTenant.Status == "Trial" ? 3 : 2;
        }

        const double itemHeight = 42;
        const double padding = 16;
        const double menuWidth = 200;

        double menuHeight = (itemCount * itemHeight) + padding;

        var viewport = await JS.InvokeAsync<Viewport>("eval",
            "({ w: window.innerWidth, h: window.innerHeight })");
        var viewportWidth = viewport.W;
        var viewportHeight = viewport.H;

        menuLeft = Math.Min(e.ClientX - menuWidth + 20, viewportWidth - menuWidth - 10);

        menuTop = (e.ClientY + menuHeight > viewportHeight)
            ? e.ClientY - menuHeight - 5
            : e.ClientY + 15;

        openMenuId = id;
    }

    List<Stat> Stats
    {
        get
        {
            var active = tenants.Count(t => t.Status == "Active");
            var trial = tenants.Count(t => t.Status == "Trial");
            var revenue = tenants.Where(t => t.Status != "Suspended" && Plans.ContainsKey(t.Plan))
                                 .Sum(t => Plans[t.Plan]);
            var syncAttention = tenants.Count(t => t.Sync != "Synced");

            return new()
            {
                new("REGISTERED BUSINESSES", tenants.Count.ToString(), "", "bi-buildings-fill", ""),
                new("ACTIVE TENANTS", active.ToString(), $"{trial} still on trial", "bi-credit-card-2-front-fill", ""),
                new("RECURRING REVENUE", $"₱{revenue:N2}", "Monthly subscription value", "bi-graph-up-arrow", ""),
                new("SYNC ATTENTION", syncAttention.ToString(), "", "bi-arrow-repeat", "stat-icon-warn"),
            };
        }
    }

    static string StatusClass(string s) => s switch
    {
        "Active" => "pill-green",
        "Trial" => "pill-blue",
        "Suspended" => "pill-red",
        "Rejected" => "pill-gray",
        "Archived" => "pill-gray",
        _ => "pill-gray"
    };

    static string SyncClass(string s) => s switch
    {
        "Synced" => "pill-green",
        "Pending" => "pill-yellow",
        "Offline" => "pill-red",
        _ => "pill-gray"
    };

    string NextCode()
    {
        long nextId = tenants.Any() ? tenants.Max(t => t.Id) + 1 : 1;
        return $"TEN-{nextId:000}";
    }

    private string CapitalizeWords(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return input;
        return System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(input.ToLower().Trim());
    }

    private void FormatContactNumber()
    {
        if (string.IsNullOrEmpty(form.Contact)) return;

        var digits = new string(form.Contact.Where(char.IsDigit).ToArray());

        if (string.IsNullOrEmpty(digits))
        {
            form.Contact = "";
            return;
        }

        if (digits.StartsWith("63") && digits.Length > 2)
        {
            digits = "0" + digits.Substring(2);
        }
        else if (digits.StartsWith("9"))
        {
            digits = "0" + digits;
        }

        if (digits.Length > 11)
        {
            digits = digits.Substring(0, 11);
        }

        if (digits.Length > 7)
        {
            form.Contact = $"{digits.Substring(0, 4)} {digits.Substring(4, 3)} {digits.Substring(7)}";
        }
        else if (digits.Length > 4)
        {
            form.Contact = $"{digits.Substring(0, 4)} {digits.Substring(4)}";
        }
        else
        {
            form.Contact = digits;
        }
    }

    private string GenerateTempPassword()
    {
        const string chars = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789";
        var random = new Random();
        return new string(Enumerable.Repeat(chars, 8)
            .Select(s => s[random.Next(s.Length)]).ToArray());
    }

    // ---------- ACTIONS ----------
    void OpenNew()
    {
        form = new Tenant
        {
            Registered = DateTime.Today,
            Status = "Active",
            Sync = "Synced",
            Code = NextCode()
        };
        editingId = null;
        showErrors = false;
        emailError = "";
        showModal = true;
    }

    void OpenEdit(Tenant t)
    {
        showDetailsModal = false;
        form = t.Clone();
        editingId = t.Id;
        showErrors = false;
        openMenuId = null;
        emailError = "";
        showModal = true;
    }

    void CloseModal() => showModal = false;

    void OpenDetails(Tenant t)
    {
        selectedTenant = t;
        showDetailsModal = true;
    }

    void CloseDetailsModal()
    {
        showDetailsModal = false;
        selectedTenant = null;
    }

    async Task AcceptTenant(Tenant t)
    {
        var business = await DbContext.Businesses.FindAsync(t.Id);
        if (business != null)
        {
            business.Status = "Active";

            var owner = await DbContext.Users
                .FirstOrDefaultAsync(u => u.BusinessId == t.Id && u.Role == "TenantAdmin");
            if (owner != null)
            {
                owner.Status = "Active";
            }

            var sub = await DbContext.Subscriptions
                .Where(s => s.BusinessId == t.Id)
                .OrderByDescending(s => s.SubscriptionId)
                .FirstOrDefaultAsync();
            if (sub != null)
            {
                sub.Status = "Active";
                sub.PaymentStatus = "Paid";
                sub.RenewalDate = DateTime.Today.AddDays(sub.Cycle == "yearly" ? 365 : 30);
            }

            await DbContext.SaveChangesAsync();
            await LoadTenantsAsync();
            if (showDetailsModal) CloseDetailsModal();
        }
    }

    async Task Save()
    {
        showErrors = true;
        emailError = "";

        if (string.IsNullOrWhiteSpace(form.Name) || string.IsNullOrWhiteSpace(form.Code))
            return;

        var rawContact = new string(form.Contact.Where(char.IsDigit).ToArray());
        if (rawContact.Length != 11)
        {
            Console.WriteLine("Contact number must be 11 digits.");
            return;
        }

        var cleanEmail = form.Email.Trim();

        if (editingId == null)
        {
            var emailExists = await DbContext.Users
                .AnyAsync(u => u.Email.ToLower() == cleanEmail.ToLower());

            if (emailExists)
            {
                emailError = "This email is already registered to an existing user.";
                return;
            }

            // 1. Create Business Tenant
            var newBusiness = new Business
            {
                BusinessName = form.Name.Trim(),
                Email = cleanEmail,
                PlanName = form.Plan,
                Status = form.Status,
                SyncStatus = form.Sync,
                RegisteredAt = form.Registered,
                ContactNumber = form.Contact.Trim(),
                Province = form.Province.Trim(),
                Address = form.Address.Trim(),
                Notes = form.Notes.Trim()
            };

            DbContext.Businesses.Add(newBusiness);
            await DbContext.SaveChangesAsync();

            // 2. Create Default TenantAdmin (Business Owner) Account
            string tempPassword = GenerateTempPassword();

            var newUser = new User
            {
                BusinessId = newBusiness.BusinessId,
                Role = "TenantAdmin",
                FName = form.FName.Trim(),
                MName = form.MName.Trim(),
                LName = form.LName.Trim(),
                Email = cleanEmail,
                PasswordHash = tempPassword,
                IsTempPassword = true,
                Status = "Active",
                CreatedAt = DateTime.Now
            };
            DbContext.Users.Add(newUser);

            // 3. Create Initial Subscription Record (para sa MySubscription page)
            var matchedPlan = await DbContext.SubscriptionPlans
                .FirstOrDefaultAsync(p => !p.IsArchived && p.Name.ToLower() == form.Plan.Trim().ToLower());

            if (matchedPlan != null)
            {
                bool isTrial = string.Equals(form.Status, "Trial", StringComparison.OrdinalIgnoreCase);
                string cycle = string.IsNullOrWhiteSpace(matchedPlan.Cycle) ? "monthly" : matchedPlan.Cycle;
                int daysToAdd = isTrial ? 14 : (cycle.Equals("yearly", StringComparison.OrdinalIgnoreCase) ? 365 : 30);

                var initialSub = new Subscription
                {
                    BusinessId = newBusiness.BusinessId,
                    SubscriptionPlanId = matchedPlan.PlanId,
                    Amount = isTrial ? 0m : matchedPlan.Price,
                    Cycle = isTrial ? "trial" : cycle,
                    RenewalDate = DateTime.Today.AddDays(daysToAdd),
                    PaymentStatus = isTrial ? "Trial" : "Paid",
                    Status = "Active",
                    AutoRenew = true
                };
                DbContext.Subscriptions.Add(initialSub);
            }

            await DbContext.SaveChangesAsync();

            generatedEmail = cleanEmail;
            generatedPassword = tempPassword;

            showModal = false;
            showSuccessModal = true;
        }
        else
        {
            var existingBusiness = await DbContext.Businesses.FindAsync(editingId);
            if (existingBusiness != null)
            {
                var existingUser = await DbContext.Users
                    .FirstOrDefaultAsync(u => u.BusinessId == editingId && u.Role == "TenantAdmin");

                var emailTakenByOther = await DbContext.Users
                    .AnyAsync(u => u.Email.ToLower() == cleanEmail.ToLower()
                                && (existingUser == null || u.UserId != existingUser.UserId));

                if (emailTakenByOther)
                {
                    emailError = "This email is already used by another user.";
                    return;
                }

                existingBusiness.BusinessName = form.Name.Trim();
                existingBusiness.Email = cleanEmail;
                existingBusiness.PlanName = form.Plan;
                existingBusiness.Status = form.Status;
                existingBusiness.SyncStatus = form.Sync;
                existingBusiness.RegisteredAt = form.Registered;
                existingBusiness.ContactNumber = form.Contact.Trim();
                existingBusiness.Province = form.Province.Trim();
                existingBusiness.Address = form.Address.Trim();
                existingBusiness.Notes = form.Notes.Trim();

                DbContext.Businesses.Update(existingBusiness);

                if (existingUser != null)
                {
                    existingUser.FName = form.FName.Trim();
                    existingUser.MName = form.MName.Trim();
                    existingUser.LName = form.LName.Trim();
                    existingUser.Email = cleanEmail;
                    DbContext.Users.Update(existingUser);
                }

                await DbContext.SaveChangesAsync();
            }

            showModal = false;
        }

        await LoadTenantsAsync();
    }

    void Reject(Tenant t)
    {
        tenantToReject = t;
        showRejectModal = true;
        openMenuId = null;
    }

    void CloseRejectModal()
    {
        showRejectModal = false;
        tenantToReject = null;
    }

    async Task ConfirmReject()
    {
        if (tenantToReject == null) return;

        var business = await DbContext.Businesses.FindAsync(tenantToReject.Id);
        if (business != null)
        {
            business.IsArchived = true;
            business.Status = "Rejected";

            var owner = await DbContext.Users
                .FirstOrDefaultAsync(u => u.BusinessId == tenantToReject.Id && u.Role == "TenantAdmin");
            if (owner != null)
                owner.Status = "Inactive";

            await DbContext.SaveChangesAsync();
        }

        CloseRejectModal();
        await LoadTenantsAsync();
    }

    void Archive(Tenant t)
    {
        tenantToArchive = t;
        showArchiveModal = true;
        openMenuId = null;
    }

    void CloseArchiveModal()
    {
        showArchiveModal = false;
        tenantToArchive = null;
    }

    async Task ConfirmArchive()
    {
        if (tenantToArchive == null) return;

        var businessToArchive = await DbContext.Businesses.FindAsync(tenantToArchive.Id);

        if (businessToArchive != null)
        {
            businessToArchive.IsArchived = true;
            businessToArchive.Status = "Archived";

            var owner = await DbContext.Users
                .FirstOrDefaultAsync(u => u.BusinessId == tenantToArchive.Id && u.Role == "TenantAdmin");
            if (owner != null)
                owner.Status = "Inactive";

            await DbContext.SaveChangesAsync();
        }

        CloseArchiveModal();
        await LoadTenantsAsync();
    }

    private async Task ToggleTab(bool isArchived)
    {
        showArchived = isArchived;
        currentPage = 1;
        await LoadTenantsAsync();
    }

    async Task RestoreTenant(Tenant t)
    {
        var business = await DbContext.Businesses.FindAsync(t.Id);
        if (business != null)
        {
            business.IsArchived = false;
            business.Status = t.Status == "Rejected" ? "Trial" : "Active";

            var owner = await DbContext.Users
                .FirstOrDefaultAsync(u => u.BusinessId == t.Id && u.Role == "TenantAdmin");
            if (owner != null)
                owner.Status = "Active";

            await DbContext.SaveChangesAsync();
        }
        openMenuId = null;
        await LoadTenantsAsync();
    }

    void CloseMenu() => openMenuId = null;
}