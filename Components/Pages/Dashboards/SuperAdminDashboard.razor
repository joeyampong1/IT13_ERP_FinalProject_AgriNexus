@page "/dashboard"

<div class="mb-4">
    <h2 class="dash-title">Dashboard</h2>
    <p class="text-muted mb-0 dash-sub">Platform-wide view of registered businesses, subscription revenue, synchronization, and system activity.</p>
</div>

<!-- STAT CARDS -->
<div class="row g-3 mb-4">
    @foreach (var s in stats)
    {
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <span class="card-title">@s.Title</span>
                    <div class="stat-icon @s.IconClass"><i class="bi @s.Icon"></i></div>
                </div>
                <div class="mt-3">
                    <div class="card-value">@s.Value</div>
                    <div class="text-muted small mt-1">@s.Note</div>
                </div>
            </div>
        </div>
    }
</div>

<!-- CHARTS -->
<div class="row g-3 mb-4">
    <div class="col-12 col-lg-8">
        <div class="stat-card h-100">
            <div class="panel-title">Recurring revenue by plan</div>
            <div class="panel-sub">Monthly amount per subscription plan</div>

            <svg viewBox="0 0 640 300" class="w-100" style="max-height:320px" role="img" aria-label="Recurring revenue by plan">
                @for (int i = 0; i <= 4; i++)
                {
                    var y = 20 + i * 60;
                    <g>
                        <line x1="50" x2="630" y1="@y" y2="@y" stroke="#E2E8F0" stroke-dasharray="3 4" />
                        <text x="40" y="@(y + 4)" text-anchor="end" font-size="11" fill="#64748B">@((16 - i * 4))k</text>
                    </g>
                }
                @for (int i = 0; i < revenue.Count; i++)
                {
                    var r = revenue[i];
                    var h = r.Amount / 16000.0 * 240;
                    var x = 70 + i * 140;
                    <g>
                        <rect x="@x" y="@((260 - h).ToString("0.##"))" width="110" height="@h.ToString("0.##")" rx="6" fill="#206A3B" />
                        <text x="@(x + 55)" y="282" text-anchor="middle" font-size="11" fill="#475569">@r.Plan</text>
                    </g>
                }
            </svg>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="stat-card h-100">
            <div class="panel-title">Tenant status</div>
            <div class="panel-sub">Distribution of registered businesses</div>

            <div class="d-flex justify-content-center my-3">
                <svg viewBox="0 0 200 200" width="210" height="210" role="img" aria-label="Tenant status">
                    @{ double offset = 0; }
                    @foreach (var t in tenantStatus)
                    {
                        var len = t.Count / (double)tenantTotal * circ;
                        <circle cx="100" cy="100" r="@radius" fill="none" stroke="@t.Color" stroke-width="30"
                                stroke-dasharray="@((len - 3).ToString("0.##")) @((circ - len + 3).ToString("0.##"))"
                                stroke-dashoffset="@((-offset).ToString("0.##"))"
                                transform="rotate(-90 100 100)" />
                        offset += len;
                    }
                </svg>
            </div>

            <div class="d-flex justify-content-center gap-3 small text-muted flex-wrap">
                @foreach (var t in tenantStatus)
                {
                    <span><span class="legend-dot" style="background:@t.Color"></span>@t.Label · @t.Count</span>
                }
            </div>
        </div>
    </div>
</div>

<!-- TABLES -->
<div class="row g-3">
    <div class="col-12 col-lg-5">
        <div class="stat-card h-100">
            <div class="panel-title">Synchronization status monitoring</div>
            <div class="panel-sub">Tenants flagged as pending or offline</div>
            <div class="table-responsive">
                <table class="table dash-table align-middle mb-0">
                    <thead><tr><th>Business</th><th>Sync</th><th>Last sync</th></tr></thead>
                    <tbody>
                    @foreach (var s in syncRows)
                    {
                        <tr>
                            <td>@s.Business</td>
                            <td><span class="pill @(s.Status == "Pending" ? "pill-warn" : "pill-danger")">@s.Status</span></td>
                            <td>@s.LastSync</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-7">
        <div class="stat-card h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="panel-title">System-wide audit logs</div>
                    <div class="panel-sub">Latest platform activity</div>
                </div>
                <i class="bi bi-shield-check text-muted"></i>
            </div>
            <div class="table-responsive">
                <table class="table dash-table align-middle mb-0">
                    <thead><tr><th>Actor</th><th>Action</th><th>Module</th><th>When</th></tr></thead>
                    <tbody>
                    @foreach (var a in auditRows)
                    {
                        <tr>
                            <td>@a.Actor</td>
                            <td><span class="pill pill-muted">@a.Action</span></td>
                            <td>@a.Module</td>
                            <td class="text-nowrap">@a.When</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    record Stat(string Title, string Value, string Note, string Icon, string IconClass);
    record Rev(string Plan, int Amount);
    record TenantSlice(string Label, int Count, string Color);
    record SyncRow(string Business, string Status, string LastSync);
    record AuditRow(string Actor, string Action, string Module, string When);

    // ---- TEMPORARY DATA (ilisi sa database later) ----
    readonly List<Stat> stats = new()
    {
        new("REGISTERED BUSINESSES", "5", "3 active · 1 on trial", "bi-buildings", ""),
        new("ACTIVE SUBSCRIPTIONS", "3", "5 total records", "bi-credit-card", ""),
        new("MONTHLY RECURRING REVENUE", "₱31,995.00", "Across all subscribed tenants", "bi-graph-up-arrow", ""),
        new("SYNC ATTENTION", "3", "Tenants not fully synchronized", "bi-arrow-repeat", "stat-icon-warn"),
    };

    readonly List<Rev> revenue = new()
    {
        new("Growth", 4000), new("Cooperative Custom", 15000),
        new("Enterprise", 10000), new("Starter", 3000),
    };

    readonly List<TenantSlice> tenantStatus = new()
    {
        new("Active", 3, "#206A3B"), new("Trial", 1, "#5FAA33"), new("Suspended", 1, "#92D050"),
    };

    readonly List<SyncRow> syncRows = new()
    {
        new("Sunrise Rice Farmers Coop", "Pending", "Oct 22, 2026, 11:05 PM"),
        new("Green Valley Farms", "Offline", "Oct 18, 2026, 5:20 PM"),
        new("Bicol River Organic Growers", "Offline", "Sep 30, 2026, 7:00 PM"),
    };

    readonly List<AuditRow> auditRows = new()
    {
        new("Paolo Gutierrez", "Payment", "Payments & Collections", "Oct 22, 2026"),
        new("Allan Mercado", "Update", "Stock Movements", "Oct 22, 2026"),
        new("Ramon Delos Santos", "Create", "Work Assignments", "Oct 21, 2026"),
        new("Andres B. Cruz", "Login", "Platform", "Oct 21, 2026"),
        new("Marilou Pangan", "Create", "Harvest Recording", "Oct 20, 2026"),
        new("Cristina Yabut", "Create", "Stock Receiving", "Oct 20, 2026"),
    };

    const double radius = 70;
    static readonly double circ = 2 * Math.PI * radius;
    int tenantTotal => tenantStatus.Sum(t => t.Count);
}