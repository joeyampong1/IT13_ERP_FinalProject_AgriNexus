@page "/labor-harvest-dashboard"
@using System.Globalization

<!-- BUSINESS / BRANCH FILTER -->
<div class="filter-bar mb-4">
    <div class="filter-box">
        <i class="bi bi-buildings"></i>
        <span class="filter-label">BUSINESS</span>
        <select class="filter-select" @bind="business" @bind:after="OnBusinessChanged">
            @foreach (var b in BusinessNames)
            {
                <option value="@b">@b</option>
            }
        </select>
    </div>

    <div class="filter-box">
        <i class="bi bi-shop"></i>
        <span class="filter-label">BRANCH</span>
        <select class="filter-select" @bind="branch">
            @foreach (var b in CurrentBranches)
            {
                <option value="@b">@b</option>
            }
        </select>
    </div>
</div>

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <h2 class="page-title">Labor &amp; Harvest Dashboard</h2>
        <p class="text-muted mb-0 page-sub">Worker records, daily assignments, attendance logs, labor cost, and harvest activity for your branch.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="attendance" class="btn-outline-lg">Log attendance</a>
        <a href="harvest" class="btn-primary-lg">Record harvest</a>
    </div>
</div>

<!-- STAT CARDS -->
<div class="row g-3 mb-4">
    @foreach (var s in Stats)
    {
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <span class="card-title">@s.Title</span>
                    <div class="stat-icon @s.IconClass"><i class="bi @s.Icon"></i></div>
                </div>
                <div class="mt-3">
                    <div class="card-value">@s.Value</div>
                    <div class="text-muted small mt-1">@s.Note</div>
                </div>
            </div>
        </div>
    }
</div>

<!-- CHARTS -->
<div class="row g-3 mb-4">
    <div class="col-12 col-lg-8">
        <div class="card-box h-100">
            <div class="panel-title">Labor cost — last 7 days</div>
            <div class="panel-sub">Daily wage cost from work logs</div>

            <svg viewBox="0 0 640 300" class="w-100" role="img" aria-label="Labor cost last 7 days">
                @for (int i = 0; i <= 4; i++)
                {
                    var y = 20 + i * 60;
                    var val = LaborMax / 4 * (4 - i);
                    <g>
                        <line x1="56" x2="630" y1="@y" y2="@y" stroke="#E2E8F0" stroke-dasharray="3 4" />
                        <text x="48" y="@(y + 4)" text-anchor="end" font-size="11" fill="#64748B">@AxisLabel(val)</text>
                    </g>
                }
                @for (int i = 0; i < LaborDays.Count; i++)
                {
                    var d = LaborDays[i];
                    var slot = 574.0 / LaborDays.Count;
                    var bw = slot * 0.5;
                    var x = 56 + i * slot + (slot - bw) / 2;
                    var h = d.Amount <= 0 ? 0 : Math.Max(2, (double)d.Amount / LaborMax * 240);
                    <g>
                        @if (h > 0)
                        {
                            <rect x="@F(x)" y="@F(260 - h)" width="@F(bw)" height="@F(h)" rx="6" fill="#62A834" />
                        }
                        <text x="@F(56 + i * slot + slot / 2)" y="282" text-anchor="middle" font-size="12" fill="#475569">@d.Label</text>
                    </g>
                }
            </svg>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card-box h-100">
            <div class="panel-title">Workforce by skill</div>
            <div class="panel-sub">Where your workers are strongest</div>

            <div class="d-flex justify-content-center my-4">
                <svg viewBox="0 0 200 200" width="240" height="240" role="img" aria-label="Workforce by skill">
                    @foreach (var seg in DonutSegments)
                    {
                        <circle cx="100" cy="100" r="@F(Radius)" fill="none" stroke="@seg.Color" stroke-width="32"
                                stroke-dasharray="@seg.Dash" stroke-dashoffset="@seg.Offset"
                                transform="rotate(-90 100 100)" />
                    }
                </svg>
            </div>

            <div class="d-flex justify-content-center gap-3 small text-muted flex-wrap">
                @foreach (var k in Skills)
                {
                    <span><span class="legend-dot" style="background:@k.Color"></span>@k.Name</span>
                }
            </div>
        </div>
    </div>
</div>

<!-- ASSIGNMENTS + HARVEST LOTS -->
<div class="row g-3 mb-4">
    <div class="col-12 col-lg-6">
        <div class="panel h-100">
            <div class="panel-head d-flex justify-content-between align-items-start gap-2">
                <div>
                    <div class="panel-title">Open work assignments</div>
                    <div class="panel-sub mb-0">Pending and ongoing tasks</div>
                </div>
                <a href="work-assignments" class="btn-pill">All assignments</a>
            </div>
            <div class="table-wrap">
                <table class="table data-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Worker</th>
                            <th>Task</th>
                            <th>Plot</th>
                            <th>Assigned</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in OpenAssignments)
                        {
                            <tr>
                                <td class="col-worker">@a.Worker</td>
                                <td class="col-task">@a.Task</td>
                                <td class="col-plot">@a.Plot</td>
                                <td class="col-date">@a.Assigned.ToString("MMM d, yyyy", Inv)</td>
                                <td><span class="pill @(a.Status == "Ongoing" ? "pill-green" : "pill-yellow")">@a.Status</span></td>
                            </tr>
                        }
                        @if (OpenAssignments.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">No open assignments.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="panel h-100">
            <div class="panel-head d-flex justify-content-between align-items-start gap-2">
                <div>
                    <div class="panel-title">Harvest lots to approve</div>
                    <div class="panel-sub mb-0">Approved lots post into produce stock</div>
                </div>
                <a href="harvest" class="btn-pill">Harvest recording</a>
            </div>

            @if (PendingHarvests.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon"><i class="bi bi-inbox"></i></div>
                    <div class="fw-semibold">Nothing awaiting approval</div>
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table data-table align-middle mb-0">
                        <thead>
                            <tr><th>Lot</th><th>Crop</th><th>Quantity</th><th>Grade</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var h in PendingHarvests)
                            {
                                <tr>
                                    <td class="text-nowrap">@h.Lot</td>
                                    <td>@h.Crop</td>
                                    <td class="text-nowrap">@h.Kg kg</td>
                                    <td>@h.Grade</td>
                                    <td class="text-end">
                                        <button type="button" class="btn-pill" @onclick="() => ApproveHarvest(h.Id)">Approve</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- RECENT WORK LOGS -->
<div class="panel mb-4">
    <div class="panel-head d-flex justify-content-between align-items-start gap-2">
        <div>
            <div class="panel-title">Recent attendance and work logs</div>
            <div class="panel-sub mb-0">Latest recorded work days</div>
        </div>
        <i class="bi bi-clipboard-check head-icon"></i>
    </div>
    <div class="table-wrap">
        <table class="table data-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Worker</th>
                    <th>Date</th>
                    <th>Task</th>
                    <th>Hours</th>
                    <th>Plot</th>
                    <th>Cost</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in RecentLogs)
                {
                    <tr>
                        <td class="text-nowrap">@l.Worker</td>
                        <td class="text-nowrap">@l.Date.ToString("MMM d, yyyy", Inv)</td>
                        <td class="col-log-task">@l.Task</td>
                        <td>@l.Hours</td>
                        <td class="text-nowrap">@l.Plot</td>
                        <td class="text-nowrap">@Peso(l.Cost)</td>
                        <td><span class="pill @(l.Status == "Approved" ? "pill-green" : "pill-gray")">@l.Status</span></td>
                        <td class="text-end">
                            @if (l.Status != "Approved")
                            {
                                <button type="button" class="btn-pill" @onclick="() => ApproveLog(l.Id)">Approve</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    // ---------- MODELS ----------
    record Stat(string Title, string Value, string Note, string Icon, string IconClass);
    record DayAmt(DateTime Date, decimal Amount)
    {
        public string Label => Date.ToString("ddd", CultureInfo.InvariantCulture);
    }
    record WorkerRec(string Name, string Skill, bool Active);
    record AssignRec(int Id, string Worker, string Task, string Plot, DateTime Assigned, string Status);
    record WorkLog(int Id, string Worker, DateTime Date, string Task, int Hours, string Plot, decimal Cost, string Status);
    record HarvestLot(int Id, string Lot, string Crop, int Kg, string Grade, bool Approved);
    record SkillRow(string Name, string Color);
    record Segment(string Color, string Dash, string Offset);

    static readonly CultureInfo Inv = CultureInfo.InvariantCulture;
    const double Radius = 70;
    static readonly double Circ = 2 * Math.PI * Radius;

    // ---------- FILTER STATE ----------
    string business = "Verdant Agri Ventures";
    string branch = "North Field Branch";

    static readonly string[] BusinessNames =
    {
        "Sunrise Rice Farmers Coop", "Green Valley Farms", "Verdant Agri Ventures",
        "Harvest Hills Agri Corp", "Bicol River Organic Growers",
    };

    // TODO: kuhaa sa database ang branches kada business
    static readonly Dictionary<string, string[]> BranchesByBusiness = new()
    {
        ["Verdant Agri Ventures"] = new[] { "North Field Branch", "South Valley Branch", "Central Packing Branch" },
    };

    string[] CurrentBranches =>
        BranchesByBusiness.TryGetValue(business, out var b) ? b : new[] { "Main Branch" };

    void OnBusinessChanged() => branch = CurrentBranches[0];

    // ---------- TEMPORARY DATA (North Field Branch, ilisi sa database later) ----------
    readonly List<WorkerRec> workers = new()
    {
        new("Ernesto Bacani", "Irrigation", true),
        new("Ronnie Aquino", "Spraying", true),
        new("Jomar Salvador", "Harvesting", true),
        new("Lito Marasigan", "Planting", true),
    };

    // Order sa legend (parehas sa screenshot)
    static readonly SkillRow[] Skills =
    {
        new("Spraying", "#1F6B3B"), new("Planting", "#62A834"), new("Harvesting", "#92D050"), new("Irrigation", "#A86B4C"),
    };

    // Order sa pag-drawing sa donut, clockwise gikan sa taas (parehas sa screenshot)
    static readonly string[] DonutOrder = { "Spraying", "Irrigation", "Harvesting", "Planting" };

    readonly List<AssignRec> assignments = new()
    {
        new(1, "Ernesto Bacani", "Irrigation scheduling and canal check", "North Plot A", new(2026, 10, 24), "Ongoing"),
        new(2, "Ronnie Aquino",  "Pest monitoring and spraying",          "North Plot B", new(2026, 10, 24), "Ongoing"),
        new(3, "Jomar Salvador", "Harvest preparation — sacks and twine", "North Plot A", new(2026, 10, 23), "Pending"),
        new(4, "Lito Marasigan", "Land preparation for next vegetable cycle", "North Plot C", new(2026, 10, 22), "Pending"),
    };

    // Walay logs karong bulana (Nov), mao nga 0 hours ug ₱0.00 sa stat cards
    List<WorkLog> workLogs = new()
    {
        new(1, "Ernesto Bacani", new(2026, 10, 24), "Irrigation scheduling", 8, "North Plot A", 500, "Recorded"),
        new(2, "Jomar Salvador", new(2026, 10, 24), "Harvest preparation",   8, "North Plot A", 400, "Recorded"),
        new(3, "Lito Marasigan", new(2026, 10, 23), "Land preparation",      8, "North Plot C", 400, "Recorded"),
        new(4, "Ronnie Aquino",  new(2026, 10, 23), "Pest monitoring",       8, "North Plot B", 450, "Approved"),
        new(5, "Ernesto Bacani", new(2026, 10, 22), "Canal check",           8, "North Plot A", 500, "Approved"),
        new(6, "Jomar Salvador", new(2026, 10, 22), "Sack and twine prep",   6, "North Plot A", 300, "Approved"),
    };

    // 2 ka harvest records, parehas na-approve na (0 awaiting)
    List<HarvestLot> harvests = new()
    {
        new(1, "LOT-004", "Rice", 320, "Grade A", true),
        new(2, "LOT-005", "Corn", 210, "Grade A", true),
    };

    // ---------- COMPUTED ----------
    List<AssignRec> OpenAssignments => assignments.OrderByDescending(a => a.Assigned).ToList();
    List<WorkLog> RecentLogs => workLogs.OrderByDescending(l => l.Date).ThenBy(l => l.Id).Take(6).ToList();
    List<HarvestLot> PendingHarvests => harvests.Where(h => !h.Approved).ToList();

    List<DayAmt> LaborDays
    {
        get
        {
            var today = DateTime.Today;
            return Enumerable.Range(0, 7)
                .Select(i => today.AddDays(i - 6))
                .Select(d => new DayAmt(d, workLogs.Where(l => l.Date.Date == d).Sum(l => l.Cost)))
                .ToList();
        }
    }

    // Axis: minimum 4 (₱0-₱4), kung naay data i-round up sa 4,000
    double LaborMax
    {
        get
        {
            var max = (double)LaborDays.Max(d => d.Amount);
            return max <= 4 ? 4 : Math.Ceiling(max / 4000) * 4000;
        }
    }

    List<Segment> DonutSegments
    {
        get
        {
            var list = new List<Segment>();
            var total = Math.Max(1, workers.Count);
            double offset = 0;
            foreach (var name in DonutOrder)
            {
                var count = workers.Count(w => w.Skill == name);
                if (count == 0) continue;
                var color = Skills.First(k => k.Name == name).Color;
                var len = (double)count / total * Circ;
                var dash = Math.Max(len - 2, 0.5);
                list.Add(new Segment(color, F(dash) + " " + F(Circ - dash), F(-offset)));
                offset += len;
            }
            return list;
        }
    }

    List<Stat> Stats
    {
        get
        {
            var now = DateTime.Today;
            var monthLogs = workLogs.Where(l => l.Date.Year == now.Year && l.Date.Month == now.Month).ToList();
            var todayLogs = workLogs.Count(l => l.Date.Date == now);

            return new()
            {
                new("ACTIVE WORKERS", workers.Count(w => w.Active).ToString(), workers.Count + " on record", "bi-person-workspace", ""),
                new("HOURS LOGGED THIS MONTH", monthLogs.Sum(l => l.Hours).ToString(), todayLogs + (todayLogs == 1 ? " log today" : " logs today"), "bi-clock", "stat-icon-info"),
                new("LABOR COST THIS MONTH", Peso(monthLogs.Sum(l => l.Cost)), "Based on logged work days", "bi-coin", "stat-icon-plain stat-icon-brown"),
                new("HARVESTS AWAITING APPROVAL", PendingHarvests.Count.ToString(), harvests.Count + " harvest records", "bi-flower1", ""),
            };
        }
    }

    // ---------- ACTIONS ----------
    // TODO: i-save sa database ug i-log sa Audit Trail
    void ApproveLog(int id)
    {
        var i = workLogs.FindIndex(l => l.Id == id);
        if (i >= 0) workLogs[i] = workLogs[i] with { Status = "Approved" };
    }

    void ApproveHarvest(int id)
    {
        var i = harvests.FindIndex(h => h.Id == id);
        if (i >= 0) harvests[i] = harvests[i] with { Approved = true };
    }

    // ---------- HELPERS ----------
    static string F(double d) => d.ToString("0.##", Inv);
    static string Peso(decimal v) => "₱" + v.ToString("N2", Inv);

    static string AxisLabel(double v) =>
        v >= 1000 ? "₱" + (v / 1000).ToString("0.#", Inv) + "K" : "₱" + v.ToString("0", Inv);
}