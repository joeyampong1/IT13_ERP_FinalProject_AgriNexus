@page "/audit"
@using System.Globalization

<div class="mb-4">
    <h2 class="page-title">Financial Audit Trail</h2>
    <p class="text-muted mb-0 page-sub">Trace of financial and operational actions affecting this business’s records.</p>
</div>

<!-- TOOLBAR -->
<div class="toolbar mb-3">
    <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="text" placeholder="Search actor, module or detail..." @bind="searchText" @bind:event="oninput" />
    </div>

    <select class="filter-select" @bind="actionFilter">
        <option value="">All actions</option>
        @foreach (var a in ActionOptions)
        {
            <option value="@a">@a</option>
        }
    </select>

    <span class="text-muted small">@Filtered.Count @(Filtered.Count == 1 ? "entry" : "entries")</span>
</div>

<!-- TABLE -->
<div class="panel">
    <div class="table-wrap">
        <table class="table log-table align-middle mb-0">
            <thead>
                <tr>
                    <th>When</th>
                    <th>Actor</th>
                    <th>Action</th>
                    <th>Module</th>
                    <th>Record</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Filtered)
                {
                    <tr>
                        <td class="when">@l.When.ToString("MMM d, yyyy, h:mm tt", Inv)</td>
                        <td class="col-actor">
                            <div class="fw-semibold">@l.Actor</div>
                            <div class="sub">@l.Role</div>
                        </td>
                        <td><span class="pill">@l.Action</span></td>
                        <td class="col-module">@l.Module</td>
                        <td class="record">@l.Record</td>
                        <td class="details">@l.Details</td>
                    </tr>
                }
                @if (Filtered.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-5">No matching entries.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    // ---------- MODEL ----------
    record LogEntry(DateTime When, string Actor, string Role, string Action, string Module, string Record, string Details);

    static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    // Fixed nga listahan sa actions (parehas sa prototype), dili depende sa data
    static readonly string[] ActionOptions = { "Create", "Update", "Delete", "Approve", "Payment", "Login", "Config" };

    // ---------- STATE ----------
    string searchText = "";
    string actionFilter = "";

    // ---------- TEMPORARY DATA (ilisi sa database later) ----------
    // Tenant-level ni: mga aksyon sa sulod sa negosyo (dili sa platform).
    // Ang 9 ka entries kay gikan sa prototype; ang 3 (Login, Delete, Payment) akong gi-dugang.
    readonly List<LogEntry> logs = new()
    {
        new(new(2026, 10, 24, 10, 41, 0), "Paolo Gutierrez",   "Sales Cashier",       "Payment", "Payments & Collections", "SO-0013",     "Posted cash collection of ₱2,600.00"),
        new(new(2026, 10, 24, 9, 20, 0),  "Allan Mercado",     "Inventory Officer",   "Update",  "Stock Movements",        "ADJ-0044",    "Adjusted insecticide balance to 2 bottles after physical count"),
        new(new(2026, 10, 23, 8, 50, 0),  "Ramon Delos Santos", "Branch Manager",     "Create",  "Work Assignments",       "ASG-0114",    "Assigned harvest preparation to Jomar Salvador"),
        new(new(2026, 10, 22, 14, 10, 0), "Marilou Pangan",    "Labor Harvest Officer", "Create", "Harvest Recording",      "LOT-006",     "Recorded 140 kg ampalaya (Grade B) pending approval"),
        new(new(2026, 10, 22, 9, 15, 0),  "Cristina Yabut",    "Inventory Officer",   "Create",  "Stock Receiving",        "DR-21098",    "Received 200 empty sacks from Central Luzon Agri Supply"),
        new(new(2026, 10, 21, 11, 35, 0), "Bernardo Ocampo",   "Accountant",          "Approve", "Expense Management",     "EXP-0031",    "Approved canal clearing and dike repair expense"),
        new(new(2026, 10, 20, 17, 30, 0), "Maria L. Santos",   "Business Owner",      "Config",  "Staff & Permissions",    "STAFF-008",   "Suspended staff access for Noel Bautista pending review"),
        new(new(2026, 10, 20, 16, 2, 0),  "Liza Fernandez",    "Branch Manager",      "Create",  "Cash Drawer",            "CS-2026-10-21", "Recorded bank deposit of ₱9,000.00 from previous collection"),
        new(new(2026, 10, 19, 15, 45, 0), "Bernardo Ocampo",   "Accountant",          "Update",  "Production Costing",     "COST-Q4",     "Allocated shared supplies cost by planted area"),
        new(new(2026, 10, 18, 8, 5, 0),   "Maria L. Santos",   "Business Owner",      "Login",   "Platform",               "",            "Signed in from Cabanatuan City, Nueva Ecija"),
        new(new(2026, 10, 17, 14, 20, 0), "Bernardo Ocampo",   "Accountant",          "Delete",  "Expense Management",     "EXP-0027",    "Removed duplicate fuel expense entry before approval"),
        new(new(2026, 10, 16, 13, 15, 0), "Jhoanna Reyes",     "Sales Cashier",       "Payment", "Payments & Collections", "SO-0010",     "Posted GCash collection of ₱2,860.00"),
    };

    // ---------- COMPUTED ----------
    List<LogEntry> Filtered => logs
        .Where(l => string.IsNullOrEmpty(actionFilter) || l.Action == actionFilter)
        .Where(l => string.IsNullOrWhiteSpace(searchText)
            || l.Actor.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || l.Module.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || l.Details.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || l.Record.Contains(searchText, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(l => l.When)
        .ToList();
}