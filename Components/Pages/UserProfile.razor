@page "/profile"
@layout MainLayout
@inject AgriNexus.Services.AuthService Auth
@inject AgriNexus.DataLayer.AgriNexusDbContext DbContext
@inject NavigationManager NavManager
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using AgriNexus.DataLayer.Models

<div class="container-fluid py-2">
    <!-- PAGE HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bolder mb-1" style="color: #0A2B1D; letter-spacing: -0.5px;">My Profile</h2>
            <p class="text-muted small mb-0">Customize your profile photo, personal details, and account security.</p>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-success" role="status"></div>
            <p class="text-muted small mt-2">Loading profile...</p>
        </div>
    }
    else if (currentUser != null)
    {
        <div class="row g-4">
            <!-- LEFT COLUMN: Modern Profile Card with Photo Upload -->
            <div class="col-12 col-lg-4">
                <div class="card profile-card border-0 rounded-4 shadow-sm overflow-hidden h-100">
                    <!-- Forest Gradient Banner -->
                    <div class="profile-banner position-relative">
                        <div class="banner-grid"></div>
                    </div>

                    <div class="card-body text-center px-4 pb-4" style="margin-top: -54px; position: relative; z-index: 2;">
                        <!-- Interactive Avatar with Camera Badge -->
                        <div class="avatar-wrapper mx-auto position-relative">
                            @if (!string.IsNullOrEmpty(profileImagePreview))
                            {
                                <img src="@profileImagePreview" alt="Profile Photo" class="profile-avatar-img shadow" />
                            }
                            else
                            {
                                <div class="profile-avatar shadow">
                                    @GetInitials()
                                </div>
                            }

                            <!-- Hidden File Input + Camera Trigger Button -->
                            <label for="avatarUpload" class="avatar-upload-btn shadow-sm" title="Change Profile Photo">
                                <i class="bi bi-camera-fill"></i>
                            </label>
                            <InputFile id="avatarUpload" OnChange="HandleImageUploadAsync" accept=".jpg,.jpeg,.png,.webp" class="d-none" />
                        </div>

                        <!-- Photo Actions -->
                        <div class="mt-2 d-flex justify-content-center gap-2">
                            <label for="avatarUpload" class="btn btn-sm btn-light border rounded-pill px-3 fw-semibold text-dark" style="font-size: 0.75rem; cursor: pointer;">
                                <i class="bi bi-upload me-1 text-success"></i> Upload Photo
                            </label>
                            @if (!string.IsNullOrEmpty(profileImagePreview))
                            {
                                <button type="button" class="btn btn-sm btn-light border rounded-pill px-3 fw-semibold text-danger" style="font-size: 0.75rem;" @onclick="RemovePhoto">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(imageError))
                        {
                            <div class="text-danger small mt-2 fw-medium">@imageError</div>
                        }

                        <h4 class="fw-bolder mt-3 mb-1" style="color: #0A2B1D;">
                            @currentUser.FName @(string.IsNullOrWhiteSpace(currentUser.MName) ? "" : currentUser.MName + " ")@currentUser.LName
                        </h4>
                        <p class="text-muted small mb-3">@currentUser.Email</p>

                        <div class="d-flex justify-content-center gap-2 flex-wrap mb-4">
                            <span class="badge rounded-pill px-3 py-2 fw-bold" style="background-color: #E8F3EC; color: #1B5E34; border: 1px solid #C6DFCE;">
                                <i class="bi bi-shield-lock-fill me-1"></i> @currentUser.Role
                            </span>
                            <span class="badge rounded-pill px-3 py-2 fw-bold @(currentUser.Status == "Active" ? "bg-success bg-opacity-10 text-success" : "bg-secondary bg-opacity-10 text-secondary")">
                                <i class="bi bi-circle-fill me-1" style="font-size: 0.55rem;"></i> @currentUser.Status
                            </span>
                        </div>

                        <hr class="opacity-15 my-3" />

                        <!-- Account Metadata -->
                        <div class="text-start small d-flex flex-column gap-3 mt-3">
                            @if (currentUser.Business != null)
                            {
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted"><i class="bi bi-building me-2 text-success"></i>Business</span>
                                    <span class="fw-bold text-dark">@currentUser.Business.BusinessName</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(assignedBranchName))
                            {
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted"><i class="bi bi-shop me-2 text-success"></i>Assigned Branch</span>
                                    <span class="fw-bold text-dark">@assignedBranchName</span>
                                </div>
                            }
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted"><i class="bi bi-telephone me-2 text-success"></i>Contact No.</span>
                                <span class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(currentUser.ContactNumber) ? "Not set" : currentUser.ContactNumber)</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted"><i class="bi bi-calendar-check me-2 text-success"></i>Member Since</span>
                                <span class="fw-semibold text-dark">@currentUser.CreatedAt.ToString("MMM dd, yyyy")</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN: Edit Details & Change Password -->
            <div class="col-12 col-lg-8 d-flex flex-column gap-4">

                <!-- 1. PERSONAL INFORMATION CARD -->
                <div class="card profile-card border-0 rounded-4 shadow-sm">
                    <div class="card-body p-4 p-md-5">
                        <div class="d-flex align-items-center gap-2 mb-4 pb-2 border-bottom">
                            <div class="section-icon">
                                <i class="bi bi-person-vcard-fill"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0" style="color: #0A2B1D;">Personal Information</h5>
                                <small class="text-muted">Update your name, profile picture, email address, and mobile number.</small>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(profileSuccess))
                        {
                            <div class="alert border-0 p-3 small rounded-3 mb-4" style="background-color: #ECFDF5; color: #065F46; border-left: 4px solid #10B981 !important;">
                                <i class="bi bi-check-circle-fill me-2 text-success"></i> @profileSuccess
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(profileError))
                        {
                            <div class="alert alert-danger border-0 p-3 small rounded-3 mb-4">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i> @profileError
                            </div>
                        }

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label fw-bold small text-muted">First Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control profile-input" @bind="fName" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold small text-muted">Middle Name</label>
                                <input type="text" class="form-control profile-input" placeholder="Optional" @bind="mName" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold small text-muted">Last Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control profile-input" @bind="lName" />
                            </div>

                            <div class="col-md-6 mt-3">
                                <label class="form-label fw-bold small text-muted">Email Address <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-success"></i></span>
                                    <input type="email" class="form-control profile-input border-start-0" @bind="email" />
                                </div>
                            </div>

                            <div class="col-md-6 mt-3">
                                <label class="form-label fw-bold small text-muted">Contact Number</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-telephone text-success"></i></span>
                                    <input type="tel"
                                           inputmode="numeric"
                                           maxlength="13"
                                           class="form-control profile-input border-start-0"
                                           @bind="contactNumber"
                                           @bind:event="oninput"
                                           @bind:after="FormatContactNumber"
                                           placeholder="09XX XXX XXXX"
                                           spellcheck="false" />
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-4 pt-2">
                            <button type="button" class="btn btn-agrinexus-primary px-4 py-2 fw-bold rounded-3 shadow-sm"
                                    @onclick="SaveProfileAsync" disabled="@isSavingProfile">
                                @if (isSavingProfile)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <span><i class="bi bi-check2-circle me-2"></i>Save Changes</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>

                <!-- 2. SECURITY / CHANGE PASSWORD CARD -->
                <div class="card profile-card border-0 rounded-4 shadow-sm">
                    <div class="card-body p-4 p-md-5">
                        <div class="d-flex align-items-center gap-2 mb-4 pb-2 border-bottom">
                            <div class="section-icon">
                                <i class="bi bi-shield-lock-fill"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0" style="color: #0A2B1D;">Change Password</h5>
                                <small class="text-muted">Ensure your account stays secure with a strong password.</small>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(passwordSuccess))
                        {
                            <div class="alert border-0 p-3 small rounded-3 mb-4" style="background-color: #ECFDF5; color: #065F46; border-left: 4px solid #10B981 !important;">
                                <i class="bi bi-check-circle-fill me-2 text-success"></i> @passwordSuccess
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(passwordError))
                        {
                            <div class="alert alert-danger border-0 p-3 small rounded-3 mb-4">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i> @passwordError
                            </div>
                        }

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label fw-bold small text-muted">Current Password</label>
                                <input type="password" class="form-control profile-input" placeholder="••••••••" @bind="currentPassword" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold small text-muted">New Password</label>
                                <input type="password" class="form-control profile-input" placeholder="••••••••" @bind="newPassword" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold small text-muted">Confirm New Password</label>
                                <input type="password" class="form-control profile-input" placeholder="••••••••" @bind="confirmNewPassword" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-4 pt-2">
                            <button type="button" class="btn btn-outline-success fw-bold px-4 py-2 rounded-3"
                                    @onclick="ChangePasswordAsync" disabled="@isSavingPassword">
                                @if (isSavingPassword)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Updating...</span>
                                }
                                else
                                {
                                    <span><i class="bi bi-key-fill me-2"></i>Update Password</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    }
</div>

@code {
    private User? currentUser;
    private string? assignedBranchName;
    private bool isLoading = true;

    // Profile Photo State
    private string? profileImagePreview;
    private string imageError = "";

    // Personal Info Fields
    private string fName = "";
    private string mName = "";
    private string lName = "";
    private string email = "";
    private string contactNumber = "";
    private bool isSavingProfile = false;
    private string profileSuccess = "";
    private string profileError = "";

    // Password Fields
    private string currentPassword = "";
    private string newPassword = "";
    private string confirmNewPassword = "";
    private bool isSavingPassword = false;
    private string passwordSuccess = "";
    private string passwordError = "";

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated && Auth.CurrentUserId <= 0 && string.IsNullOrWhiteSpace(Auth.CurrentUserName))
        {
            NavManager.NavigateTo("/login");
            return;
        }

        if (Auth.CurrentUserId > 0)
        {
            currentUser = await DbContext.Users
                .Include(u => u.Business)
                .FirstOrDefaultAsync(u => u.UserId == Auth.CurrentUserId);
        }
        else if (!string.IsNullOrWhiteSpace(Auth.CurrentUserEmail))
        {
            var cleanEmail = Auth.CurrentUserEmail.Trim().ToLower();
            currentUser = await DbContext.Users
                .Include(u => u.Business)
                .FirstOrDefaultAsync(u => u.Email != null && u.Email.ToLower() == cleanEmail);
        }
        else
        {
            var cleanName = (Auth.CurrentUserName ?? "").Trim();
            currentUser = await DbContext.Users
                .Include(u => u.Business)
                .FirstOrDefaultAsync(u =>
                    (((u.FName ?? "") + " " + (u.MName ?? "") + " " + (u.LName ?? "")).Replace("  ", " ").Trim() == cleanName) ||
                    (((u.FName ?? "") + " " + (u.LName ?? "")).Trim() == cleanName));
        }

        if (currentUser != null)
        {
            fName = currentUser.FName;
            mName = currentUser.MName ?? "";
            lName = currentUser.LName;
            email = currentUser.Email;
            contactNumber = currentUser.ContactNumber ?? "";
            profileImagePreview = currentUser.ProfileImage;

            if (currentUser.BranchId != null)
            {
                var branch = await DbContext.Branches.FindAsync(currentUser.BranchId);
                assignedBranchName = branch?.BranchName;
            }
        }

        isLoading = false;
    }

    private string GetInitials()
    {
        if (currentUser == null) return "U";
        char first = !string.IsNullOrWhiteSpace(currentUser.FName) ? char.ToUpper(currentUser.FName[0]) : 'U';
        char last = !string.IsNullOrWhiteSpace(currentUser.LName) ? char.ToUpper(currentUser.LName[0]) : ' ';
        return $"{first}{last}".Trim();
    }

    private async Task HandleImageUploadAsync(InputFileChangeEventArgs e)
    {
        imageError = "";
        var file = e.File;
        if (file == null) return;

        const long maxFileSize = 2 * 1024 * 1024;
        if (file.Size > maxFileSize)
        {
            imageError = "Image must be smaller than 2MB.";
            return;
        }

        try
        {
            var resizedImage = await file.RequestImageFileAsync("image/jpeg", 300, 300);
            using var stream = resizedImage.OpenReadStream(maxFileSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            var base64 = Convert.ToBase64String(ms.ToArray());
            profileImagePreview = $"data:image/jpeg;base64,{base64}";
        }
        catch (Exception ex)
        {
            imageError = "Could not load image: " + ex.Message;
        }
    }

    private void RemovePhoto()
    {
        profileImagePreview = null;
        imageError = "";
    }

    private void FormatContactNumber()
    {
        if (string.IsNullOrEmpty(contactNumber)) return;

        // 1. Extract digits only (strip letters and symbols)
        var digits = new string(contactNumber.Where(char.IsDigit).ToArray());

        if (string.IsNullOrEmpty(digits))
        {
            contactNumber = "";
            return;
        }

        // 2. Smart prefix handling (+63 / 63 or 9 -> 09)
        if (digits.StartsWith("63") && digits.Length > 2)
        {
            digits = "0" + digits.Substring(2);
        }
        else if (digits.StartsWith("9"))
        {
            digits = "0" + digits;
        }

        // 3. Limit to 11 digits
        if (digits.Length > 11)
        {
            digits = digits.Substring(0, 11);
        }

        // 4. Auto-format to "09XX XXX XXXX"
        if (digits.Length > 7)
        {
            contactNumber = $"{digits.Substring(0, 4)} {digits.Substring(4, 3)} {digits.Substring(7)}";
        }
        else if (digits.Length > 4)
        {
            contactNumber = $"{digits.Substring(0, 4)} {digits.Substring(4)}";
        }
        else
        {
            contactNumber = digits;
        }
    }

    private async Task SaveProfileAsync()
    {
        profileSuccess = "";
        profileError = "";

        if (currentUser == null) return;

        if (string.IsNullOrWhiteSpace(fName) || string.IsNullOrWhiteSpace(lName) || string.IsNullOrWhiteSpace(email))
        {
            profileError = "First Name, Last Name, and Email Address are required.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(contactNumber))
        {
            var rawContact = new string(contactNumber.Where(char.IsDigit).ToArray());
            if (rawContact.Length != 11)
            {
                profileError = "Contact number must be a valid 11-digit mobile number (e.g., 09XX XXX XXXX).";
                return;
            }
        }

        isSavingProfile = true;

        try
        {
            if (!string.Equals(currentUser.Email, email.Trim(), StringComparison.OrdinalIgnoreCase))
            {
                bool emailTaken = await DbContext.Users.AnyAsync(u => u.Email == email.Trim() && u.UserId != currentUser.UserId);
                if (emailTaken)
                {
                    profileError = "That email address is already used by another account.";
                    return;
                }
            }

            currentUser.FName = fName.Trim();
            currentUser.MName = mName.Trim();
            currentUser.LName = lName.Trim();
            currentUser.Email = email.Trim();
            currentUser.ContactNumber = contactNumber.Trim();
            currentUser.ProfileImage = profileImagePreview;

            DbContext.Users.Update(currentUser);
            await DbContext.SaveChangesAsync();

            Auth.Login(currentUser);
            profileSuccess = "Your profile and photo have been updated successfully.";
        }
        catch (Exception ex)
        {
            profileError = "Failed to update profile: " + ex.Message;
        }
        finally
        {
            isSavingProfile = false;
        }
    }

    private async Task ChangePasswordAsync()
    {
        passwordSuccess = "";
        passwordError = "";

        if (currentUser == null) return;

        if (string.IsNullOrWhiteSpace(currentPassword) || string.IsNullOrWhiteSpace(newPassword) || string.IsNullOrWhiteSpace(confirmNewPassword))
        {
            passwordError = "Please fill in all password fields.";
            return;
        }

        if (currentUser.PasswordHash != currentPassword)
        {
            passwordError = "Your current password is incorrect.";
            return;
        }

        if (newPassword.Length < 6)
        {
            passwordError = "New password must be at least 6 characters long.";
            return;
        }

        if (newPassword != confirmNewPassword)
        {
            passwordError = "New password and confirmation do not match.";
            return;
        }

        isSavingPassword = true;

        try
        {
            currentUser.PasswordHash = newPassword;
            currentUser.IsTempPassword = false;
            DbContext.Users.Update(currentUser);
            await DbContext.SaveChangesAsync();

            currentPassword = "";
            newPassword = "";
            confirmNewPassword = "";
            passwordSuccess = "Password updated successfully.";
        }
        catch (Exception ex)
        {
            passwordError = "Failed to update password: " + ex.Message;
        }
        finally
        {
            isSavingPassword = false;
        }
    }
}