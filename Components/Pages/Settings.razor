@page "/settings"
@layout MainLayout
@inject AgriNexus.Services.AuthService Auth
@inject NavigationManager Nav

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <h2 class="page-title"><i class="bi bi-sliders2 text-success me-2"></i>Settings</h2>
        <p class="text-muted mb-0 page-sub">Manage your session security, notifications, and system preferences for your role.</p>
    </div>

    @if (Auth.CurrentRole == AgriNexus.Services.UserRole.TenantAdmin)
    {
        <button type="button" class="btn-outline-brand" @onclick='() => Nav.NavigateTo("/business-settings")'>
            <i class="bi bi-building-gear me-1"></i> Full Business Profile
        </button>
    }
</div>

<div class="settings-layout">

    <!-- LEFT: TAB NAV -->
    <aside class="settings-nav">
        <div class="role-chip mb-2">
            <i class="bi bi-person-check-fill text-success"></i>
            <span>@RoleDisplayName</span>
        </div>

        @foreach (var t in Tabs)
        {
            <button type="button" class="settings-tab @(activeTab == t.Key ? "active" : "")" @onclick="() => SetTab(t.Key)">
                <i class="bi @t.Icon"></i>
                <span>@t.Label</span>
            </button>
        }

        <div class="nav-divider"></div>

        @if (Auth.CurrentRole == AgriNexus.Services.UserRole.TenantAdmin)
        {
            <button type="button" class="settings-tab" @onclick='() => Nav.NavigateTo("/business-settings")'>
                <i class="bi bi-building-gear"></i>
                <span>Business Profile Page</span>
                <i class="bi bi-box-arrow-up-right ms-auto small opacity-75"></i>
            </button>
        }

        <a href="/profile" class="settings-tab text-decoration-none">
            <i class="bi bi-person-badge"></i>
            <span>Edit Personal Profile</span>
        </a>
    </aside>

    <!-- RIGHT: CONTENT -->
    <section class="settings-content">

        @if (!string.IsNullOrEmpty(toast))
        {
            <div class="toast-note shadow-sm">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <span>@toast</span>
            </div>
        }

        <!-- ================= SECURITY & SESSION ================= -->
        @if (activeTab == "security")
        {
            <div class="card-box">
                <div class="card-head d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <div class="panel-title"><i class="bi bi-shield-lock-fill text-success me-2"></i>Session &amp; Account Protection</div>
                        <div class="panel-sub mb-0">Control sign-in verification and automatic session timeouts.</div>
                    </div>
                    <span class="pill pill-forest"><i class="bi bi-lock-fill me-1"></i>Security</span>
                </div>

                <div class="toggle-row">
                    <div>
                        <div class="fw-semibold" style="color: #0A2B1D;"><i class="bi bi-phone-vibrate text-success me-2"></i>Two-step verification</div>
                        <div class="sub">Ask for a verification code when signing in from a new device.</div>
                    </div>
                    <label class="switch"><input type="checkbox" @bind="twoStep" /><span class="slider"></span></label>
                </div>

                <div class="toggle-row">
                    <div>
                        <div class="fw-semibold" style="color: #0A2B1D;"><i class="bi bi-clock-history text-success me-2"></i>Auto sign-out when idle</div>
                        <div class="sub">Sign out automatically after 30 minutes of inactivity.</div>
                    </div>
                    <label class="switch"><input type="checkbox" @bind="autoSignOut" /><span class="slider"></span></label>
                </div>

                <div class="card-actions">
                    <button type="button" class="btn-save" @onclick='() => Toast("Security preferences saved.")'>
                        <i class="bi bi-check2-circle me-1"></i> Save changes
                    </button>
                </div>
            </div>
        }

        <!-- ================= NOTIFICATIONS ================= -->
        @if (activeTab == "notifications")
        {
            <div class="card-box">
                <div class="card-head d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <div class="panel-title"><i class="bi bi-bell-fill text-success me-2"></i>Notifications &amp; Localization</div>
                        <div class="panel-sub mb-0">Choose what alerts you receive and set your regional preferences.</div>
                    </div>
                    <span class="pill pill-forest"><i class="bi bi-globe-asia-australia me-1"></i>Preferences</span>
                </div>

                <div class="toggle-row">
                    <div>
                        <div class="fw-semibold" style="color: #0A2B1D;"><i class="bi bi-envelope-check text-success me-2"></i>Email notifications</div>
                        <div class="sub">Receive summaries and important alerts by email.</div>
                    </div>
                    <label class="switch"><input type="checkbox" @bind="notifEmail" /><span class="slider"></span></label>
                </div>

                <div class="toggle-row">
                    <div>
                        <div class="fw-semibold" style="color: #0A2B1D;"><i class="bi bi-arrow-repeat text-success me-2"></i>Synchronization alerts</div>
                        <div class="sub">Notify me when local offline data is pending cloud sync.</div>
                    </div>
                    <label class="switch"><input type="checkbox" @bind="notifSync" /><span class="slider"></span></label>
                </div>

                <div class="toggle-row">
                    <div>
                        <div class="fw-semibold" style="color: #0A2B1D;"><i class="bi bi-calendar-week text-success me-2"></i>Weekly summary</div>
                        <div class="sub">Receive an operational summary every Monday morning.</div>
                    </div>
                    <label class="switch"><input type="checkbox" @bind="notifWeekly" /><span class="slider"></span></label>
                </div>

                <div class="row g-3 mt-2">
                    <div class="col-md-6">
                        <label class="form-label"><i class="bi bi-translate text-success me-1"></i>Language</label>
                        <select class="form-select" @bind="language">
                            <option>English</option>
                            <option>Filipino</option>
                            <option>Bisaya</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label"><i class="bi bi-clock text-success me-1"></i>Time zone</label>
                        <select class="form-select" @bind="timezone">
                            <option>Asia/Manila (UTC+8)</option>
                        </select>
                    </div>
                </div>

                <div class="card-actions">
                    <button type="button" class="btn-save" @onclick='() => Toast("Notification preferences saved.")'>
                        <i class="bi bi-check2-circle me-1"></i> Save changes
                    </button>
                </div>
            </div>
        }

        <!-- ================= ROLE-SPECIFIC ================= -->
        @if (activeTab == "role")
        {
            <div class="card-box">
                <div class="card-head d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div>
                        <div class="panel-title"><i class="bi @RoleTab.Icon text-success me-2"></i>@RoleTab.Label</div>
                        <div class="panel-sub mb-0">@RoleTab.Description</div>
                    </div>
                    <span class="pill pill-earth">@RoleDisplayName</span>
                </div>

                @if (Auth.CurrentRole == AgriNexus.Services.UserRole.SuperAdmin)
                {
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label"><i class="bi bi-hourglass-split text-success me-1"></i>Default trial length (days)</label>
                            <input type="number" min="1" class="form-control" @bind="trialDays" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label"><i class="bi bi-arrow-repeat text-success me-1"></i>Sync check interval (minutes)</label>
                            <input type="number" min="1" class="form-control" @bind="syncMinutes" />
                        </div>
                    </div>
                    <div class="toggle-row mt-3">
                        <div>
                            <div class="fw-semibold" style="color: #0A2B1D;"><i class="bi bi-person-plus text-success me-2"></i>Allow new business registrations</div>
                            <div class="sub">When off, new tenants can only be created by a Super Admin.</div>
                        </div>
                        <label class="switch"><input type="checkbox" @bind="allowRegistration" /><span class="slider"></span></label>
                    </div>
                    <div class="toggle-row">
                        <div>
                            <div class="fw-semibold" style="color: #0A2B1D;"><i class="bi bi-wrench-adjustable text-success me-2"></i>Maintenance mode</div>
                            <div class="sub">Temporarily block tenant access while updating the platform.</div>
                        </div>
                        <label class="switch"><input type="checkbox" @bind="maintenance" /><span class="slider"></span></label>
                    </div>
                }
                else if (Auth.CurrentRole == AgriNexus.Services.UserRole.TenantAdmin)
                {
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label"><i class="bi bi-building text-success me-1"></i>Business name</label>
                            <input class="form-control" @bind="bizName" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label"><i class="bi bi-cash-coin text-success me-1"></i>Currency</label>
                            <select class="form-select" @bind="currency">
                                <option>PHP (₱)</option>
                                <option>USD ($)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label"><i class="bi bi-calendar3 text-success me-1"></i>Fiscal year starts</label>
                            <select class="form-select" @bind="fiscalMonth">
                                @foreach (var m in Months)
                                {
                                    <option>@m</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label"><i class="bi bi-telephone text-success me-1"></i>Contact number</label>
                            <input class="form-control" @bind="bizContact" />
                        </div>
                        <div class="col-12">
                            <label class="form-label"><i class="bi bi-geo-alt text-success me-1"></i>Business address</label>
                            <input class="form-control" @bind="bizAddress" />
                        </div>
                    </div>

                    <div class="mt-3 pt-3 border-top d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <span class="text-muted small">
                            <i class="bi bi-info-circle me-1"></i>Need more fields like Region/Province, Sync Mode, or Notes?
                        </span>
                        <button type="button" class="btn-outline-brand btn-sm" @onclick='() => Nav.NavigateTo("/business-settings")'>
                            <i class="bi bi-building-gear me-1"></i> Open Full Business Profile
                        </button>
                    </div>
                }
                else if (Auth.CurrentRole == AgriNexus.Services.UserRole.BranchManager)
                {
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label"><i class="bi bi-wallet2 text-success me-1"></i>Expense approval limit (₱)</label>
                            <input type="number" min="0" class="form-control" @bind="approvalLimit" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label"><i class="bi bi-exclamation-triangle text-success me-1"></i>Low stock alert level</label>
                            <input type="number" min="0" class="form-control" @bind="lowStock" />
                        </div>
                    </div>
                    <div class="toggle-row mt-3">
                        <div>
                            <div class="fw-semibold" style="color: #0A2B1D;"><i class="bi bi-check2-square text-success me-2"></i>Require approval for harvest lots</div>
                            <div class="sub">Harvest records stay pending until you approve them.</div>
                        </div>
                        <label class="switch"><input type="checkbox" @bind="requireHarvestApproval" /><span class="slider"></span></label>
                    </div>
                }
                else if (Auth.CurrentRole == AgriNexus.Services.UserRole.InventoryOfficer)
                {
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label"><i class="bi bi-exclamation-triangle text-success me-1"></i>Low stock alert level</label>
                            <input type="number" min="0" class="form-control" @bind="lowStock" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label"><i class="bi bi-rulers text-success me-1"></i>Default unit</label>
                            <select class="form-select" @bind="defaultUnit">
                                <option>pcs</option>
                                <option>kg</option>
                                <option>sack</option>
                                <option>bottle</option>
                                <option>liter</option>
                            </select>
                        </div>
                    </div>
                    <div class="toggle-row mt-3">
                        <div>
                            <div class="fw-semibold" style="color: #0A2B1D;"><i class="bi bi-clipboard-check text-success me-2"></i>Remind me about stock counts</div>
                            <div class="sub">Monthly reminder to do a physical count.</div>
                        </div>
                        <label class="switch"><input type="checkbox" @bind="countReminder" /><span class="slider"></span></label>
                    </div>
                }
                else if (Auth.CurrentRole == AgriNexus.Services.UserRole.LaborOfficer)
                {
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label"><i class="bi bi-sunrise text-success me-1"></i>Workday starts</label>
                            <input type="time" class="form-control" @bind="workStart" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label"><i class="bi bi-alarm text-success me-1"></i>Overtime after (hours)</label>
                            <input type="number" min="1" class="form-control" @bind="overtimeHours" />
                        </div>
                    </div>
                    <div class="toggle-row mt-3">
                        <div>
                            <div class="fw-semibold" style="color: #0A2B1D;"><i class="bi bi-flag text-success me-2"></i>Flag late arrivals</div>
                            <div class="sub">Mark workers as late if they log in after the start time.</div>
                        </div>
                        <label class="switch"><input type="checkbox" @bind="flagLate" /><span class="slider"></span></label>
                    </div>
                }
                else if (Auth.CurrentRole == AgriNexus.Services.UserRole.SalesOfficer)
                {
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label"><i class="bi bi-credit-card text-success me-1"></i>Default payment method</label>
                            <select class="form-select" @bind="defaultPayment">
                                <option>Cash</option>
                                <option>GCash</option>
                                <option>Bank transfer</option>
                                <option>On account</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label"><i class="bi bi-receipt text-success me-1"></i>Receipt footer note</label>
                            <input class="form-control" @bind="receiptNote" />
                        </div>
                    </div>
                    <div class="toggle-row mt-3">
                        <div>
                            <div class="fw-semibold" style="color: #0A2B1D;"><i class="bi bi-printer text-success me-2"></i>Print receipt after each sale</div>
                            <div class="sub">Open the print dialog automatically after saving a sale.</div>
                        </div>
                        <label class="switch"><input type="checkbox" @bind="autoPrint" /><span class="slider"></span></label>
                    </div>
                }
                else if (Auth.CurrentRole == AgriNexus.Services.UserRole.Accountant)
                {
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label"><i class="bi bi-calendar3 text-success me-1"></i>Fiscal year starts</label>
                            <select class="form-select" @bind="fiscalMonth">
                                @foreach (var m in Months)
                                {
                                    <option>@m</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label"><i class="bi bi-123 text-success me-1"></i>Number format</label>
                            <select class="form-select" @bind="numberFormat">
                                <option>1,234.56</option>
                                <option>1.234,56</option>
                            </select>
                        </div>
                    </div>
                    <div class="toggle-row mt-3">
                        <div>
                            <div class="fw-semibold" style="color: #0A2B1D;"><i class="bi bi-exclamation-octagon text-success me-2"></i>Highlight overdue collections</div>
                            <div class="sub">Show overdue payments in red on financial reports.</div>
                        </div>
                        <label class="switch"><input type="checkbox" @bind="highlightOverdue" /><span class="slider"></span></label>
                    </div>
                }

                <div class="card-actions">
                    <button type="button" class="btn-save" @onclick='() => Toast($"{RoleTab.Label} saved.")'>
                        <i class="bi bi-check2-circle me-1"></i> Save changes
                    </button>
                </div>
            </div>
        }
    </section>
</div>

@code {
    record Tab(string Key, string Label, string Icon, string Description = "");

    string activeTab = "security";
    string toast = "";

    // ---------- SECURITY ----------
    bool twoStep, autoSignOut = true;

    // ---------- NOTIFICATIONS ----------
    bool notifEmail = true, notifSync = true, notifWeekly;
    string language = "English";
    string timezone = "Asia/Manila (UTC+8)";

    // ---------- ROLE SETTINGS ----------
    int trialDays = 14, syncMinutes = 15;
    bool allowRegistration = true, maintenance;
    string bizName = "", bizContact = "", bizAddress = "", currency = "PHP (₱)";
    string fiscalMonth = "January";
    int lowStock = 5;
    decimal approvalLimit = 5000;
    bool requireHarvestApproval = true;
    string defaultUnit = "pcs";
    bool countReminder = true;
    TimeOnly workStart = new(6, 0);
    int overtimeHours = 8;
    bool flagLate = true;
    string defaultPayment = "Cash";
    string receiptNote = "Thank you for your purchase!";
    bool autoPrint = true;
    string numberFormat = "1,234.56";
    bool highlightOverdue = true;

    static readonly string[] Months =
        { "January","February","March","April","May","June","July","August","September","October","November","December" };

    string RoleDisplayName => Auth.CurrentRole switch
    {
        AgriNexus.Services.UserRole.SuperAdmin => "Super Admin",
        AgriNexus.Services.UserRole.TenantAdmin => "Business Owner / Admin",
        AgriNexus.Services.UserRole.BranchManager => "Branch Manager",
        AgriNexus.Services.UserRole.InventoryOfficer => "Inventory Officer",
        AgriNexus.Services.UserRole.LaborOfficer => "Labor Officer",
        AgriNexus.Services.UserRole.SalesOfficer => "Sales Officer",
        AgriNexus.Services.UserRole.Accountant => "Accountant",
        _ => "User"
    };

    Tab RoleTab => Auth.CurrentRole switch
    {
        AgriNexus.Services.UserRole.SuperAdmin => new("role", "Platform settings", "bi-sliders", "Defaults that apply to every tenant on the platform."),
        AgriNexus.Services.UserRole.TenantAdmin => new("role", "Business settings", "bi-building", "Details and defaults for your business."),
        AgriNexus.Services.UserRole.BranchManager => new("role", "Branch preferences", "bi-shop", "Approval limits and alerts for your branch."),
        AgriNexus.Services.UserRole.InventoryOfficer => new("role", "Inventory preferences", "bi-box-seam", "Stock alerts and default units."),
        AgriNexus.Services.UserRole.LaborOfficer => new("role", "Labor preferences", "bi-person-badge", "Work hours and attendance rules."),
        AgriNexus.Services.UserRole.SalesOfficer => new("role", "Sales preferences", "bi-receipt", "Payment and receipt defaults."),
        AgriNexus.Services.UserRole.Accountant => new("role", "Finance preferences", "bi-pie-chart", "Fiscal year and report display."),
        _ => new("role", "Preferences", "bi-sliders", "")
    };

    List<Tab> Tabs => new()
    {
        new("security", "Security & Session", "bi-shield-lock"),
        new("notifications", "Notifications", "bi-bell"),
        new("role", RoleTab.Label, RoleTab.Icon),
    };

    void SetTab(string key)
    {
        activeTab = key;
        toast = "";
    }

    async void Toast(string message)
    {
        toast = message;
        StateHasChanged();
        await Task.Delay(2500);
        toast = "";
        await InvokeAsync(StateHasChanged);
    }
}