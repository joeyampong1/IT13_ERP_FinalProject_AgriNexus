@page "/inventory"
@layout MainLayout
@using System.IO
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Maui.Storage
@using AgriNexus.DataLayer
@using AgriNexus.DataLayer.Models
@using AgriNexus.Services
@inject AgriNexusDbContext DbContext
@inject AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="page-title">Inventory</h2>
        <p class="text-muted mb-0 page-sub">
            <i class="bi bi-building text-success me-1"></i><strong>@ActiveBranch</strong> · seeds, fertilizers, tools, fuel and harvested produce held in stock.
        </p>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <span class="badge rounded-pill px-3 py-2 fw-semibold" style="background-color: #E8F3EC; color: #1B5E34; border: 1px solid #C6DFCE;">
            <i class="bi bi-box-seam me-1"></i> Inventory Directory
        </span>
        <button type="button" class="btn-new shadow-sm" @onclick="GoStock">
            <i class="bi bi-arrow-left-right"></i> Receive / issue stock
        </button>
    </div>
</div>

<!-- STAT CARDS -->
<div class="row g-3 mb-4">
    @foreach (var s in Stats)
    {
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <span class="card-title">@s.Title</span>
                    <div class="stat-icon @s.IconClass"><i class="bi @s.Icon"></i></div>
                </div>
                <div class="mt-3">
                    <div class="card-value">@s.Value</div>
                    @if (!string.IsNullOrEmpty(s.Note))
                    {
                        <div class="text-muted small mt-1">@s.Note</div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- 4 MODULE TABS -->
<div class="tabs mb-4">
    <button type="button" class="tab-btn @(activeTab == "items" ? "active" : "")" @onclick='() => SetTab("items")'>
        <i class="bi bi-box-seam me-1"></i> Item and supply management
    </button>
    <button type="button" class="tab-btn @(activeTab == "low" ? "active" : "")" @onclick='() => SetTab("low")'>
        <i class="bi bi-exclamation-triangle me-1"></i> Low-stock monitoring
    </button>
    <button type="button" class="tab-btn @(activeTab == "produce" ? "active" : "")" @onclick='() => SetTab("produce")'>
        <i class="bi bi-flower2 me-1"></i> Produce stock
    </button>
    <button type="button" class="tab-btn @(activeTab == "reports" ? "active" : "")" @onclick='() => SetTab("reports")'>
        <i class="bi bi-bar-chart-line me-1"></i> Inventory reports
    </button>
</div>

<!-- ======================= TAB 1: ITEM AND SUPPLY MANAGEMENT ======================= -->
@if (activeTab == "items")
{
    <div class="toolbar mb-3 d-flex flex-wrap align-items-center gap-3">

        <!-- ACTIVE / ARCHIVED TABS (Branches.razor btn-group style) -->
        <div class="btn-group shadow-sm" role="group" aria-label="View Tabs">
            <input type="radio" class="btn-check" name="inventoryViewTabs" id="tabInvActive" autocomplete="off"
                   checked="@(!showArchived)" @onchange="() => ToggleArchiveTab(false)">
            <label class="btn btn-outline-success fw-bold" for="tabInvActive">
                <i class="bi bi-check-circle me-1"></i> Active
            </label>

            <input type="radio" class="btn-check" name="inventoryViewTabs" id="tabInvArchived" autocomplete="off"
                   checked="@showArchived" @onchange="() => ToggleArchiveTab(true)">
            <label class="btn btn-outline-secondary fw-bold" for="tabInvArchived">
                <i class="bi bi-archive me-1"></i> Archived
            </label>
        </div>

        <!-- SEARCH BOX -->
        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text" placeholder="Search items..."
                   @bind="searchText"
                   @bind:event="oninput"
                   @bind:after="ResetPagination" />
        </div>

        <span class="badge rounded-pill px-3 py-2 fw-semibold count-label" style="background-color: #FFFFFF; color: #0A2B1D; border: 1px solid #E2ECE6;">
            <i class="bi bi-box-seam me-1 text-success"></i>@Filtered.Count @(Filtered.Count == 1 ? "item" : "items")
        </span>

        @if (!showArchived)
        {
            <button type="button" class="btn-new ms-auto shadow-sm" @onclick="OpenNew">
                <i class="bi bi-plus-lg"></i> New item
            </button>
        }
    </div>

    // Table layout
        <div class="panel shadow-sm bg-white d-flex flex-column" style="border-radius: 16px; border: 1px solid #E2ECE6; max-height: calc(100vh - 340px); overflow: hidden;">
            <div class="table-responsive" style="flex-grow: 1; overflow-y: auto;">
                <table class="table table-hover align-middle mb-0 biz-table" style="width: 100%;">
                    <thead style="position: sticky; top: 0; z-index: 1; background-color: #F7FAF8;">
                        <tr>
                            <th class="text-muted small fw-bold text-uppercase py-3 px-4">Item</th>
                            <th class="text-muted small fw-bold text-uppercase py-3">Category</th>
                            <th class="text-muted small fw-bold text-uppercase py-3">On hand</th>
                            <th class="text-muted small fw-bold text-uppercase py-3">Stock<br />level</th>
                            <th class="text-muted small fw-bold text-uppercase py-3">Reorder<br />at</th>
                            <th class="text-muted small fw-bold text-uppercase py-3">Unit cost</th>
                            <th class="text-muted small fw-bold text-uppercase py-3">Stock<br />value</th>
                            <th class="text-muted small fw-bold text-uppercase py-3">Supplier</th>
                            <th class="py-3"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in PaginatedItems)
                        {
                            <tr style="cursor: pointer;" @onclick="() => OpenDetails(i)">
                                <td class="px-4">
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrWhiteSpace(i.ImageUrl))
                                        {
                                            <img src="@i.ImageUrl" alt="@i.ItemName"
                                                 style="width: 38px; height: 38px; object-fit: cover; border-radius: 10px; border: 1px solid #C6DFCE; flex-shrink: 0;" />
                                        }
                                        else
                                        {
                                            <div class="branch-avatar">
                                                <i class="bi bi-box-seam"></i>
                                            </div>
                                        }
                                        <div>
                                            <div class="fw-bold" style="color: #0A2B1D;">@i.ItemName</div>
                                            <div class="text-muted small mt-1">
                                                <span class="fw-semibold" style="color: #1B5E34;">@i.ItemCode</span>
                                                @(string.IsNullOrWhiteSpace(i.StorageLocation) ? "" : " · " + i.StorageLocation)
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-dark fw-medium">@Cap(i.Category)</td>
                                <td class="text-nowrap fw-semibold text-dark">@Qty(i.QuantityOnHand) @i.Unit</td>
                                <td>
                                    @if (i.IsArchived)
                                    {
                                        <span class="pill pill-earth">
                                            <i class="bi bi-archive me-1"></i>Archived
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="pill @(IsLow(i) ? "pill-earth" : "pill-forest")">
                                            <i class="bi @(IsLow(i) ? "bi-exclamation-circle" : "bi-check-circle") me-1"></i>@(IsLow(i) ? "Low Stock" : "Active")
                                        </span>
                                    }
                                </td>
                                <td class="text-muted fw-medium">@(i.ReorderLevel > 0 ? Qty(i.ReorderLevel) : "—")</td>
                                <td class="text-nowrap text-dark fw-medium">@Peso(i.UnitCost)</td>
                                <td class="text-nowrap text-dark fw-semibold">@Peso(i.QuantityOnHand * i.UnitCost)</td>
                                <td class="text-dark fw-medium">@SupplierNameOf(i)</td>
                                <td class="text-end px-4 action-cell">
                                    <button type="button" class="btn-dots"
                                            @onclick="(e) => ToggleMenuAsync(e, i.ItemId)"
                                            @onclick:stopPropagation="true" aria-label="Actions">
                                        <i class="bi bi-three-dots"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                        @if (Filtered.Count == 0)
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox fs-3 d-block mb-2 opacity-50"></i>
                                    @(showArchived ? "No archived items found." : "No items found.")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Filtered.Count > 0)
            {
                <div class="d-flex flex-wrap justify-content-between align-items-center p-3 border-top bg-white" style="flex-shrink: 0; border-color: #E2ECE6 !important; border-radius: 0 0 16px 16px;">
                    <div class="text-muted small mb-2 mb-md-0">
                        Showing <span class="fw-bold" style="color: #0A2B1D;">@StartItem</span> - <span class="fw-bold" style="color: #0A2B1D;">@EndItem</span> of <span class="fw-bold" style="color: #0A2B1D;">@Filtered.Count</span> items
                    </div>

                    <div class="d-flex gap-1">
                        <button class="btn btn-sm btn-light border px-3 rounded-2 fw-medium" @onclick="PreviousPage" disabled="@(currentPage == 1)">
                            <i class="bi bi-chevron-left me-1"></i>Previous
                        </button>

                        @for (int p = 1; p <= TotalPages; p++)
                        {
                            var pageNumber = p;
                            <button class="btn btn-sm px-3 rounded-2 fw-bold @(currentPage == pageNumber ? "btn-new text-white shadow-sm" : "btn-light border text-dark")"
                                    @onclick="() => GoToPage(pageNumber)">
                                @pageNumber
                            </button>
                        }

                        <button class="btn btn-sm btn-light border px-3 rounded-2 fw-medium" @onclick="NextPage" disabled="@(currentPage == TotalPages)">
                            Next<i class="bi bi-chevron-right ms-1"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    }

    <!-- ======================= TAB 2: LOW STOCK MONITORING ======================= -->
    @if (activeTab == "low")
    {
        <div class="panel shadow-sm bg-white">
            <div class="panel-head">
                <div class="panel-title">Low-stock monitoring</div>
                <div class="panel-sub mb-0">Items at or below their reorder level</div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 biz-table">
                    <thead style="background-color: #F7FAF8;">
                        <tr>
                            <th class="text-muted small fw-bold text-uppercase py-3 px-4">Item</th>
                            <th class="text-muted small fw-bold text-uppercase py-3">Category</th>
                            <th class="text-muted small fw-bold text-uppercase py-3">On hand</th>
                            <th class="text-muted small fw-bold text-uppercase py-3">Reorder at</th>
                            <th class="text-muted small fw-bold text-uppercase py-3">Shortage</th>
                            <th class="text-muted small fw-bold text-uppercase py-3">Suggested order</th>
                            <th class="text-muted small fw-bold text-uppercase py-3">Supplier</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in LowItems)
                        {
                            <tr style="cursor: pointer;" @onclick="() => OpenDetails(i)">
                                <td class="px-4">
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrWhiteSpace(i.ImageUrl))
                                        {
                                            <img src="@i.ImageUrl" alt="@i.ItemName"
                                                 style="width: 38px; height: 38px; object-fit: cover; border-radius: 10px; border: 1px solid #C6DFCE; flex-shrink: 0;" />
                                        }
                                        else
                                        {
                                            <div class="branch-avatar">
                                                <i class="bi bi-box-seam"></i>
                                            </div>
                                        }
                                        <div>
                                            <div class="fw-bold" style="color: #0A2B1D;">@i.ItemName</div>
                                            <div class="text-muted small">@i.ItemCode</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@Cap(i.Category)</td>
                                <td class="text-nowrap fw-semibold neg">@Qty(i.QuantityOnHand) @i.Unit</td>
                                <td class="text-nowrap">@Qty(i.ReorderLevel) @i.Unit</td>
                                <td class="text-nowrap">@Qty(Math.Max(0, i.ReorderLevel - i.QuantityOnHand)) @i.Unit</td>
                                <td class="text-nowrap fw-semibold">@Qty(Math.Max(0, i.ReorderLevel * 2 - i.QuantityOnHand)) @i.Unit</td>
                                <td>@SupplierNameOf(i)</td>
                            </tr>
                        }
                        @if (LowItems.Count == 0)
                        {
                            <tr><td colspan="7" class="text-center text-muted py-5">All items are above their reorder level.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="text-muted small mt-2">Suggested order brings each item back to twice its reorder level.</div>
    }

<!-- ======================= TAB 3: PRODUCE STOCK ======================= -->
@if (activeTab == "produce")
{
    <div class="panel shadow-sm bg-white">
        <div class="panel-head">
            <div class="panel-title">Produce stock</div>
            <div class="panel-sub mb-0">Harvested produce, managed as a separate inventory category</div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 biz-table">
                <thead style="background-color: #F7FAF8;">
                    <tr>
                        <th class="text-muted small fw-bold text-uppercase py-3 px-4">Lot</th>
                        <th class="text-muted small fw-bold text-uppercase py-3">Source plot</th>
                        <th class="text-muted small fw-bold text-uppercase py-3">On hand</th>
                        <th class="text-muted small fw-bold text-uppercase py-3">Unit value</th>
                        <th class="text-muted small fw-bold text-uppercase py-3">Stock value</th>
                        <th class="text-muted small fw-bold text-uppercase py-3">Storage</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in ProduceItems)
                    {
                        <tr style="cursor: pointer;" @onclick="() => OpenDetails(i)">
                            <td class="px-4">
                                <div class="fw-bold" style="color: #0A2B1D;">@i.ItemName</div>
                                <div class="text-muted small">@i.ItemCode</div>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(i.SourcePlot) ? "—" : i.SourcePlot)</td>
                            <td class="text-nowrap">@Qty(i.QuantityOnHand) @i.Unit</td>
                            <td class="text-nowrap">@Peso(i.UnitCost)</td>
                            <td class="text-nowrap">@Peso(i.QuantityOnHand * i.UnitCost)</td>
                            <td>@(string.IsNullOrWhiteSpace(i.StorageLocation) ? "—" : i.StorageLocation)</td>
                        </tr>
                    }
                    @if (ProduceItems.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-5">No produce in stock.</td></tr>
                    }
                </tbody>
                @if (ProduceItems.Count > 0)
                {
                    <tfoot>
                        <tr>
                            <td class="fw-semibold px-4">Total</td>
                            <td></td>
                            <td class="fw-semibold text-nowrap">@Qty(ProduceKg) kg</td>
                            <td></td>
                            <td class="fw-semibold text-nowrap">@Peso(ProduceItems.Sum(p => p.QuantityOnHand * p.UnitCost))</td>
                            <td></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
    <div class="text-muted small mt-2">New produce lots are added when a harvest is approved in Harvest Recording.</div>
}

<!-- ======================= TAB 4: INVENTORY REPORTS ======================= -->
@if (activeTab == "reports")
{
    <div class="panel shadow-sm bg-white">
        <div class="panel-head">
            <div class="panel-title">Stock value by category</div>
            <div class="panel-sub mb-0">How inventory value is distributed</div>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0 biz-table">
                <thead style="background-color: #F7FAF8;">
                    <tr>
                        <th class="text-muted small fw-bold text-uppercase py-3 px-4">Category</th>
                        <th class="text-muted small fw-bold text-uppercase py-3">Items</th>
                        <th class="text-muted small fw-bold text-uppercase py-3">Low stock</th>
                        <th class="text-muted small fw-bold text-uppercase py-3">Stock value</th>
                        <th class="text-muted small fw-bold text-uppercase py-3" style="width: 28%;">Share</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in CategorySummary)
                    {
                        <tr>
                            <td class="fw-semibold px-4">@Cap(c.Category)</td>
                            <td>@c.Items</td>
                            <td class="@(c.Low > 0 ? "neg fw-semibold" : "text-muted")">@c.Low</td>
                            <td class="text-nowrap">@Peso(c.Value)</td>
                            <td>
                                <div class="share-cell">
                                    <div class="bar-track"><div class="bar-fill" style="width:@Share(c.Value)%"></div></div>
                                    <span class="share-text">@Share(c.Value)%</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td class="fw-semibold px-4">Total</td>
                        <td class="fw-semibold">@allActiveItems.Count</td>
                        <td class="fw-semibold">@allActiveItems.Count(IsLow)</td>
                        <td class="fw-semibold text-nowrap">@Peso(TotalValue)</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

<!-- FLOATING ACTION MENU -->
@if (openMenuId != null)
{
    var menuItem = allItems.FirstOrDefault(x => x.ItemId == openMenuId);
    if (menuItem != null)
    {
        <div class="menu-backdrop" @onclick="CloseMenu" @onclick:stopPropagation="true"></div>

        <div class="vertical-action-menu shadow-lg" style="top:@(menuTop)px; left:@(menuLeft)px;">
            @if (!menuItem.IsArchived)
            {
                <button type="button" class="action-item"
                        @onclick="() => OpenEdit(menuItem)"
                        @onclick:stopPropagation="true">
                    <i class="bi bi-pencil-square text-success"></i> Edit
                </button>

                @if (!string.Equals(menuItem.ItemType, "PRODUCE", StringComparison.OrdinalIgnoreCase))
                {
                    <button type="button" class="action-item text-earth"
                            @onclick="() => PromptArchive(menuItem)"
                            @onclick:stopPropagation="true">
                        <i class="bi bi-archive"></i> Archive
                    </button>
                }
            }
            else
            {
                <button type="button" class="action-item text-success"
                        @onclick="() => RestoreItemAsync(menuItem)"
                        @onclick:stopPropagation="true">
                    <i class="bi bi-arrow-counterclockwise"></i> Restore
                </button>
            }
        </div>
    }
}

<!-- DETAILS MODAL -->
@if (showDetailsModal && selectedItem != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(10, 43, 29, 0.65); backdrop-filter: blur(5px); z-index: 1050;" tabindex="-1" @onclick="CloseDetailsModal">
        <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation="true">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="modal-header border-0 p-4 d-flex justify-content-between align-items-center" style="background-color: #F4F7F5;">
                    <div class="d-flex align-items-center gap-3">
                        @if (!string.IsNullOrWhiteSpace(selectedItem.ImageUrl))
                        {
                            <div class="position-relative"
                                 style="cursor: zoom-in; flex-shrink: 0;"
                                 title="Click to enlarge image"
                                 @onclick="() => OpenImageZoom(selectedItem.ImageUrl, selectedItem.ItemName)">
                                <img src="@selectedItem.ImageUrl" alt="@selectedItem.ItemName"
                                     style="width: 64px; height: 64px; object-fit: cover; border-radius: 14px; border: 2px solid #C6DFCE; background-color: #FFFFFF;" />
                                <span class="position-absolute bottom-0 end-0 badge rounded-pill shadow-sm"
                                      style="background-color: #0A2B1D; color: #FFFFFF; font-size: 0.65rem; padding: 3px 5px; transform: translate(20%, 20%);">
                                    <i class="bi bi-zoom-in"></i>
                                </span>
                            </div>
                        }
                        else
                        {
                            <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; background-color: #E8F3EC; color: #1B5E34; flex-shrink: 0;">
                                <i class="bi bi-box-seam fs-4"></i>
                            </div>
                        }
                        <div>
                            <h4 class="modal-title fw-bolder mb-0" style="color: #0A2B1D;">@selectedItem.ItemName</h4>
                            <div class="d-flex flex-wrap align-items-center gap-2 mt-1">
                                <span class="badge px-2 py-1 rounded-pill" style="background-color: #FFFFFF; color: #1B5E34; border: 1px solid #C6DFCE;">
                                    <i class="bi bi-upc-scan me-1"></i>@selectedItem.ItemCode
                                </span>
                                @if (selectedItem.IsArchived)
                                {
                                    <span class="pill pill-earth"><i class="bi bi-archive me-1"></i>Archived</span>
                                }
                                else
                                {
                                    <span class="pill @(IsLow(selectedItem) ? "pill-earth" : "pill-forest")">
                                        <i class="bi @(IsLow(selectedItem) ? "bi-exclamation-circle" : "bi-check-circle") me-1"></i>@(IsLow(selectedItem) ? "Low Stock" : "Active")
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn-close bg-white shadow-sm rounded-circle p-2" @onclick="CloseDetailsModal" aria-label="Close" style="width: 32px; height: 32px;"></button>
                </div>

                <div class="modal-body p-4" style="max-height: 70vh; overflow-y: auto;">
                    <!-- SECTION 1: Product, Supplier & Storage Information -->
                    <div class="mb-4">
                        <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                            <i class="bi bi-info-circle me-2 text-success"></i>Product &amp; Storage Information
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="text-muted small fw-bold text-uppercase">Product Name</label>
                                <p class="mb-0 fw-semibold fs-6 text-dark">
                                    <i class="bi bi-box-seam text-success me-2"></i>@selectedItem.ItemName
                                </p>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted small fw-bold text-uppercase">Category &amp; Type</label>
                                <p class="mb-0 fw-semibold fs-6 text-dark">
                                    <i class="bi bi-tags text-success me-2"></i>@Cap(selectedItem.Category) (@selectedItem.ItemType)
                                </p>
                            </div>

                            @if (CanViewCostAndSupplier)
                            {
                                <div class="col-md-6 mt-3">
                                    <label class="text-muted small fw-bold text-uppercase">Supplier</label>
                                    <p class="mb-0 fw-semibold fs-6 text-dark">
                                        <i class="bi bi-truck text-success me-2"></i>@SupplierNameOf(selectedItem)
                                    </p>
                                </div>
                                <div class="col-md-6 mt-3">
                                    <label class="text-muted small fw-bold text-uppercase">Supplier Contact Number</label>
                                    <p class="mb-0 fw-medium text-dark">
                                        <i class="bi bi-telephone text-success me-2"></i>@SupplierContactOf(selectedItem)
                                    </p>
                                </div>
                            }

                            <div class="col-md-6 mt-3">
                                <label class="text-muted small fw-bold text-uppercase">Storage Location</label>
                                <p class="mb-0 fw-medium text-dark">
                                    <i class="bi bi-geo-alt text-success me-2"></i>@(string.IsNullOrWhiteSpace(selectedItem.StorageLocation) ? "—" : selectedItem.StorageLocation)
                                </p>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label class="text-muted small fw-bold text-uppercase">Reorder Level</label>
                                <p class="mb-0 fw-medium text-dark">
                                    <i class="bi bi-bell text-success me-2"></i>@(selectedItem.ReorderLevel > 0 ? $"{Qty(selectedItem.ReorderLevel)} {selectedItem.Unit}" : "—")
                                </p>
                            </div>

                            @if (string.Equals(selectedItem.ItemType, "PRODUCE", StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="col-md-6 mt-3">
                                    <label class="text-muted small fw-bold text-uppercase">Source Plot</label>
                                    <p class="mb-0 fw-medium text-dark">
                                        <i class="bi bi-flower2 text-success me-2"></i>@(string.IsNullOrWhiteSpace(selectedItem.SourcePlot) ? "—" : selectedItem.SourcePlot)
                                    </p>
                                </div>
                            }

                            <div class="col-12 mt-3">
                                <label class="text-muted small fw-bold text-uppercase">Notes</label>
                                <p class="mb-0 text-muted fst-italic">
                                    <i class="bi bi-journal-text text-success me-2"></i>@(string.IsNullOrWhiteSpace(selectedItem.Notes) ? "No notes provided." : selectedItem.Notes)
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 2: Pricing, Stock & Valuation Summary -->
                    <div class="p-4 rounded-4" style="background-color: #F7FAF8; border: 1px dashed #C6DFCE;">
                        <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                            <i class="bi bi-cash-coin me-2 text-success"></i>Pricing, Stock &amp; Valuation Summary
                        </h6>
                        <div class="row g-3 text-center">
                            <div class="@(CanViewCostAndSupplier ? "col-6 col-md-3" : "col-6")">
                                <div class="p-3 bg-white rounded-3 border h-100 d-flex flex-column align-items-center justify-content-center" style="border-color: #E2ECE6 !important;">
                                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 34px; height: 34px; background-color: #E8F3EC; color: #0A2B1D;">
                                        <i class="bi bi-boxes"></i>
                                    </div>
                                    <h5 class="fw-bolder mb-1" style="color: #0A2B1D;">@Qty(selectedItem.QuantityOnHand) @selectedItem.Unit</h5>
                                    <small class="text-muted fw-medium">On Hand</small>
                                </div>
                            </div>

                            @if (CanViewCostAndSupplier)
                            {
                                <div class="col-6 col-md-3">
                                    <div class="p-3 bg-white rounded-3 border h-100 d-flex flex-column align-items-center justify-content-center" style="border-color: #E2ECE6 !important;">
                                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 34px; height: 34px; background-color: #EDF7E8; color: #4E8D2A;">
                                            <i class="bi bi-tag"></i>
                                        </div>
                                        <h5 class="fw-bolder mb-1" style="color: #4E8D2A;">@Peso(selectedItem.UnitCost)</h5>
                                        <small class="text-muted fw-medium">Unit Cost (Base)</small>
                                    </div>
                                </div>
                            }

                            <div class="@(CanViewCostAndSupplier ? "col-6 col-md-3" : "col-6")">
                                <div class="p-3 bg-white rounded-3 border h-100 d-flex flex-column align-items-center justify-content-center" style="border-color: #E2ECE6 !important;">
                                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 34px; height: 34px; background-color: #E8F3EC; color: #1B5E34;">
                                        <i class="bi bi-cash-stack"></i>
                                    </div>
                                    <h5 class="fw-bolder mb-1" style="color: #1B5E34;">@Peso(ResaleValueOf(selectedItem))</h5>
                                    <small class="text-muted fw-medium">
                                        Selling Price
                                        @if (selectedItem.SellingPrice <= 0 && selectedItem.UnitCost > 0)
                                        {
                                            <span class="d-block" style="font-size: 0.7rem; color: #7A5230;">(Same as cost)</span>
                                        }
                                    </small>
                                </div>
                            </div>

                            @if (CanViewCostAndSupplier)
                            {
                                <div class="col-6 col-md-3">
                                    <div class="p-3 bg-white rounded-3 border h-100 d-flex flex-column align-items-center justify-content-center" style="border-color: #E2ECE6 !important;">
                                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 34px; height: 34px; background-color: #F5EFEA; color: #7A5230;">
                                            <i class="bi bi-wallet2"></i>
                                        </div>
                                        <h5 class="fw-bolder mb-1" style="color: #7A5230;">@Peso(selectedItem.QuantityOnHand * selectedItem.UnitCost)</h5>
                                        <small class="text-muted fw-medium">Total Cost Value</small>
                                        @if (selectedItem.SellingPrice > 0)
                                        {
                                            <span class="d-block mt-1" style="font-size: 0.7rem; color: #1B5E34;">
                                                Est. Sales: @Peso(selectedItem.QuantityOnHand * selectedItem.SellingPrice)
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Footer -->
                <div class="modal-footer border-0 p-4 d-flex justify-content-between" style="background-color: #F4F7F5;">
                    <button type="button" class="btn btn-light border fw-bold px-4 rounded-3 shadow-sm" @onclick="CloseDetailsModal">
