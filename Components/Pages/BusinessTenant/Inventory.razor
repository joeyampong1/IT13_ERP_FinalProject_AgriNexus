    private async Task HandleImageSelectedAsync(InputFileChangeEventArgs e)
    {
        imageError = "";
        var file = e.File;
        if (file == null) return;

        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        if (ext is not (".jpg" or ".jpeg" or ".png" or ".webp"))
        {
            imageError = "Only JPG, PNG, or WEBP images are allowed.";
            return;
        }

        if (file.Size > MaxImageBytes)
        {
            imageError = "Image size must be 3 MB or less.";
            return;
        }

        selectedImageFile = file;
        removeExistingImage = false;

        using var ms = new MemoryStream();
        await file.OpenReadStream(MaxImageBytes).CopyToAsync(ms);
        imagePreviewUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
    }

    private void RemoveImage()
    {
        selectedImageFile = null;
        imagePreviewUrl = null;
        imageError = "";
        removeExistingImage = true;
    }

    private async Task<string?> SaveImageFileAsync()
    {
        if (selectedImageFile == null)
            return removeExistingImage ? null : form.ImageUrl;

        var uploadDir = Path.Combine(FileSystem.AppDataDirectory, "uploads", "inventory");
        Directory.CreateDirectory(uploadDir);

        var ext = Path.GetExtension(selectedImageFile.Name).ToLowerInvariant();
        var fileName = $"{Guid.NewGuid():N}{ext}";
        var fullPath = Path.Combine(uploadDir, fileName);

        await using var fs = new FileStream(fullPath, FileMode.Create);
        await selectedImageFile.OpenReadStream(MaxImageBytes).CopyToAsync(fs);

        using var ms = new MemoryStream();
        await using var readStream = File.OpenRead(fullPath);
        await readStream.CopyToAsync(ms);
        var mime = ext == ".png" ? "image/png" : ext == ".webp" ? "image/webp" : "image/jpeg";
        return $"data:{mime};base64,{Convert.ToBase64String(ms.ToArray())}";
    }

