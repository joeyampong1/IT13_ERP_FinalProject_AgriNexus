    async Task ConfirmArchiveAsync()
    {
        if (itemToArchive == null) return;
        isSaving = true;
        try
        {
            var existing = await DbContext.InventoryItems.FindAsync(itemToArchive.ItemId);
            if (existing != null)
            {
                existing.IsArchived = true;
                DbContext.InventoryItems.Update(existing);
                await DbContext.SaveChangesAsync();
                await ShowToast($"{itemToArchive.ItemName} moved to Archived.");
            }

            showConfirmArchiveModal = false;
            itemToArchive = null;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            await ShowToast("Error archiving item: " + ex.Message, isWarning: true);
        }
        finally
        {
            isSaving = false;
        }
    }

    async Task RestoreItemAsync(InventoryItem item)
    {
        openMenuId = null;
        try
        {
            var existing = await DbContext.InventoryItems.FindAsync(item.ItemId);
            if (existing != null)
            {
                existing.IsArchived = false;
                DbContext.InventoryItems.Update(existing);
                await DbContext.SaveChangesAsync();
                await ShowToast($"{item.ItemName} restored to Active.");
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            await ShowToast("Error restoring item: " + ex.Message, isWarning: true);
        }
    }

    async Task ShowToast(string message, bool isWarning = false)
    {
        toast = message;
        toastIsWarning = isWarning;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(3200);
        toast = "";
        await InvokeAsync(StateHasChanged);
    }
