@code {
    record Stat(string Title, string Value, string Note, string Icon, string IconClass);
    record CatRow(string Category, int Items, int Low, decimal Value);

    class Viewport
    {
        public double W { get; set; }
        public double H { get; set; }
    }

    static readonly CultureInfo Inv = CultureInfo.InvariantCulture;
    static readonly string[] CategoryOptions = { "seeds", "fertilizer", "pesticide", "tools", "fuel", "packaging", "supplies" };
    static readonly string[] UnitOptions = { "kg", "sack", "bottle", "liter", "piece", "pair", "box" };
    const long MaxImageBytes = 3 * 1024 * 1024; // 3 MB

    long currentBusinessId;
    long? currentBranchId;
    string ActiveBranch = "All Branches";

    List<InventoryItem> allItems = new();
    List<AgriNexus.DataLayer.Models.Supplier> suppliers = new();

    string activeTab = "items";
    bool showArchived = false;
    string searchText = "";
    string selectedSupplierIdStr = "";
    string toast = "";
    bool toastIsWarning = false;

    bool showModal;
    bool showErrors;
    bool isSaving;
    int? editingId;
    int? openMenuId;
    bool selectedItemIsTaxable = true;
    InventoryItem form = new();
    decimal? qtyInput, reorderInput, costInput, sellingPriceInput;

    // Image upload state
    IBrowserFile? selectedImageFile;
    string? imagePreviewUrl;
    string imageError = "";
    bool removeExistingImage;

    // Details & Zoom state
    bool showDetailsModal;
    InventoryItem? selectedItem;

    bool showImageZoomModal;
    string? zoomedImageUrl;
    string zoomedImageTitle = "";

    bool showConfirmArchiveModal;
    InventoryItem? itemToArchive;

    private int currentPage = 1;
    private int pageSize = 5;
    private double menuTop;
    private double menuLeft;

    bool CanViewCostAndSupplier =>
        Auth.CurrentRole == UserRole.TenantAdmin ||
        Auth.CurrentRole == UserRole.InventoryOfficer;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            User? currentUser = null;

            if (Auth.CurrentUserId > 0)
            {
                currentUser = await DbContext.Users
                    .Include(u => u.Business)
                    .FirstOrDefaultAsync(u => u.UserId == Auth.CurrentUserId);
            }
            else if (!string.IsNullOrWhiteSpace(Auth.CurrentUserEmail))
            {
                var cleanEmail = Auth.CurrentUserEmail.Trim().ToLower();
                currentUser = await DbContext.Users
                    .Include(u => u.Business)
                    .FirstOrDefaultAsync(u => u.Email != null && u.Email.ToLower() == cleanEmail);
            }
            else if (!string.IsNullOrWhiteSpace(Auth.CurrentUserName))
            {
                currentUser = await DbContext.Users
                    .Include(u => u.Business)
                    .FirstOrDefaultAsync(u => (u.FName + " " + u.LName) == Auth.CurrentUserName
                                           || u.FName == Auth.CurrentUserName);
            }

            if (currentUser?.BusinessId != null)
            {
                currentBusinessId = currentUser.BusinessId.Value;
                currentBranchId = currentUser.BranchId;
            }
            else
            {
                var firstBiz = await DbContext.Businesses.FirstOrDefaultAsync();
                if (firstBiz != null) currentBusinessId = firstBiz.BusinessId;
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            await ShowToast("Error loading inventory: " + ex.Message, isWarning: true);
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            var branches = await DbContext.Branches
                .Where(b => b.BusinessId == currentBusinessId)
                .OrderBy(b => b.BranchName)
                .ToListAsync();

            if (currentBranchId.HasValue)
            {
                var matchedBranch = branches.FirstOrDefault(b => b.BranchId == currentBranchId.Value);
                if (matchedBranch != null) ActiveBranch = matchedBranch.BranchName;
            }
            else if (branches.Count > 0)
            {
                ActiveBranch = branches[0].BranchName;
            }

            suppliers = await DbContext.Suppliers
                .Where(s => s.BusinessId == currentBusinessId && s.Status != "archived")
                .OrderBy(s => s.Name)
                .ToListAsync();

            allItems = await DbContext.InventoryItems
                .Include(i => i.Supplier)
                .Where(i => i.BusinessId == currentBusinessId)
                .OrderByDescending(i => i.ItemId)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            await ShowToast("Database load error: " + ex.Message, isWarning: true);
        }
    }

    List<InventoryItem> allActiveItems => allItems.Where(i => !i.IsArchived).ToList();

    List<InventoryItem> SupplyItemsByStatus => allItems
        .Where(i => !string.Equals(i.ItemType, "PRODUCE", StringComparison.OrdinalIgnoreCase)
                 && (showArchived ? i.IsArchived : !i.IsArchived))
        .ToList();

    List<InventoryItem> ProduceItems => allActiveItems
        .Where(i => string.Equals(i.ItemType, "PRODUCE", StringComparison.OrdinalIgnoreCase))
        .ToList();

    List<InventoryItem> Filtered
    {
        get
        {
            var baseList = SupplyItemsByStatus;
            if (string.IsNullOrWhiteSpace(searchText))
                return baseList;

            return baseList.Where(i =>
                i.ItemName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                i.ItemCode.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                i.Category.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                SupplierNameOf(i).Contains(searchText, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)Filtered.Count / pageSize));
    private int StartItem => Filtered.Count == 0 ? 0 : (currentPage - 1) * pageSize + 1;
    private int EndItem => Math.Min(currentPage * pageSize, Filtered.Count);
    private IEnumerable<InventoryItem> PaginatedItems => Filtered.Skip((currentPage - 1) * pageSize).Take(pageSize);

    List<InventoryItem> LowItems => allActiveItems
        .Where(IsLow)
        .OrderBy(i => i.ReorderLevel == 0 ? 1 : i.QuantityOnHand / i.ReorderLevel)
        .ToList();

    decimal ProduceKg => ProduceItems.Sum(p => p.QuantityOnHand);
    decimal TotalValue => allActiveItems.Sum(i => i.QuantityOnHand * i.UnitCost);

    List<CatRow> CategorySummary => allActiveItems
        .GroupBy(i => string.IsNullOrWhiteSpace(i.Category) ? "supplies" : i.Category)
        .Select(g => new CatRow(g.Key, g.Count(), g.Count(IsLow), g.Sum(i => i.QuantityOnHand * i.UnitCost)))
        .OrderByDescending(c => c.Value)
        .ToList();

    List<Stat> Stats => new()
    {
        new("ITEMS TRACKED", allActiveItems.Count.ToString(), ProduceItems.Count + " produce lots", "bi-box-seam", ""),
        new("STOCK VALUE", Peso(TotalValue), "", "bi-cash-coin", "stat-icon-leaf"),
        new("LOW STOCK", allActiveItems.Count(IsLow).ToString(), "At or below reorder level", "bi-exclamation-triangle", "stat-icon-earth"),
        new("PRODUCE ON HAND", Qty(ProduceKg) + " kg", "", "bi-flower2", "stat-icon-leaf"),
    };

    bool SkuTaken => !string.IsNullOrWhiteSpace(form.ItemCode) &&
        allItems.Any(i => i.ItemId != (editingId ?? -1) &&
                     string.Equals(i.ItemCode, form.ItemCode.Trim(), StringComparison.OrdinalIgnoreCase));

    bool AnyNegative => Negative(qtyInput) || Negative(reorderInput) || Negative(costInput) || Negative(sellingPriceInput);

    static bool IsLow(InventoryItem i) => !i.IsArchived && i.ReorderLevel > 0 && i.QuantityOnHand <= i.ReorderLevel;
    static bool Negative(decimal? v) => v.HasValue && v.Value < 0;
    static string Qty(decimal v) => v.ToString("#,##0.##", Inv);
    static string Peso(decimal v) => "₱" + v.ToString("N2", Inv);
    static string Cap(string? s) => string.IsNullOrWhiteSpace(s) ? "" : char.ToUpper(s[0]) + s.Substring(1);

    int Share(decimal value) => TotalValue <= 0 ? 0 : (int)Math.Round(value * 100 / TotalValue);

    string SupplierNameOf(InventoryItem item)
    {
        if (item.Supplier != null && !string.IsNullOrWhiteSpace(item.Supplier.Name))
            return item.Supplier.Name;

        if (item.SupplierId.HasValue)
        {
            var sup = suppliers.FirstOrDefault(s => s.SupplierId == item.SupplierId.Value);
            if (sup != null) return sup.Name;
        }

        return "—";
    }

    private void OnCategoryChanged()
    {
        selectedItemIsTaxable = IsCategoryTaxable(form.Category, form.ItemType);
    }

    private static bool IsCategoryTaxable(string? category, string? itemType)
    {
        if (string.Equals(itemType, "PRODUCE", StringComparison.OrdinalIgnoreCase))
            return false;

        var cat = (category ?? "").Trim().ToLowerInvariant();
        return cat switch
        {
            "seeds" => false,
            "fertilizer" => false,
            _ => true
        };
    }

    string SupplierContactOf(InventoryItem item)
    {
        if (item.Supplier != null && !string.IsNullOrWhiteSpace(item.Supplier.ContactNumber))
            return item.Supplier.ContactNumber;

        if (item.SupplierId.HasValue)
        {
            var sup = suppliers.FirstOrDefault(s => s.SupplierId == item.SupplierId.Value);
            if (sup != null && !string.IsNullOrWhiteSpace(sup.ContactNumber))
                return sup.ContactNumber;
        }

        return "—";
    }

    decimal ResaleValueOf(InventoryItem item) => item.SellingPrice > 0 ? item.SellingPrice : item.UnitCost;

    string NextSku(string? category)
    {
        var prefix = (category ?? "").ToLower() switch
        {
            "seeds" => "SEED",
            "fertilizer" => "FER",
            "pesticide" => "PES",
            "tools" => "TOOL",
            "fuel" => "FUEL",
            "packaging" => "PKG",
            "produce" => "LOT",
            _ => "SUP"
        };

        var max = 0;
        foreach (var i in allItems)
        {
            var parts = (i.ItemCode ?? "").Split('-');
            if (parts.Length == 2 && parts[0].Equals(prefix, StringComparison.OrdinalIgnoreCase) && int.TryParse(parts[1], out var n))
                max = Math.Max(max, n);
        }
        return prefix + "-" + (max + 1).ToString("000");
    }

    private string CapitalizeWords(string? input)
    {
        if (string.IsNullOrWhiteSpace(input)) return input ?? "";
        return CultureInfo.CurrentCulture.TextInfo.ToTitleCase(input.ToLower().Trim());
    }

