<!-- ADD / EDIT MODAL -->
@if (showModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(10, 43, 29, 0.65); backdrop-filter: blur(5px); z-index: 1050;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation="true">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="modal-header border-0 p-4" style="background-color: #F4F7F5;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; background-color: #E8F3EC; color: #1B5E34;">
                            <i class="bi @(editingId == null ? "bi-box-seam" : "bi-pencil-square") fs-5"></i>
                        </div>
                        <div>
                            <h4 class="modal-title fw-bolder mb-0" style="color: #0A2B1D;">
                                @(editingId == null ? "Register New Item" : "Edit Item Details")
                            </h4>
                            <p class="text-muted small mb-0">Fill in the master item details below to @(editingId == null ? "add an inventory item" : "update the item").</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close bg-white shadow-sm rounded-circle p-2" @onclick="CloseModal" aria-label="Close" style="width: 32px; height: 32px;"></button>
                </div>

                <div class="modal-body p-4" style="max-height: 70vh; overflow-y: auto;">
                    <form>
                        <!-- SECTION 0: Product Image -->
                        <div class="mb-4 p-3 rounded-4 d-flex flex-wrap align-items-center gap-3" style="background-color: #F7FAF8; border: 1px dashed #C6DFCE;">
                            <div style="width: 78px; height: 78px; border-radius: 14px; background-color: #FFFFFF; border: 1px solid #E2ECE6; overflow: hidden; flex-shrink: 0;"
                                 class="d-flex align-items-center justify-content-center">
                                @if (!string.IsNullOrWhiteSpace(imagePreviewUrl))
                                {
                                    <img src="@imagePreviewUrl" alt="Preview" style="width: 100%; height: 100%; object-fit: cover;" />
                                }
                                else
                                {
                                    <i class="bi bi-image text-muted fs-3 opacity-50"></i>
                                }
                            </div>

                            <div class="flex-grow-1">
                                <label class="form-label fw-bold small text-muted mb-1">
                                    <i class="bi bi-camera me-1 text-success"></i>Product Image (Displayed in Sales / POS)
                                </label>
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <InputFile OnChange="HandleImageSelectedAsync"
                                               accept=".jpg,.jpeg,.png,.webp"
                                               class="form-control form-control-sm"
                                               style="max-width: 280px;" />
                                    @if (!string.IsNullOrWhiteSpace(imagePreviewUrl))
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-3" @onclick="RemoveImage">
                                            <i class="bi bi-trash me-1"></i>Remove
                                        </button>
                                    }
                                </div>
                                <div class="text-muted small mt-1">JPG, PNG, or WEBP · Max 3 MB</div>
                                @if (!string.IsNullOrEmpty(imageError))
                                {
                                    <div class="err">@imageError</div>
                                }
                            </div>
                        </div>

                        <!-- SECTION 1: Item Identification -->
                        <div class="mb-4">
                            <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                                <i class="bi bi-box-seam me-2 text-success"></i>Item Identification
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label class="form-label fw-bold small text-muted">Item Name <span class="text-danger">*</span></label>
                                    <div class="input-group modern-input @(showErrors && string.IsNullOrWhiteSpace(form.ItemName) ? "border border-danger rounded-3" : "")">
                                        <span class="input-group-text bg-white"><i class="bi bi-box-seam text-success"></i></span>
                                        <input class="form-control" placeholder="e.g. Urea (46-0-0)"
                                               @bind="form.ItemName"
                                               @bind:after="() => form.ItemName = CapitalizeWords(form.ItemName)" />
                                    </div>
                                    @if (showErrors && string.IsNullOrWhiteSpace(form.ItemName))
                                    {
                                        <div class="err">Item name is required.</div>
                                    }
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label fw-bold small text-muted">SKU / Code</label>
                                    <div class="input-group modern-input @(showErrors && SkuTaken ? "border border-danger rounded-3" : "")">
                                        <span class="input-group-text bg-white"><i class="bi bi-upc-scan text-success"></i></span>
                                        <input class="form-control fw-bold" placeholder="@NextSku(form.Category)"
                                               @bind="form.ItemCode"
                                               @bind:after="() => form.ItemCode = form.ItemCode.Trim().ToUpper()" />
                                    </div>
                                    @if (showErrors && SkuTaken)
                                    {
                                        <div class="err">This code is already used.</div>
                                    }
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Category</label>
                                    @if (string.Equals(form.ItemType, "PRODUCE", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <input class="form-control" value="produce" disabled />
                                        <div class="mt-1">
                                            <span class="badge bg-secondary-subtle text-secondary">VAT-Exempt (Produce)</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <select class="form-select" @bind="form.Category" @bind:after="OnCategoryChanged">
                                            @foreach (var c in CategoryOptions)
                                            {
                                                <option value="@c">@c</option>
                                            }
                                        </select>
                                        <div class="mt-1">
                                            @if (selectedItemIsTaxable)
                                            {
                                                <span class="badge bg-success-subtle text-success">
                                                    <i class="bi bi-percent me-1"></i>12% VAT (Default for @form.Category)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary">
                                                    <i class="bi bi-shield-check me-1"></i>VAT-Exempt (Default for @form.Category)
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Unit</label>
                                    <select class="form-select" @bind="form.Unit">
                                        @foreach (var u in UnitOptions)
                                        {
                                            <option value="@u">@u</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- SECTION 2: Stock & Supplier -->
                        <div class="mb-4">
                            <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                                <i class="bi bi-sliders me-2 text-success"></i>Stock Levels, Cost &amp; Supplier
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Quantity On Hand</label>
                                    <input type="number" min="0" step="any"
                                           class="form-control @(showErrors && Negative(qtyInput) ? "border-danger" : "")"
                                           @bind="qtyInput" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Reorder Level</label>
                                    <input type="number" min="0" step="any"
                                           class="form-control @(showErrors && Negative(reorderInput) ? "border-danger" : "")"
                                           @bind="reorderInput" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Unit Cost (₱)</label>
                                    <input type="number" min="0" step="0.01"
                                           class="form-control @(showErrors && Negative(costInput) ? "border-danger" : "")"
                                           @bind="costInput" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Selling Price (₱)</label>
                                    <input type="number" min="0" step="0.01"
                                           class="form-control @(showErrors && Negative(sellingPriceInput) ? "border-danger" : "")"
                                           @bind="sellingPriceInput" />
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-bold small text-muted">Supplier</label>
                                    <select class="form-select" @bind="selectedSupplierIdStr">
                                        <option value="">-- Select Supplier --</option>
                                        @foreach (var sup in suppliers)
                                        {
                                            <option value="@sup.SupplierId">@sup.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- SECTION 3: Storage & Notes -->
                        <div class="p-4 rounded-4" style="background-color: #F7FAF8; border: 1px dashed #C6DFCE;">
                            <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                                <i class="bi bi-geo-alt me-2 text-success"></i>Storage &amp; Notes
                            </h6>
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label fw-bold small text-muted">Storage Location</label>
                                    <input class="form-control border-0 shadow-sm" placeholder="e.g. Fertilizer shed"
                                           @bind="form.StorageLocation"
                                           @bind:after="() => form.StorageLocation = CapitalizeWords(form.StorageLocation)" />
                                </div>
                                <div class="col-12 mt-3">
                                    <label class="form-label fw-bold small text-muted">Notes</label>
                                    <textarea class="form-control border-0 shadow-sm" rows="3" @bind="form.Notes"></textarea>
                                </div>
                            </div>
                        </div>

                        @if (showErrors && AnyNegative)
                        {
                            <div class="err mt-3"><i class="bi bi-exclamation-circle"></i> Quantity, reorder level, cost, and selling price can’t be negative.</div>
                        }
                    </form>
                </div>

                <!-- Footer -->
                <div class="modal-footer border-0 p-4 d-flex justify-content-end gap-2" style="background-color: #F4F7F5;">
                    <button type="button" class="btn btn-light border fw-bold px-4 rounded-3 shadow-sm" @onclick="CloseModal">Cancel</button>
                    <button type="button" class="btn-save px-5 shadow-sm" @onclick="SaveAsync" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <i class="bi bi-check2-circle me-2"></i>
                            <span>@(editingId == null ? "Save Item" : "Update Item")</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

