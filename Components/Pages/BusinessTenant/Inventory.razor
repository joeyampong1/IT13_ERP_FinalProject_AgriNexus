    async Task SaveAsync()
    {
        showErrors = true;
        if (string.IsNullOrWhiteSpace(form.ItemName) || SkuTaken || AnyNegative || !string.IsNullOrEmpty(imageError)) return;

        isSaving = true;
        try
        {
            var savedImageUrl = await SaveImageFileAsync();
            int? parsedSupplierId = int.TryParse(selectedSupplierIdStr, out var supId) && supId > 0 ? supId : null;
            var cleanName = form.ItemName.Trim();
            var cleanSku = string.IsNullOrWhiteSpace(form.ItemCode) ? NextSku(form.Category) : form.ItemCode.Trim().ToUpper();
            var cleanCategory = string.Equals(form.ItemType, "PRODUCE", StringComparison.OrdinalIgnoreCase)
                ? "produce"
                : (string.IsNullOrWhiteSpace(form.Category) ? "supplies" : form.Category.Trim());

            if (editingId == null)
            {
                var created = new InventoryItem
                {
                    BusinessId = currentBusinessId,
                    BranchId = currentBranchId,
                    ItemName = cleanName,
                    ItemCode = cleanSku,
                    Category = cleanCategory,
                    ItemType = "SUPPLY",
                    QuantityOnHand = qtyInput ?? 0,
                    ReorderLevel = reorderInput ?? 0,
                    UnitCost = costInput ?? 0,
                    SellingPrice = sellingPriceInput ?? 0,
                    Unit = string.IsNullOrWhiteSpace(form.Unit) ? "kg" : form.Unit.Trim(),
                    StorageLocation = (form.StorageLocation ?? "").Trim(),
                    SupplierId = parsedSupplierId,
                    Notes = (form.Notes ?? "").Trim(),
                    IsArchived = false,
                    ImageUrl = savedImageUrl
                };

                DbContext.InventoryItems.Add(created);
                await DbContext.SaveChangesAsync();
                await ShowToast("Inventory item saved successfully.");
            }
            else
            {
                var existing = await DbContext.InventoryItems.FindAsync(editingId.Value);
                if (existing != null)
                {
                    existing.ItemName = cleanName;
                    existing.ItemCode = cleanSku;
                    existing.Category = cleanCategory;
                    existing.QuantityOnHand = qtyInput ?? 0;
                    existing.ReorderLevel = reorderInput ?? 0;
                    existing.UnitCost = costInput ?? 0;
                    existing.SellingPrice = sellingPriceInput ?? 0;
                    existing.Unit = string.IsNullOrWhiteSpace(form.Unit) ? "kg" : form.Unit.Trim();
                    existing.StorageLocation = (form.StorageLocation ?? "").Trim();
                    existing.SupplierId = parsedSupplierId;
                    existing.Notes = (form.Notes ?? "").Trim();
                    existing.ImageUrl = savedImageUrl;

                    DbContext.InventoryItems.Update(existing);
                    await DbContext.SaveChangesAsync();
                    await ShowToast("Inventory item updated.");
                }
            }

            showModal = false;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            await ShowToast("Error saving item: " + ex.Message, isWarning: true);
        }
        finally
        {
            isSaving = false;
        }
    }

