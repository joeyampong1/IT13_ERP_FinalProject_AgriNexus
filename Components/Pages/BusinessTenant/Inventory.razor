                    {
                        <button type="button" class="btn-save px-5 shadow-sm" @onclick="() => OpenEdit(selectedItem)">
                            <i class="bi bi-pencil-square me-2"></i>Edit Item
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

