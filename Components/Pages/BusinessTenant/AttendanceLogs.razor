@page "/attendance"
@layout MainLayout
@using System.Globalization
@using System.Reflection
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Web
@using AgriNexus.DataLayer
@using AgriNexus.DataLayer.Models
@inject AgriNexusDbContext DbContext
@inject AgriNexus.Services.AuthService Auth
@inject IJSRuntime JS

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="page-title">Labor Attendance and Work Logs</h2>
        <p class="text-muted mb-0 page-sub">
            <i class="bi bi-building text-success me-1"></i><strong>@ActiveBranch</strong> · daily attendance, hours worked and computed labor cost per worker, task and plot.
        </p>
    </div>
    <span class="badge rounded-pill px-3 py-2 fw-semibold" style="background-color: #E8F3EC; color: #1B5E34; border: 1px solid #C6DFCE;">
        <i class="bi bi-clock-history me-1"></i> Attendance &amp; Labor Ledger
    </span>
</div>

<!-- STAT CARDS -->
<div class="row g-3 mb-4">
    @foreach (var s in Stats)
    {
        <div class="col-12 col-md-4">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <span class="card-title">@s.Title</span>
                    <div class="stat-icon @s.IconClass"><i class="bi @s.Icon"></i></div>
                </div>
                <div class="mt-3">
                    <div class="card-value">@s.Value</div>
                    @if (!string.IsNullOrEmpty(s.Note))
                    {
                        <div class="text-muted small mt-1">@s.Note</div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- TOOLBAR WITH ACTIVE / ARCHIVED TOGGLE + FILTERS -->
<div class="toolbar mb-3 d-flex flex-wrap align-items-center gap-3">

    <div class="btn-group shadow-sm" role="group" aria-label="View Tabs">
        <input type="radio" class="btn-check" name="attViewTabs" id="tabAttActive" autocomplete="off"
               checked="@(!showArchived)" @onchange="() => ToggleTab(false)">
        <label class="btn btn-outline-success fw-bold" for="tabAttActive">
            <i class="bi bi-check-circle me-1"></i> Active
        </label>

        <input type="radio" class="btn-check" name="attViewTabs" id="tabAttArchived" autocomplete="off"
               checked="@showArchived" @onchange="() => ToggleTab(true)">
        <label class="btn btn-outline-secondary fw-bold" for="tabAttArchived">
            <i class="bi bi-archive me-1"></i> Archived
        </label>
    </div>

    <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="text" placeholder="Search work logs..."
               @bind="searchText"
               @bind:event="oninput"
               @bind:after="ResetPagination" />
    </div>

    <select class="filter-select" @bind="dateRangeFilter" @bind:after="ResetPagination">
        <option value="all">All Time</option>
        <option value="month">This Month</option>
        <option value="90days">Last 90 Days</option>
        <option value="year">This Year</option>
    </select>

    @if (!showArchived)
    {
        <select class="filter-select" @bind="statusFilter" @bind:after="ResetPagination">
            <option value="">All statuses</option>
            <option value="recorded">Recorded</option>
            <option value="approved">Approved</option>
        </select>
    }

    <span class="badge rounded-pill px-3 py-2 fw-semibold count-label" style="background-color: #FFFFFF; color: #0A2B1D; border: 1px solid #E2ECE6;">
        <i class="bi bi-clock-history me-1 text-success"></i>@Filtered.Count work @(Filtered.Count == 1 ? "log" : "logs")
    </span>

    @if (!showArchived)
    {
        <button type="button" class="btn-new ms-auto shadow-sm" @onclick="OpenNew">
            <i class="bi bi-plus-lg"></i> New work log
        </button>
    }
</div>

<!-- TABLE -->
<div class="panel shadow-sm bg-white d-flex flex-column" style="border-radius: 16px; border: 1px solid #E2ECE6; max-height: calc(100vh - 280px); overflow: hidden;">
    <div class="table-responsive" style="flex-grow: 1; overflow-y: auto;">
        <table class="table table-hover align-middle mb-0 biz-table" style="width: 100%;">
            <thead style="position: sticky; top: 0; z-index: 1; background-color: #F7FAF8;">
                <tr>
                    <th class="text-muted small fw-bold text-uppercase py-3 px-4">Date</th>
                    <th class="text-muted small fw-bold text-uppercase py-3">Worker</th>
                    <th class="text-muted small fw-bold text-uppercase py-3">Task</th>
                    <th class="text-muted small fw-bold text-uppercase py-3">Plot</th>
                    <th class="text-muted small fw-bold text-uppercase py-3">Hours</th>
                    <th class="text-muted small fw-bold text-uppercase py-3">Labor cost</th>
                    <th class="text-muted small fw-bold text-uppercase py-3">Status</th>
                    <th class="py-3"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in PaginatedLogs)
                {
                    var wName = WorkerNameOf(l.WorkerId);
                    var pName = PlotNameOf(l.PlotId);

                    <tr style="cursor: pointer;" @onclick="() => OpenDetails(l)">
                        <td class="text-nowrap px-4 text-muted small fw-medium">
                            <i class="bi bi-calendar3 text-success me-1"></i>@l.WorkDate.ToString("MMM d, yyyy", Inv)
                        </td>
                        <td class="col-worker">
                            <div class="d-flex align-items-center gap-3">
                                <div class="biz-avatar">
                                    <i class="bi bi-person"></i>
                                </div>
                                <span class="fw-bold" style="color: #0A2B1D;">@(string.IsNullOrWhiteSpace(wName) ? "—" : wName)</span>
                            </div>
                        </td>
                        <td class="col-task text-dark fw-medium">@(string.IsNullOrWhiteSpace(l.Task) ? "—" : l.Task)</td>
                        <td class="col-plot text-dark">@(string.IsNullOrWhiteSpace(pName) ? "—" : pName)</td>
                        <td class="text-nowrap fw-semibold text-dark">@Hrs(l.HoursWorked)</td>
                        <td class="text-nowrap fw-semibold text-dark">@Peso(Cost(l))</td>
                        <td>
                            <span class="pill @StatusPillClass(l.Status)">
                                <i class="bi @StatusIcon(l.Status) me-1"></i>@Cap(l.Status)
                            </span>
                        </td>
                        <td class="text-end px-4 action-cell">
                            <button type="button" class="btn-dots"
                                    @onclick="(e) => ToggleMenuAsync(e, l)"
                                    @onclick:stopPropagation="true" aria-label="Actions">
                                <i class="bi bi-three-dots"></i>
                            </button>
                        </td>
                    </tr>
                }
                @if (Filtered.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-5">
                            <i class="bi bi-inbox fs-3 d-block mb-2 opacity-50"></i>
                            @(showArchived ? "No archived work logs found." : "No work logs found.")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Filtered.Count > 0)
    {
        <div class="d-flex flex-wrap justify-content-between align-items-center p-3 border-top bg-white" style="flex-shrink: 0; border-color: #E2ECE6 !important; border-radius: 0 0 16px 16px;">
            <div class="text-muted small mb-2 mb-md-0">
                Showing <span class="fw-bold" style="color: #0A2B1D;">@StartItem</span> - <span class="fw-bold" style="color: #0A2B1D;">@EndItem</span> of <span class="fw-bold" style="color: #0A2B1D;">@Filtered.Count</span> logs
            </div>

            <div class="d-flex gap-1">
                <button class="btn btn-sm btn-light border px-3 rounded-2 fw-medium" @onclick="PreviousPage" disabled="@(currentPage == 1)">
                    <i class="bi bi-chevron-left me-1"></i>Previous
                </button>

                @for (int p = 1; p <= TotalPages; p++)
                {
                    var pageNumber = p;
                    <button class="btn btn-sm px-3 rounded-2 fw-bold @(currentPage == pageNumber ? "btn-new text-white shadow-sm" : "btn-light border text-dark")"
                            @onclick="() => GoToPage(pageNumber)">
                        @pageNumber
                    </button>
                }

                <button class="btn btn-sm btn-light border px-3 rounded-2 fw-medium" @onclick="NextPage" disabled="@(currentPage == TotalPages)">
                    Next<i class="bi bi-chevron-right ms-1"></i>
                </button>
            </div>
        </div>
    }
</div>

<!-- FLOATING ACTION MENU -->
@if (openMenuId != null)
{
    var menuLog = logs.FirstOrDefault(x => x.AttendanceId == openMenuId);
    if (menuLog != null)
    {
        var st = (menuLog.Status ?? "recorded").ToLower();

        <div class="menu-backdrop" @onclick="CloseMenu" @onclick:stopPropagation="true"></div>

        <div class="vertical-action-menu shadow-lg" style="top:@(menuTop)px; left:@(menuLeft)px;">
            @if (st != "archived")
            {
                <button type="button" class="action-item"
                        @onclick="() => OpenEdit(menuLog)"
                        @onclick:stopPropagation="true">
                    <i class="bi bi-pencil-square text-success"></i> Edit
                </button>

                @if (st != "approved")
                {
                    <button type="button" class="action-item"
                            @onclick="() => ApproveAsync(menuLog)"
                            @onclick:stopPropagation="true">
                        <i class="bi bi-check-circle text-success"></i> Approve log
                    </button>
                }

                <button type="button" class="action-item text-earth"
                        @onclick="() => PromptArchive(menuLog)"
                        @onclick:stopPropagation="true">
                    <i class="bi bi-archive"></i> Archive
                </button>
            }
            else
            {
                <button type="button" class="action-item text-success"
                        @onclick="() => RestoreLogAsync(menuLog)"
                        @onclick:stopPropagation="true">
                    <i class="bi bi-arrow-counterclockwise"></i> Restore
                </button>
            }
        </div>
    }
}

<!-- DETAILS MODAL (ROW CLICK) -->
@if (showDetailsModal && selectedLog != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(10, 43, 29, 0.65); backdrop-filter: blur(5px); z-index: 1050;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation="true">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

                <div class="modal-header border-0 p-4 d-flex justify-content-between align-items-center" style="background-color: #F4F7F5;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; background-color: #E8F3EC; color: #1B5E34;">
                            <i class="bi bi-clock-history fs-4"></i>
                        </div>
                        <div>
                            <h4 class="modal-title fw-bolder mb-0" style="color: #0A2B1D;">@WorkerNameOf(selectedLog.WorkerId)</h4>
                            <span class="badge px-2 py-1 mt-1 rounded-pill" style="background-color: #FFFFFF; color: #1B5E34; border: 1px solid #C6DFCE;">
                                <i class="bi bi-calendar3 me-1"></i>@selectedLog.WorkDate.ToString("MMMM d, yyyy", Inv)
                            </span>
                        </div>
                    </div>
                    <button type="button" class="btn-close bg-white shadow-sm rounded-circle p-2" @onclick="CloseDetailsModal" aria-label="Close" style="width: 32px; height: 32px;"></button>
                </div>

                <div class="modal-body p-4" style="max-height: 70vh; overflow-y: auto;">
                    <div class="mb-4">
                        <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                            <i class="bi bi-info-circle me-2 text-success"></i>Work Log Details
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="text-muted small fw-bold text-uppercase">Task Performed</label>
                                <p class="mb-0 fw-semibold fs-6 text-dark">@(string.IsNullOrWhiteSpace(selectedLog.Task) ? "—" : selectedLog.Task)</p>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted small fw-bold text-uppercase">Plot</label>
                                <p class="mb-0 fw-semibold fs-6 text-dark">@PlotNameOf(selectedLog.PlotId)</p>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label class="text-muted small fw-bold text-uppercase">Daily Rate</label>
                                <p class="mb-0 fw-medium text-dark">@Peso(DailyRateOf(selectedLog.WorkerId))</p>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label class="text-muted small fw-bold text-uppercase d-block mb-1">Status</label>
                                <span class="pill @StatusPillClass(selectedLog.Status)">
                                    <i class="bi @StatusIcon(selectedLog.Status) me-1"></i>@Cap(selectedLog.Status)
                                </span>
                            </div>
                            <div class="col-12 mt-3">
                                <label class="text-muted small fw-bold text-uppercase">Notes</label>
                                <p class="mb-0 text-muted fst-italic">
                                    @(string.IsNullOrWhiteSpace(selectedLog.Notes) ? "No notes provided." : selectedLog.Notes)
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="p-4 rounded-4" style="background-color: #F7FAF8; border: 1px dashed #C6DFCE;">
                        <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                            <i class="bi bi-calculator me-2 text-success"></i>Hours &amp; Computed Labor Cost
                        </h6>
                        <div class="row g-3 text-center">
                            <div class="col-md-6">
                                <div class="p-3 bg-white rounded-3 border" style="border-color: #E2ECE6 !important;">
                                    <h4 class="fw-bolder mb-0" style="color: #0A2B1D;">@Hrs(selectedLog.HoursWorked) hrs</h4>
                                    <small class="text-muted fw-medium">Hours Worked</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 bg-white rounded-3 border" style="border-color: #E2ECE6 !important;">
                                    <h4 class="fw-bolder mb-0" style="color: #1B5E34;">@Peso(Cost(selectedLog))</h4>
                                    <small class="text-muted fw-medium">Computed Labor Cost</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-0 p-4 d-flex justify-content-between" style="background-color: #F4F7F5;">
                    <button type="button" class="btn btn-light border fw-bold px-4 rounded-3 shadow-sm" @onclick="CloseDetailsModal">Close</button>
                    @if (!string.Equals(selectedLog.Status, "archived", StringComparison.OrdinalIgnoreCase))
                    {
                        <button type="button" class="btn-save px-5 shadow-sm" @onclick="() => OpenEdit(selectedLog)">
                            <i class="bi bi-pencil-square me-2"></i>Edit Details
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- ADD / EDIT MODAL -->
@if (showModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(10, 43, 29, 0.65); backdrop-filter: blur(5px); z-index: 1050;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation="true">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

                <div class="modal-header border-0 p-4" style="background-color: #F4F7F5;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; background-color: #E8F3EC; color: #1B5E34;">
                            <i class="bi @(editingId == null ? "bi-clock-history" : "bi-pencil-square") fs-5"></i>
                        </div>
                        <div>
                            <h4 class="modal-title fw-bolder mb-0" style="color: #0A2B1D;">
                                @(editingId == null ? "New Work Log" : "Edit Work Log")
                            </h4>
                            <p class="text-muted small mb-0">Record daily worker hours, task performed, and computed labor cost.</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close bg-white shadow-sm rounded-circle p-2" @onclick="CloseModal" aria-label="Close" style="width: 32px; height: 32px;"></button>
                </div>

                <div class="modal-body p-4" style="max-height: 70vh; overflow-y: auto;">
                    <form>
                        <div class="mb-4">
                            <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                                <i class="bi bi-person-badge me-2 text-success"></i>Worker, Date &amp; Hours
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Worker <span class="text-danger">*</span></label>
                                    <div class="input-group modern-input @(showErrors && string.IsNullOrWhiteSpace(selectedWorkerIdStr) ? "border border-danger rounded-3" : "")">
                                        <span class="input-group-text bg-white"><i class="bi bi-person text-success"></i></span>
                                        <select class="form-select" @bind="selectedWorkerIdStr">
                                            <option value="">-- Select Worker --</option>
                                            @foreach (var w in workers)
                                            {
                                                <option value="@w.WorkerId">@w.FullName (@Peso(w.DailyRate)/day)</option>
                                            }
                                        </select>
                                    </div>
                                    @if (showErrors && string.IsNullOrWhiteSpace(selectedWorkerIdStr))
                                    {
                                        <div class="text-danger small mt-1 fw-bold"><i class="bi bi-exclamation-triangle me-1"></i>Please select a worker.</div>
                                    }
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Work Date</label>
                                    <input type="date" class="form-control" @bind="form.WorkDate" />
                                </div>

                                <div class="col-md-6 mt-4">
                                    <label class="form-label fw-bold small text-muted">Hours Worked <span class="text-danger">*</span></label>
                                    <input type="number" min="0" max="24" step="0.5"
                                           class="form-control @(showErrors && HoursInvalid ? "is-invalid" : "")"
                                           @bind="hoursInput" />
                                    @if (showErrors && HoursInvalid)
                                    {
                                        <div class="text-danger small mt-1 fw-bold"><i class="bi bi-exclamation-triangle me-1"></i>Enter hours between 0.5 and 24.</div>
                                    }
                                </div>

                                <div class="col-md-6 mt-4">
                                    <label class="form-label fw-bold small text-muted">Task Performed</label>
                                    <input class="form-control" placeholder="Irrigation, weeding, harvesting..."
                                           @bind="form.Task"
                                           @bind:after="() => form.Task = CapitalizeWords(form.Task)" />
                                </div>
                            </div>
                        </div>

                        <div class="p-4 rounded-4" style="background-color: #F7FAF8; border: 1px dashed #C6DFCE;">
                            <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                                <i class="bi bi-geo-alt me-2 text-success"></i>Plot, Status &amp; Notes
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Plot</label>
                                    @if (plotOptions.Count > 0)
                                    {
                                        <select class="form-select border-0 shadow-sm" @bind="selectedPlotIdStr">
                                            <option value="">-- Select Plot --</option>
                                            @foreach (var p in plotOptions)
                                            {
                                                <option value="@p.Id">@p.Name</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <input type="number" class="form-control border-0 shadow-sm" placeholder="Plot ID (optional)" @bind="form.PlotId" />
                                    }
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Status</label>
                                    <select class="form-select border-0 shadow-sm" @bind="form.Status">
                                        <option value="recorded">recorded</option>
                                        <option value="approved">approved</option>
                                    </select>
                                </div>

                                <div class="col-12 mt-3">
                                    <label class="form-label fw-bold small text-muted">Notes</label>
                                    <textarea class="form-control border-0 shadow-sm" rows="3" @bind="form.Notes"></textarea>
                                </div>
                            </div>
                        </div>

                        @if (EstimatedCost.HasValue)
                        {
                            <div class="hint mt-3">
                                <i class="bi bi-calculator"></i> Computed labor cost: <strong>@Peso(EstimatedCost.Value)</strong> (daily rate ÷ 8 hours × hours worked)
                            </div>
                        }
                    </form>
                </div>

                <div class="modal-footer border-0 p-4 d-flex justify-content-end gap-2" style="background-color: #F4F7F5;">
                    <button type="button" class="btn btn-light border fw-bold px-4 rounded-3 shadow-sm" @onclick="CloseModal">Cancel</button>
                    <button type="button" class="btn-save px-5 shadow-sm" @onclick="PromptSave" disabled="@isSaving">
                        <i class="bi bi-check2-circle me-2"></i>@(editingId == null ? "Save Work Log" : "Update Work Log")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- SAVE CONFIRMATION MODAL -->
@if (showConfirmSaveModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(10, 43, 29, 0.65); backdrop-filter: blur(4px); z-index: 1060;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content border-0 shadow-lg rounded-4 text-center">
                <div class="modal-body p-4 mt-2">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px; background-color: #E8F3EC; color: #1B5E34;">
                        <i class="bi bi-check2" style="font-size: 2.5rem;"></i>
                    </div>

                    <h4 class="fw-bolder mb-2" style="color: #0A2B1D;">@(editingId == null ? "Save Work Log?" : "Update Work Log?")</h4>
                    <p class="text-muted small mb-4">
                        @(editingId == null
                            ? "Are you sure you want to save this attendance work log?"
                            : "Are you sure you want to save changes to this work log?")
                    </p>

                    <div class="d-flex justify-content-center gap-3">
                        <button type="button" class="btn btn-light border rounded-3 fw-bold px-4" @onclick="CancelSaveConfirm">Cancel</button>
                        <button type="button" class="btn-save rounded-3 fw-bold px-4 shadow-sm" disabled="@isSaving" @onclick="ConfirmSaveAsync">
                            @(isSaving ? "Saving..." : "Yes, Save")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- ARCHIVE CONFIRMATION MODAL -->
@if (showConfirmArchiveModal && logToArchive != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(10, 43, 29, 0.65); backdrop-filter: blur(4px); z-index: 1060;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content border-0 shadow-lg rounded-4 text-center">
                <div class="modal-body p-4 mt-2">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px; background-color: #F5EFEA; color: #7A5230;">
                        <i class="bi bi-archive" style="font-size: 2.5rem;"></i>
                    </div>

                    <h4 class="fw-bolder mb-2" style="color: #0A2B1D;">Archive Work Log?</h4>
                    <p class="text-muted small mb-4">
                        Are you sure you want to archive the work log for <strong>@WorkerNameOf(logToArchive.WorkerId)</strong> on <strong>@logToArchive.WorkDate.ToString("MMM d, yyyy", Inv)</strong>?
                    </p>

                    <div class="d-flex justify-content-center gap-3">
                        <button type="button" class="btn btn-light border rounded-3 fw-bold px-4" @onclick="CancelArchiveConfirm">Cancel</button>
                        <button type="button" class="btn-earth rounded-3 fw-bold px-4 shadow-sm" disabled="@isSaving" @onclick="ConfirmArchiveAsync">
                            <i class="bi bi-archive me-1"></i> Yes, Archive
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(toast))
{
    <div class="toast-note shadow-lg">
        <i class="bi @(toastIsWarning ? "bi-exclamation-circle" : "bi-check2")"></i>
        <span>@toast</span>
    </div>
}

@code {
    record Stat(string Title, string Value, string Note, string Icon, string IconClass);
    record PlotOption(int Id, string Name);

    class Viewport
    {
        public double W { get; set; }
        public double H { get; set; }
    }

    static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    long currentBusinessId;
    long? currentBranchId;
    string ActiveBranch = "All Branches";

    List<Branch> branches = new();
    List<AgriNexus.DataLayer.Models.Worker> workers = new();
    List<PlotOption> plotOptions = new();
    List<AttendanceLog> logs = new();

    bool showArchived = false;
    string searchText = "";
    string dateRangeFilter = "all"; // all | month | 90days | year
    string statusFilter = ""; // "" | recorded | approved
    string selectedWorkerIdStr = "";
    string selectedPlotIdStr = "";
    string toast = "";
    bool toastIsWarning = false;

    bool showModal;
    bool showErrors;
    bool isSaving;
    int? editingId;
    int? openMenuId;
    AttendanceLog form = new();
    decimal? hoursInput = 8;

    bool showDetailsModal;
    AttendanceLog? selectedLog;

    bool showConfirmSaveModal;
    bool showConfirmArchiveModal;
    AttendanceLog? logToArchive;

    private int currentPage = 1;
    private int pageSize = 5;
    private double menuTop;
    private double menuLeft;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            User? currentUser = null;

            if (Auth.CurrentUserId > 0)
            {
                currentUser = await DbContext.Users
                    .Include(u => u.Business)
                    .FirstOrDefaultAsync(u => u.UserId == Auth.CurrentUserId);
            }
            else if (!string.IsNullOrWhiteSpace(Auth.CurrentUserEmail))
            {
                var cleanEmail = Auth.CurrentUserEmail.Trim().ToLower();
                currentUser = await DbContext.Users
                    .Include(u => u.Business)
                    .FirstOrDefaultAsync(u => u.Email != null && u.Email.ToLower() == cleanEmail);
            }
            else if (!string.IsNullOrWhiteSpace(Auth.CurrentUserName))
            {
                currentUser = await DbContext.Users
                    .Include(u => u.Business)
                    .FirstOrDefaultAsync(u => (u.FName + " " + u.LName) == Auth.CurrentUserName
                                           || u.FName == Auth.CurrentUserName);
            }

            if (currentUser?.BusinessId != null)
            {
                currentBusinessId = currentUser.BusinessId.Value;
                currentBranchId = currentUser.BranchId;
            }
            else
            {
                var firstBiz = await DbContext.Businesses.FirstOrDefaultAsync();
                if (firstBiz != null) currentBusinessId = firstBiz.BusinessId;
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            await ShowToast("Error loading attendance logs: " + ex.Message, isWarning: true);
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            branches = await DbContext.Branches
                .Where(b => b.BusinessId == currentBusinessId)
                .OrderBy(b => b.BranchName)
                .ToListAsync();

            if (currentBranchId.HasValue)
            {
                var matched = branches.FirstOrDefault(b => b.BranchId == currentBranchId.Value);
                if (matched != null) ActiveBranch = matched.BranchName;
            }
            else if (branches.Count > 0)
            {
                ActiveBranch = branches[0].BranchName;
            }

            var branchIds = branches.Select(b => b.BranchId).ToHashSet();

            var allBranchWorkers = await DbContext.Workers
                .Where(w => branchIds.Contains(w.BranchId))
                .ToListAsync();

            var workerIds = allBranchWorkers.Select(w => w.WorkerId).ToHashSet();
            workers = allBranchWorkers
                .Where(w => !string.Equals(w.Status, "archived", StringComparison.OrdinalIgnoreCase))
                .OrderBy(w => w.FullName)
                .ToList();

            plotOptions = await TryLoadPlotsAsync();

            logs = await DbContext.AttendanceLogs
                .Where(l => workerIds.Contains(l.WorkerId))
                .OrderByDescending(l => l.WorkDate)
                .ThenByDescending(l => l.AttendanceId)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            await ShowToast("Database load error: " + ex.Message, isWarning: true);
        }
    }

    private async Task<List<PlotOption>> TryLoadPlotsAsync()
    {
        var result = new List<PlotOption>();
        try
        {
            var prop = DbContext.GetType().GetProperties(BindingFlags.Public | BindingFlags.Instance)
                .FirstOrDefault(p => p.Name.Equals("Plots", StringComparison.OrdinalIgnoreCase)
                                  || p.Name.Equals("FarmPlots", StringComparison.OrdinalIgnoreCase));

            if (prop?.GetValue(DbContext) is System.Collections.IEnumerable rawSet)
            {
                foreach (var entity in rawSet)
                {
                    if (entity == null) continue;
                    var t = entity.GetType();
                    var idProp = t.GetProperty("PlotId") ?? t.GetProperty("Id");
                    var nameProp = t.GetProperty("PlotName") ?? t.GetProperty("Name") ?? t.GetProperty("Code");
                    if (idProp != null && nameProp != null)
                    {
                        if (int.TryParse(idProp.GetValue(entity)?.ToString(), out var id))
                        {
                            var name = nameProp.GetValue(entity)?.ToString() ?? $"Plot #{id}";
                            result.Add(new PlotOption(id, name));
                        }
                    }
                }
            }
        }
        catch
        {
            // Ignore if plots DbSet is not present yet
        }
        return await Task.FromResult(result.OrderBy(p => p.Name).ToList());
    }

    List<AttendanceLog> NonArchivedLogs => logs
        .Where(l => !string.Equals(l.Status, "archived", StringComparison.OrdinalIgnoreCase))
        .ToList();

    DateTime? DateCutoff => dateRangeFilter switch
    {
        "month" => new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1),
        "90days" => DateTime.Today.AddDays(-90),
        "year" => new DateTime(DateTime.Today.Year, 1, 1),
        _ => null
    };

    string WorkerNameOf(int workerId) =>
        workers.FirstOrDefault(w => w.WorkerId == workerId)?.FullName
        ?? DbContext.Workers.Local.FirstOrDefault(w => w.WorkerId == workerId)?.FullName
        ?? "—";

    decimal DailyRateOf(int workerId) =>
        workers.FirstOrDefault(w => w.WorkerId == workerId)?.DailyRate
        ?? DbContext.Workers.Local.FirstOrDefault(w => w.WorkerId == workerId)?.DailyRate
        ?? 0m;

    string PlotNameOf(int? plotId)
    {
        if (!plotId.HasValue) return "—";
        var matched = plotOptions.FirstOrDefault(p => p.Id == plotId.Value);
        return matched != null ? matched.Name : $"Plot #{plotId.Value}";
    }

    List<AttendanceLog> Filtered
    {
        get
        {
            var baseList = logs
                .Where(l => showArchived
                    ? string.Equals(l.Status, "archived", StringComparison.OrdinalIgnoreCase)
                    : !string.Equals(l.Status, "archived", StringComparison.OrdinalIgnoreCase))
                .ToList();

            var cutoff = DateCutoff;
            if (cutoff.HasValue)
                baseList = baseList.Where(l => l.WorkDate.Date >= cutoff.Value).ToList();

            if (!showArchived && !string.IsNullOrEmpty(statusFilter))
                baseList = baseList.Where(l => string.Equals(l.Status, statusFilter, StringComparison.OrdinalIgnoreCase)).ToList();

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                baseList = baseList.Where(l =>
                    WorkerNameOf(l.WorkerId).Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    (l.Task ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    PlotNameOf(l.PlotId).Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    (l.Status ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase)).ToList();
            }

            return baseList.OrderByDescending(l => l.WorkDate).ThenByDescending(l => l.AttendanceId).ToList();
        }
    }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)Filtered.Count / pageSize));
    private int StartItem => Filtered.Count == 0 ? 0 : (currentPage - 1) * pageSize + 1;
    private int EndItem => Math.Min(currentPage * pageSize, Filtered.Count);
    private IEnumerable<AttendanceLog> PaginatedLogs => Filtered.Skip((currentPage - 1) * pageSize).Take(pageSize);

    List<Stat> Stats
    {
        get
        {
            var today = DateTime.Today;
            var activeList = NonArchivedLogs;
            var month = activeList.Where(l => l.WorkDate.Year == today.Year && l.WorkDate.Month == today.Month).ToList();
            var waiting = activeList.Count(l => string.Equals(l.Status, "recorded", StringComparison.OrdinalIgnoreCase));

            return new()
            {
                new("LOGS THIS MONTH", month.Count.ToString(), activeList.Count + " logs in history", "bi-clock-history", ""),
                new("HOURS THIS MONTH", Hrs(month.Sum(l => l.HoursWorked)), "", "bi-clock", "stat-icon-leaf"),
                new("LABOR COST THIS MONTH", Peso(month.Sum(Cost)), waiting + " logs awaiting approval", "bi-cash-coin", "stat-icon-earth"),
            };
        }
    }

    bool HoursInvalid => !hoursInput.HasValue || hoursInput.Value < 0.5m || hoursInput.Value > 24m;

    decimal? EstimatedCost
    {
        get
        {
            if (!int.TryParse(selectedWorkerIdStr, out var wId) || wId <= 0) return null;
            if (!hoursInput.HasValue || hoursInput.Value < 0.5m || hoursInput.Value > 24m) return null;
            var rate = DailyRateOf(wId);
            return Math.Round(rate / 8m * hoursInput.Value, 2);
        }
    }

    decimal Cost(AttendanceLog l)
    {
        var rate = DailyRateOf(l.WorkerId);
        return Math.Round(rate / 8m * l.HoursWorked, 2);
    }

    static string Hrs(decimal v) => v.ToString("0.##", Inv);
    static string Peso(decimal v) => "₱" + v.ToString("N2", Inv);
    static string Cap(string? s) => string.IsNullOrWhiteSpace(s) ? "" : char.ToUpper(s[0]) + s.Substring(1);

    static string StatusPillClass(string? s) =>
        string.Equals(s, "approved", StringComparison.OrdinalIgnoreCase) ? "pill-forest" : "pill-earth";

    static string StatusIcon(string? s) =>
        string.Equals(s, "approved", StringComparison.OrdinalIgnoreCase) ? "bi-check-circle" : "bi-clock-history";

    private string CapitalizeWords(string? input)
    {
        if (string.IsNullOrWhiteSpace(input)) return input ?? "";
        return CultureInfo.CurrentCulture.TextInfo.ToTitleCase(input.ToLower().Trim());
    }

    private void GoToPage(int page) => currentPage = page;
    private void PreviousPage() { if (currentPage > 1) currentPage--; }
    private void NextPage() { if (currentPage < TotalPages) currentPage++; }
    private void ResetPagination() => currentPage = 1;

    private async Task ToggleTab(bool archived)
    {
        showArchived = archived;
        if (archived) statusFilter = "";
        currentPage = 1;
        openMenuId = null;
        await Task.CompletedTask;
    }

    private async Task ToggleMenuAsync(MouseEventArgs e, AttendanceLog item)
    {
        if (openMenuId == item.AttendanceId)
        {
            openMenuId = null;
            return;
        }

        var st = (item.Status ?? "recorded").ToLower();
        int itemCount = st == "archived" ? 1 : (st == "approved" ? 2 : 3);

        const double itemHeight = 42;
        const double padding = 16;
        const double menuWidth = 185;
        double menuHeight = (itemCount * itemHeight) + padding;

        var viewport = await JS.InvokeAsync<Viewport>("eval", "({ w: window.innerWidth, h: window.innerHeight })");

        menuLeft = Math.Min(e.ClientX - menuWidth + 20, viewport.W - menuWidth - 10);
        menuTop = (e.ClientY + menuHeight > viewport.H) ? e.ClientY - menuHeight - 5 : e.ClientY + 15;

        openMenuId = item.AttendanceId;
    }

    void CloseMenu() => openMenuId = null;

    void OpenDetails(AttendanceLog l)
    {
        selectedLog = l;
        showDetailsModal = true;
    }

    void CloseDetailsModal()
    {
        showDetailsModal = false;
        selectedLog = null;
    }

    void OpenNew()
    {
        openMenuId = null;
        form = new AttendanceLog
        {
            WorkDate = DateTime.Today,
            HoursWorked = 8,
            Status = "recorded"
        };
        selectedWorkerIdStr = "";
        selectedPlotIdStr = "";
        hoursInput = 8;
        editingId = null;
        showErrors = false;
        showModal = true;
    }

    void OpenEdit(AttendanceLog l)
    {
        showDetailsModal = false;
        openMenuId = null;
        form = new AttendanceLog
        {
            AttendanceId = l.AttendanceId,
            WorkerId = l.WorkerId,
            PlotId = l.PlotId,
            WorkDate = l.WorkDate,
            Task = l.Task,
            HoursWorked = l.HoursWorked,
            Status = l.Status,
            Notes = l.Notes
        };
        selectedWorkerIdStr = l.WorkerId > 0 ? l.WorkerId.ToString() : "";
        selectedPlotIdStr = l.PlotId.HasValue ? l.PlotId.Value.ToString() : "";
        hoursInput = l.HoursWorked;
        editingId = l.AttendanceId;
        showErrors = false;
        showModal = true;
    }

    void CloseModal() => showModal = false;

    void PromptSave()
    {
        showErrors = true;
        if (string.IsNullOrWhiteSpace(selectedWorkerIdStr) || HoursInvalid)
            return;

        showConfirmSaveModal = true;
    }

    void CancelSaveConfirm() => showConfirmSaveModal = false;

    async Task ConfirmSaveAsync()
    {
        isSaving = true;
        try
        {
            if (!int.TryParse(selectedWorkerIdStr, out var workerId) || workerId <= 0)
            {
                await ShowToast("Please select a valid worker.", isWarning: true);
                return;
            }

            int? parsedPlotId = int.TryParse(selectedPlotIdStr, out var pId) && pId > 0
                ? pId
                : form.PlotId;

            var cleanTask = (form.Task ?? "").Trim();
            var cleanStatus = string.IsNullOrWhiteSpace(form.Status) ? "recorded" : form.Status.Trim().ToLower();

            if (editingId == null)
            {
                var created = new AttendanceLog
                {
                    WorkerId = workerId,
                    PlotId = parsedPlotId,
                    WorkDate = form.WorkDate,
                    Task = cleanTask,
                    HoursWorked = hoursInput ?? 8,
                    Status = cleanStatus,
                    Notes = string.IsNullOrWhiteSpace(form.Notes) ? null : form.Notes.Trim()
                };

                DbContext.AttendanceLogs.Add(created);
                await DbContext.SaveChangesAsync();
                await ShowToast("Work log saved.");
            }
            else
            {
                var existing = await DbContext.AttendanceLogs.FindAsync(editingId.Value);
                if (existing != null)
                {
                    existing.WorkerId = workerId;
                    existing.PlotId = parsedPlotId;
                    existing.WorkDate = form.WorkDate;
                    existing.Task = cleanTask;
                    existing.HoursWorked = hoursInput ?? 8;
                    existing.Status = cleanStatus;
                    existing.Notes = string.IsNullOrWhiteSpace(form.Notes) ? null : form.Notes.Trim();

                    DbContext.AttendanceLogs.Update(existing);
                    await DbContext.SaveChangesAsync();
                    await ShowToast("Work log updated.");
                }
            }

            showConfirmSaveModal = false;
            showModal = false;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            await ShowToast("Error saving work log: " + ex.Message, isWarning: true);
        }
        finally
        {
            isSaving = false;
        }
    }

    async Task ApproveAsync(AttendanceLog l)
    {
        openMenuId = null;
        try
        {
            var existing = await DbContext.AttendanceLogs.FindAsync(l.AttendanceId);
            if (existing != null)
            {
                existing.Status = "approved";
                DbContext.AttendanceLogs.Update(existing);
                await DbContext.SaveChangesAsync();
                await ShowToast("Work log for " + WorkerNameOf(l.WorkerId) + " approved.");
            }
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            await ShowToast("Error approving work log: " + ex.Message, isWarning: true);
        }
    }

    async Task PromptArchive(AttendanceLog l)
    {
        openMenuId = null;
        if (string.Equals(l.Status, "approved", StringComparison.OrdinalIgnoreCase))
        {
            await ShowToast("Approved logs are part of the labor cost records and can’t be archived.", isWarning: true);
            return;
        }

        logToArchive = l;
        showConfirmArchiveModal = true;
    }

    void CancelArchiveConfirm()
    {
        showConfirmArchiveModal = false;
        logToArchive = null;
    }

    async Task ConfirmArchiveAsync()
    {
        if (logToArchive == null) return;
        isSaving = true;
        try
        {
            var existing = await DbContext.AttendanceLogs.FindAsync(logToArchive.AttendanceId);
            if (existing != null)
            {
                if (string.Equals(existing.Status, "approved", StringComparison.OrdinalIgnoreCase))
                {
                    await ShowToast("Approved logs are part of the labor cost records and can’t be archived.", isWarning: true);
                    return;
                }

                existing.Status = "archived";
                DbContext.AttendanceLogs.Update(existing);
                await DbContext.SaveChangesAsync();
                await ShowToast("Work log moved to Archived.");
            }

            showConfirmArchiveModal = false;
            logToArchive = null;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            await ShowToast("Error archiving work log: " + ex.Message, isWarning: true);
        }
        finally
        {
            isSaving = false;
        }
    }

    async Task RestoreLogAsync(AttendanceLog l)
    {
        openMenuId = null;
        try
        {
            var existing = await DbContext.AttendanceLogs.FindAsync(l.AttendanceId);
            if (existing != null)
            {
                existing.Status = "recorded";
                DbContext.AttendanceLogs.Update(existing);
                await DbContext.SaveChangesAsync();
                await ShowToast("Work log restored to Active.");
            }
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            await ShowToast("Error restoring work log: " + ex.Message, isWarning: true);
        }
    }

    async Task ShowToast(string message, bool isWarning = false)
    {
        toast = message;
        toastIsWarning = isWarning;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(3200);
        toast = "";
        await InvokeAsync(StateHasChanged);
    }
}