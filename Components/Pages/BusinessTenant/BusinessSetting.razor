@page "/business-settings"
@using System.Globalization

<div class="mb-4">
    <h2 class="page-title">Business Profile &amp; Settings</h2>
    <p class="text-muted mb-0 page-sub">Tenant @TenantCode · keep the business identity and contact details your branches rely on.</p>
</div>

<!-- STAT CARDS -->
<div class="row g-3 mb-4">
    @foreach (var s in Stats)
    {
        <div class="col-12 col-md-4">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <span class="card-title">@s.Title</span>
                    <div class="stat-icon @s.IconClass"><i class="bi @s.Icon"></i></div>
                </div>
                <div class="mt-3">
                    <div class="card-value">@s.Value</div>
                    <div class="text-muted small mt-1">@s.Note</div>
                </div>
            </div>
        </div>
    }
</div>

<!-- BUSINESS PROFILE -->
<div class="card-box">
    <div class="panel-title">Business profile</div>
    <div class="panel-sub">Registered @Registered.ToString("MMM d, yyyy", Inv) · synchronization @form.Sync</div>

    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Business name <span class="req">*</span></label>
            <input class="form-control @(showErrors && string.IsNullOrWhiteSpace(form.Name) ? "is-invalid" : "")" @bind="form.Name" />
            @if (showErrors && string.IsNullOrWhiteSpace(form.Name))
            {
                <div class="err">Business name is required.</div>
            }
        </div>
        <div class="col-md-6">
            <label class="form-label">Owner / administrator</label>
            <input class="form-control" @bind="form.Owner" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Owner email</label>
            <input type="email" class="form-control @(showErrors && !EmailValid ? "is-invalid" : "")" @bind="form.Email" />
            @if (showErrors && !EmailValid)
            {
                <div class="err">Enter a valid email address.</div>
            }
        </div>
        <div class="col-md-6">
            <label class="form-label">Contact number</label>
            <input class="form-control" @bind="form.Contact" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Region / province</label>
            <input class="form-control" @bind="form.Province" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Synchronization mode</label>
            <select class="form-select" @bind="form.Sync">
                <option value="synced">synced</option>
                <option value="pending">pending</option>
                <option value="offline">offline</option>
            </select>
        </div>

        <div class="col-12">
            <label class="form-label">Business address</label>
            <input class="form-control" @bind="form.Address" />
        </div>
        <div class="col-12">
            <label class="form-label">Internal notes</label>
            <textarea class="form-control" rows="3" @bind="form.Notes"></textarea>
        </div>
    </div>

    <div class="mt-3">
        <button type="button" class="btn-save" @onclick="Save">Save changes</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(toast))
{
    <div class="toast-note"><i class="bi bi-check-circle-fill"></i> @toast</div>
}

@code {
    // ---------- MODELS ----------
    class Profile
    {
        public string Name { get; set; } = "";
        public string Owner { get; set; } = "";
        public string Email { get; set; } = "";
        public string Contact { get; set; } = "";
        public string Province { get; set; } = "";
        public string Sync { get; set; } = "synced";   // synced | pending | offline
        public string Address { get; set; } = "";
        public string Notes { get; set; } = "";
    }

    record Stat(string Title, string Value, string Note, string Icon, string IconClass);

    static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    // ---------- TEMPORARY DATA (ilisi sa database later) ----------
    // TODO: kuhaa gikan sa naka-login nga tenant
    const string TenantCode = "AGV-001";
    const string PlanName = "Growth";
    const string ActiveBranch = "North Field Branch";
    readonly DateTime Registered = new(2024, 2, 14);

    Profile form = new()
    {
        Name = "Verdant Agri Ventures",
        Owner = "Maria L. Santos",
        Email = "maria.santos@verdantagri.ph",
        Contact = "0917 555 0142",
        Province = "Nueva Ecija",
        Sync = "synced",
        Address = "Km 12, Maharlika Highway, Cabanatuan City",
        Notes = "Primary tenant for the prototype walkthrough.",
    };

    // ---------- STATE ----------
    bool showErrors;
    string toast = "";

    // ---------- COMPUTED ----------
    List<Stat> Stats => new()
    {
        new("TENANT CODE", TenantCode, "Used across branches and reports", "bi-buildings", ""),
        new("SUBSCRIBED PLAN", PlanName, "Account active", "bi-check-circle", "stat-icon-plain"),
        new("ACTIVE BRANCH CONTEXT", ActiveBranch, "Switch branch in the top bar", "bi-shop", "stat-icon-plain"),
    };

    bool EmailValid => string.IsNullOrWhiteSpace(form.Email) ||
        System.Text.RegularExpressions.Regex.IsMatch(form.Email.Trim(), @"^[^@\s]+@[^@\s]+\.[^@\s]+$");

    // ---------- ACTIONS ----------
    async Task Save()
    {
        showErrors = true;
        if (string.IsNullOrWhiteSpace(form.Name) || !EmailValid) return;

        showErrors = false;
        form.Name = form.Name.Trim();
        // TODO: i-save sa database, ug i-log sa Audit Logs (Update · Business Settings)

        toast = "Business profile saved.";
        await InvokeAsync(StateHasChanged);
        await Task.Delay(2500);
        toast = "";
        await InvokeAsync(StateHasChanged);
    }
}