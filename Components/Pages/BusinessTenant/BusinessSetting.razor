@page "/business-settings"
@layout MainLayout
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using AgriNexus.DataLayer
@using AgriNexus.DataLayer.Models
@using AgriNexus.Services
@inject AgriNexusDbContext DbContext
@inject AuthService Auth
@inject NavigationManager Nav

@if (isLoading)
{
    <div class="d-flex align-items-center justify-content-center py-5">
        <div class="spinner-border text-success me-2" role="status"></div>
        <span class="text-muted fw-medium">Loading business profile...</span>
    </div>
}
else if (!isTenantAdmin)
{
    <div class="card-box text-center py-5">
        <div class="mx-auto mb-3 d-inline-flex align-items-center justify-content-center rounded-circle"
             style="width: 64px; height: 64px; background-color: #F5EFEA; color: #7A5230;">
            <i class="bi bi-shield-lock-fill fs-2"></i>
        </div>
        <h4 class="fw-bolder mb-1" style="color: #0A2B1D;">Access Restricted</h4>
        <p class="text-muted small mb-4">Only the Business Tenant (Owner / Admin) can view and edit Business Profile &amp; Settings.</p>
        <button type="button" class="btn-save" @onclick="GoBack">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        </button>
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <h2 class="page-title"><i class="bi bi-building-gear text-success me-2"></i>Business Profile &amp; Settings</h2>
            <p class="text-muted mb-0 page-sub">
                Tenant <strong>@tenantCode</strong> · keep the business identity and contact details your branches rely on.
            </p>
        </div>
        <button type="button" class="btn-outline-lg" @onclick="GoToSubscription">
            <i class="bi bi-credit-card-2-front me-1"></i> My Subscription
        </button>
    </div>

    <!-- STAT CARDS -->
    <div class="row g-3 mb-4">
        @foreach (var s in Stats)
        {
            <div class="col-12 col-md-4">
                <div class="stat-card h-100">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <span class="card-title">@s.Title</span>
                        <div class="stat-icon @s.IconClass"><i class="bi @s.Icon"></i></div>
                    </div>
                    <div class="mt-3">
                        <div class="card-value">@s.Value</div>
                        <div class="text-muted small mt-1">@s.Note</div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- BUSINESS PROFILE -->
    <div class="card-box">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
                <div class="panel-title"><i class="bi bi-card-heading text-success me-2"></i>Business profile</div>
                <div class="panel-sub mb-0">
                    <i class="bi bi-calendar-check me-1"></i>Registered @registeredAt.ToString("MMM d, yyyy", Inv) ·
                    <i class="bi bi-arrow-repeat ms-1 me-1"></i>Synchronization: <strong class="text-capitalize">@form.Sync</strong>
                </div>
            </div>
            <span class="pill @SyncPillClass(form.Sync)">
                <i class="bi bi-cloud-check-fill me-1"></i>@form.Sync.ToUpperInvariant()
            </span>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label"><i class="bi bi-building me-1 text-success"></i>Business name <span class="req">*</span></label>
                <div class="input-group modern-input">
                    <span class="input-group-text"><i class="bi bi-buildings"></i></span>
                    <input class="form-control @(showErrors && string.IsNullOrWhiteSpace(form.Name) ? "is-invalid" : "")"
                           placeholder="e.g. Verdant Agri Ventures" @bind="form.Name" />
                </div>
                @if (showErrors && string.IsNullOrWhiteSpace(form.Name))
                {
                    <div class="err"><i class="bi bi-exclamation-circle me-1"></i>Business name is required.</div>
                }
            </div>

            <div class="col-md-6">
                <label class="form-label"><i class="bi bi-person-badge me-1 text-success"></i>Owner / administrator</label>
                <div class="input-group modern-input">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <input class="form-control" placeholder="e.g. Maria L. Santos" @bind="form.Owner" />
                </div>
            </div>

            <div class="col-md-6">
                <label class="form-label"><i class="bi bi-envelope me-1 text-success"></i>Owner email</label>
                <div class="input-group modern-input">
                    <span class="input-group-text"><i class="bi bi-at"></i></span>
                    <input type="email" class="form-control @(showErrors && !EmailValid ? "is-invalid" : "")"
                           placeholder="owner@business.ph" @bind="form.Email" />
                </div>
                @if (showErrors && !EmailValid)
                {
                    <div class="err"><i class="bi bi-exclamation-circle me-1"></i>Enter a valid email address.</div>
                }
            </div>

            <div class="col-md-6">
                <label class="form-label"><i class="bi bi-telephone me-1 text-success"></i>Contact number</label>
                <div class="input-group modern-input">
                    <span class="input-group-text"><i class="bi bi-phone"></i></span>
                    <input class="form-control" placeholder="09XX XXX XXXX" @bind="form.Contact" />
                </div>
            </div>

            <div class="col-md-6">
                <label class="form-label"><i class="bi bi-geo-alt me-1 text-success"></i>Region / province</label>
                <div class="input-group modern-input">
                    <span class="input-group-text"><i class="bi bi-map"></i></span>
                    <input class="form-control" placeholder="e.g. Bukidnon / Misamis Oriental" @bind="form.Province" />
                </div>
            </div>

            <div class="col-md-6">
                <label class="form-label"><i class="bi bi-arrow-repeat me-1 text-success"></i>Cloud synchronization status</label>
                <div class="input-group modern-input">
                    <span class="input-group-text"><i class="bi bi-cloud-check"></i></span>
                    <input class="form-control bg-light text-muted fw-semibold" value="@form.Sync (Auto-managed by system)" readonly />
                </div>
            </div>

            <div class="col-12">
                <label class="form-label"><i class="bi bi-pin-map me-1 text-success"></i>Business address</label>
                <div class="input-group modern-input">
                    <span class="input-group-text"><i class="bi bi-house-door"></i></span>
                    <input class="form-control" placeholder="Street, Barangay, Municipality/City" @bind="form.Address" />
                </div>
            </div>

        <div class="col-12">
            <label class="form-label"><i class="bi bi-journal-text me-1 text-success"></i>Internal notes</label>
            <textarea class="form-control bg-light text-muted" rows="3" readonly @bind="form.Notes"></textarea>
            <div class="sub mt-1"><i class="bi bi-info-circle me-1"></i>Added by platform administrator; contact Super Admin for updates.</div>
        </div>
        </div>

        <div class="mt-4 d-flex justify-content-end gap-2">
            <button type="button" class="btn-save" @onclick="SaveAsync" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <i class="bi bi-check2-circle me-1"></i>
                    <span>Save changes</span>
                }
            </button>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(toast))
{
    <div class="toast-note"><i class="bi bi-check-circle-fill"></i> @toast</div>
}

@code {
    // ---------- MODELS ----------
    class Profile
    {
        public string Name { get; set; } = "";
        public string Owner { get; set; } = "";
        public string Email { get; set; } = "";
        public string Contact { get; set; } = "";
        public string Province { get; set; } = "";
        public string Sync { get; set; } = "Synced";
        public string Address { get; set; } = "";
        public string Notes { get; set; } = "";
    }

    record Stat(string Title, string Value, string Note, string Icon, string IconClass);

    static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    // ---------- STATE ----------
    bool isLoading = true;
    bool isTenantAdmin = false;
    bool isSaving = false;
    bool showErrors = false;
    string toast = "";

    long businessId;
    string tenantCode = "TEN-000";
    string planName = "Starter";
    string activeBranchCountText = "0 active branches";
    DateTime registeredAt = DateTime.Today;

    Profile form = new();

protected override async Task OnInitializedAsync()
{
    User? currentUser = null;

    if (Auth.CurrentUserId > 0)
    {
        currentUser = await DbContext.Users
            .Include(u => u.Business)
            .FirstOrDefaultAsync(u => u.UserId == Auth.CurrentUserId);
    }
    else if (!string.IsNullOrWhiteSpace(Auth.CurrentUserEmail))
    {
        currentUser = await DbContext.Users
            .Include(u => u.Business)
            .FirstOrDefaultAsync(u => u.Email.ToLower() == Auth.CurrentUserEmail.Trim().ToLower());
    }

    bool roleMatchesTenantAdmin =
        Auth.CurrentRole == AgriNexus.Services.UserRole.TenantAdmin ||
        string.Equals(currentUser?.Role, "TenantAdmin", StringComparison.OrdinalIgnoreCase);

    long? resolvedBusinessId = Auth.CurrentBusinessId ?? currentUser?.BusinessId;

    isTenantAdmin = roleMatchesTenantAdmin && resolvedBusinessId != null;

    if (isTenantAdmin && resolvedBusinessId != null)
    {
        businessId = resolvedBusinessId.Value;
        var biz = await DbContext.Businesses.FindAsync(businessId);
        if (biz != null)
        {
            tenantCode = $"TEN-{biz.BusinessId:000}";
            planName = string.IsNullOrWhiteSpace(biz.PlanName) ? "Starter" : biz.PlanName;
            registeredAt = biz.RegisteredAt;

            var branchCount = await DbContext.Branches
                .CountAsync(b => b.BusinessId == businessId && b.Status == "active");
            activeBranchCountText = $"{branchCount} active {(branchCount == 1 ? "branch" : "branches")}";

            var ownerFullName = currentUser != null
                ? $"{currentUser.FName} {currentUser.MName} {currentUser.LName}".Replace("  ", " ").Trim()
                : Auth.CurrentUserName;

            form = new Profile
            {
                Name = biz.BusinessName,
                Owner = ownerFullName,
                Email = string.IsNullOrWhiteSpace(biz.Email) ? (currentUser?.Email ?? Auth.CurrentUserEmail) : biz.Email,
                Contact = biz.ContactNumber,
                Province = biz.Province,
                Sync = string.IsNullOrWhiteSpace(biz.SyncStatus) ? "Synced" : biz.SyncStatus,
                Address = biz.Address,
                Notes = biz.Notes
            };
        }
    }

    isLoading = false;
}

    // ---------- COMPUTED ----------
    List<Stat> Stats => new()
    {
        new("TENANT CODE", tenantCode, "Used across branches and reports", "bi-buildings-fill", ""),
        new("SUBSCRIBED PLAN", planName, "Account active", "bi-patch-check-fill", "stat-icon-leaf"),
        new("BRANCH OPERATIONS", activeBranchCountText, "Managed under this business", "bi-shop", "stat-icon-earth"),
    };

    bool EmailValid => string.IsNullOrWhiteSpace(form.Email) ||
        System.Text.RegularExpressions.Regex.IsMatch(form.Email.Trim(), @"^[^@\s]+@[^@\s]+\.[^@\s]+$");

    static string SyncPillClass(string s) => (s ?? "").ToLower() switch
    {
        "synced" => "pill-forest",
        "pending" => "pill-earth",
        _ => "pill-earth"
    };

    // ---------- ACTIONS ----------
    void GoBack() => Nav.NavigateTo("/dashboard");
    void GoToSubscription() => Nav.NavigateTo("/my-subscription");

    async Task SaveAsync()
    {
        if (!isTenantAdmin) return;

        showErrors = true;
        if (string.IsNullOrWhiteSpace(form.Name) || !EmailValid) return;

        isSaving = true;
        showErrors = false;

        try
        {
            var biz = await DbContext.Businesses.FindAsync(businessId);
            if (biz != null)
            {
                biz.BusinessName = form.Name.Trim();
                biz.Email = form.Email.Trim();
                biz.ContactNumber = form.Contact.Trim();
                biz.Province = form.Province.Trim();
                biz.SyncStatus = form.Sync;
                biz.Address = form.Address.Trim();
                biz.Notes = form.Notes.Trim();

                DbContext.Businesses.Update(biz);
                await DbContext.SaveChangesAsync();

                toast = "Business profile saved successfully.";
                await InvokeAsync(StateHasChanged);
                await Task.Delay(2500);
                toast = "";
                await InvokeAsync(StateHasChanged);
            }
        }
        finally
        {
            isSaving = false;
        }
    }
}