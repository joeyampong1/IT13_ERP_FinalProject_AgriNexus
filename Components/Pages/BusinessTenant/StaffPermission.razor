                                </p>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label class="text-muted small fw-bold text-uppercase d-block mb-1">Account Status</label>
                                <span class="pill @(selectedStaff.Status == "Active" ? "pill-forest" : "pill-earth")">
                                    <i class="bi @(selectedStaff.Status == "Active" ? "bi-check-circle" : "bi-pause-circle") me-1"></i>@selectedStaff.Status
                                </span>
                            </div>
                        </div>
