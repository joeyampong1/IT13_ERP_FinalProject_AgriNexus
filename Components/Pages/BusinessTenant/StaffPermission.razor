                    </div>
                    <button type="button" class="btn-close bg-white shadow-sm rounded-circle p-2" @onclick="CloseModal" aria-label="Close" style="width: 32px; height: 32px;"></button>
                </div>

                <div class="modal-body p-4" style="max-height: 70vh; overflow-y: auto;">
                    <form>
                        <!-- SECTION 1: Personal Name -->
                        <div class="mb-4">
                            <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                                <i class="bi bi-person me-2 text-success"></i>Staff Full Name
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small text-muted">First Name <span class="text-danger">*</span></label>
                                    <div class="input-group modern-input @(showErrors && string.IsNullOrWhiteSpace(form.FName) ? "border border-danger rounded-3" : "")">
                                        <span class="input-group-text bg-white"><i class="bi bi-person text-success"></i></span>
                                        <input class="form-control" placeholder="Juan"
                                               @bind="form.FName"
                                               @bind:after="() => form.FName = CapitalizeWords(form.FName)" />
                                    </div>
                                    @if (showErrors && string.IsNullOrWhiteSpace(form.FName))
                                    {
                                        <div class="err">First name is required.</div>
                                    }
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small text-muted">Middle Name</label>
                                    <div class="input-group modern-input">
                                        <span class="input-group-text bg-white"><i class="bi bi-person text-success"></i></span>
                                        <input class="form-control" placeholder="Optional"
                                               @bind="form.MName"
                                               @bind:after="() => form.MName = CapitalizeWords(form.MName)" />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small text-muted">Last Name <span class="text-danger">*</span></label>
                                    <div class="input-group modern-input @(showErrors && string.IsNullOrWhiteSpace(form.LName) ? "border border-danger rounded-3" : "")">
                                        <span class="input-group-text bg-white"><i class="bi bi-person text-success"></i></span>
                                        <input class="form-control" placeholder="Dela Cruz"
                                               @bind="form.LName"
                                               @bind:after="() => form.LName = CapitalizeWords(form.LName)" />
                                    </div>
                                    @if (showErrors && string.IsNullOrWhiteSpace(form.LName))
                                    {
                                        <div class="err">Last name is required.</div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- SECTION 2: Contact & Email -->
                        <div class="mb-4">
                            <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                                <i class="bi bi-envelope me-2 text-success"></i>Contact &amp; Login Credentials
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Email Address <span class="text-danger">*</span></label>
                                    <div class="input-group modern-input @(showErrors && (string.IsNullOrWhiteSpace(form.Email) || EmailTaken) ? "border border-danger rounded-3" : "")">
                                        <span class="input-group-text bg-white"><i class="bi bi-envelope text-success"></i></span>
                                        <input type="email" class="form-control" placeholder="staff@company.ph" @bind="form.Email" />
                                    </div>
                                    @if (showErrors && string.IsNullOrWhiteSpace(form.Email))
                                    {
                                        <div class="err">Email address is required.</div>
                                    }
                                    @if (showErrors && EmailTaken)
                                    {
                                        <div class="err">This email is already registered.</div>
                                    }
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Contact Number</label>
                                    <div class="input-group modern-input @(showErrors && !string.IsNullOrEmpty(contactError) ? "border border-danger rounded-3" : "")">
                                        <span class="input-group-text bg-white"><i class="bi bi-telephone text-success"></i></span>
                                        <input type="tel"
                                               inputmode="numeric"
                                               maxlength="13"
                                               class="form-control"
                                               @bind="form.ContactNumber"
                                               @bind:event="oninput"
                                               @bind:after="FormatContactNumber"
                                               placeholder="09XX XXX XXXX"
                                               spellcheck="false" />
                                    </div>
                                    @if (showErrors && !string.IsNullOrEmpty(contactError))
                                    {
                                        <div class="err">@contactError</div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- SECTION 3: Role, Branch & Status -->
                        <div class="p-4 rounded-4" style="background-color: #F7FAF8; border: 1px dashed #C6DFCE;">
                            <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                                <i class="bi bi-shield-lock me-2 text-success"></i>Role &amp; Branch Assignment
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Role</label>
                                    <select class="form-select border-0 shadow-sm" value="@form.Role" @onchange="OnRoleChanged" disabled="@(form.Role == "TenantAdmin")">
                                        @if (form.Role == "TenantAdmin")
                                        {
                                            <option value="TenantAdmin">Business Owner / Tenant Admin</option>
                                        }
                                        @foreach (var r in StaffRoleRows)
                                        {
                                            <option value="@r.RoleKey">@r.SingularLabel</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Assigned Branch</label>
                                    @if (IsWideRole(form.Role))
                                    {
                                        <input class="form-control border-0 shadow-sm bg-white text-muted fw-semibold" value="Business-wide" disabled />
                                    }
                                    else
                                    {
                                        <select class="form-select border-0 shadow-sm" @bind="form.BranchId">
                                            <option value="">Select Branch...</option>
                                            @foreach (var b in businessBranches)
                                            {
                                                <option value="@b.BranchId">@b.BranchName</option>
                                            }
                                        </select>
                                    }
                                </div>

                                <div class="col-md-6 mt-3">
                                    <label class="form-label fw-bold small text-muted">Account Status</label>
                                    <select class="form-select border-0 shadow-sm" @bind="form.Status" disabled="@(form.Role == "TenantAdmin")">
                                        <option value="Active">Active</option>
                                        <option value="Inactive">Inactive</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="modal-footer border-0 p-4 d-flex justify-content-end gap-2" style="background-color: #F4F7F5;">
                    <button type="button" class="btn btn-light border fw-bold px-4 rounded-3 shadow-sm" @onclick="CloseModal">Cancel</button>
                    <button type="button" class="btn-save px-5 shadow-sm" @onclick="SaveAsync" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <i class="bi bi-check2 me-2"></i>
                            <span>@(editingId == null ? "Create Staff" : "Update Staff")</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

