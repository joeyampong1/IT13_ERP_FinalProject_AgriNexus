@code {
    // ---------- MODELS ----------
    class StaffRec
    {
        public long UserId { get; set; }
        public long? BusinessId { get; set; }
        public long? BranchId { get; set; }
        public string BranchName { get; set; } = "";
        public string Role { get; set; } = "BranchManager";
        public string FName { get; set; } = "";
        public string MName { get; set; } = "";
        public string LName { get; set; } = "";
        public string FullName => $"{FName} {MName} {LName}".Replace("  ", " ").Trim();
        public string Email { get; set; } = "";
        public string ContactNumber { get; set; } = "";
        public string ProfileImage { get; set; } = "";
        public string PasswordHash { get; set; } = "";
        public string Status { get; set; } = "Active";
        public DateTime CreatedAt { get; set; } = DateTime.Now;
        public bool IsTempPassword { get; set; } = true;

        public StaffRec Clone() => (StaffRec)MemberwiseClone();
    }

    record Stat(string Title, string Value, string Note, string Icon, string IconClass);
    record RoleRowDef(string RoleKey, string RowTitle, string SingularLabel, string RowSubtitle, string Icon);

    class Viewport
    {
        public double W { get; set; }
        public double H { get; set; }
    }

    static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    // 5 Horizontal Rows in Roles & Permissions
    static readonly RoleRowDef[] StaffRoleRows =
    {
        new("BranchManager", "Managers", "Manager", "Branch operations, plots, and daily supervision", "bi-shop"),
        new("Accountant", "Finance Officers", "Finance Officer", "Expenses, costing, collections, and financial records", "bi-calculator"),
        new("InventoryOfficer", "Inventory Officers", "Inventory Officer", "Seeds, fertilizers, supplies, stock movements, and suppliers", "bi-box-seam"),
        new("SalesOfficer", "Sales & Cashiering Officers", "Sales & Cashier Officer", "Orders, sales, collections, and cash drawer", "bi-cart-check"),
        new("LaborOfficer", "Labor & Harvest Officers", "Labor & Harvest Officer", "Workers, work assignments, attendance, and harvest logs", "bi-person-badge")
    };

    // Restricted modules excluded from staff access & customization
    static readonly HashSet<string> RestrictedModules = new(StringComparer.OrdinalIgnoreCase)
    {
        "Branches",
        "Staff & Permissions",
        "StaffPermission",
        "My Subscription",
        "MySubscription",
        "Business Settings",
        "BusinessSetting"
    };

    static readonly HashSet<string> WideRoles = new(StringComparer.OrdinalIgnoreCase) { "TenantAdmin", "Accountant" };

    // Filtered modules safe for staff customization
    List<dynamic> CustomizableModules => RolePermissionService.AllBusinessModules
        .Where(m => !RestrictedModules.Contains(m.Key) && !RestrictedModules.Contains(m.Name))
        .Cast<dynamic>()
        .ToList();

    // ---------- STATE ----------
    long currentBusinessId;
    string businessName = "AgriNexus Farm Operations";
    string currentPlanName = "Starter";
    int maxStaffLimit = int.MaxValue;

    string activeTab = "staff";
    bool showInactive = false;
    string searchText = "";
    string contactError = "";
    string toast = "";
    bool toastIsWarning = false;
    bool showOwnPassword = false;
    bool showConfirmResetModal;
    StaffRec? pendingResetMember;
    string pendingResetLabel = "";

    bool showModal;
    bool showErrors;
    bool isSaving;
    long? editingId;
    long? openMenuId;
    StaffRec form = new();

    bool showDetailsModal;
    StaffRec? selectedStaff;

    bool showSuccessModal;
    string generatedEmail = "";
    string generatedPassword = "";

    bool showDeactivateModal;
    StaffRec? staffToDeactivate;

    // Per-staff permission customization state + confirmation dialog state
    long? customizingStaffUserId;
    HashSet<string> staffDraftPermissions = new(StringComparer.OrdinalIgnoreCase);
    HashSet<string> originalStaffPermissions = new(StringComparer.OrdinalIgnoreCase);
    Dictionary<long, HashSet<string>> perStaffPermissions = new();

    bool showConfirmPermModal;
    StaffRec? pendingSaveMember;
    string pendingSaveLabel = "";

    List<StaffRec> staffList = new();
    List<Branch> businessBranches = new();

    private int currentPage = 1;
    private int pageSize = 5;
    private double menuTop;
    private double menuLeft;

    int CurrentStaffCount => staffList.Count(s => s.Role != "TenantAdmin");

    protected override async Task OnInitializedAsync()
    {
        User? currentUser = null;

        if (Auth.CurrentUserId > 0)
        {
            currentUser = await DbContext.Users
                .Include(u => u.Business)
                .FirstOrDefaultAsync(u => u.UserId == Auth.CurrentUserId);
        }
        else if (!string.IsNullOrWhiteSpace(Auth.CurrentUserEmail))
        {
            var cleanEmail = Auth.CurrentUserEmail.Trim().ToLower();
            currentUser = await DbContext.Users
                .Include(u => u.Business)
                .FirstOrDefaultAsync(u => u.Email != null && u.Email.ToLower() == cleanEmail);
        }
        else
        {
            currentUser = await DbContext.Users
                .Include(u => u.Business)
                .FirstOrDefaultAsync(u => (u.FName + " " + u.LName) == Auth.CurrentUserName
                                       || u.FName == Auth.CurrentUserName);
        }

        if (currentUser?.BusinessId != null)
        {
            currentBusinessId = currentUser.BusinessId.Value;
            if (currentUser.Business != null)
            {
                businessName = currentUser.Business.BusinessName;
                currentPlanName = currentUser.Business.PlanName ?? "Starter";
            }
        }
        else
        {
            var firstBiz = await DbContext.Businesses.FirstOrDefaultAsync();
            if (firstBiz != null)
            {
                currentBusinessId = firstBiz.BusinessId;
                businessName = firstBiz.BusinessName;
                currentPlanName = firstBiz.PlanName ?? "Starter";
            }
        }

        await ResolvePlanStaffLimitAsync();
        await LoadDataAsync();
    }

    private async Task ResolvePlanStaffLimitAsync()
    {
        var activeSub = await DbContext.Subscriptions
            .Include(s => s.SubscriptionPlan)
            .Where(s => s.BusinessId == currentBusinessId && s.Status == "Active")
            .OrderByDescending(s => s.SubscriptionId)
            .FirstOrDefaultAsync();

        var planLabel = activeSub?.SubscriptionPlan?.Name ?? currentPlanName;
        var normalized = (planLabel ?? "").ToLower();

        if (normalized.Contains("enterprise") || normalized.Contains("unlimited"))
            maxStaffLimit = int.MaxValue;
        else if (normalized.Contains("growth") || normalized.Contains("pro") || normalized.Contains("professional"))
            maxStaffLimit = 15;
        else if (normalized.Contains("trial"))
            maxStaffLimit = 3;
        else
            maxStaffLimit = 5;
    }

    private async Task LoadDataAsync()
    {
        businessBranches = await DbContext.Branches
            .Where(b => b.BusinessId == currentBusinessId && b.Status == "active")
            .OrderBy(b => b.BranchName)
            .ToListAsync();

        var allBranchesDict = await DbContext.Branches
            .Where(b => b.BusinessId == currentBusinessId)
            .ToDictionaryAsync(b => b.BranchId, b => b.BranchName);

        var users = await DbContext.Users
            .Where(u => u.BusinessId == currentBusinessId
                     && u.Role != "SuperAdmin"
                     && u.Role != "TenantAdmin")
            .OrderBy(u => u.UserId)
            .ToListAsync();

        staffList = users.Select(u => new StaffRec
        {
            UserId = u.UserId,
            BusinessId = u.BusinessId,
            BranchId = u.BranchId,
            BranchName = (u.BranchId != null && allBranchesDict.TryGetValue(u.BranchId.Value, out var bName)) ? bName : "",
            Role = u.Role,
            FName = u.FName,
            MName = u.MName ?? "",
            LName = u.LName,
            Email = u.Email,
            ContactNumber = u.ContactNumber ?? "",
            ProfileImage = u.ProfileImage ?? "",
            PasswordHash = u.PasswordHash,
            IsTempPassword = u.IsTempPassword,
            Status = u.Status,
            CreatedAt = u.CreatedAt
        }).ToList();

        foreach (var s in staffList)
        {
            if (!perStaffPermissions.ContainsKey(s.UserId))
            {
                var baseSet = PermissionService.GetAllowedModules(s.Role)
                    .Where(k => !RestrictedModules.Contains(k))
                    .ToHashSet(StringComparer.OrdinalIgnoreCase);
                perStaffPermissions[s.UserId] = baseSet;
            }
        }
    }

    // ---------- COMPUTED ----------
    List<StaffRec> Filtered
    {
        get
        {
            var baseList = staffList
                .Where(s => showInactive ? s.Status != "Active" : s.Status == "Active")
                .ToList();

            if (string.IsNullOrWhiteSpace(searchText))
                return baseList;

            return baseList.Where(s =>
                s.FullName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                s.Email.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                RoleDisplayName(s.Role).Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                s.BranchName.Contains(searchText, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)Filtered.Count / pageSize));
    private int StartItem => Filtered.Count == 0 ? 0 : (currentPage - 1) * pageSize + 1;
    private int EndItem => Math.Min(currentPage * pageSize, Filtered.Count);
    private IEnumerable<StaffRec> PaginatedStaff => Filtered.Skip((currentPage - 1) * pageSize).Take(pageSize);

    List<Stat> Stats
    {
        get
        {
            var activeCount = staffList.Count(s => s.Status == "Active");
            var inactiveCount = staffList.Count(s => s.Status != "Active");
            var branchAssigned = staffList.Count(s => s.Status == "Active" && !IsWideRole(s.Role));
            var limitNote = maxStaffLimit == int.MaxValue
                ? $"{currentPlanName} (Unlimited)"
                : $"{CurrentStaffCount} / {maxStaffLimit} ({currentPlanName})";

            return new()
           {
               new("TOTAL STAFF ACCOUNTS", staffList.Count.ToString(), $"Plan quota: {limitNote}", "bi-people", ""),
               new("BRANCH-ASSIGNED STAFF", branchAssigned.ToString(), "Across " + businessBranches.Count + " active branches", "bi-shop", "stat-icon-leaf"),
               new("ROLE ROWS", StaffRoleRows.Length.ToString(), "Per-staff permission control", "bi-shield-lock", ""),
               new("INACTIVE ACCOUNTS", inactiveCount.ToString(), activeCount + " active · " + inactiveCount + " inactive", "bi-person-x", "stat-icon-earth"),
           };
        }
    }

    bool EmailTaken => !string.IsNullOrWhiteSpace(form.Email) &&
        staffList.Any(s => s.UserId != (editingId ?? -1) &&
                           string.Equals(s.Email, form.Email.Trim(), StringComparison.OrdinalIgnoreCase));

    static bool IsWideRole(string role) => WideRoles.Contains(role);

    static string RoleDisplayName(string role) => role switch
    {
        "TenantAdmin" => "Business Owner / Admin",
        "BranchManager" => "Branch Manager",
        "InventoryOfficer" => "Inventory Officer",
        "LaborOfficer" => "Labor & Harvest Officer",
        "SalesOfficer" => "Sales & Cashier Officer",
        "Accountant" => "Accountant / Finance Officer",
        _ => role
    };

    static string RoleIcon(string role) => role switch
    {
        "TenantAdmin" => "bi-award",
        "BranchManager" => "bi-shop",
        "InventoryOfficer" => "bi-box-seam",
        "LaborOfficer" => "bi-person-badge",
        "SalesOfficer" => "bi-cart-check",
        "Accountant" => "bi-calculator",
        _ => "bi-person"
    };

