@page "/staff"
@layout MainLayout
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Web
@using AgriNexus.DataLayer
@using AgriNexus.DataLayer.Models
@using AgriNexus.Services
@inject AgriNexusDbContext DbContext
@inject AuthService Auth
@inject RolePermissionService PermissionService
@inject IJSRuntime JS

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="page-title">Staff Account Management</h2>
        <p class="text-muted mb-0 page-sub">
            <i class="bi bi-building text-success me-1"></i><strong>@businessName</strong> · create staff accounts within your plan limit and customize per-staff module permissions.
        </p>
    </div>
    <span class="badge rounded-pill px-3 py-2 fw-semibold" style="background-color: #E8F3EC; color: #1B5E34; border: 1px solid #C6DFCE;">
        <i class="bi bi-people me-1"></i> Team &amp; Access Control
    </span>
</div>

<!-- STAT CARDS -->
<div class="row g-3 mb-4">
    @foreach (var s in Stats)
    {
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <span class="card-title">@s.Title</span>
                    <div class="stat-icon @s.IconClass"><i class="bi @s.Icon"></i></div>
                </div>
                <div class="mt-3">
                    <div class="card-value">@s.Value</div>
                    @if (!string.IsNullOrEmpty(s.Note))
                    {
                        <div class="text-muted small mt-1">@s.Note</div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- MAIN TABS -->
<div class="tabs mb-4">
    <button type="button" class="tab-btn @(activeTab == "staff" ? "active" : "")" @onclick='() => SetTab("staff")'>
        <i class="bi bi-person-lines-fill"></i> Staff accounts
    </button>
    <button type="button" class="tab-btn @(activeTab == "roles" ? "active" : "")" @onclick='() => SetTab("roles")'>
        <i class="bi bi-shield-lock"></i> Roles &amp; permissions
    </button>
</div>

@if (activeTab == "staff")
{
    <!-- TOOLBAR WITH ACTIVE/INACTIVE FILTER -->
    <div class="toolbar mb-3 d-flex flex-wrap align-items-center gap-3">

        <!-- ACTIVE / SUSPENDED TABS -->
        <div class="btn-group shadow-sm" role="group" aria-label="Status Tabs">
            <input type="radio" class="btn-check" name="staffStatusTabs" id="tabStaffActive" autocomplete="off"
                   checked="@(!showInactive)" @onchange="() => ToggleStatusTab(false)">
            <label class="btn btn-outline-success fw-bold" for="tabStaffActive">
                <i class="bi bi-check-circle me-1"></i> Active
            </label>

            <input type="radio" class="btn-check" name="staffStatusTabs" id="tabStaffInactive" autocomplete="off"
                   checked="@showInactive" @onchange="() => ToggleStatusTab(true)">
            <label class="btn btn-outline-secondary fw-bold" for="tabStaffInactive">
                <i class="bi bi-pause-circle me-1"></i> Inactive
            </label>
        </div>

        <!-- SEARCH BOX -->
        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text" placeholder="Search staff by name, email or role..."
                   @bind="searchText"
                   @bind:event="oninput"
                   @bind:after="ResetPagination" />
        </div>

        <span class="badge rounded-pill px-3 py-2 fw-semibold" style="background-color: #FFFFFF; color: #0A2B1D; border: 1px solid #E2ECE6;">
            <i class="bi bi-person-badge me-1 text-success"></i>@Filtered.Count @(Filtered.Count == 1 ? "account" : "accounts")
            @if (maxStaffLimit < int.MaxValue)
            {
                <span class="text-muted ms-1">· Limit: @CurrentStaffCount / @maxStaffLimit</span>
            }
        </span>

        <!-- NEW BUTTON -->
        <button type="button" class="btn-new ms-auto shadow-sm" @onclick="OpenNew">
            <i class="bi bi-plus-lg"></i> New staff account
        </button>
    </div>

    <!-- TABLE -->
    <div class="panel shadow-sm bg-white d-flex flex-column" style="border-radius: 16px; border: 1px solid #E2ECE6; max-height: calc(100vh - 300px); overflow: hidden;">
        <div class="table-responsive" style="flex-grow: 1; overflow-y: auto;">
            <table class="table table-hover align-middle mb-0 biz-table" style="width: 100%;">
                <thead style="position: sticky; top: 0; z-index: 1; background-color: #F7FAF8;">
                    <tr>
                        <th class="text-muted small fw-bold text-uppercase py-3 px-4">Staff Member</th>
                        <th class="text-muted small fw-bold text-uppercase py-3">Role</th>
                        <th class="text-muted small fw-bold text-uppercase py-3">Assigned Branch</th>
                        <th class="text-muted small fw-bold text-uppercase py-3">Contact</th>
                        <th class="text-muted small fw-bold text-uppercase py-3">Created</th>
                        <th class="text-muted small fw-bold text-uppercase py-3">Status</th>
                        <th class="py-3"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in PaginatedStaff)
                    {
                        <tr style="cursor: pointer;" @onclick="() => OpenDetails(s)">
                            <td class="px-4">
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrWhiteSpace(s.ProfileImage))
                                    {
                                        <img src="@s.ProfileImage" alt="@s.FullName" class="staff-avatar-img" />
                                    }
                                    else
                                    {
                                        <div class="staff-avatar">
                                            <i class="bi bi-person"></i>
                                        </div>
                                    }
                                    <div>
                                        <div class="fw-bold" style="color: #0A2B1D;">@s.FullName</div>
                                        <div class="text-muted small mt-1"><i class="bi bi-envelope me-1"></i>@s.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="role-pill">
                                    <i class="bi @RoleIcon(s.Role) me-1 text-success"></i>@RoleDisplayName(s.Role)
                                </span>
                            </td>
                            <td class="fw-medium text-dark">
                                @if (IsWideRole(s.Role))
                                {
                                    <span class="text-muted"><i class="bi bi-globe2 text-success me-1"></i>Business-wide</span>
                                }
                                else if (!string.IsNullOrWhiteSpace(s.BranchName))
                                {
                                    <span><i class="bi bi-shop text-success me-1"></i>@s.BranchName</span>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">Unassigned</span>
                                }
                            </td>
                            <td class="text-nowrap text-dark fw-medium">
                                @(string.IsNullOrWhiteSpace(s.ContactNumber) ? "—" : s.ContactNumber)
                            </td>
                            <td class="text-nowrap text-muted small fw-medium">
                                <i class="bi bi-calendar3 text-success me-1"></i>@s.CreatedAt.ToString("MMM d, yyyy", Inv)
                            </td>
                            <td>
                                <span class="pill @(s.Status == "Active" ? "pill-forest" : "pill-earth")">
                                    <i class="bi @(s.Status == "Active" ? "bi-check-circle" : "bi-pause-circle") me-1"></i>@s.Status
                                </span>
                            </td>
                            <td class="text-end px-4 action-cell">
                                <button type="button" class="btn-dots"
                                        @onclick="(e) => ToggleMenuAsync(e, s.UserId)"
                                        @onclick:stopPropagation="true" aria-label="Actions">
                                    <i class="bi bi-three-dots"></i>
                                </button>
                            </td>
                        </tr>
                    }
                    @if (Filtered.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-3 d-block mb-2 opacity-50"></i>
                                No staff accounts found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- PAGINATION FOOTER -->
        @if (Filtered.Count > 0)
        {
            <div class="d-flex flex-wrap justify-content-between align-items-center p-3 border-top bg-white" style="flex-shrink: 0; border-color: #E2ECE6 !important; border-radius: 0 0 16px 16px;">
                <div class="text-muted small mb-2 mb-md-0">
                    Showing <span class="fw-bold" style="color: #0A2B1D;">@StartItem</span> - <span class="fw-bold" style="color: #0A2B1D;">@EndItem</span> of <span class="fw-bold" style="color: #0A2B1D;">@Filtered.Count</span> staff accounts
                </div>

                <div class="d-flex gap-1">
                    <button class="btn btn-sm btn-light border px-3 rounded-2 fw-medium" @onclick="PreviousPage" disabled="@(currentPage == 1)">
                        <i class="bi bi-chevron-left me-1"></i>Previous
                    </button>

                    @for (int i = 1; i <= TotalPages; i++)
                    {
                        var pageNumber = i;
                        <button class="btn btn-sm px-3 rounded-2 fw-bold @(currentPage == pageNumber ? "btn-new text-white shadow-sm" : "btn-light border text-dark")"
                                @onclick="() => GoToPage(pageNumber)">
                            @pageNumber
                        </button>
                    }

                    <button class="btn btn-sm btn-light border px-3 rounded-2 fw-medium" @onclick="NextPage" disabled="@(currentPage == TotalPages)">
                        Next<i class="bi bi-chevron-right ms-1"></i>
                    </button>
                </div>
            </div>
        }
    </div>
}
else
{
    <!-- ======================= ROLES & PERMISSIONS (5 HORIZONTAL ROWS PER STAFF CREATED) ======================= -->
    <div class="info-banner mb-4">
        <i class="bi bi-shield-check fs-5"></i>
        <span>
            Customize module access per staff member across the 5 operational rows. Restricted system management modules (<strong>Branches</strong>, <strong>Staff &amp; Permissions</strong>, <strong>My Subscription</strong>, and <strong>Business Settings</strong>) are excluded to protect tenant governance.
        </span>
    </div>

    <div class="d-flex flex-column gap-4">
        @foreach (var rowDef in StaffRoleRows)
        {
            var membersInRow = staffList
                .Where(s => string.Equals(s.Role, rowDef.RoleKey, StringComparison.OrdinalIgnoreCase))
                .ToList();

            <div class="role-row-panel">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <div class="role-row-icon">
                            <i class="bi @rowDef.Icon"></i>
                        </div>
                        <div>
                            <h5 class="role-row-title mb-0">@rowDef.RowTitle</h5>
                            <span class="text-muted small">@rowDef.RowSubtitle</span>
                        </div>
                    </div>
                    <span class="module-badge">@membersInRow.Count @(membersInRow.Count == 1 ? "staff" : "staff")</span>
                </div>

                @if (membersInRow.Count == 0)
                {
                    <div class="empty-row-card">
                        <i class="bi bi-person-plus me-2 text-muted"></i>
                        <span class="text-muted small">No @rowDef.RowTitle.ToLower() created yet. Add one in <strong>Staff accounts</strong> to customize permissions.</span>
                    </div>
                }
                else
                {
                    <div class="horizontal-cards-track">
                        @for (int idx = 0; idx < membersInRow.Count; idx++)
                        {
                            var member = membersInRow[idx];
                            var indexedLabel = $"{rowDef.SingularLabel} {idx + 1}";
                            var isEditingThis = customizingStaffUserId == member.UserId;
                            var savedSet = GetStaffPermissions(member);
                            var allowedSet = isEditingThis ? staffDraftPermissions : savedSet;
                            var hasUnsavedChanges = isEditingThis && !staffDraftPermissions.SetEquals(originalStaffPermissions);
                            var isSavedNonDefault = !IsDefaultRoleSetup(member, savedSet);

                            <div class="staff-perm-card @(isEditingThis ? "editing" : "")">
                                <!-- Top Info: User Icon/Photo, Name, Branch -->
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <div class="d-flex align-items-center gap-2 min-w-0">
                                        @if (!string.IsNullOrWhiteSpace(member.ProfileImage))
                                        {
                                            <img src="@member.ProfileImage" alt="@member.FullName" class="perm-avatar-img" />
                                        }
                                        else
                                        {
                                            <div class="perm-avatar-icon">
                                                <i class="bi bi-person"></i>
                                            </div>
                                        }
                                        <div class="min-w-0">
                                            <div class="perm-staff-name text-truncate" title="@member.FullName">@member.FullName</div>
                                            <div class="perm-staff-sub text-truncate">
                                                <span class="fw-semibold text-success">@indexedLabel</span>
                                                <span class="mx-1">·</span>
                                                <i class="bi @(IsWideRole(member.Role) ? "bi-globe2" : "bi-shop") me-1"></i>
                                                @(IsWideRole(member.Role) ? "Business-wide" : (string.IsNullOrWhiteSpace(member.BranchName) ? "Unassigned" : member.BranchName))
                                            </div>
                                        </div>
                                    </div>
                                    <span class="module-badge">@allowedSet.Count / @CustomizableModules.Count</span>
                                </div>

                                <!-- Action Buttons: Customize (or Cancel icon, Reset icon, Save icon during Customize) -->
                                <div class="d-flex align-items-center gap-2 mt-3 mb-2">
                                    @if (!isEditingThis)
                                    {
                                        <button type="button" class="btn-role-mini" @onclick="() => StartCustomizeStaff(member)">
                                            <i class="bi bi-sliders"></i> Customize
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn-role-mini cancel btn-icon-only"
                                                title="Cancel customization"
                                                aria-label="Cancel customization"
                                                @onclick="CancelCustomizeStaff">
                                            <i class="bi bi-x-lg"></i>
                                        </button>

                                        <div class="ms-auto d-flex align-items-center gap-2">
                                            @if (hasUnsavedChanges)
                                            {
                                                <button type="button"
                                                        class="btn-role-mini save btn-icon-only"
                                                        title="Save permission changes"
                                                        aria-label="Save permission changes"
                                                        @onclick="() => RequestSaveStaffPermissions(member, indexedLabel)">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                            }
                                            else if (isSavedNonDefault)
                                            {
                                                <button type="button"
                                                        class="btn-role-mini btn-icon-only"
                                                        title="Reset to default modules"
                                                        aria-label="Reset to default modules"
                                                        @onclick="() => PromptResetStaffToDefault(member, indexedLabel)">
                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>

                                <!-- Permissions Checklist -->
                                <div class="perm-checklist">
                                    @foreach (var mod in CustomizableModules)
                                    {
                                        var isChecked = allowedSet.Contains(mod.Key);

                                        if (isEditingThis)
                                        {
                                            <label class="perm-mod-item editable @(isChecked ? "checked" : "")">
                                                <input type="checkbox"
                                                       checked="@isChecked"
                                                       @onchange="(e) => ToggleStaffModule((string)mod.Key, (bool)(e.Value ?? false))" />
                                                <i class="bi @mod.Icon mod-icon"></i>
                                                <span class="text-truncate">@mod.Name</span>
                                            </label>
                                        }
                                        else
                                        {
                                            <div class="perm-mod-item @(isChecked ? "checked" : "unchecked")">
                                                <i class="bi @(isChecked ? "bi-check-square" : "bi-square")"></i>
                                                <i class="bi @mod.Icon mod-icon"></i>
                                                <span class="text-truncate">@mod.Name</span>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

<!-- CONFIRMATION DIALOG WHEN SAVING CUSTOMIZED PERMISSIONS -->
@if (showConfirmPermModal && pendingSaveMember != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(10, 43, 29, 0.65); backdrop-filter: blur(4px); z-index: 1065;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content border-0 shadow-lg rounded-4 text-center">
                <div class="modal-body p-4 mt-2">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 66px; height: 66px; background-color: #E8F3EC; color: #1B5E34;">
                        <i class="bi bi-shield-check" style="font-size: 2.2rem;"></i>
                    </div>
                    <h4 class="fw-bolder mb-2" style="color: #0A2B1D;">Save Permission Changes?</h4>
                    <p class="text-muted small mb-4">
                        You updated module access for <strong>@pendingSaveMember.FullName</strong> (<strong>@pendingSaveLabel</strong>). Apply these changes now?
                    </p>
                    <div class="d-flex justify-content-center gap-3">
                        <button type="button" class="btn btn-light border rounded-3 fw-bold px-4" @onclick="CancelConfirmPermissionSave">
                            Cancel
                        </button>
                        <button type="button" class="btn-save rounded-3 fw-bold px-4 shadow-sm" @onclick="ConfirmSaveStaffPermissionsAsync">
                            <i class="bi bi-check2 me-1"></i> Confirm &amp; Save
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- FLOATING ACTION MENU -->
@if (openMenuId != null)
{
    var menuStaff = staffList.FirstOrDefault(x => x.UserId == openMenuId);
    if (menuStaff != null)
    {
        <div class="menu-backdrop" @onclick="CloseMenu" @onclick:stopPropagation="true"></div>

        <div class="vertical-action-menu shadow-lg" style="top:@(menuTop)px; left:@(menuLeft)px;">
            <button type="button" class="action-item"
                    @onclick="() => OpenEdit(menuStaff)"
                    @onclick:stopPropagation="true">
                <i class="bi bi-pencil-square text-success"></i> Edit
            </button>

            @if (menuStaff.Role != "TenantAdmin")
            {
                @if (menuStaff.Status == "Active")
                {
                    <button type="button" class="action-item text-earth"
                            @onclick="() => PromptStatusChange(menuStaff)"
                            @onclick:stopPropagation="true">
                        <i class="bi bi-pause-circle"></i> Deactivate
                    </button>
                }
                else
                {
                    <button type="button" class="action-item text-success"
                            @onclick="() => ReactivateStaffAsync(menuStaff)"
                            @onclick:stopPropagation="true">
                        <i class="bi bi-arrow-counterclockwise"></i> Reactivate
                    </button>
                }
            }
        </div>
    }
}

<!-- DETAILS MODAL -->
@if (showDetailsModal && selectedStaff != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(10, 43, 29, 0.65); backdrop-filter: blur(5px); z-index: 1050;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation="true">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

                <div class="modal-header border-0 p-4 d-flex justify-content-between align-items-center" style="background-color: #F4F7F5;">
                    <div class="d-flex align-items-center gap-3">
                        @if (!string.IsNullOrWhiteSpace(selectedStaff.ProfileImage))
                        {
                            <img src="@selectedStaff.ProfileImage" alt="@selectedStaff.FullName" class="rounded-circle object-fit-cover" style="width: 50px; height: 50px; border: 2px solid #1B5E34;" />
                        }
                        else
                        {
                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 50px; height: 50px; background-color: #1B5E34; color: #FFFFFF; font-size: 1.2rem;">
                                <i class="bi bi-person"></i>
                            </div>
                        }
                        <div>
                            <h4 class="modal-title fw-bolder mb-0" style="color: #0A2B1D;">@selectedStaff.FullName</h4>
                            <span class="badge px-2 py-1 mt-1 rounded-pill" style="background-color: #FFFFFF; color: #1B5E34; border: 1px solid #C6DFCE;">
                                <i class="bi @RoleIcon(selectedStaff.Role) me-1"></i>@RoleDisplayName(selectedStaff.Role)
                            </span>
                        </div>
                    </div>
                    <button type="button" class="btn-close bg-white shadow-sm rounded-circle p-2" @onclick="CloseDetailsModal" aria-label="Close" style="width: 32px; height: 32px;"></button>
                </div>

                <div class="modal-body p-4" style="max-height: 70vh; overflow-y: auto;">
                    <div class="mb-4">
                        <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                            <i class="bi bi-person-vcard me-2 text-success"></i>Account &amp; Contact Information
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="text-muted small fw-bold text-uppercase">Email Address</label>
                                <p class="mb-0 fw-semibold text-dark">@selectedStaff.Email</p>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted small fw-bold text-uppercase">Contact Number</label>
                                <p class="mb-0 fw-semibold text-dark">
                                    @(string.IsNullOrWhiteSpace(selectedStaff.ContactNumber) ? "N/A" : selectedStaff.ContactNumber)
                                </p>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label class="text-muted small fw-bold text-uppercase">Assigned Branch</label>
                                <p class="mb-0 fw-semibold text-dark">
                                    @(IsWideRole(selectedStaff.Role) ? "Business-wide" : (string.IsNullOrWhiteSpace(selectedStaff.BranchName) ? "Unassigned" : selectedStaff.BranchName))
                                </p>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label class="text-muted small fw-bold text-uppercase">Account Password</label>
                                <div class="mt-1">
                                    @if (selectedStaff.Role == "TenantAdmin" || selectedStaff.FullName == Auth.CurrentUserName)
                                    {
                                        <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-3" style="background-color: #F4F7F5; border: 1px solid #DCE6E0; color: #0A2B1D;">
                                            <i class="bi bi-shield-lock text-success"></i>
                                            <span class="fw-bold" style="letter-spacing: @(showOwnPassword ? "0.5px" : "2px"); font-size: 0.9rem;">
                                                @(showOwnPassword ? selectedStaff.PasswordHash : "••••••••••••")
                                            </span>
                                            <button type="button" class="btn btn-sm p-0 border-0 bg-transparent text-muted ms-1"
                                                    @onclick="() => showOwnPassword = !showOwnPassword"
                                                    title="@(showOwnPassword ? "Hide password" : "Show password")">
                                                <i class="bi @(showOwnPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                            </button>
                                        </div>
                                        <div class="text-muted small mt-1"><i class="bi bi-person-check text-success me-1"></i>Your account password</div>
                                    }
                                    else if (selectedStaff.IsTempPassword)
                                    {
                                        <span class="badge px-3 py-2 rounded-3 fs-6 shadow-sm" style="background-color: #FEF3C7; color: #92400E; border: 1px solid #FDE68A;">
                                            <i class="bi bi-key me-2"></i>@selectedStaff.PasswordHash
                                        </span>
                                        <div class="text-muted small mt-1"><i class="bi bi-info-circle me-1"></i>Temporary password (not yet changed by staff)</div>
                                    }
                                    else
                                    {
                                        <span class="badge px-3 py-2 rounded-3 fs-6" style="background-color: #F4F7F5; color: #0A2B1D; border: 1px solid #DCE6E0; letter-spacing: 2px;">
                                            <i class="bi bi-shield-lock text-success me-2"></i>••••••••••••
                                        </span>
                                        <div class="text-success small mt-1 fw-medium"><i class="bi bi-check-circle me-1"></i>Updated by staff</div>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label class="text-muted small fw-bold text-uppercase">Date Created</label>
