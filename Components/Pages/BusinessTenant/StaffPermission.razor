    void OnRoleChanged(ChangeEventArgs e)
    {
        var key = e.Value?.ToString() ?? form.Role;
        form.Role = key;
        if (IsWideRole(key))
        {
            form.BranchId = null;
        }
    }

    async Task SaveAsync()
    {
        showErrors = true;
        contactError = "";

        if (string.IsNullOrWhiteSpace(form.FName) || string.IsNullOrWhiteSpace(form.LName) || string.IsNullOrWhiteSpace(form.Email) || EmailTaken)
            return;

        if (!string.IsNullOrWhiteSpace(form.ContactNumber))
        {
            var rawContact = new string(form.ContactNumber.Where(char.IsDigit).ToArray());
            if (rawContact.Length != 11)
            {
                contactError = "Contact number must be 11 digits (e.g., 09XX XXX XXXX).";
                return;
            }
        }

        if (editingId == null && CurrentStaffCount >= maxStaffLimit)
        {
            await ShowToast($"Staff limit reached ({maxStaffLimit}) for your {currentPlanName} plan.", isWarning: true);
            return;
        }

        isSaving = true;

        try
        {
            if (IsWideRole(form.Role))
            {
                form.BranchId = null;
            }

            if (editingId == null)
            {
                bool globalEmailExists = await DbContext.Users
                    .AnyAsync(u => u.Email.ToLower() == form.Email.Trim().ToLower());

                if (globalEmailExists)
                {
                    await ShowToast("This email is already registered in the system.", isWarning: true);
                    return;
                }

                string tempPassword = GenerateTempPassword();

                var newUser = new User
                {
                    BusinessId = currentBusinessId,
                    BranchId = form.BranchId,
                    Role = form.Role,
                    FName = form.FName.Trim(),
                    MName = (form.MName ?? "").Trim(),
                    LName = form.LName.Trim(),
                    Email = form.Email.Trim(),
                    ContactNumber = (form.ContactNumber ?? "").Trim(),
                    PasswordHash = tempPassword,
                    IsTempPassword = true,
                    Status = form.Status,
                    CreatedAt = DateTime.Now
                };

                DbContext.Users.Add(newUser);
                await DbContext.SaveChangesAsync();

                generatedEmail = newUser.Email;
                generatedPassword = tempPassword;

                showModal = false;
                showSuccessModal = true;
            }
            else
            {
                var existing = await DbContext.Users.FindAsync(editingId.Value);
                if (existing != null)
                {
                    existing.FName = form.FName.Trim();
                    existing.MName = (form.MName ?? "").Trim();
                    existing.LName = form.LName.Trim();
                    existing.Email = form.Email.Trim();
                    existing.ContactNumber = (form.ContactNumber ?? "").Trim();
                    existing.Role = form.Role;
                    existing.BranchId = form.BranchId;
                    existing.Status = form.Status;

                    DbContext.Users.Update(existing);
                    await DbContext.SaveChangesAsync();
                    await ShowToast("Staff account updated successfully.");
                }

                showModal = false;
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            await ShowToast("Failed to save staff account: " + ex.Message, isWarning: true);
        }
        finally
        {
            isSaving = false;
        }
    }

    void PromptStatusChange(StaffRec s)
    {
        openMenuId = null;
        if (s.Role == "TenantAdmin")
        {
            _ = ShowToast("The business owner account cannot be deactivated.", isWarning: true);
            return;
        }
        staffToDeactivate = s;
        showDeactivateModal = true;
    }

    void CloseDeactivateModal()
    {
        showDeactivateModal = false;
        staffToDeactivate = null;
    }

    async Task ConfirmDeactivateAsync()
    {
        if (staffToDeactivate == null) return;

        var existing = await DbContext.Users.FindAsync(staffToDeactivate.UserId);
        if (existing != null)
        {
            existing.Status = "Inactive";
            DbContext.Users.Update(existing);
            await DbContext.SaveChangesAsync();
            await ShowToast($"{staffToDeactivate.FullName} moved to Inactive.");
        }

        CloseDeactivateModal();
        await LoadDataAsync();
    }

    async Task ReactivateStaffAsync(StaffRec s)
    {
        openMenuId = null;
        var existing = await DbContext.Users.FindAsync(s.UserId);
        if (existing != null)
        {
            existing.Status = "Active";
            DbContext.Users.Update(existing);
            await DbContext.SaveChangesAsync();
            await ShowToast($"{s.FullName} reactivated.");
        }

        await LoadDataAsync();
    }

    async Task ShowToast(string message, bool isWarning = false)
    {
        toast = message;
        toastIsWarning = isWarning;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(3200);
        toast = "";
        await InvokeAsync(StateHasChanged);
    }
