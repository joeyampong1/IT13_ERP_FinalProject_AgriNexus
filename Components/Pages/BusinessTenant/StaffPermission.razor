    private void GoToPage(int page) => currentPage = page;
    private void PreviousPage() { if (currentPage > 1) currentPage--; }
    private void NextPage() { if (currentPage < TotalPages) currentPage++; }
    private void ResetPagination() => currentPage = 1;

    private async Task ToggleMenuAsync(MouseEventArgs e, long id)
    {
        if (openMenuId == id)
        {
            openMenuId = null;
            return;
        }

        var target = staffList.FirstOrDefault(x => x.UserId == id);
        int itemCount = (target?.Role == "TenantAdmin") ? 1 : 2;
        const double itemHeight = 42;
        const double padding = 16;
        const double menuWidth = 175;
        double menuHeight = (itemCount * itemHeight) + padding;

        var viewport = await JS.InvokeAsync<Viewport>("eval", "({ w: window.innerWidth, h: window.innerHeight })");

        menuLeft = Math.Min(e.ClientX - menuWidth + 20, viewport.W - menuWidth - 10);
        menuTop = (e.ClientY + menuHeight > viewport.H) ? e.ClientY - menuHeight - 5 : e.ClientY + 15;

        openMenuId = id;
    }

    void CloseMenu() => openMenuId = null;

    // ---------- PER-STAFF ROLE CUSTOMIZATION ACTIONS ----------
    HashSet<string> GetStaffPermissions(StaffRec member)
    {
        if (perStaffPermissions.TryGetValue(member.UserId, out var set))
            return set;

        var allowed = PermissionService.GetStaffAllowedModules(member.UserId, member.Role)
            .Where(k => !RestrictedModules.Contains(k))
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        perStaffPermissions[member.UserId] = allowed;
        return allowed;
    }

    void StartCustomizeStaff(StaffRec member)
    {
        customizingStaffUserId = member.UserId;
        var current = GetStaffPermissions(member);
        staffDraftPermissions = new HashSet<string>(current, StringComparer.OrdinalIgnoreCase);
        originalStaffPermissions = new HashSet<string>(current, StringComparer.OrdinalIgnoreCase);
    }

    void CancelCustomizeStaff()
    {
        customizingStaffUserId = null;
        staffDraftPermissions.Clear();
        originalStaffPermissions.Clear();
    }

    void ToggleStaffModule(string moduleKey, bool isChecked)
    {
        if (RestrictedModules.Contains(moduleKey)) return;

        if (isChecked) staffDraftPermissions.Add(moduleKey);
        else staffDraftPermissions.Remove(moduleKey);
    }

    void RequestSaveStaffPermissions(StaffRec member, string indexedLabel)
    {
        if (customizingStaffUserId != member.UserId) return;

        bool hasChanges = !staffDraftPermissions.SetEquals(originalStaffPermissions);
        if (!hasChanges)
        {
            customizingStaffUserId = null;
            _ = ShowToast("No permission changes detected.");
            return;
        }

        pendingSaveMember = member;
        pendingSaveLabel = indexedLabel;
        showConfirmPermModal = true;
    }

    void CancelConfirmPermissionSave()
    {
        showConfirmPermModal = false;
        pendingSaveMember = null;
        pendingSaveLabel = "";
    }

    async Task ConfirmSaveStaffPermissionsAsync()
    {
        if (pendingSaveMember == null) return;

        var cleanSet = staffDraftPermissions
            .Where(k => !RestrictedModules.Contains(k))
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        perStaffPermissions[pendingSaveMember.UserId] = cleanSet;
        PermissionService.SaveStaffPermissions(pendingSaveMember.UserId, cleanSet);

        var savedName = pendingSaveMember.FullName;
        customizingStaffUserId = null;
        showConfirmPermModal = false;
        pendingSaveMember = null;
        pendingSaveLabel = "";

        await ShowToast($"Permissions saved for {savedName}.");
    }

    HashSet<string> GetDefaultRolePermissions(string roleKey)
    {
        return PermissionService.GetDefaultModules(roleKey)
            .Where(k => !RestrictedModules.Contains(k))
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

    bool IsDefaultRoleSetup(StaffRec member, HashSet<string> targetSet)
    {
        var defaultSet = GetDefaultRolePermissions(member.Role);
        return targetSet.SetEquals(defaultSet);
    }

    void PromptResetStaffToDefault(StaffRec member, string indexedLabel)
    {
        pendingResetMember = member;
        pendingResetLabel = indexedLabel;
        showConfirmResetModal = true;
    }

    void CancelResetStaffToDefault()
    {
        showConfirmResetModal = false;
        pendingResetMember = null;
        pendingResetLabel = "";
    }

    async Task ConfirmResetStaffToDefaultAsync()
    {
        if (pendingResetMember == null) return;

        var defaultSet = GetDefaultRolePermissions(pendingResetMember.Role);
        perStaffPermissions[pendingResetMember.UserId] = new HashSet<string>(defaultSet, StringComparer.OrdinalIgnoreCase);
        PermissionService.ResetStaffPermissions(pendingResetMember.UserId, pendingResetMember.Role);

        var resetName = pendingResetMember.FullName;
        var resetLabel = pendingResetLabel;

        customizingStaffUserId = null;
        staffDraftPermissions.Clear();
        originalStaffPermissions.Clear();
        showConfirmResetModal = false;
        pendingResetMember = null;
        pendingResetLabel = "";

        await ShowToast($"{resetName} ({resetLabel}) restored to default modules.");
    }

    // ---------- FORMATTING HELPERS ----------
    private string CapitalizeWords(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return input;
        return CultureInfo.CurrentCulture.TextInfo.ToTitleCase(input.ToLower().Trim());
    }

    private void FormatContactNumber()
    {
        if (string.IsNullOrEmpty(form.ContactNumber)) return;

        var digits = new string(form.ContactNumber.Where(char.IsDigit).ToArray());

        if (string.IsNullOrEmpty(digits))
        {
            form.ContactNumber = "";
            return;
        }

        if (digits.StartsWith("63") && digits.Length > 2)
        {
            digits = "0" + digits.Substring(2);
        }
        else if (digits.StartsWith("9"))
        {
            digits = "0" + digits;
        }

        if (digits.Length > 11)
        {
            digits = digits.Substring(0, 11);
        }

        if (digits.Length > 7)
        {
            form.ContactNumber = $"{digits.Substring(0, 4)} {digits.Substring(4, 3)} {digits.Substring(7)}";
        }
        else if (digits.Length > 4)
        {
            form.ContactNumber = $"{digits.Substring(0, 4)} {digits.Substring(4)}";
        }
        else
        {
            form.ContactNumber = digits;
        }
    }

    private string GenerateTempPassword()
    {
        const string chars = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789";
        var random = new Random();
        return new string(Enumerable.Repeat(chars, 8)
            .Select(s => s[random.Next(s.Length)]).ToArray());
    }

