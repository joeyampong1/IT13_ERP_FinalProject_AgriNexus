@page "/harvest"
@layout MainLayout
@using System.Globalization
@using System.IO
@using System.Reflection
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using Microsoft.Maui.Storage
@using AgriNexus.DataLayer
@using AgriNexus.DataLayer.Models
@inject AgriNexusDbContext DbContext
@inject AgriNexus.Services.AuthService Auth

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <h2 class="page-title">Harvest Recording</h2>
        <p class="text-muted mb-0 page-sub">
            <i class="bi bi-building text-success me-1"></i><strong>@ActiveBranch</strong> · record harvested lots, grade quality, and post approved quantities into produce stock.
        </p>
    </div>
    <button type="button" class="btn-solid shadow-sm" @onclick="OpenNew">
        <i class="bi bi-basket"></i> Record harvest
    </button>
</div>

<!-- STAT CARDS -->
<div class="row g-3 mb-4">
    @foreach (var s in Stats)
    {
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <span class="card-title">@s.Title</span>
                    <div class="stat-icon @s.IconClass"><i class="bi @s.Icon"></i></div>
                </div>
                <div class="mt-3">
                    <div class="card-value">@s.Value</div>
                    <div class="text-muted small mt-1">@s.Note</div>
                </div>
            </div>
        </div>
    }
</div>

<!-- TABS -->
<div class="tabs mb-4">
    <button type="button" class="tab-btn @(activeTab == "record" ? "active" : "")" @onclick='() => SetTab("record")'>
        <i class="bi bi-clipboard-check me-1"></i> Recording &amp; approval
    </button>
    <button type="button" class="tab-btn @(activeTab == "lots" ? "active" : "")" @onclick='() => SetTab("lots")'>
        <i class="bi bi-collection me-1"></i> Harvest lots
    </button>
    <button type="button" class="tab-btn @(activeTab == "reports" ? "active" : "")" @onclick='() => SetTab("reports")'>
        <i class="bi bi-bar-chart-line me-1"></i> Harvest history &amp; reports
    </button>
</div>

<!-- ======================= RECORDING & APPROVAL ======================= -->
@if (activeTab == "record")
{
    <div class="toolbar mb-3 d-flex flex-wrap align-items-center gap-3">
        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text" placeholder="Search lot, crop, plot..."
                   @bind="searchText"
                   @bind:event="oninput" />
        </div>

        <select class="filter-select" @bind="dateRangeFilter">
            <option value="all">All Time</option>
            <option value="month">This Month</option>
            <option value="90days">Last 90 Days</option>
            <option value="year">This Year</option>
        </select>

        <select class="filter-select" @bind="statusFilter">
            <option value="">All statuses</option>
            <option value="pending">Pending approval</option>
            <option value="approved">Approved</option>
            <option value="rejected">Rejected</option>
        </select>

        <span class="text-muted small">@Filtered.Count @(Filtered.Count == 1 ? "record" : "records")</span>
    </div>

    <div class="panel shadow-sm bg-white" style="border-radius: 16px; border: 1px solid #E2ECE6; overflow: hidden;">
        <div class="table-responsive">
            <table class="table table-hover data-table align-middle mb-0">
                <thead style="background-color: #F7FAF8;">
                    <tr>
                        <th class="text-muted small fw-bold text-uppercase py-3 px-4">Lot</th>
                        <th class="text-muted small fw-bold text-uppercase py-3">Date</th>
                        <th class="text-muted small fw-bold text-uppercase py-3">Crop</th>
                        <th class="text-muted small fw-bold text-uppercase py-3">Plot</th>
                        <th class="text-muted small fw-bold text-uppercase py-3">Quantity</th>
                        <th class="text-muted small fw-bold text-uppercase py-3">Grade</th>
                        <th class="text-muted small fw-bold text-uppercase py-3">Unit<br />value</th>
                        <th class="text-muted small fw-bold text-uppercase py-3">Selling<br />price</th>
                        <th class="text-muted small fw-bold text-uppercase py-3">Status</th>
                        <th class="py-3 px-4"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in Filtered)
                    {
                        var st = NormalizeStatus(h.Status);
                        var effectiveSell = h.SellingPrice > 0 ? h.SellingPrice : h.UnitValue;
                        <tr style="cursor: pointer;" @onclick="() => OpenDetails(h)">
                            <td class="fw-bold text-nowrap px-4">@h.LotNumber</td>
                            <td class="col-date text-nowrap">@h.HarvestDate.ToString("MMM d, yyyy", Inv)</td>
                            <td class="fw-semibold">
                                <div class="d-flex align-items-center gap-2">
                                    @if (!string.IsNullOrWhiteSpace(h.ImageUrl))
                                    {
                                        <img src="@h.ImageUrl" alt="@h.CropName"
                                             style="width: 34px; height: 34px; object-fit: cover; border-radius: 8px; border: 1px solid #C6DFCE; flex-shrink: 0;" />
                                    }
                                    <span>@h.CropName</span>
                                </div>
                            </td>
                            <td class="col-plot">@PlotNameOf(h.PlotId)</td>
                            <td class="text-nowrap">@Qty(h.QuantityKg) @h.Unit</td>
                            <td>@h.QualityGrade</td>
                            <td class="text-nowrap">@Peso(h.UnitValue)</td>
                            <td class="text-nowrap fw-semibold text-success">@Peso(effectiveSell) / @h.Unit</td>
                            <td><span class="pill @StatusClass(st)">@Label(st)</span></td>
                            <td class="text-end text-nowrap col-actions px-4" @onclick:stopPropagation="true">
                                @if (IsBusinessTenant && st == "pending")
                                {
                                    <button type="button" class="btn-approve" @onclick="() => ApproveAsync(h)">
                                        <i class="bi bi-check-circle"></i> Approve
                                    </button>
                                    <button type="button" class="btn-reject" @onclick="() => RejectAsync(h)">
                                        <i class="bi bi-x-circle"></i> Reject
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                    @if (Filtered.Count == 0)
                    {
                        <tr><td colspan="10" class="text-center text-muted py-5">No harvest records found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- ======================= HARVEST LOTS ======================= -->
@if (activeTab == "lots")
{
    <div class="panel shadow-sm bg-white" style="border-radius: 16px; border: 1px solid #E2ECE6; overflow: hidden;">
        <div class="panel-head">
            <div class="panel-title">Harvest lot management</div>
            <div class="panel-sub mb-0">Quantities grouped per lot number for traceability</div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover data-table align-middle mb-0">
                <thead style="background-color: #F7FAF8;">
                    <tr>
                        <th class="text-muted small fw-bold text-uppercase py-3 px-4">Lot number</th>
                        <th class="text-muted small fw-bold text-uppercase py-3">Crop</th>
                        <th class="text-muted small fw-bold text-uppercase py-3">Plot</th>
                        <th class="text-muted small fw-bold text-uppercase py-3">Harvest date</th>
                        <th class="text-muted small fw-bold text-uppercase py-3">Total quantity</th>
                        <th class="text-muted small fw-bold text-uppercase py-3 px-4">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Lots)
                    {
                        <tr>
                            <td class="fw-bold text-nowrap px-4">@l.Lot</td>
                            <td>@l.Crop</td>
                            <td>@l.Plot</td>
                            <td class="text-nowrap">@l.Date.ToString("MMM d, yyyy", Inv)</td>
                            <td class="text-nowrap">@Qty(l.Qty) @l.Unit</td>
                            <td class="px-4"><span class="pill @StatusClass(l.Status)">@Label(l.Status)</span></td>
                        </tr>
                    }
                    @if (Lots.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-5">No harvest lots found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- ======================= HISTORY & REPORTS ======================= -->
@if (activeTab == "reports")
{
    <div class="row g-3">
        <div class="col-12 col-lg-8">
            <div class="stat-card h-100">
                <div class="panel-title">Harvest output by crop</div>
                <div class="panel-sub">Approved quantities</div>

                <svg viewBox="0 0 640 300" class="w-100" style="max-height:340px" role="img" aria-label="Harvest output by crop">
                    <defs>
                        <linearGradient id="leafBarGrad" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="#62A834" />
                            <stop offset="100%" stop-color="#4E8D2A" />
                        </linearGradient>
                    </defs>

                    @for (int i = 0; i <= 4; i++)
                    {
                        var y = 20 + i * 60;
                        var val = AxisMax / 4 * (4 - i);
                        <g>
                            <line x1="62" x2="630" y1="@y" y2="@y" stroke="#E2ECE6" stroke-dasharray="3 4" />
                            <text x="52" y="@(y + 4)" text-anchor="end" font-size="11" fill="#64748B">@val.ToString("0", Inv)</text>
                        </g>
                    }
                    @for (int i = 0; i < CropOutput.Count; i++)
                    {
                        var c = CropOutput[i];
                        var slot = 568.0 / CropOutput.Count;
                        var w = slot * 0.76;
                        var x = 62 + i * slot + (slot - w) / 2;
                        var h = (double)c.Qty / AxisMax * 240;
                        var barY = 260 - h;
                        <g>
                            @if (h > 0)
                            {
                                <rect x="@F(x)" y="@F(barY)" width="@F(w)" height="@F(h)" rx="6" fill="url(#leafBarGrad)" />
                                @((MarkupString)$"<text x=\"{F(x + w / 2)}\" y=\"{F(barY - 6)}\" text-anchor=\"middle\" font-size=\"10.5\" font-weight=\"700\" fill=\"#1B5E34\">{Qty(c.Qty)} kg</text>")
                            }
                            <text x="@F(x + w / 2)" y="282" text-anchor="middle" font-size="11" font-weight="600" fill="#475569">@c.Crop</text>
                        </g>
                    }
                </svg>

                @if (CropOutput.Count == 0)
                {
                    <div class="text-center text-muted small">No approved harvests yet.</div>
                }
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="stat-card h-100">
                <div class="panel-title">Quality grade mix</div>
                <div class="panel-sub">Share of approved harvest</div>

                <div class="d-flex justify-content-center my-3">
                    <svg viewBox="0 0 200 200" width="220" height="220" role="img" aria-label="Quality grade mix">
                        @{
                            double offset = 0;
                        }
                        @foreach (var g in TwoColorGradeMix)
                        {
                            var len = (double)(g.Qty / TwoColorGradeTotal) * Circ;
                            var dash = TwoColorGradeMix.Count == 1 ? len : Math.Max(len - 2, 0.5);
                            <circle cx="100" cy="100" r="@Radius" fill="none" stroke="@g.Color" stroke-width="30"
                                    stroke-dasharray="@F(dash) @F(Circ - dash)"
                                    stroke-dashoffset="@F(-offset)"
                                    transform="rotate(-90 100 100)" />
                            offset += len;
                        }
                    </svg>
                </div>

                <div class="d-flex justify-content-center gap-4 small text-muted flex-wrap">
                    @foreach (var g in TwoColorGradeMix)
                    {
                        <span class="fw-medium" style="color: #0A2B1D;">
                            <span class="legend-dot" style="background:@g.Color"></span>@g.Label · @PctOf(g.Qty, TwoColorGradeTotal)%
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- DETAILS MODAL -->
@if (showDetailsModal && selectedHarvest != null)
{
    var dStatus = NormalizeStatus(selectedHarvest.Status);
    var dSell = selectedHarvest.SellingPrice > 0 ? selectedHarvest.SellingPrice : selectedHarvest.UnitValue;

    <div class="modal fade show d-block" style="background-color: rgba(10, 43, 29, 0.65); backdrop-filter: blur(5px); z-index: 1050;" tabindex="-1" @onclick="CloseDetailsModal">
        <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation="true">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="modal-header border-0 p-4 d-flex justify-content-between align-items-center" style="background-color: #F4F7F5;">
                    <div class="d-flex align-items-center gap-3">
                        @if (!string.IsNullOrWhiteSpace(selectedHarvest.ImageUrl))
                        {
                            <div class="position-relative"
                                 style="cursor: zoom-in; flex-shrink: 0;"
                                 title="Click to enlarge image"
                                 @onclick="() => OpenImageZoom(selectedHarvest.ImageUrl, selectedHarvest.CropName)">
                                <img src="@selectedHarvest.ImageUrl" alt="@selectedHarvest.CropName"
                                     style="width: 64px; height: 64px; object-fit: cover; border-radius: 14px; border: 2px solid #C6DFCE; background-color: #FFFFFF;" />
                                <span class="position-absolute bottom-0 end-0 badge rounded-pill shadow-sm"
                                      style="background-color: #0A2B1D; color: #FFFFFF; font-size: 0.65rem; padding: 3px 5px; transform: translate(20%, 20%);">
                                    <i class="bi bi-zoom-in"></i>
                                </span>
                            </div>
                        }
                        else
                        {
                            <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; background-color: #E8F3EC; color: #1B5E34; flex-shrink: 0;">
                                <i class="bi bi-flower2 fs-4"></i>
                            </div>
                        }
                        <div>
                            <h4 class="modal-title fw-bolder mb-0" style="color: #0A2B1D;">@selectedHarvest.CropName</h4>
                            <div class="d-flex flex-wrap align-items-center gap-2 mt-1">
                                <span class="badge px-2 py-1 rounded-pill" style="background-color: #FFFFFF; color: #1B5E34; border: 1px solid #C6DFCE;">
                                    <i class="bi bi-upc-scan me-1"></i>@selectedHarvest.LotNumber
                                </span>
                                <span class="pill @StatusClass(dStatus)">@Label(dStatus)</span>
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn-close bg-white shadow-sm rounded-circle p-2" @onclick="CloseDetailsModal" aria-label="Close" style="width: 32px; height: 32px;"></button>
                </div>

                <div class="modal-body p-4" style="max-height: 70vh; overflow-y: auto;">
                    <div class="mb-4">
                        <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                            <i class="bi bi-info-circle me-2 text-success"></i>Harvest &amp; Lot Details
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="text-muted small fw-bold text-uppercase">Crop</label>
                                <p class="mb-0 fw-semibold fs-6 text-dark">
                                    <i class="bi bi-flower2 text-success me-2"></i>@selectedHarvest.CropName
                                </p>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted small fw-bold text-uppercase">Plot</label>
                                <p class="mb-0 fw-semibold fs-6 text-dark">
                                    <i class="bi bi-geo-alt text-success me-2"></i>@PlotNameOf(selectedHarvest.PlotId)
                                </p>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label class="text-muted small fw-bold text-uppercase">Harvest Date</label>
                                <p class="mb-0 fw-medium text-dark">
                                    <i class="bi bi-calendar3 text-success me-2"></i>@selectedHarvest.HarvestDate.ToString("MMM d, yyyy", Inv)
                                </p>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label class="text-muted small fw-bold text-uppercase">Quality Grade</label>
                                <p class="mb-0 fw-medium text-dark">
                                    <i class="bi bi-award text-success me-2"></i>Grade @selectedHarvest.QualityGrade
                                </p>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label class="text-muted small fw-bold text-uppercase">Recorded By</label>
                                <p class="mb-0 fw-medium text-dark">
                                    <i class="bi bi-person text-success me-2"></i>@(string.IsNullOrWhiteSpace(selectedHarvest.RecordedBy) ? "—" : selectedHarvest.RecordedBy)
                                </p>
                            </div>
                            <div class="col-12 mt-3">
                                <label class="text-muted small fw-bold text-uppercase">Notes</label>
                                <p class="mb-0 text-muted fst-italic">
                                    <i class="bi bi-journal-text text-success me-2"></i>@(string.IsNullOrWhiteSpace(selectedHarvest.Notes) ? "No notes provided." : selectedHarvest.Notes)
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="p-4 rounded-4" style="background-color: #F7FAF8; border: 1px dashed #C6DFCE;">
                        <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                            <i class="bi bi-cash-coin me-2 text-success"></i>Quantity &amp; Pricing Summary
                        </h6>
                        <div class="row g-3 text-center">
                            <div class="col-6 col-md-3">
                                <div class="p-3 bg-white rounded-3 border h-100 d-flex flex-column align-items-center justify-content-center" style="border-color: #E2ECE6 !important;">
                                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 34px; height: 34px; background-color: #E8F3EC; color: #0A2B1D;">
                                        <i class="bi bi-basket"></i>
                                    </div>
                                    <h5 class="fw-bolder mb-1" style="color: #0A2B1D;">@Qty(selectedHarvest.QuantityKg) @selectedHarvest.Unit</h5>
                                    <small class="text-muted fw-medium">Harvested</small>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-3 bg-white rounded-3 border h-100 d-flex flex-column align-items-center justify-content-center" style="border-color: #E2ECE6 !important;">
                                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 34px; height: 34px; background-color: #EDF7E8; color: #4E8D2A;">
                                        <i class="bi bi-tag"></i>
                                    </div>
                                    <h5 class="fw-bolder mb-1" style="color: #4E8D2A;">@Peso(selectedHarvest.UnitValue)</h5>
                                    <small class="text-muted fw-medium">Unit Value / @selectedHarvest.Unit</small>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-3 bg-white rounded-3 border h-100 d-flex flex-column align-items-center justify-content-center" style="border-color: #E2ECE6 !important;">
                                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 34px; height: 34px; background-color: #E8F3EC; color: #1B5E34;">
                                        <i class="bi bi-cash-stack"></i>
                                    </div>
                                    <h5 class="fw-bolder mb-1" style="color: #1B5E34;">@Peso(dSell)</h5>
                                    <small class="text-muted fw-medium">Selling Price / @selectedHarvest.Unit</small>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-3 bg-white rounded-3 border h-100 d-flex flex-column align-items-center justify-content-center" style="border-color: #E2ECE6 !important;">
                                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 34px; height: 34px; background-color: #F5EFEA; color: #7A5230;">
                                        <i class="bi bi-wallet2"></i>
                                    </div>
                                    <h5 class="fw-bolder mb-1" style="color: #7A5230;">@Peso(selectedHarvest.QuantityKg * dSell)</h5>
                                    <small class="text-muted fw-medium">Est. Sales Value</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-0 p-4 d-flex justify-content-between" style="background-color: #F4F7F5;">
                    <button type="button" class="btn btn-light border fw-bold px-4 rounded-3 shadow-sm" @onclick="CloseDetailsModal">
                        <i class="bi bi-x-lg me-1"></i> Close
                    </button>
                    @if (IsBusinessTenant && dStatus == "pending")
                    {
                        <div class="d-flex gap-2">
                            <button type="button" class="btn-reject" @onclick="async () => { var item = selectedHarvest; CloseDetailsModal(); await RejectAsync(item); }">
                                <i class="bi bi-x-circle"></i> Reject
                            </button>
                            <button type="button" class="btn-approve" @onclick="async () => { var item = selectedHarvest; CloseDetailsModal(); await ApproveAsync(item); }">
                                <i class="bi bi-check-circle"></i> Approve &amp; Post
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- IMAGE ZOOM LIGHTBOX MODAL -->
@if (showImageZoomModal && !string.IsNullOrWhiteSpace(zoomedImageUrl))
{
    <div class="modal fade show d-block"
         style="background-color: rgba(10, 43, 29, 0.85); backdrop-filter: blur(6px); z-index: 1080;"
         tabindex="-1"
         @onclick="CloseImageZoom">
        <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation="true">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden bg-white">
                <div class="modal-header border-0 px-4 py-3 d-flex justify-content-between align-items-center" style="background-color: #F4F7F5;">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-image text-success"></i>
                        <h6 class="modal-title fw-bold mb-0" style="color: #0A2B1D;">@zoomedImageTitle</h6>
                    </div>
                    <button type="button" class="btn-close bg-white shadow-sm rounded-circle p-2"
                            @onclick="CloseImageZoom" aria-label="Close" style="width: 30px; height: 30px;"></button>
                </div>
                <div class="modal-body p-3 text-center" style="background-color: #0A2B1D;">
                    <img src="@zoomedImageUrl" alt="@zoomedImageTitle"
                         class="img-fluid rounded-3"
                         style="max-height: 75vh; object-fit: contain;" />
                </div>
            </div>
        </div>
    </div>
}

<!-- RECORD HARVEST MODAL -->
@if (showModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(10, 43, 29, 0.65); backdrop-filter: blur(5px); z-index: 1050;" tabindex="-1" @onclick="CloseModal">
        <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation="true">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="modal-header border-0 p-4 d-flex justify-content-between align-items-center" style="background-color: #F4F7F5;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; background-color: #E8F3EC; color: #1B5E34; flex-shrink: 0;">
                            <i class="bi bi-basket fs-5"></i>
                        </div>
                        <div>
                            <h4 class="modal-title fw-bolder mb-0" style="color: #0A2B1D;">Record Harvest</h4>
                            <p class="text-muted small mb-0">
                                @if (IsBusinessTenant)
                                {
                                    <span>Approved harvest quantities post directly into inventory &amp; POS produce stock.</span>
                                }
                                else
                                {
                                    <span>Harvests recorded by staff are submitted as pending for Business Tenant approval.</span>
                                }
                            </p>
                        </div>
                    </div>
                    <button type="button" class="btn-close bg-white shadow-sm rounded-circle p-2" @onclick="CloseModal" aria-label="Close" style="width: 32px; height: 32px;"></button>
                </div>

                <div class="modal-body p-4" style="max-height: 70vh; overflow-y: auto;">
                    <form>
                        <!-- SECTION 0: Produce Image -->
                        <div class="mb-4 p-3 rounded-4 d-flex flex-wrap align-items-center gap-3" style="background-color: #F7FAF8; border: 1px dashed #C6DFCE;">
                            <div style="width: 78px; height: 78px; border-radius: 14px; background-color: #FFFFFF; border: 1px solid #E2ECE6; overflow: hidden; flex-shrink: 0;"
                                 class="d-flex align-items-center justify-content-center">
                                @if (!string.IsNullOrWhiteSpace(imagePreviewUrl))
                                {
                                    <img src="@imagePreviewUrl" alt="Crop preview" style="width: 100%; height: 100%; object-fit: cover;" />
                                }
                                else
                                {
                                    <i class="bi bi-image text-muted fs-3 opacity-50"></i>
                                }
                            </div>

                            <div class="flex-grow-1">
                                <label class="form-label fw-bold small text-muted mb-1">
                                    <i class="bi bi-camera me-1 text-success"></i>Produce Image (Displayed in Inventory &amp; POS)
                                </label>
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <InputFile OnChange="HandleImageSelectedAsync"
                                               accept=".jpg,.jpeg,.png,.webp"
                                               class="form-control form-control-sm"
                                               style="max-width: 280px;" />
                                    @if (!string.IsNullOrWhiteSpace(imagePreviewUrl))
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-3" @onclick="RemoveImage">
                                            <i class="bi bi-trash me-1"></i>Remove
                                        </button>
                                    }
                                </div>
                                <div class="text-muted small mt-1">JPG, PNG, or WEBP · Max 3 MB</div>
                                @if (!string.IsNullOrEmpty(imageError))
                                {
                                    <div class="err">@imageError</div>
                                }
                            </div>
                        </div>

                        <!-- SECTION 1: Crop & Plot Details -->
                        <div class="mb-4">
                            <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                                <i class="bi bi-flower2 me-2 text-success"></i>Crop &amp; Plot Details
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Crop <span class="text-danger">*</span></label>
                                    <div class="input-group modern-input @(showErrors && string.IsNullOrWhiteSpace(form.CropName) ? "border border-danger rounded-3" : "")">
                                        <span class="input-group-text bg-white"><i class="bi bi-flower2 text-success"></i></span>
                                        <input class="form-control" placeholder="e.g. Rice, Corn, Cabbage"
                                               list="cropList" @bind="form.CropName" />
                                    </div>
                                    <datalist id="cropList">
                                        @foreach (var c in CropSuggestions)
                                        {
                                            <option value="@c"></option>
                                        }
                                    </datalist>
                                    @if (showErrors && string.IsNullOrWhiteSpace(form.CropName))
                                    {
                                        <div class="err">Crop is required.</div>
                                    }
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Plot</label>
                                    <div class="input-group modern-input">
                                        <span class="input-group-text bg-white"><i class="bi bi-geo-alt text-success"></i></span>
                                        @if (plotOptions.Count > 0)
                                        {
                                            <select class="form-select" @bind="selectedPlotIdStr">
                                                <option value="">Select...</option>
                                                @foreach (var p in plotOptions)
                                                {
                                                    <option value="@p.Id">@p.Name</option>
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            <input type="number" class="form-control" placeholder="Plot ID (optional)" @bind="form.PlotId" />
                                        }
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Harvest Date</label>
                                    <div class="input-group modern-input">
                                        <span class="input-group-text bg-white"><i class="bi bi-calendar3 text-success"></i></span>
                                        <input type="date" class="form-control" @bind="form.HarvestDate" />
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Quality Grade</label>
                                    <div class="input-group modern-input">
                                        <span class="input-group-text bg-white"><i class="bi bi-award text-success"></i></span>
                                        <select class="form-select" @bind="form.QualityGrade">
                                            <option value="A">A</option>
                                            <option value="B">B</option>
                                            <option value="C">C</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- SECTION 2: Quantity, Unit & Pricing -->
                        <div class="mb-4">
                            <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                                <i class="bi bi-cash-coin me-2 text-success"></i>Quantity, Unit &amp; Pricing
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Quantity Harvested <span class="text-danger">*</span></label>
                                    <div class="input-group modern-input @(showErrors && QtyInvalid ? "border border-danger rounded-3" : "")">
                                        <span class="input-group-text bg-white"><i class="bi bi-basket text-success"></i></span>
                                        <input type="number" min="0" step="any" class="form-control" placeholder="0.00" @bind="qtyInput" />
                                    </div>
                                    @if (showErrors && QtyInvalid)
                                    {
                                        <div class="err">Enter a quantity greater than zero.</div>
                                    }
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Unit</label>
                                    <div class="input-group modern-input">
                                        <span class="input-group-text bg-white"><i class="bi bi-rulers text-success"></i></span>
                                        <select class="form-select" @bind="form.Unit">
                                            @foreach (var u in UnitOptions)
                                            {
                                                <option value="@u">@u</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Unit Value / Base Cost (₱ / @form.Unit)</label>
                                    <div class="input-group modern-input @(showErrors && valueInput < 0 ? "border border-danger rounded-3" : "")">
                                        <span class="input-group-text bg-white"><i class="bi bi-tag text-success"></i></span>
                                        <input type="number" min="0" step="0.01" class="form-control" placeholder="0.00" @bind="valueInput" />
                                    </div>
                                    @if (showErrors && valueInput < 0)
                                    {
                                        <div class="err">Value can’t be negative.</div>
                                    }
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Selling Price (₱ / @form.Unit)</label>
                                    <div class="input-group modern-input @(showErrors && sellingPriceInput < 0 ? "border border-danger rounded-3" : "")">
                                        <span class="input-group-text bg-white"><i class="bi bi-cash-stack text-success"></i></span>
                                        <input type="number" min="0" step="0.01" class="form-control" placeholder="0.00" @bind="sellingPriceInput" />
                                    </div>
                                    <div class="text-muted small mt-1">Resale/POS price per @form.Unit (uses unit value if blank).</div>
                                    @if (showErrors && sellingPriceInput < 0)
                                    {
                                        <div class="err">Selling price can’t be negative.</div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- SECTION 3: Lot, Recorder & Notes -->
                        <div class="p-4 rounded-4" style="background-color: #F7FAF8; border: 1px dashed #C6DFCE;">
                            <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                                <i class="bi bi-upc-scan me-2 text-success"></i>Lot, Recorder &amp; Notes
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Lot Number</label>
                                    <div class="input-group modern-input @(showErrors && LotTaken ? "border border-danger rounded-3" : "")">
                                        <span class="input-group-text bg-white"><i class="bi bi-upc-scan text-success"></i></span>
                                        <input class="form-control fw-bold" @bind="form.LotNumber" />
                                    </div>
                                    @if (showErrors && LotTaken)
                                    {
                                        <div class="err">This lot number is already used.</div>
                                    }
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Recorded By</label>
                                    <div class="input-group modern-input">
                                        <span class="input-group-text bg-white"><i class="bi bi-person text-success"></i></span>
                                        <input class="form-control" @bind="form.RecordedBy" />
                                    </div>
                                </div>

                                <div class="col-12 mt-3">
                                    <label class="form-label fw-bold small text-muted">Notes</label>
                                    <div class="input-group modern-input">
                                        <span class="input-group-text bg-white"><i class="bi bi-journal-text text-success"></i></span>
                                        <textarea class="form-control border-0 shadow-sm" rows="3" @bind="form.Notes"></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Footer -->
                <div class="modal-footer border-0 p-4 d-flex justify-content-end gap-2" style="background-color: #F4F7F5;">
                    <button type="button" class="btn btn-light border fw-bold px-4 rounded-3 shadow-sm" @onclick="CloseModal">
                        <i class="bi bi-x-lg me-1"></i> Cancel
                    </button>
                    <button type="button" class="btn-save px-5 shadow-sm" @onclick="SaveAsync" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <i class="bi bi-check2-circle me-2"></i>
                            <span>@(IsBusinessTenant ? "Record & Post Harvest" : "Submit to Admin")</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(toast))
{
    <div class="toast-note"><i class="bi bi-check-circle-fill"></i> @toast</div>
}

@code {
    record Stat(string Title, string Value, string Note, string Icon, string IconClass);
    record LotRow(string Lot, string Crop, string Plot, DateTime Date, decimal Qty, string Unit, string Status);
    record CropQty(string Crop, decimal Qty);
    record GradeSlice(string Label, decimal Qty, string Color);
    record PlotOption(int Id, string Name);

    static readonly CultureInfo Inv = CultureInfo.InvariantCulture;
    const double Radius = 70;
    static readonly double Circ = 2 * Math.PI * Radius;
    static readonly string[] UnitOptions = { "kg", "sack", "piece", "bundle", "crate", "box" };
    const long MaxImageBytes = 3 * 1024 * 1024; // 3 MB

    long currentBusinessId;
    long? currentBranchId;
    string ActiveBranch = "All Branches";
    string currentUserRole = "";

    List<Branch> branches = new();
    List<PlotOption> plotOptions = new();
    List<HarvestRecord> harvests = new();

    string activeTab = "record";
    string searchText = "";
    string dateRangeFilter = "all"; // all | month | 90days | year
    string statusFilter = "";
    string selectedPlotIdStr = "";
    string toast = "";
    bool showModal;
    bool showErrors;
    bool isSaving;
    HarvestRecord form = new();
    decimal? qtyInput;
    decimal? valueInput;
    decimal? sellingPriceInput;

    // Details & Image Zoom state
    bool showDetailsModal;
    HarvestRecord? selectedHarvest;
    bool showImageZoomModal;
    string? zoomedImageUrl;
    string zoomedImageTitle = "";

    // Image upload state
    IBrowserFile? selectedImageFile;
    string? imagePreviewUrl;
    string imageError = "";

    bool IsBusinessTenant
    {
        get
        {
            var r = (currentUserRole ?? "").Trim().ToLower();
            if (string.IsNullOrEmpty(r)) return true;
            return r.Contains("tenant") || r.Contains("owner") || r.Contains("admin");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            User? currentUser = null;

            if (Auth.CurrentUserId > 0)
            {
                currentUser = await DbContext.Users
                    .Include(u => u.Business)
                    .FirstOrDefaultAsync(u => u.UserId == Auth.CurrentUserId);
            }
            else if (!string.IsNullOrWhiteSpace(Auth.CurrentUserEmail))
            {
                var cleanEmail = Auth.CurrentUserEmail.Trim().ToLower();
                currentUser = await DbContext.Users
                    .Include(u => u.Business)
                    .FirstOrDefaultAsync(u => u.Email != null && u.Email.ToLower() == cleanEmail);
            }
            else if (!string.IsNullOrWhiteSpace(Auth.CurrentUserName))
            {
                currentUser = await DbContext.Users
                    .Include(u => u.Business)
                    .FirstOrDefaultAsync(u => (u.FName + " " + u.LName) == Auth.CurrentUserName
                                           || u.FName == Auth.CurrentUserName);
            }

            currentUserRole = currentUser?.Role ?? "";

            if (currentUser?.BusinessId != null)
            {
                currentBusinessId = currentUser.BusinessId.Value;
                currentBranchId = currentUser.BranchId;
            }
            else
            {
                var firstBiz = await DbContext.Businesses.FirstOrDefaultAsync();
                if (firstBiz != null) currentBusinessId = firstBiz.BusinessId;
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            await ShowToast("Error loading harvest records: " + ex.Message);
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            branches = await DbContext.Branches
                .Where(b => b.BusinessId == currentBusinessId)
                .OrderBy(b => b.BranchName)
                .ToListAsync();

            if (currentBranchId.HasValue)
            {
                var matched = branches.FirstOrDefault(b => b.BranchId == currentBranchId.Value);
                if (matched != null) ActiveBranch = matched.BranchName;
            }
            else if (branches.Count > 0)
            {
                ActiveBranch = branches[0].BranchName;
            }

            plotOptions = await TryLoadPlotsAsync();

            harvests = await DbContext.HarvestRecords
                .Where(h => h.BusinessId == currentBusinessId)
                .OrderByDescending(h => h.HarvestDate)
                .ThenByDescending(h => h.HarvestId)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            await ShowToast("Database load error: " + ex.Message);
        }
    }

    private async Task<List<PlotOption>> TryLoadPlotsAsync()
    {
        var result = new List<PlotOption>();
        try
        {
            var prop = DbContext.GetType().GetProperties(BindingFlags.Public | BindingFlags.Instance)
                .FirstOrDefault(p => p.Name.Equals("Plots", StringComparison.OrdinalIgnoreCase)
                                  || p.Name.Equals("FarmPlots", StringComparison.OrdinalIgnoreCase));

            if (prop?.GetValue(DbContext) is System.Collections.IEnumerable rawSet)
            {
                foreach (var entity in rawSet)
                {
                    if (entity == null) continue;
                    var t = entity.GetType();
                    var idProp = t.GetProperty("PlotId") ?? t.GetProperty("Id");
                    var nameProp = t.GetProperty("PlotName") ?? t.GetProperty("Name") ?? t.GetProperty("Code");
                    if (idProp != null && nameProp != null)
                    {
                        if (int.TryParse(idProp.GetValue(entity)?.ToString(), out var id))
                        {
                            var name = nameProp.GetValue(entity)?.ToString() ?? $"Plot #{id}";
                            result.Add(new PlotOption(id, name));
                        }
                    }
                }
            }
        }
        catch
        {
            // Ignore if plots DbSet is not present yet
        }
        return await Task.FromResult(result.OrderBy(p => p.Name).ToList());
    }

    static string NormalizeStatus(string? s) => (s ?? "pending").Trim().ToLowerInvariant();
    static decimal Kg(HarvestRecord h) => string.Equals(h.Unit, "kg", StringComparison.OrdinalIgnoreCase) ? h.QuantityKg : 0;

    string PlotNameOf(int plotId)
    {
        if (plotId <= 0) return "—";
        var matched = plotOptions.FirstOrDefault(p => p.Id == plotId);
        return matched != null ? matched.Name : $"Plot #{plotId}";
    }

    DateTime? DateCutoff => dateRangeFilter switch
    {
        "month" => new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1),
        "90days" => DateTime.Today.AddDays(-90),
        "year" => new DateTime(DateTime.Today.Year, 1, 1),
        _ => null
    };

    IEnumerable<HarvestRecord> Approved => harvests.Where(h => NormalizeStatus(h.Status) == "approved");

    List<HarvestRecord> Filtered
    {
        get
        {
            IEnumerable<HarvestRecord> query = harvests;

            var cutoff = DateCutoff;
            if (cutoff.HasValue)
                query = query.Where(h => h.HarvestDate.Date >= cutoff.Value);

            if (!string.IsNullOrEmpty(statusFilter))
                query = query.Where(h => NormalizeStatus(h.Status) == statusFilter);

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                query = query.Where(h =>
                    (h.LotNumber ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    (h.CropName ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    PlotNameOf(h.PlotId).Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    (h.RecordedBy ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase));
            }

            return query.OrderByDescending(h => h.HarvestDate).ThenByDescending(h => h.HarvestId).ToList();
        }
    }

    List<Stat> Stats => new()
    {
        new("HARVEST RECORDS", harvests.Count.ToString(), harvests.Select(h => h.LotNumber).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().Count() + " lots created", "bi-flower2", ""),
        new("APPROVED QUANTITY", Qty(Approved.Sum(Kg)) + " kg", "Posted to produce stock", "bi-check-circle", ""),
        new("AWAITING APPROVAL", harvests.Count(h => NormalizeStatus(h.Status) == "pending").ToString(), "Not yet in inventory", "bi-hourglass-split", "stat-icon-warn"),
        new("ESTIMATED VALUE", Peso(Approved.Sum(h => h.QuantityKg * h.UnitValue)), "Quantity × unit value", "bi-cash-coin", "stat-icon-plain"),
    };

    List<LotRow> Lots => harvests
        .GroupBy(h => h.LotNumber)
        .Select(g => new LotRow(
            g.Key,
            g.First().CropName,
            PlotNameOf(g.First().PlotId),
            g.Max(x => x.HarvestDate),
            g.Sum(x => x.QuantityKg),
            g.First().Unit,
            g.Any(x => NormalizeStatus(x.Status) == "pending") ? "pending"
                : g.All(x => NormalizeStatus(x.Status) == "rejected") ? "rejected" : "approved"))
        .OrderByDescending(l => l.Date).ThenByDescending(l => l.Lot)
        .ToList();

    List<CropQty> CropOutput => Approved
        .OrderByDescending(h => h.HarvestDate).ThenByDescending(h => h.HarvestId)
        .GroupBy(h => h.CropName)
        .Select(g => new CropQty(g.Key, g.Sum(Kg)))
        .Where(c => c.Qty > 0)
        .ToList();

    double AxisMax
    {
        get
        {
            var max = CropOutput.Count == 0 ? 0 : (double)CropOutput.Max(c => c.Qty);
            return Math.Max(400, Math.Ceiling(max / 400) * 400);
        }
    }

    List<GradeSlice> TwoColorGradeMix
    {
        get
        {
            var gradeA = Approved.Where(h => string.Equals(h.QualityGrade, "A", StringComparison.OrdinalIgnoreCase)).Sum(Kg);
            var otherGrades = Approved.Where(h => !string.Equals(h.QualityGrade, "A", StringComparison.OrdinalIgnoreCase)).Sum(Kg);

            var list = new List<GradeSlice>();
            if (gradeA > 0) list.Add(new GradeSlice("Grade A", gradeA, "#1B5E34"));
            if (otherGrades > 0) list.Add(new GradeSlice("Grade B & C", otherGrades, "#4E8D2A"));

            if (list.Count == 0)
            {
                list.Add(new GradeSlice("Grade A", 1, "#1B5E34"));
                list.Add(new GradeSlice("Grade B & C", 1, "#4E8D2A"));
            }
            return list;
        }
    }

    decimal TwoColorGradeTotal => Math.Max(1m, TwoColorGradeMix.Sum(g => g.Qty));

    IEnumerable<string> CropSuggestions => harvests.Select(h => h.CropName).Where(c => !string.IsNullOrWhiteSpace(c)).Distinct()
        .Concat(new[] { "Rice", "Corn", "Cabbage", "Ampalaya" }).Distinct();

    bool QtyInvalid => !qtyInput.HasValue || qtyInput.Value <= 0;

    bool LotTaken => !string.IsNullOrWhiteSpace(form.LotNumber) &&
        harvests.Any(h => string.Equals(h.LotNumber, form.LotNumber.Trim(), StringComparison.OrdinalIgnoreCase));

    string NextLot
    {
        get
        {
            var max = 0;
            foreach (var h in harvests)
            {
                var p = (h.LotNumber ?? "").Split('-');
                if (p.Length == 2 && p[0] == "LOT" && int.TryParse(p[1], out var n)) max = Math.Max(max, n);
            }
            return "LOT-" + (max + 1).ToString("000");
        }
    }

    static string F(double d) => d.ToString("0.##", Inv);
    static string Qty(decimal v) => v.ToString("#,##0.##", Inv);
    static string Peso(decimal v) => "₱" + v.ToString("N2", Inv);
    int PctOf(decimal qty, decimal total) => (int)Math.Round(qty * 100m / Math.Max(1m, total));

    static string Label(string s) => NormalizeStatus(s) switch
    {
        "pending" => "Pending",
        "approved" => "Approved",
        "rejected" => "Rejected",
        _ => s
    };

    static string StatusClass(string s) => NormalizeStatus(s) switch
    {
        "approved" => "pill-green",
        "rejected" => "pill-red",
        _ => "pill-yellow"
    };

    void SetTab(string key) => activeTab = key;

    void OpenDetails(HarvestRecord item)
    {
        selectedHarvest = item;
        showDetailsModal = true;
    }

    void CloseDetailsModal()
    {
        showDetailsModal = false;
        selectedHarvest = null;
    }

    void OpenImageZoom(string? imageUrl, string title)
    {
        if (string.IsNullOrWhiteSpace(imageUrl)) return;
        zoomedImageUrl = imageUrl;
        zoomedImageTitle = title;
        showImageZoomModal = true;
    }

    void CloseImageZoom()
    {
        showImageZoomModal = false;
        zoomedImageUrl = null;
        zoomedImageTitle = "";
    }

    private async Task HandleImageSelectedAsync(InputFileChangeEventArgs e)
    {
        imageError = "";
        var file = e.File;
        if (file == null) return;

        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        if (ext is not (".jpg" or ".jpeg" or ".png" or ".webp"))
        {
            imageError = "Only JPG, PNG, or WEBP images are allowed.";
            return;
        }

        if (file.Size > MaxImageBytes)
        {
            imageError = "Image size must be 3 MB or less.";
            return;
        }

        selectedImageFile = file;

        using var ms = new MemoryStream();
        await file.OpenReadStream(MaxImageBytes).CopyToAsync(ms);
        imagePreviewUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
    }

    private void RemoveImage()
    {
        selectedImageFile = null;
        imagePreviewUrl = null;
        imageError = "";
    }

    private async Task<string?> SaveImageFileAsync()
    {
        if (selectedImageFile == null)
            return null;

        var uploadDir = Path.Combine(FileSystem.AppDataDirectory, "uploads", "harvest");
        Directory.CreateDirectory(uploadDir);

        var ext = Path.GetExtension(selectedImageFile.Name).ToLowerInvariant();
        var fileName = $"{Guid.NewGuid():N}{ext}";
        var fullPath = Path.Combine(uploadDir, fileName);

        await using var fs = new FileStream(fullPath, FileMode.Create);
        await selectedImageFile.OpenReadStream(MaxImageBytes).CopyToAsync(fs);

        using var ms = new MemoryStream();
        await using var readStream = File.OpenRead(fullPath);
        await readStream.CopyToAsync(ms);
        var mime = ext == ".png" ? "image/png" : ext == ".webp" ? "image/webp" : "image/jpeg";
        return $"data:{mime};base64,{Convert.ToBase64String(ms.ToArray())}";
    }

    private string NextProduceSku(string prefix = "LOT")
    {
        var existingCodes = DbContext.InventoryItems
            .Where(i => i.BusinessId == currentBusinessId && i.ItemCode != null)
            .Select(i => i.ItemCode!)
            .ToList();

        var max = 0;
        foreach (var code in existingCodes)
        {
            var parts = code.Split('-');
            if (parts.Length == 2 && parts[0].Equals(prefix, StringComparison.OrdinalIgnoreCase) && int.TryParse(parts[1], out var n))
                max = Math.Max(max, n);
        }

        return $"{prefix}-{(max + 1):000}";
    }

    private async Task PostHarvestToInventoryAsync(HarvestRecord h)
    {
        if (h.QuantityKg <= 0) return;

        var cleanCrop = string.IsNullOrWhiteSpace(h.CropName) ? "Harvested Produce" : h.CropName.Trim();
        var cleanUnit = string.IsNullOrWhiteSpace(h.Unit) ? "kg" : h.Unit.Trim();
        var plotLabel = PlotNameOf(h.PlotId);
        var cleanPlot = plotLabel == "—" ? "" : plotLabel;
        var effectiveSellingPrice = h.SellingPrice > 0 ? h.SellingPrice : h.UnitValue;

        var alreadyPosted = await DbContext.InventoryItems.AnyAsync(i =>
            i.BusinessId == currentBusinessId &&
            !i.IsArchived &&
            i.HarvestId == h.HarvestId);

        if (alreadyPosted) return;

        var matchingProduce = await DbContext.InventoryItems.FirstOrDefaultAsync(i =>
            i.BusinessId == currentBusinessId &&
            !i.IsArchived &&
            i.ItemType == "PRODUCE" &&
            i.ItemName.ToLower() == cleanCrop.ToLower() &&
            i.Unit == cleanUnit);

        if (matchingProduce != null)
        {
            matchingProduce.QuantityOnHand += h.QuantityKg;
            if (h.UnitValue > 0) matchingProduce.UnitCost = h.UnitValue;
            if (effectiveSellingPrice > 0) matchingProduce.SellingPrice = effectiveSellingPrice;
            if (!string.IsNullOrWhiteSpace(cleanPlot)) matchingProduce.SourcePlot = cleanPlot;
            if (!string.IsNullOrWhiteSpace(h.ImageUrl)) matchingProduce.ImageUrl = h.ImageUrl;

            DbContext.InventoryItems.Update(matchingProduce);
        }
        else
        {
            var sku = string.IsNullOrWhiteSpace(h.LotNumber)
                ? NextProduceSku("LOT")
                : h.LotNumber.Trim().ToUpperInvariant();

            var skuExists = await DbContext.InventoryItems.AnyAsync(i =>
                i.BusinessId == currentBusinessId && i.ItemCode == sku);
            if (skuExists)
                sku = NextProduceSku("LOT");

            var newProduce = new InventoryItem
            {
                BusinessId = currentBusinessId,
                BranchId = currentBranchId,
                ItemName = cleanCrop,
                ItemCode = sku,
                Category = "produce",
                ItemType = "PRODUCE",
                QuantityOnHand = h.QuantityKg,
                ReorderLevel = 0,
                UnitCost = h.UnitValue,
                SellingPrice = effectiveSellingPrice,
                Unit = cleanUnit,
                StorageLocation = cleanPlot,
                HarvestId = h.HarvestId,
                SourcePlot = cleanPlot,
                ImageUrl = h.ImageUrl,
                Notes = string.IsNullOrWhiteSpace(h.Notes)
                    ? $"Grade {h.QualityGrade} · Lot {h.LotNumber}"
                    : $"{h.Notes.Trim()} (Grade {h.QualityGrade} · Lot {h.LotNumber})",
                IsArchived = false
            };

            DbContext.InventoryItems.Add(newProduce);
        }

        await DbContext.SaveChangesAsync();
    }

    void OpenNew()
    {
        form = new HarvestRecord
        {
            BusinessId = currentBusinessId,
            HarvestDate = DateTime.Today,
            Unit = "kg",
            QualityGrade = "A",
            LotNumber = NextLot,
            RecordedBy = Auth.CurrentUserName ?? ""
        };
        selectedPlotIdStr = plotOptions.FirstOrDefault()?.Id.ToString() ?? "";
        qtyInput = null;
        valueInput = null;
        sellingPriceInput = null;
        selectedImageFile = null;
        imagePreviewUrl = null;
        imageError = "";
        showErrors = false;
        showModal = true;
    }

    void CloseModal() => showModal = false;

    async Task SaveAsync()
    {
        showErrors = true;
        if (string.IsNullOrWhiteSpace(form.CropName)
            || QtyInvalid
            || (valueInput.HasValue && valueInput < 0)
            || (sellingPriceInput.HasValue && sellingPriceInput < 0)
            || !string.IsNullOrEmpty(imageError)) return;

        var lot = string.IsNullOrWhiteSpace(form.LotNumber) ? NextLot : form.LotNumber.Trim().ToUpperInvariant();
        if (harvests.Any(h => string.Equals(h.LotNumber, lot, StringComparison.OrdinalIgnoreCase))) return;

        isSaving = true;
        try
        {
            var savedImageUrl = await SaveImageFileAsync();

            int plotId = int.TryParse(selectedPlotIdStr, out var pId) && pId > 0
                ? pId
                : (form.PlotId > 0 ? form.PlotId : (plotOptions.FirstOrDefault()?.Id ?? 0));

            string finalStatus = IsBusinessTenant ? "Approved" : "Pending";
            decimal unitCost = valueInput ?? 0;
            decimal sellingPrice = (sellingPriceInput.HasValue && sellingPriceInput.Value > 0)
                ? sellingPriceInput.Value
                : unitCost;

            var entity = new HarvestRecord
            {
                BusinessId = currentBusinessId,
                PlotId = plotId,
                WorkerId = form.WorkerId,
                LotNumber = lot,
                CropName = form.CropName.Trim(),
                QuantityKg = qtyInput!.Value,
                Unit = string.IsNullOrWhiteSpace(form.Unit) ? "kg" : form.Unit.Trim(),
                QualityGrade = string.IsNullOrWhiteSpace(form.QualityGrade) ? "A" : form.QualityGrade.Trim(),
                UnitValue = unitCost,
                SellingPrice = sellingPrice,
                ImageUrl = savedImageUrl,
                Status = finalStatus,
                RecordedBy = string.IsNullOrWhiteSpace(form.RecordedBy) ? (Auth.CurrentUserName ?? "") : form.RecordedBy.Trim(),
                Notes = (form.Notes ?? "").Trim(),
                HarvestDate = form.HarvestDate
            };

            DbContext.HarvestRecords.Add(entity);
            await DbContext.SaveChangesAsync();

            if (IsBusinessTenant)
            {
                await PostHarvestToInventoryAsync(entity);
            }

            showModal = false;
            await LoadDataAsync();

            if (IsBusinessTenant)
                await ShowToast(lot + " recorded, approved, and added to inventory.");
            else
                await ShowToast(lot + " submitted to admin for approval.");
        }
        catch (Exception ex)
        {
            await ShowToast("Error saving harvest: " + ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }

    async Task ApproveAsync(HarvestRecord h)
    {
        if (!IsBusinessTenant) return;
        try
        {
            var existing = await DbContext.HarvestRecords.FindAsync(h.HarvestId);
            if (existing != null)
            {
                existing.Status = "Approved";
                DbContext.HarvestRecords.Update(existing);
                await DbContext.SaveChangesAsync();

                await PostHarvestToInventoryAsync(existing);

                await LoadDataAsync();
                await ShowToast(h.LotNumber + " approved and posted to inventory.");
            }
        }
        catch (Exception ex)
        {
            await ShowToast("Error approving harvest: " + ex.Message);
        }
    }

    async Task RejectAsync(HarvestRecord h)
    {
        if (!IsBusinessTenant) return;
        try
        {
            var existing = await DbContext.HarvestRecords.FindAsync(h.HarvestId);
            if (existing != null)
            {
                existing.Status = "Rejected";
                DbContext.HarvestRecords.Update(existing);
                await DbContext.SaveChangesAsync();
                await LoadDataAsync();
                await ShowToast(h.LotNumber + " was rejected. Nothing was added to inventory.");
            }
        }
        catch (Exception ex)
        {
            await ShowToast("Error rejecting harvest: " + ex.Message);
        }
    }

    async Task ShowToast(string message)
    {
        toast = message;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(3000);
        toast = "";
        await InvokeAsync(StateHasChanged);
    }
}