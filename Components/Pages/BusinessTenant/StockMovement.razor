    async Task SaveAsync()
    {
        showErrors = true;
        if (form.ItemId == null || QtyError != null) return;
        if (modal == "receive" && form.Cost < 0) return;

        isSaving = true;
        try
        {
            var dbItem = await DbContext.InventoryItems.FindAsync(form.ItemId.Value);
            if (dbItem == null) return;

            var qty = form.Qty!.Value;
            var by = string.IsNullOrWhiteSpace(form.By) ? (Auth.CurrentUserName ?? "") : form.By.Trim();
            var kind = modal == "receive" ? "received" : modal == "issue" ? "issued" : "adjusted";

            string dbMovementType;
            decimal movementQty;

            switch (modal)
            {
                case "receive":
                    dbItem.QuantityOnHand += qty;
                    if (form.Cost.HasValue) dbItem.UnitCost = form.Cost.Value;
                    dbMovementType = "IN";
                    movementQty = qty;
                    break;

                case "issue":
                    if (qty > dbItem.QuantityOnHand)
                    {
                        await ShowToast($"Only {Qty(dbItem.QuantityOnHand)} {dbItem.Unit} on hand.", isWarning: true);
                        return;
                    }
                    dbItem.QuantityOnHand -= qty;
                    dbMovementType = "OUT";
                    movementQty = qty;
                    break;

                default: // adjust (new counted balance)
                    var diff = qty - dbItem.QuantityOnHand;
                    dbMovementType = diff >= 0 ? "IN" : "OUT";
                    movementQty = Math.Abs(diff);
                    dbItem.QuantityOnHand = qty;
                    break;
            }

            var reference = form.Reference?.Trim() ?? "";
            if (modal != "receive" && reference.Length == 0) reference = NextRef(modal);

            long branchToUse = dbItem.BranchId ?? activeBranchId;

            var entity = new AgriNexus.DataLayer.Models.StockMovement
            {
                ItemId = dbItem.ItemId,
                BranchId = branchToUse,
                MovementType = dbMovementType,
                Quantity = movementQty,
                ReferenceNumber = reference,
                Notes = BuildNotes(kind, form.Reason, by),
                TransactionDate = form.Date
            };

            DbContext.InventoryItems.Update(dbItem);
            DbContext.StockMovements.Add(entity);
            await DbContext.SaveChangesAsync();

            var title = ModalTitle;
            modal = null;
            await LoadDataAsync();
            await ShowToast($"{title} recorded for {dbItem.ItemName}.");
        }
        catch (Exception ex)
        {
            await ShowToast("Error recording movement: " + ex.Message, isWarning: true);
        }
        finally
        {
            isSaving = false;
        }
    }

    async Task ShowToast(string message, bool isWarning = false)
    {
        toast = message;
        toastIsWarning = isWarning;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(3200);
        toast = "";
        await InvokeAsync(StateHasChanged);
    }
