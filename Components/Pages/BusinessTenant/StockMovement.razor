    };

    string NextRef(string? type)
    {
        var prefix = type == "adjust" ? "ADJ" : "IS";
        var max = 0;
        foreach (var m in movements)
        {
            var p = (m.Reference ?? "").Split('-');
            if (p.Length == 2 && p[0].Equals(prefix, StringComparison.OrdinalIgnoreCase) && int.TryParse(p[1], out var n))
                max = Math.Max(max, n);
        }
        return prefix + "-" + (max + 1).ToString("0000");
    }

    private void GoToPage(int page) => currentPage = page;
    private void PreviousPage() { if (currentPage > 1) currentPage--; }
    private void NextPage() { if (currentPage < TotalPages) currentPage++; }
