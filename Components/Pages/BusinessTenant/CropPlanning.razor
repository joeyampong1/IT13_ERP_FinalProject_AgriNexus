@page "/crops"
@layout MainLayout
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Web
@using AgriNexus.DataLayer
@using AgriNexus.DataLayer.Models
@inject AgriNexusDbContext DbContext
@inject AgriNexus.Services.AuthService Auth
@inject IJSRuntime JS

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="page-title">Crop Planning and Planting</h2>
        <p class="text-muted mb-0 page-sub">
            <i class="bi bi-building text-success me-1"></i><strong>@ActiveBranch</strong> · plan crop cycles, track growth stages and expected harvest dates.
        </p>
    </div>
    <span class="badge rounded-pill px-3 py-2 fw-semibold" style="background-color: #E8F3EC; color: #1B5E34; border: 1px solid #C6DFCE;">
        <i class="bi bi-flower1 me-1"></i> Crop Cycle Directory
    </span>
</div>

<!-- STAT CARDS -->
<div class="row g-3 mb-4">
    @foreach (var s in Stats)
    {
        <div class="col-12 col-md-4">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <span class="card-title">@s.Title</span>
                    <div class="stat-icon @s.IconClass"><i class="bi @s.Icon"></i></div>
                </div>
                <div class="mt-3">
                    <div class="card-value">@s.Value</div>
                    @if (!string.IsNullOrEmpty(s.Note))
                    {
                        <div class="text-muted small mt-1">@s.Note</div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- TOOLBAR WITH TABS -->
<div class="toolbar mb-3 d-flex flex-wrap align-items-center gap-3">

    <!-- ACTIVE / HARVESTED TABS -->
    <div class="btn-group shadow-sm" role="group" aria-label="View Tabs">
        <input type="radio" class="btn-check" name="cropViewTabs" id="tabCropActive" autocomplete="off"
               checked="@(!showHarvestedOnly)" @onchange="() => ToggleTab(false)">
        <label class="btn btn-outline-success fw-bold" for="tabCropActive">
            <i class="bi bi-check-circle me-1"></i> Active
        </label>

        <input type="radio" class="btn-check" name="cropViewTabs" id="tabCropHarvested" autocomplete="off"
               checked="@showHarvestedOnly" @onchange="() => ToggleTab(true)">
        <label class="btn btn-outline-secondary fw-bold" for="tabCropHarvested">
            <i class="bi bi-archive me-1"></i> Harvested
        </label>
    </div>

    <!-- SEARCH BOX -->
    <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="text" placeholder="Search crop cycles..."
               @bind="searchText"
               @bind:event="oninput"
               @bind:after="ResetPagination" />
    </div>

    <span class="badge rounded-pill px-3 py-2 fw-semibold count-label" style="background-color: #FFFFFF; color: #0A2B1D; border: 1px solid #E2ECE6;">
        <i class="bi bi-flower1 me-1 text-success"></i>@Filtered.Count crop @(Filtered.Count == 1 ? "cycle" : "cycles")
    </span>

    <!-- NEW BUTTON -->
    <button type="button" class="btn-new ms-auto shadow-sm" @onclick="OpenNew">
        <i class="bi bi-plus-lg"></i> New crop cycle
    </button>
</div>

<!-- TABLE -->
<div class="panel shadow-sm bg-white d-flex flex-column" style="border-radius: 16px; border: 1px solid #E2ECE6; max-height: calc(100vh - 280px); overflow: hidden;">

    <div class="table-responsive" style="flex-grow: 1; overflow-y: auto;">
        <table class="table table-hover align-middle mb-0 biz-table" style="width: 100%;">
            <thead style="position: sticky; top: 0; z-index: 1; background-color: #F7FAF8;">
                <tr>
                    <th class="text-muted small fw-bold text-uppercase py-3 px-4">Crop</th>
                    <th class="text-muted small fw-bold text-uppercase py-3">Plot</th>
                    <th class="text-muted small fw-bold text-uppercase py-3">Area (ha)</th>
                    <th class="text-muted small fw-bold text-uppercase py-3">Planted</th>
                    <th class="text-muted small fw-bold text-uppercase py-3">Expected harvest</th>
                    <th class="text-muted small fw-bold text-uppercase py-3">Season</th>
                    <th class="text-muted small fw-bold text-uppercase py-3">Status</th>
                    <th class="py-3"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in PaginatedCycles)
                {
                    <tr style="cursor: pointer;" @onclick="() => OpenDetails(c)">
                        <td class="px-4">
                            <div class="d-flex align-items-center gap-3">
                                <div class="branch-avatar">
                                    <i class="bi bi-flower1"></i>
                                </div>
                                <div>
                                    <div class="fw-bold" style="color: #0A2B1D;">@c.Crop</div>
                                    <div class="text-muted small mt-1">@(string.IsNullOrWhiteSpace(c.Variety) ? "—" : c.Variety)</div>
                                </div>
                            </div>
                        </td>
                        <td class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(c.PlotName) ? "—" : c.PlotName)</td>
                        <td class="fw-semibold text-dark">@c.Area.ToString("0.##", Inv)</td>
                        <td class="text-nowrap text-dark">@DateText(c.Planted)</td>
                        <td class="text-nowrap text-dark">@DateText(c.ExpectedHarvest)</td>
                        <td class="text-dark">@Cap(c.Season)</td>
                        <td>
                            <span class="pill @StatusClass(c.Status)">
                                <i class="bi @StatusIcon(c.Status) me-1"></i>@Cap(c.Status)
                            </span>
                        </td>
                        <td class="text-end px-4 action-cell">
                            <button type="button" class="btn-dots"
                                    @onclick="(e) => ToggleMenuAsync(e, c.CropCycleId)"
                                    @onclick:stopPropagation="true" aria-label="Actions">
                                <i class="bi bi-three-dots"></i>
                            </button>
                        </td>
                    </tr>
                }
                @if (Filtered.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-5">
                            <i class="bi bi-inbox fs-3 d-block mb-2 opacity-50"></i>
                            No crop cycles found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- PAGINATION FOOTER -->
    @if (Filtered.Count > 0)
    {
        <div class="d-flex flex-wrap justify-content-between align-items-center p-3 border-top bg-white" style="flex-shrink: 0; border-color: #E2ECE6 !important; border-radius: 0 0 16px 16px;">
            <div class="text-muted small mb-2 mb-md-0">
                Showing <span class="fw-bold" style="color: #0A2B1D;">@StartItem</span> - <span class="fw-bold" style="color: #0A2B1D;">@EndItem</span> of <span class="fw-bold" style="color: #0A2B1D;">@Filtered.Count</span> cycles
            </div>

            <div class="d-flex gap-1">
                <button class="btn btn-sm btn-light border px-3 rounded-2 fw-medium" @onclick="PreviousPage" disabled="@(currentPage == 1)">
                    <i class="bi bi-chevron-left me-1"></i>Previous
                </button>

                @for (int i = 1; i <= TotalPages; i++)
                {
                    var pageNumber = i;
                    <button class="btn btn-sm px-3 rounded-2 fw-bold @(currentPage == pageNumber ? "btn-new text-white shadow-sm" : "btn-light border text-dark")"
                            @onclick="() => GoToPage(pageNumber)">
                        @pageNumber
                    </button>
                }

                <button class="btn btn-sm btn-light border px-3 rounded-2 fw-medium" @onclick="NextPage" disabled="@(currentPage == TotalPages)">
                    Next<i class="bi bi-chevron-right ms-1"></i>
                </button>
            </div>
        </div>
    }
</div>

<!-- FLOATING ACTION MENU -->
@if (openMenuId != null)
{
    var menuCycle = cycles.FirstOrDefault(x => x.CropCycleId == openMenuId);
    if (menuCycle != null)
    {
        <div class="menu-backdrop" @onclick="CloseMenu" @onclick:stopPropagation="true"></div>

        <div class="vertical-action-menu shadow-lg" style="top:@(menuTop)px; left:@(menuLeft)px;">
            <button type="button" class="action-item"
                    @onclick="() => OpenEdit(menuCycle)"
                    @onclick:stopPropagation="true">
                <i class="bi bi-pencil-square text-success"></i> Edit
            </button>

            @if (!string.Equals(menuCycle.Status, "growing", StringComparison.OrdinalIgnoreCase))
            {
                <button type="button" class="action-item"
                        @onclick='() => SetStatusAsync(menuCycle, "growing")'
                        @onclick:stopPropagation="true">
                    <i class="bi bi-sprout text-success"></i> Mark as growing
                </button>
            }

            @if (!string.Equals(menuCycle.Status, "harvested", StringComparison.OrdinalIgnoreCase))
            {
                <button type="button" class="action-item"
                        @onclick='() => SetStatusAsync(menuCycle, "harvested")'
                        @onclick:stopPropagation="true">
                    <i class="bi bi-check2-circle text-success"></i> Mark as harvested
                </button>
            }

            <div class="menu-sep"></div>

            <button type="button" class="action-item text-earth"
                    @onclick="() => PromptDelete(menuCycle)"
                    @onclick:stopPropagation="true">
                <i class="bi bi-trash"></i> Delete
            </button>
        </div>
    }
}

<!-- DETAILS MODAL -->
@if (showDetailsModal && selectedCycle != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(10, 43, 29, 0.65); backdrop-filter: blur(5px); z-index: 1050;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation="true">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

                <div class="modal-header border-0 p-4 d-flex justify-content-between align-items-center" style="background-color: #F4F7F5;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; background-color: #E8F3EC; color: #1B5E34;">
                            <i class="bi bi-flower1 fs-4"></i>
                        </div>
                        <div>
                            <h4 class="modal-title fw-bolder mb-0" style="color: #0A2B1D;">@selectedCycle.Crop</h4>
                            <span class="badge px-2 py-1 mt-1 rounded-pill" style="background-color: #FFFFFF; color: #1B5E34; border: 1px solid #C6DFCE;">
                                <i class="bi bi-tag me-1"></i>@(string.IsNullOrWhiteSpace(selectedCycle.Variety) ? "Standard Variety" : selectedCycle.Variety)
                            </span>
                        </div>
                    </div>
                    <button type="button" class="btn-close bg-white shadow-sm rounded-circle p-2" @onclick="CloseDetailsModal" aria-label="Close" style="width: 32px; height: 32px;"></button>
                </div>

                <div class="modal-body p-4" style="max-height: 70vh; overflow-y: auto;">
                    <div class="mb-4">
                        <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                            <i class="bi bi-info-circle me-2 text-success"></i>Cycle &amp; Plot Information
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="text-muted small fw-bold text-uppercase">Plot</label>
                                <p class="mb-0 fw-semibold fs-6 text-dark">@(string.IsNullOrWhiteSpace(selectedCycle.PlotName) ? "—" : selectedCycle.PlotName)</p>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted small fw-bold text-uppercase">Branch</label>
                                <p class="mb-0 fw-semibold fs-6 text-dark">@(string.IsNullOrWhiteSpace(selectedCycle.BranchName) ? "—" : selectedCycle.BranchName)</p>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label class="text-muted small fw-bold text-uppercase">Planted Date</label>
                                <p class="mb-0 fw-medium text-dark"><i class="bi bi-calendar-event text-success me-2"></i>@DateText(selectedCycle.Planted)</p>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label class="text-muted small fw-bold text-uppercase">Expected Harvest</label>
                                <p class="mb-0 fw-medium text-dark"><i class="bi bi-calendar-check text-success me-2"></i>@DateText(selectedCycle.ExpectedHarvest)</p>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label class="text-muted small fw-bold text-uppercase">Season &amp; Seed Qty</label>
                                <p class="mb-0 fw-medium text-dark">@Cap(selectedCycle.Season) · @(string.IsNullOrWhiteSpace(selectedCycle.SeedQty) ? "—" : selectedCycle.SeedQty)</p>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label class="text-muted small fw-bold text-uppercase d-block mb-1">Status</label>
                                <span class="pill @StatusClass(selectedCycle.Status)">
                                    <i class="bi @StatusIcon(selectedCycle.Status) me-1"></i>@Cap(selectedCycle.Status)
                                </span>
                            </div>
                            <div class="col-12 mt-3">
                                <label class="text-muted small fw-bold text-uppercase">Notes</label>
                                <p class="mb-0 text-muted fst-italic">@(string.IsNullOrWhiteSpace(selectedCycle.Notes) ? "No notes provided." : selectedCycle.Notes)</p>
                            </div>
                        </div>
                    </div>

                    <div class="p-4 rounded-4" style="background-color: #F7FAF8; border: 1px dashed #C6DFCE;">
                        <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                            <i class="bi bi-grid-1x2 me-2 text-success"></i>Planted Area Summary
                        </h6>
                        <div class="row g-3 text-center">
                            <div class="col-6">
                                <div class="p-3 bg-white rounded-3 border" style="border-color: #E2ECE6 !important;">
                                    <h4 class="fw-bolder mb-0" style="color: #1B5E34;">@selectedCycle.Area.ToString("0.##", Inv) ha</h4>
                                    <small class="text-muted fw-medium">Area Planted</small>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 bg-white rounded-3 border" style="border-color: #E2ECE6 !important;">
                                    <h4 class="fw-bolder mb-0" style="color: #4E8D2A;">@Cap(selectedCycle.Season)</h4>
                                    <small class="text-muted fw-medium">Cropping Season</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-0 p-4 d-flex justify-content-between" style="background-color: #F4F7F5;">
                    <button type="button" class="btn btn-light border fw-bold px-4 rounded-3 shadow-sm" @onclick="CloseDetailsModal">Close</button>
                    <button type="button" class="btn-save px-5 shadow-sm" @onclick="() => OpenEdit(selectedCycle)">
                        <i class="bi bi-pencil-square me-2"></i>Edit Cycle
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ADD / EDIT MODAL -->
@if (showModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(10, 43, 29, 0.65); backdrop-filter: blur(5px); z-index: 1050;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation="true">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

                <div class="modal-header border-0 p-4" style="background-color: #F4F7F5;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; background-color: #E8F3EC; color: #1B5E34;">
                            <i class="bi @(editingId == null ? "bi-flower1" : "bi-pencil-square") fs-5"></i>
                        </div>
                        <div>
                            <h4 class="modal-title fw-bolder mb-0" style="color: #0A2B1D;">
                                @(editingId == null ? "New Crop Cycle" : "Edit Crop Cycle")
                            </h4>
                            <p class="text-muted small mb-0">Fill in the crop cycle details below to @(editingId == null ? "plan a new cycle" : "update the cycle").</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close bg-white shadow-sm rounded-circle p-2" @onclick="CloseModal" aria-label="Close" style="width: 32px; height: 32px;"></button>
                </div>

                <div class="modal-body p-4" style="max-height: 70vh; overflow-y: auto;">
                    <form>
                        <div class="mb-4">
                            <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                                <i class="bi bi-flower1 me-2 text-success"></i>Crop &amp; Plot Assignment
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Crop <span class="text-danger">*</span></label>
                                    <input class="form-control @(showErrors && string.IsNullOrWhiteSpace(form.Crop) ? "border-danger" : "")"
                                           placeholder="Rice, corn, cabbage..." @bind="form.Crop" />
                                    @if (showErrors && string.IsNullOrWhiteSpace(form.Crop))
                                    {
                                        <div class="err">Crop is required.</div>
                                    }
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Variety</label>
                                    <input class="form-control" placeholder="e.g. NSIC Rc222" @bind="form.Variety" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Plot</label>
                                    <select class="form-select" value="@selectedPlotIdStr" @onchange="OnPlotChanged">
                                        <option value="">Select...</option>
                                        @foreach (var p in plotOptions)
                                        {
                                            <option value="@p.PlotId">@p.Name (@p.FarmName)</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Plot name (as displayed)</label>
                                    <input class="form-control" placeholder="Plot A" @bind="form.PlotName" />
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                                <i class="bi bi-calendar3 me-2 text-success"></i>Area, Seeds &amp; Schedule
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Area planted (ha)</label>
                                    <input type="number" min="0" step="0.1" class="form-control @(showErrors && AreaInvalid ? "border-danger" : "")" @bind="areaInput" />
                                    @if (showErrors && AreaInvalid)
                                    {
                                        <div class="err">Area can’t be negative.</div>
                                    }
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Seed quantity</label>
                                    <input class="form-control" placeholder="e.g. 50 kg" @bind="form.SeedQty" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Planting date</label>
                                    <input type="date" class="form-control" @bind="form.Planted" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Expected harvest</label>
                                    <input type="date" class="form-control @(showErrors && DatesInvalid ? "border-danger" : "")" @bind="form.ExpectedHarvest" />
                                    @if (showErrors && DatesInvalid)
                                    {
                                        <div class="err">Harvest date must be after the planting date.</div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="p-4 rounded-4" style="background-color: #F7FAF8; border: 1px dashed #C6DFCE;">
                            <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                                <i class="bi bi-sliders me-2 text-success"></i>Season, Status &amp; Notes
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small text-muted">Season</label>
                                    <select class="form-select border-0 shadow-sm" @bind="form.Season">
                                        <option value="dry">dry</option>
                                        <option value="wet">wet</option>
                                    </select>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label fw-bold small text-muted">Status</label>
                                    <select class="form-select border-0 shadow-sm" @bind="form.Status">
                                        @foreach (var s in StatusOptions)
                                        {
                                            <option value="@s">@s</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label fw-bold small text-muted">Branch</label>
                                    <select class="form-select border-0 shadow-sm" @bind="form.BranchName">
                                        @if (!string.IsNullOrWhiteSpace(form.BranchName) && !branchNames.Contains(form.BranchName))
                                        {
                                            <option value="@form.BranchName">@form.BranchName</option>
                                        }
                                        @foreach (var b in branchNames)
                                        {
                                            <option value="@b">@b</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-12 mt-3">
                                    <label class="form-label fw-bold small text-muted">Notes</label>
                                    <textarea class="form-control border-0 shadow-sm" rows="3" @bind="form.Notes"></textarea>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="modal-footer border-0 p-4 d-flex justify-content-end gap-2" style="background-color: #F4F7F5;">
                    <button type="button" class="btn btn-light border fw-bold px-4 rounded-3 shadow-sm" @onclick="CloseModal">Cancel</button>
                    <button type="button" class="btn-save px-5 shadow-sm" @onclick="PromptSave" disabled="@isSaving">
                        <i class="bi bi-check2 me-2"></i>Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- SAVE CONFIRMATION MODAL -->
@if (showConfirmSaveModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(10, 43, 29, 0.65); backdrop-filter: blur(4px); z-index: 1060;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content border-0 shadow-lg rounded-4 text-center">
                <div class="modal-body p-4 mt-2">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px; background-color: #E8F3EC; color: #1B5E34;">
                        <i class="bi bi-check2" style="font-size: 2.3rem;"></i>
                    </div>

                    <h4 class="fw-bolder mb-2" style="color: #0A2B1D;">@(editingId == null ? "Create New Crop Cycle?" : "Save Crop Cycle Changes?")</h4>
                    <p class="text-muted small mb-4">
                        @(editingId == null
                            ? $"Are you sure you want to save crop cycle \"{form.Crop.Trim()}\"?"
                            : $"Are you sure you want to update crop cycle \"{form.Crop.Trim()}\" details?")
                    </p>

                    <div class="d-flex justify-content-center gap-3">
                        <button type="button" class="btn btn-light border rounded-3 fw-bold px-4" @onclick="CancelSaveConfirm">Cancel</button>
                        <button type="button" class="btn-save rounded-3 fw-bold px-4 shadow-sm" disabled="@isSaving" @onclick="ConfirmSaveAsync">
                            @(isSaving ? "Saving..." : "Yes, Save")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- DELETE CONFIRMATION MODAL -->
@if (showConfirmDeleteModal && cycleToDelete != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(10, 43, 29, 0.65); backdrop-filter: blur(4px); z-index: 1060;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content border-0 shadow-lg rounded-4 text-center">
                <div class="modal-body p-4 mt-2">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px; background-color: #F5EFEA; color: #7A5230;">
                        <i class="bi bi-trash" style="font-size: 2.3rem;"></i>
                    </div>

                    <h4 class="fw-bolder mb-2" style="color: #0A2B1D;">Delete Crop Cycle?</h4>
                    <p class="text-muted small mb-4">
                        Are you sure you want to delete <strong>@cycleToDelete.Crop</strong> (@cycleToDelete.PlotName)?
                    </p>

                    <div class="d-flex justify-content-center gap-3">
                        <button type="button" class="btn btn-light border rounded-3 fw-bold px-4" @onclick="CancelDeleteConfirm">Cancel</button>
                        <button type="button" class="btn-earth rounded-3 fw-bold px-4 shadow-sm" disabled="@isSaving" @onclick="ConfirmDeleteAsync">
                            <i class="bi bi-trash me-1"></i> Yes, Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(toast))
{
    <div class="toast-note shadow-lg">
        <i class="bi @(toastIsWarning ? "bi-exclamation-circle" : "bi-check2")"></i>
        <span>@toast</span>
    </div>
}

@code {
    record Stat(string Title, string Value, string Note, string Icon, string IconClass);
    record PlotOption(int PlotId, string Name, string FarmName, string BranchName, double Area);

    class Viewport
    {
        public double W { get; set; }
        public double H { get; set; }
    }

    static readonly CultureInfo Inv = CultureInfo.InvariantCulture;
    static readonly string[] StatusOptions = { "planned", "growing", "ready", "harvested" };

    long currentBusinessId;
    string ActiveBranch = "All Branches";
    List<string> branchNames = new();
    List<PlotOption> plotOptions = new();
    List<CropCycle> cycles = new();

    string searchText = "";
    string selectedPlotIdStr = "";
    bool showHarvestedOnly = false;
    string toast = "";
    bool toastIsWarning = false;

    bool showModal;
    bool showErrors;
    bool isSaving;
    int? editingId;
    int? openMenuId;
    CropCycle form = new();
    double? areaInput;

    bool showDetailsModal;
    CropCycle? selectedCycle;

    bool showConfirmSaveModal;
    bool showConfirmDeleteModal;
    CropCycle? cycleToDelete;

    private int currentPage = 1;
    private int pageSize = 5;
    private double menuTop;
    private double menuLeft;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            User? currentUser = null;

            if (Auth.CurrentUserId > 0)
            {
                currentUser = await DbContext.Users
                    .Include(u => u.Business)
                    .FirstOrDefaultAsync(u => u.UserId == Auth.CurrentUserId);
            }
            else if (!string.IsNullOrWhiteSpace(Auth.CurrentUserEmail))
            {
                var cleanEmail = Auth.CurrentUserEmail.Trim().ToLower();
                currentUser = await DbContext.Users
                    .Include(u => u.Business)
                    .FirstOrDefaultAsync(u => u.Email != null && u.Email.ToLower() == cleanEmail);
            }
            else if (!string.IsNullOrWhiteSpace(Auth.CurrentUserName))
            {
                currentUser = await DbContext.Users
                    .Include(u => u.Business)
                    .FirstOrDefaultAsync(u => (u.FName + " " + u.LName) == Auth.CurrentUserName
                                           || u.FName == Auth.CurrentUserName);
            }

            if (currentUser?.BusinessId != null)
            {
                currentBusinessId = currentUser.BusinessId.Value;
            }
            else
            {
                var firstBiz = await DbContext.Businesses.FirstOrDefaultAsync();
                if (firstBiz != null) currentBusinessId = firstBiz.BusinessId;
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            await ShowToast("Error loading page: " + ex.Message, isWarning: true);
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            var branches = await DbContext.Branches
                .Where(b => b.BusinessId == currentBusinessId)
                .OrderBy(b => b.BranchName)
                .ToListAsync();

            branchNames = branches.Select(b => b.BranchName).ToList();
            if (branchNames.Count > 0) ActiveBranch = branchNames[0];

            var branchIds = branches.Select(b => b.BranchId).ToList();
            var farms = await DbContext.Farms
                .Where(f => branchIds.Contains(f.BranchId) && f.Status != "Archived")
                .ToListAsync();

            var farmIds = farms.Select(f => f.FarmId).ToList();
            var dbPlots = await DbContext.Plots
                .Where(p => farmIds.Contains(p.FarmId) && p.Status != "Archived")
                .OrderBy(p => p.PlotName)
                .ToListAsync();

            plotOptions = dbPlots.Select(p =>
            {
                var farm = farms.FirstOrDefault(f => f.FarmId == p.FarmId);
                var branchName = branches.FirstOrDefault(b => b.BranchId == farm?.BranchId)?.BranchName ?? ActiveBranch;
                return new PlotOption(
                    p.PlotId,
                    p.PlotName,
                    farm?.FarmName ?? "",
                    branchName,
                    (double)p.PlotArea
                );
            }).ToList();

            var validPlotIds = dbPlots.Select(p => p.PlotId).ToHashSet();

            cycles = await DbContext.CropCycles
                .Where(c => !c.IsArchived && (c.PlotId == null || validPlotIds.Contains(c.PlotId.Value)))
                .OrderByDescending(c => c.CropCycleId)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            await ShowToast("Database load error: " + ex.Message, isWarning: true);
        }
    }

    List<CropCycle> Filtered
    {
        get
        {
            var baseList = cycles
                .Where(c => showHarvestedOnly
                    ? string.Equals(c.Status, "harvested", StringComparison.OrdinalIgnoreCase)
                    : !string.Equals(c.Status, "harvested", StringComparison.OrdinalIgnoreCase))
                .ToList();

            if (string.IsNullOrWhiteSpace(searchText))
                return baseList;

            return baseList.Where(c =>
                c.Crop.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                || c.Variety.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                || c.PlotName.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                || c.Status.Contains(searchText, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)Filtered.Count / pageSize));
    private int StartItem => Filtered.Count == 0 ? 0 : (currentPage - 1) * pageSize + 1;
    private int EndItem => Math.Min(currentPage * pageSize, Filtered.Count);
    private IEnumerable<CropCycle> PaginatedCycles => Filtered.Skip((currentPage - 1) * pageSize).Take(pageSize);

    List<Stat> Stats
    {
        get
        {
            var growing = cycles.Count(c => string.Equals(c.Status, "growing", StringComparison.OrdinalIgnoreCase));
            var ready = cycles.Count(c => string.Equals(c.Status, "ready", StringComparison.OrdinalIgnoreCase));
            var done = cycles.Count(c => string.Equals(c.Status, "harvested", StringComparison.OrdinalIgnoreCase));
            var area = cycles.Sum(c => c.Area);

            return new()
            {
                new("CROP CYCLES", cycles.Count.ToString(), "", "bi-flower1", ""),
                new("GROWING NOW", growing.ToString(), ready + " ready to harvest", "bi-calendar-check", "stat-icon-leaf"),
                new("PLANTED AREA", area.ToString("0.##", Inv) + " ha", done + (done == 1 ? " cycle" : " cycles") + " completed", "bi-flower3", "stat-icon-earth"),
            };
        }
    }

    bool AreaInvalid => areaInput.HasValue && areaInput.Value < 0;

    bool DatesInvalid => form.Planted.HasValue && form.ExpectedHarvest.HasValue &&
                         form.ExpectedHarvest.Value.Date < form.Planted.Value.Date;

    static string DateText(DateTime? d) => d.HasValue ? d.Value.ToString("MMM d, yyyy", Inv) : "—";

    static string Cap(string? s) => string.IsNullOrWhiteSpace(s) ? "" : char.ToUpper(s[0]) + s.Substring(1);

    static string StatusClass(string? s) => (s ?? "").ToLower() switch
    {
        "growing" => "pill-forest",
        "ready" => "pill-earth",
        "planned" => "pill-forest",
        _ => "pill-earth"
    };

    static string StatusIcon(string? s) => (s ?? "").ToLower() switch
    {
        "growing" => "bi-sprout",
        "ready" => "bi-check2-circle",
        "planned" => "bi-calendar3",
        _ => "bi-archive"
    };

    private void GoToPage(int page) => currentPage = page;
    private void PreviousPage() { if (currentPage > 1) currentPage--; }
    private void NextPage() { if (currentPage < TotalPages) currentPage++; }
    private void ResetPagination() => currentPage = 1;

    private async Task ToggleTab(bool harvestedOnly)
    {
        showHarvestedOnly = harvestedOnly;
        currentPage = 1;
        openMenuId = null;
        await Task.CompletedTask;
    }

    private async Task ToggleMenuAsync(MouseEventArgs e, int id)
    {
        if (openMenuId == id)
        {
            openMenuId = null;
            return;
        }

        const double itemHeight = 42;
        const double padding = 18;
        const double menuWidth = 190;
        double menuHeight = (4 * itemHeight) + padding;

        var viewport = await JS.InvokeAsync<Viewport>("eval", "({ w: window.innerWidth, h: window.innerHeight })");

        menuLeft = Math.Min(e.ClientX - menuWidth + 20, viewport.W - menuWidth - 10);
        menuTop = (e.ClientY + menuHeight > viewport.H) ? e.ClientY - menuHeight - 5 : e.ClientY + 15;

        openMenuId = id;
    }

    void CloseMenu() => openMenuId = null;

    void OpenDetails(CropCycle c)
    {
        selectedCycle = c;
        showDetailsModal = true;
    }

    void CloseDetailsModal()
    {
        showDetailsModal = false;
        selectedCycle = null;
    }

    void OpenNew()
    {
        openMenuId = null;
        form = new CropCycle
        {
            Season = "dry",
            Status = "planned",
            BranchName = ActiveBranch
        };
        selectedPlotIdStr = "";
        areaInput = null;
        editingId = null;
        showErrors = false;
        showModal = true;
    }

    void OpenEdit(CropCycle c)
    {
        showDetailsModal = false;
        openMenuId = null;
        form = new CropCycle
        {
            CropCycleId = c.CropCycleId,
            PlotId = c.PlotId,
            Crop = c.Crop,
            Variety = c.Variety,
            PlotName = c.PlotName,
            Area = c.Area,
            SeedQty = c.SeedQty,
            Planted = c.Planted,
            ExpectedHarvest = c.ExpectedHarvest,
            Season = c.Season,
            Status = c.Status,
            BranchName = c.BranchName,
            Notes = c.Notes,
            IsArchived = c.IsArchived
        };
        selectedPlotIdStr = c.PlotId?.ToString() ?? "";
        areaInput = (double)c.Area;
        editingId = c.CropCycleId;
        showErrors = false;
        showModal = true;
    }

    void CloseModal() => showModal = false;

    void OnPlotChanged(ChangeEventArgs e)
    {
        selectedPlotIdStr = e.Value?.ToString() ?? "";
        if (!int.TryParse(selectedPlotIdStr, out var plotId))
        {
            form.PlotId = null;
            return;
        }

        var p = plotOptions.FirstOrDefault(x => x.PlotId == plotId);
        if (p == null) return;

        form.PlotId = p.PlotId;
        form.PlotName = p.Name;
        if (!string.IsNullOrWhiteSpace(p.BranchName)) form.BranchName = p.BranchName;
        if (!areaInput.HasValue || areaInput.Value <= 0) areaInput = p.Area;
    }

    void PromptSave()
    {
        showErrors = true;
        if (string.IsNullOrWhiteSpace(form.Crop) || AreaInvalid || DatesInvalid) return;
        showConfirmSaveModal = true;
    }

    void CancelSaveConfirm() => showConfirmSaveModal = false;

    async Task ConfirmSaveAsync()
    {
        isSaving = true;
        try
        {
            var cleanCrop = form.Crop.Trim();
            var cleanVariety = (form.Variety ?? "").Trim();
            var cleanPlotName = string.IsNullOrWhiteSpace(form.PlotName)
                ? (plotOptions.FirstOrDefault(x => x.PlotId == form.PlotId)?.Name ?? "")
                : form.PlotName.Trim();
            var areaDec = Convert.ToDecimal(areaInput ?? 0, Inv);

            if (editingId == null)
            {
                var entity = new CropCycle
                {
                    PlotId = form.PlotId,
                    Crop = cleanCrop,
                    Variety = cleanVariety,
                    PlotName = cleanPlotName,
                    Area = areaDec,
                    SeedQty = (form.SeedQty ?? "").Trim(),
                    Planted = form.Planted,
                    ExpectedHarvest = form.ExpectedHarvest,
                    Season = form.Season,
                    Status = form.Status,
                    BranchName = (form.BranchName ?? ActiveBranch).Trim(),
                    Notes = (form.Notes ?? "").Trim(),
                    IsArchived = false
                };

                DbContext.CropCycles.Add(entity);
                await DbContext.SaveChangesAsync();
                await SyncPlotFromCycleAsync(entity);
                await ShowToast("Crop cycle saved.");
            }
            else
            {
                var existing = await DbContext.CropCycles.FindAsync(editingId.Value);
                if (existing != null)
                {
                    existing.PlotId = form.PlotId;
                    existing.Crop = cleanCrop;
                    existing.Variety = cleanVariety;
                    existing.PlotName = cleanPlotName;
                    existing.Area = areaDec;
                    existing.SeedQty = (form.SeedQty ?? "").Trim();
                    existing.Planted = form.Planted;
                    existing.ExpectedHarvest = form.ExpectedHarvest;
                    existing.Season = form.Season;
                    existing.Status = form.Status;
                    existing.BranchName = (form.BranchName ?? ActiveBranch).Trim();
                    existing.Notes = (form.Notes ?? "").Trim();

                    DbContext.CropCycles.Update(existing);
                    await DbContext.SaveChangesAsync();
                    await SyncPlotFromCycleAsync(existing);
                    await ShowToast("Crop cycle updated.");
                }
            }

            showConfirmSaveModal = false;
            showModal = false;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            await ShowToast("Error saving crop cycle: " + ex.Message, isWarning: true);
        }
        finally
        {
            isSaving = false;
        }
    }

    void PromptDelete(CropCycle c)
    {
        openMenuId = null;
        if (string.Equals(c.Status, "harvested", StringComparison.OrdinalIgnoreCase))
        {
            _ = ShowToast("This cycle is already harvested and linked to harvest records. It can’t be deleted.", isWarning: true);
            return;
        }
        cycleToDelete = c;
        showConfirmDeleteModal = true;
    }

    void CancelDeleteConfirm()
    {
        showConfirmDeleteModal = false;
        cycleToDelete = null;
    }

    async Task ConfirmDeleteAsync()
    {
        if (cycleToDelete == null) return;
        isSaving = true;
        try
        {
            var existing = await DbContext.CropCycles.FindAsync(cycleToDelete.CropCycleId);
            if (existing != null)
            {
                DbContext.CropCycles.Remove(existing);
                await DbContext.SaveChangesAsync();
                await ShowToast("Crop cycle deleted.");
            }

            showConfirmDeleteModal = false;
            cycleToDelete = null;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            await ShowToast("Error deleting crop cycle: " + ex.Message, isWarning: true);
        }
        finally
        {
            isSaving = false;
        }
    }

    async Task SetStatusAsync(CropCycle c, string status)
    {
        openMenuId = null;
        try
        {
            var existing = await DbContext.CropCycles.FindAsync(c.CropCycleId);
            if (existing != null)
            {
                existing.Status = status;
                DbContext.CropCycles.Update(existing);
                await DbContext.SaveChangesAsync();
                await SyncPlotFromCycleAsync(existing);
                await ShowToast($"Cycle marked as {status}.");
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            await ShowToast("Error updating status: " + ex.Message, isWarning: true);
        }
    }

    async Task SyncPlotFromCycleAsync(CropCycle c)
    {
        if (!c.PlotId.HasValue) return;

        try
        {
            var dbPlot = await DbContext.Plots.FindAsync(c.PlotId.Value);
            if (dbPlot == null) return;

            if (string.Equals(c.Status, "harvested", StringComparison.OrdinalIgnoreCase))
            {
                dbPlot.CurrentCrop = "";
                dbPlot.Status = "Vacant";
            }
            else
            {
                dbPlot.CurrentCrop = string.IsNullOrWhiteSpace(c.Variety) ? c.Crop : $"{c.Crop} · {c.Variety}";
                dbPlot.Status = "Planted";
            }

            DbContext.Plots.Update(dbPlot);
            await DbContext.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            await ShowToast("Could not sync plot status: " + ex.Message, isWarning: true);
        }
    }

    async Task ShowToast(string message, bool isWarning = false)
    {
        toast = message;
        toastIsWarning = isWarning;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(3500);
        toast = "";
        await InvokeAsync(StateHasChanged);
    }
}