@page "/new-sale"
@layout MainLayout
@using System.Globalization
@using System.Reflection
@using Microsoft.EntityFrameworkCore
@using AgriNexus.DataLayer
@using AgriNexus.DataLayer.Models
@inject AgriNexusDbContext DbContext
@inject AgriNexus.Services.AuthService Auth
@inject IJSRuntime JS

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h2 class="page-title">New Sale</h2>
        <p class="text-muted mb-0 page-sub">
            <i class="bi bi-building text-success me-1"></i><strong>@ActiveBranch</strong> · pick produce cards, record sales, collect full or partial payment, and issue a receipt.
        </p>
    </div>
    <span class="badge rounded-pill px-3 py-2 fw-semibold" style="background-color: #E8F3EC; color: #1B5E34; border: 1px solid #C6DFCE;">
        <i class="bi bi-receipt me-1"></i>@NextNo
    </span>
</div>

<!-- STAT CARDS -->
<div class="row g-3 mb-4">
    @foreach (var s in Stats)
    {
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <span class="card-title">@s.Title</span>
                    <div class="stat-icon @s.IconClass"><i class="bi @s.Icon"></i></div>
                </div>
                <div class="mt-3">
                    <div class="card-value">@s.Value</div>
                    @if (!string.IsNullOrEmpty(s.Note))
                    {
                        <div class="text-muted small mt-1">@s.Note</div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<div class="row g-3">
    <!-- ======================= PRODUCE CARDS & CART ======================= -->
    <div class="col-12 col-lg-8">
        <div class="card-box h-100">
            <div class="mb-3">
                <div class="panel-title">
                    <i class="bi bi-grid-3x3-gap text-success me-1"></i>Available produce &amp; sale items
                </div>
                <div class="panel-sub mb-0">Raw agri food &amp; farm inputs are VAT-exempt; taxable items include 12% VAT unless PWD/Senior.</div>
            </div>

            <!-- MAIN WHITE TABS + CONNECTED SEARCH BAR -->
            <div class="pos-filter-bar bg-white border rounded-3 p-1 d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2"
                 style="border-color: #E2ECE6 !important;">
                <div class="d-flex align-items-center gap-1 flex-wrap">
                    <button type="button"
                            class="btn btn-sm px-3 py-2 rounded-2 fw-semibold"
                            style="@(mainTab == "inventory"
                                        ? "background-color: #FFFFFF; color: #1B5E34; border: 1px solid #1B5E34; box-shadow: 0 0 0 0.25rem rgba(27, 94, 52, 0.15);"
                                        : "background-color: transparent; color: #64748B; border: 1px solid transparent; box-shadow: none;")"
                            @onclick='() => SelectMainTab("inventory")'>
                        Inventory Products
                    </button>
                    <button type="button"
                            class="btn btn-sm px-3 py-2 rounded-2 fw-semibold"
                            style="@(mainTab == "produce"
                                        ? "background-color: #FFFFFF; color: #1B5E34; border: 1px solid #1B5E34; box-shadow: 0 0 0 0.25rem rgba(27, 94, 52, 0.15);"
                                        : "background-color: transparent; color: #64748B; border: 1px solid transparent; box-shadow: none;")"
                            @onclick='() => SelectMainTab("produce")'>
                        Produce Product
                    </button>
                </div>

                <div class="search-box" style="width: 240px;">
                    <i class="bi bi-search"></i>
                    <input type="text" placeholder="Search item or SKU..."
                           @bind="produceSearch"
                           @bind:event="oninput" />
                </div>
            </div>

            <!-- HORIZONTAL SCROLLABLE SUB-TABS -->
            @if (mainTab == "inventory")
            {
                <div class="d-flex align-items-center gap-3 overflow-x-auto pb-2 mb-3 border-bottom"
                     style="white-space: nowrap; border-color: #E2ECE6 !important;">
                    <button type="button"
                            class="btn btn-link p-0 text-decoration-none fw-semibold flex-shrink-0"
                            style="color: @(string.IsNullOrEmpty(selectedInventoryCategory) ? "#1B5E34" : "#64748B"); font-size: .9rem;"
                            @onclick='() => selectedInventoryCategory = ""'>
                        All
                    </button>
                    @foreach (var cat in InventorySubCategories)
                    {
                        var isActiveCat = string.Equals(selectedInventoryCategory, cat, StringComparison.OrdinalIgnoreCase);
                        <button type="button"
                                class="btn btn-link p-0 text-decoration-none @(isActiveCat ? "fw-bold" : "fw-medium") flex-shrink-0"
                                style="color: @(isActiveCat ? "#1B5E34" : "#64748B"); font-size: .9rem;"
                                @onclick="() => selectedInventoryCategory = cat">
                            @cat
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="d-flex align-items-center gap-3 overflow-x-auto pb-2 mb-3 border-bottom"
                     style="white-space: nowrap; border-color: #E2ECE6 !important;">
                    <button type="button"
                            class="btn btn-link p-0 text-decoration-none fw-semibold flex-shrink-0"
                            style="color: @(string.IsNullOrEmpty(selectedHarvestProduct) ? "#1B5E34" : "#64748B"); font-size: .9rem;"
                            @onclick='() => selectedHarvestProduct = ""'>
                        All
                    </button>
                    @foreach (var prodName in HarvestSubProducts)
                    {
                        var isActiveProd = string.Equals(selectedHarvestProduct, prodName, StringComparison.OrdinalIgnoreCase);
                        <button type="button"
                                class="btn btn-link p-0 text-decoration-none @(isActiveProd ? "fw-bold" : "fw-medium") flex-shrink-0"
                                style="color: @(isActiveProd ? "#1B5E34" : "#64748B"); font-size: .9rem;"
                                @onclick="() => selectedHarvestProduct = prodName">
                            @prodName
                        </button>
                    }
                </div>
            }

            <!-- PRODUCE SELECTION CARDS -->
            @if (AvailableCatalog.Count == 0)
            {
                <div class="empty-box mb-4 py-4">
                    <div class="empty-icon"><i class="bi bi-box-seam"></i></div>
                    <div class="fw-semibold mt-2">No items match the current filter</div>
                    <div class="text-muted small">Try another tab, category/product filter, or search term.</div>
                </div>
            }
            else
            {
                <div class="row g-2 mb-4 produce-grid">
                    @foreach (var p in AvailableCatalog)
                    {
                        var inCart = lines.FirstOrDefault(l => l.ItemId == p.ItemId);
                        var inCartQty = inCart?.Qty ?? 0;
                        var remainingQty = Math.Max(0, p.AvailableQty - inCartQty);

                        <div class="col-6 col-md-4 col-xl-3">
                            <div class="produce-card h-100 @(inCart != null ? "selected" : "") @(remainingQty <= 0 ? "depleted" : "")"
                                 @onclick="() => AddProduceCard(p)">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <div class="produce-thumb">
                                        @if (!string.IsNullOrWhiteSpace(p.ImageUrl))
                                        {
                                            <img src="@p.ImageUrl" alt="@p.Name" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-flower2 text-success"></i>
                                        }
                                    </div>
                                    <div class="min-w-0 flex-grow-1">
                                        <div class="fw-bold text-truncate" style="color: #0A2B1D; font-size: .88rem;">@p.Name</div>
                                        <div class="d-flex align-items-center gap-1 flex-wrap">
                                            @if (!string.IsNullOrWhiteSpace(p.ItemCode))
                                            {
                                                <span class="text-muted" style="font-size: .7rem;">@p.ItemCode</span>
                                            }
                                            <span class="badge @(p.IsTaxable ? "bg-light text-success border border-success-subtle" : "bg-light text-secondary border")"
                                                  style="font-size: .62rem; padding: 1px 5px;">
                                                @(p.IsTaxable ? "12% VAT" : "VAT-Exempt")
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-1 mt-auto pt-2 produce-card-footer">
                                    <span class="fw-bold text-nowrap" style="color: #1B5E34; font-size: .88rem;">
                                        @Peso(p.SellingPrice)<span class="text-muted fw-normal" style="font-size: .72rem;">/@p.Unit</span>
                                    </span>
                                    <span class="stock-tag @(remainingQty <= 0 ? "out" : "")">
                                        @Qty(remainingQty) @p.Unit
                                    </span>
                                </div>

                                @if (inCart != null)
                                {
                                    <div class="cart-badge">
                                        <i class="bi bi-bag-check me-1"></i>@Qty(inCartQty) @p.Unit in cart
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- SELECTED CART ITEMS -->
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-bold small text-uppercase text-muted" style="letter-spacing: .5px;">
                    <i class="bi bi-cart3 text-success me-1"></i>Selected sale items (@lines.Count)
                </span>
                @if (lines.Count > 0)
                {
                    <span class="small fw-semibold" style="color: #1B5E34;">Items total: @Peso(GrossSubtotal)</span>
                }
            </div>

            @if (lines.Count == 0)
            {
                <div class="empty-box">
                    <div class="empty-icon"><i class="bi bi-cart"></i></div>
                    <div class="fw-semibold mt-3">No items added yet</div>
                    <div class="text-muted small">Click any produce card above to build this sale.</div>
                </div>
            }
            else
            {
                <div class="items-wrap">
                    <table class="table items-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Tax</th>
                                <th>Qty</th>
                                <th>Unit price (₱)</th>
                                <th>Item total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in lines)
                            {
                                <tr>
                                    <td class="col-item">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="mini-thumb">
                                                @if (!string.IsNullOrWhiteSpace(l.ImageUrl))
                                                {
                                                    <img src="@l.ImageUrl" alt="@l.Name" />
                                                }
                                                else
                                                {
                                                    <i class="bi bi-flower2 text-success"></i>
                                                }
                                            </div>
                                            <div>
                                                <div class="fw-semibold" style="color: #0A2B1D;">@l.Name</div>
                                                <div class="sub">@Qty(OnHand(l)) @l.Unit on hand</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @(l.IsTaxable && !IsPwdOrSenior ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")"
                                              style="font-size: .7rem;">
                                            @(l.IsTaxable ? (IsPwdOrSenior ? "Exempt (PWD/SC)" : "12% VAT") : "Exempt")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="input-group input-group-sm" style="width: 122px;">
                                            <input type="number" min="0" step="any"
                                                   class="form-control qty-input @(LineQtyBad(l) ? "is-invalid" : "")"
                                                   @bind="l.Qty" @bind:event="oninput" />
                                            <span class="input-group-text bg-white text-muted">@l.Unit</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="input-group input-group-sm" style="width: 132px;">
                                            <span class="input-group-text bg-white text-success"><i class="bi bi-tag"></i></span>
                                            <input type="number" min="0" step="0.01" class="form-control price-input"
                                                   @bind="l.Price" @bind:event="oninput" />
                                        </div>
                                    </td>
                                    <td class="fw-bold text-nowrap" style="color: #1B5E34;">@Peso(LineTotal(l))</td>
                                    <td class="text-end">
                                        <button type="button" class="btn-remove" @onclick="() => RemoveLine(l)" aria-label="Remove item">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- ======================= CUSTOMER & PAYMENT ======================= -->
    <div class="col-12 col-lg-4">
        <div class="card-box h-100">
            <div class="panel-title">
                <i class="bi bi-wallet2 text-success me-1"></i>Customer &amp; payment
            </div>
            <div class="panel-sub">Partial payments leave the remaining balance on the customer account.</div>

            <div class="mb-3">
                <label class="form-label"><i class="bi bi-person text-success me-1"></i>Customer</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-person text-success"></i></span>
                    <select class="form-select" value="@(selectedCustomerId?.ToString() ?? "")" @onchange="OnCustomerChanged">
                        <option value="">Walk-in customer</option>
                        @foreach (var c in customers)
                        {
                            <option value="@c.Id">@CustomerLabel(c)</option>
                        }
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <div class="form-check">
                    <input class="form-check-input agri-check" type="checkbox" id="chkPwdSenior"
                           checked="@IsPwdOrSenior" @onchange="OnPwdSeniorChanged" />
                    <label class="form-check-label small fw-semibold" for="chkPwdSenior" style="color: #0A2B1D;">
                        Senior Citizen / PWD (VAT-Exempt + 20% Discount)
                    </label>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label"><i class="bi bi-percent text-success me-1"></i>Discount (₱)</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-tag text-success"></i></span>
                    <input type="number" min="0" step="0.01" class="form-control" placeholder="0.00"
                           value="@DiscountDisplay"
                           @oninput="OnManualDiscountInput" />
                </div>
                @if (IsPwdOrSenior && !manualDiscountEdited && AutoSeniorPwdDiscount > 0)
                {
                    <div class="text-muted small mt-1">Auto 20% Senior/PWD discount: <strong>@Peso(AutoSeniorPwdDiscount)</strong></div>
                }
            </div>

            <div class="mb-3">
                <label class="form-label"><i class="bi bi-credit-card text-success me-1"></i>Payment method</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-credit-card text-success"></i></span>
                    <select class="form-select" @bind="method">
                        @foreach (var m in MethodOptions)
                        {
                            <option value="@m">@Cap(m)</option>
                        }
                    </select>
                </div>
            </div>

            <div class="mb-1">
                <label class="form-label"><i class="bi bi-cash-coin text-success me-1"></i>Amount paid now (₱)</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-cash-coin text-success"></i></span>
                    <input type="number" min="0" step="0.01" class="form-control" placeholder="0.00"
                           @bind="paidInput" @bind:event="oninput" />
                </div>
            </div>
            <button type="button" class="link-btn" @onclick="PayInFull">
                <i class="bi bi-check2-all me-1"></i>Pay in full
            </button>

            <hr class="my-3" />

            <div class="summary">
                <div class="row-line"><span>Gross subtotal</span><span>@Peso(GrossSubtotal)</span></div>
                <div class="row-line"><span>VAT-exempt sales</span><span>@Peso(VatExemptSales)</span></div>
                <div class="row-line"><span>Vatable sales</span><span>@Peso(VatableSales)</span></div>
                <div class="row-line"><span>Tax (12% VAT)</span><span>@Peso(ComputedTax)</span></div>
                @if (IsPwdOrSenior && VatRemoved > 0)
                {
                    <div class="row-line"><span>Less: VAT exemption (SC/PWD)</span><span>– @Peso(VatRemoved)</span></div>
                }
                <div class="row-line"><span>Discount</span><span>– @Peso(Discount)</span></div>
                <div class="row-line total"><span>Total</span><span>@Peso(Total)</span></div>
                <div class="row-line"><span>Amount paid</span><span>@Peso(Paid)</span></div>
                <div class="row-line"><span>Balance</span><span class="@(Balance > 0 ? "text-warn" : "")">@Peso(Balance)</span></div>
                <div class="row-line"><span>Change</span><span>@Peso(Change)</span></div>
            </div>

            @if (showErrors && Errors.Count > 0)
            {
                <div class="error-box">
                    @foreach (var e in Errors)
                    {
                        <div><i class="bi bi-exclamation-circle"></i> @e</div>
                    }
                </div>
            }

            <div class="d-flex gap-2 mt-3">
                <button type="button" class="btn-complete w-100" @onclick="CompleteAsync" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>Processing...</span>
                    }
                    else
                    {
                        <i class="bi bi-check2-circle me-1"></i>
                        <span>Complete sale</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

<!-- AUTO-DISMISS SUCCESSFUL PURCHASE MODAL (~1.5s, NO BUTTON) -->
@if (showSuccessModal)
{
    <div class="modal fade show d-block" style="position: fixed; inset: 0; background-color: rgba(10, 43, 29, 0.65); backdrop-filter: blur(5px); z-index: 2100; display: flex !important; align-items: center; justify-content: center;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered m-0" style="width: 100%; max-width: 380px;">
            <div class="modal-content border-0 shadow-lg rounded-4 text-center p-4">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-3"
                     style="width: 72px; height: 72px; background-color: #E8F3EC; color: #1B5E34;">
                    <i class="bi bi-check2-circle" style="font-size: 2.6rem;"></i>
                </div>
                <h5 class="fw-bolder mb-1" style="color: #0A2B1D;">Purchase Successful!</h5>
                <p class="text-muted small mb-0">
                    Sale <strong>@lastSaleNo</strong> recorded &amp; inventory updated. Opening receipt...
                </p>
            </div>
        </div>
    </div>
}

<!-- RECEIPT MODAL (4-INCH THERMAL ROLL) -->
@if (receipt != null)
{
    var totalLineQty = receipt.Lines.Sum(x => x.Qty);

    <div class="modal-overlay receipt-overlay" @onclick="CloseReceipt">
        <div class="receipt-wrap" @onclick:stopPropagation="true">

            @* Only this card is sent to the printer (see wwwroot/js/receipt-print.js) *@
            <div class="thermal-receipt-card" id="receipt-print-area">
                <div class="receipt-printable">
                    <div class="receipt-header-center">
                        <div class="receipt-biz-name">@BusinessName</div>
                        <div class="receipt-branch-line">@receipt.Branch</div>
                        @if (!string.IsNullOrWhiteSpace(receipt.BranchAddress))
                        {
                            <div class="receipt-address-line">@receipt.BranchAddress</div>
                        }
                        <div class="receipt-doc-tag">OFFICIAL SALES RECEIPT</div>
                    </div>

                    <div class="receipt-dash"></div>

                    <div class="receipt-info-list">
                        <div class="receipt-info-row">
                            <span>Sale No.</span>
                            <strong>@receipt.No</strong>
                        </div>
                        <div class="receipt-info-row">
                            <span>Date &amp; Time</span>
                            <strong>@receipt.Date.ToString("MMM d, yyyy · hh:mm tt", Inv)</strong>
                        </div>
                        <div class="receipt-info-row">
                            <span>Staff</span>
                            <strong>@(string.IsNullOrWhiteSpace(receipt.By) ? "—" : receipt.By)</strong>
                        </div>
                        <div class="receipt-info-row">
                            <span>Customer</span>
                            <strong>@receipt.Customer@(receipt.IsPwdOrSenior ? " (PWD/SC)" : "")</strong>
                        </div>
                    </div>

                    <div class="receipt-dash"></div>

                    <table class="thermal-items-table">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in receipt.Lines)
                            {
                                <tr>
                                    <td colspan="2" class="thermal-item-name">@r.Name</td>
                                </tr>
                                <tr class="thermal-item-subrow">
                                    <td class="thermal-calc-cell">@Qty(r.Qty) @r.Unit × @Peso(r.Price)</td>
                                    <td class="thermal-num-cell fw-bold">@Peso(LineAmt(r.Qty, r.Price))</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="receipt-dash"></div>

                    <div class="receipt-totals">
                        <div class="r-row">
                            <span>Items / Qty</span>
                            <strong>@receipt.Lines.Count @(receipt.Lines.Count == 1 ? "item" : "items") (@Qty(totalLineQty) total)</strong>
                        </div>
                    </div>

                    <div class="receipt-dash"></div>

                    <div class="receipt-totals">
                        <div class="r-row">
                            <span>Gross Subtotal</span>
                            <span>@Peso(receipt.Subtotal)</span>
                        </div>
                        <div class="r-row">
                            <span>VAT-Exempt Sales</span>
                            <span>@Peso(receipt.VatExemptSales)</span>
                        </div>
                        <div class="r-row">
                            <span>Vatable Sales</span>
                            <span>@Peso(receipt.VatableSales)</span>
                        </div>
                        <div class="r-row">
                            <span>VAT (12%)</span>
                            <span>@Peso(receipt.TaxAmount)</span>
                        </div>
                        @if (receipt.IsPwdOrSenior && receipt.VatRemoved > 0)
                        {
                            <div class="r-row">
                                <span>Less: VAT Exemption</span>
                                <span>– @Peso(receipt.VatRemoved)</span>
                            </div>
                        }
                        <div class="r-row">
                            <span>@(receipt.IsPwdOrSenior ? "Less: SC/PWD Discount" : "Less: Discount")</span>
                            <span>– @Peso(receipt.Discount)</span>
                        </div>
                        <div class="receipt-dash my-1"></div>
                        <div class="r-row grand">
                            <span>TOTAL</span>
                            <span>@Peso(receipt.Total)</span>
                        </div>
                    </div>

                    <div class="receipt-dash"></div>

                    <div class="receipt-totals">
                        <div class="r-row">
                            <span>Paid (@Cap(receipt.Method))</span>
                            <span>@Peso(receipt.Paid)</span>
                        </div>
                        <div class="r-row">
                            <span>Balance</span>
                            <span class="@(receipt.Balance > 0 ? "text-warn" : "")">@Peso(receipt.Balance)</span>
                        </div>
                        <div class="r-row">
                            <span>Change</span>
                            <span>@Peso(receipt.Change)</span>
                        </div>
                    </div>

                    <div class="receipt-dash"></div>

                    <div class="receipt-footer-note">
                        Thank you for your purchase!
                    </div>
                    <div class="receipt-cut-space"></div>
                </div>
            </div>

            <div class="receipt-actions">
                <button type="button" class="btn-receipt-print" @onclick="PrintReceiptAsync">
                    <i class="bi bi-printer"></i>Print again
                </button>
                <button type="button" class="btn-receipt-done" @onclick="CloseReceipt">
                    <i class="bi bi-check2"></i>Done
                </button>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(toast))
{
    <div class="toast-note" style="position: fixed; bottom: 20px; right: 20px; z-index: 2300;"><i class="bi bi-check-circle-fill"></i> @toast</div>
}

@code {
    class ProduceCardItem
    {
        public int ItemId { get; set; }
        public string Name { get; set; } = "";
        public string? ItemCode { get; set; }
        public string Category { get; set; } = "";
        public string ItemType { get; set; } = "SUPPLY";
        public bool IsFromHarvestRecord { get; set; }
        public string Unit { get; set; } = "kg";
        public decimal AvailableQty { get; set; }
        public decimal SellingPrice { get; set; }
        public string? ImageUrl { get; set; }
        public bool IsTaxable { get; set; } = true;
    }

    class CustomerRec
    {
        public int Id { get; set; }
        public object? Entity { get; set; }
        public string Name { get; set; } = "";
        public decimal Balance { get; set; }
        public bool IsPwdOrSenior { get; set; }
    }

    class SaleLine
    {
        public int ItemId { get; set; }
        public string Name { get; set; } = "";
        public string Unit { get; set; } = "kg";
        public string? ImageUrl { get; set; }
        public decimal? Qty { get; set; }
        public decimal? Price { get; set; }
        public bool IsTaxable { get; set; } = true;
    }

    class ReceiptLine
    {
        public string Name { get; set; } = "";
        public string Unit { get; set; } = "kg";
        public decimal Qty { get; set; }
        public decimal Price { get; set; }
        public bool IsTaxable { get; set; } = true;
    }

    class SaleRec
    {
        public string No { get; set; } = "";
        public DateTime Date { get; set; }
        public string Branch { get; set; } = "";
        public string BranchAddress { get; set; } = "";
        public string Customer { get; set; } = "";
        public string By { get; set; } = "";
        public string Method { get; set; } = "cash";
        public bool IsPwdOrSenior { get; set; }
        public List<ReceiptLine> Lines { get; set; } = new();
        public decimal Subtotal { get; set; }
        public decimal VatExemptSales { get; set; }
        public decimal VatableSales { get; set; }
        public decimal TaxAmount { get; set; }
        public decimal VatRemoved { get; set; }
        public decimal Discount { get; set; }
        public decimal Total { get; set; }
        public decimal Paid { get; set; }
        public decimal Balance { get; set; }
        public decimal Change { get; set; }
    }

    record Stat(string Title, string Value, string Note, string Icon, string IconClass);

    static readonly CultureInfo Inv = CultureInfo.InvariantCulture;
    static readonly string[] MethodOptions = { "cash", "gcash", "bank", "check", "credit" };
    static readonly string[] InventorySubCategories = { "seeds", "fertilizer", "produce", "pesticide", "tools", "fuel", "packaging", "supplies" };
    const string WalkIn = "Walk-in customers";

    // Tax / discount settings
    const decimal VatRate = 0.12m;
    const decimal SeniorPwdRate = 0.20m;

    // Receipt paper width in millimetres (4 inch roll ≈ 100 mm). Use 80 for a 3-inch roll.
    const int ReceiptWidthMm = 100;

    long currentBusinessId;
    long? currentBranchId;
    string BusinessName = "AgriNexus Farm Operations";
    string ActiveBranch = "All Branches";
    string BranchAddress = "";

    string mainTab = "inventory";
    string selectedInventoryCategory = "";
    string selectedHarvestProduct = "";
    HashSet<string> activeHarvestNames = new(StringComparer.OrdinalIgnoreCase);
    HashSet<int> activeHarvestItemIds = new();

    int? selectedCustomerId;
    bool isPwdOrSenior;
    bool manualDiscountEdited;
    string discountText = "";
    string produceSearch = "";
    decimal? discountInput;
    decimal? paidInput;
    string method = "cash";
    bool showErrors;
    bool isSaving;
    bool showSuccessModal;
    string lastSaleNo = "";
    string toast = "";
    int saleSeq = 1;
    SaleRec? receipt;

    readonly List<ProduceCardItem> catalog = new();
    readonly List<CustomerRec> customers = new();
    readonly List<SaleLine> lines = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            User? currentUser = null;

            if (Auth.CurrentUserId > 0)
            {
                currentUser = await DbContext.Users
                    .Include(u => u.Business)
                    .FirstOrDefaultAsync(u => u.UserId == Auth.CurrentUserId);
            }
            else if (!string.IsNullOrWhiteSpace(Auth.CurrentUserEmail))
            {
                var cleanEmail = Auth.CurrentUserEmail.Trim().ToLower();
                currentUser = await DbContext.Users
                    .Include(u => u.Business)
                    .FirstOrDefaultAsync(u => u.Email != null && u.Email.ToLower() == cleanEmail);
            }
            else if (!string.IsNullOrWhiteSpace(Auth.CurrentUserName))
            {
                currentUser = await DbContext.Users
                    .Include(u => u.Business)
                    .FirstOrDefaultAsync(u => (u.FName + " " + u.LName) == Auth.CurrentUserName
                                           || u.FName == Auth.CurrentUserName);
            }

            if (currentUser?.BusinessId != null)
            {
                currentBusinessId = currentUser.BusinessId.Value;
                currentBranchId = currentUser.BranchId;
                if (currentUser.Business != null && !string.IsNullOrWhiteSpace(currentUser.Business.BusinessName))
                    BusinessName = currentUser.Business.BusinessName;
            }
            else
            {
                var firstBiz = await DbContext.Businesses.FirstOrDefaultAsync();
                if (firstBiz != null)
                {
                    currentBusinessId = firstBiz.BusinessId;
                    BusinessName = firstBiz.BusinessName;
                }
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            await ShowToast("Error loading POS data: " + ex.Message);
        }
    }

    private async Task LoadDataAsync()
    {
        var branch = currentBranchId.HasValue
            ? await DbContext.Branches.FirstOrDefaultAsync(b => b.BranchId == currentBranchId.Value)
            : await DbContext.Branches.FirstOrDefaultAsync(b => b.BusinessId == currentBusinessId);

        if (branch != null)
        {
            ActiveBranch = branch.BranchName;
            var bType = branch.GetType();
            BranchAddress = bType.GetProperty("Address")?.GetValue(branch)?.ToString()
                         ?? bType.GetProperty("Location")?.GetValue(branch)?.ToString()
                         ?? "";
        }

        await LoadActiveHarvestsAsync();

        var items = await DbContext.InventoryItems
            .Where(i => i.BusinessId == currentBusinessId && !i.IsArchived && i.QuantityOnHand > 0)
            .OrderBy(i => i.ItemName)
            .ToListAsync();

        catalog.Clear();
        foreach (var i in items)
        {
            var sellPrice = i.SellingPrice > 0 ? i.SellingPrice : i.UnitCost;
            var isHarvestProduce = string.Equals(i.ItemType, "PRODUCE", StringComparison.OrdinalIgnoreCase)
                                   || activeHarvestItemIds.Contains(i.ItemId)
                                   || (i.HarvestId.HasValue && i.HarvestId.Value > 0);

            catalog.Add(new ProduceCardItem
            {
                ItemId = i.ItemId,
                Name = i.ItemName,
                ItemCode = i.ItemCode,
                Category = (i.Category ?? "").Trim(),
                ItemType = (i.ItemType ?? "SUPPLY").Trim(),
                IsFromHarvestRecord = isHarvestProduce,
                Unit = string.IsNullOrWhiteSpace(i.Unit) ? "kg" : i.Unit.Trim(),
                AvailableQty = i.QuantityOnHand,
                SellingPrice = sellPrice,
                ImageUrl = i.ImageUrl,
                IsTaxable = DetermineItemTaxable(i)
            });
        }

        if (!string.IsNullOrEmpty(selectedHarvestProduct) && !HarvestSubProducts.Contains(selectedHarvestProduct))
            selectedHarvestProduct = "";

        await LoadCustomersAsync();
        saleSeq = await GetNextSaleSequenceAsync();
    }

    private async Task LoadActiveHarvestsAsync()
    {
        activeHarvestNames.Clear();
        activeHarvestItemIds.Clear();

        var harvestProp = DbContext.GetType().GetProperties()
            .FirstOrDefault(p => p.Name.Equals("HarvestRecords", StringComparison.OrdinalIgnoreCase)
                              || p.Name.Equals("RecordHarvests", StringComparison.OrdinalIgnoreCase)
                              || p.Name.Equals("Harvests", StringComparison.OrdinalIgnoreCase));

        if (harvestProp?.GetValue(DbContext) is not IQueryable rawQuery)
            return;

        var list = await rawQuery.Cast<object>().ToListAsync();
        foreach (var h in list)
        {
            var t = h.GetType();

            var isArchProp = t.GetProperty("IsArchived");
            if (isArchProp != null && isArchProp.GetValue(h) is bool arch && arch)
                continue;

            var statusStr = t.GetProperty("Status")?.GetValue(h)?.ToString();
            if (string.Equals(statusStr, "archived", StringComparison.OrdinalIgnoreCase)
                || string.Equals(statusStr, "deleted", StringComparison.OrdinalIgnoreCase)
                || string.Equals(statusStr, "cancelled", StringComparison.OrdinalIgnoreCase))
                continue;

            var nameVal = t.GetProperty("ProduceName")?.GetValue(h)?.ToString()
                       ?? t.GetProperty("ProductName")?.GetValue(h)?.ToString()
                       ?? t.GetProperty("CropName")?.GetValue(h)?.ToString()
                       ?? t.GetProperty("ItemName")?.GetValue(h)?.ToString()
                       ?? t.GetProperty("Name")?.GetValue(h)?.ToString();

            if (!string.IsNullOrWhiteSpace(nameVal))
                activeHarvestNames.Add(nameVal.Trim());

            var itemIdObj = t.GetProperty("InventoryItemId")?.GetValue(h) ?? t.GetProperty("ItemId")?.GetValue(h);
            if (itemIdObj != null && int.TryParse(itemIdObj.ToString(), out var itemId) && itemId > 0)
                activeHarvestItemIds.Add(itemId);
        }
    }

    void SelectMainTab(string tab)
    {
        mainTab = tab;
        if (tab == "inventory")
            selectedHarvestProduct = "";
        else
            selectedInventoryCategory = "";
    }

    IEnumerable<string> HarvestSubProducts => catalog
        .Where(p => p.IsFromHarvestRecord)
        .Select(p => p.Name.Trim())
        .Where(n => !string.IsNullOrWhiteSpace(n) && (activeHarvestNames.Count == 0 || activeHarvestNames.Contains(n)))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(n => n, StringComparer.OrdinalIgnoreCase);

    private static bool DetermineItemTaxable(InventoryItem item)
    {
        // All harvested produce items are VAT-exempt
        if (string.Equals(item.ItemType, "PRODUCE", StringComparison.OrdinalIgnoreCase))
            return false;

        var cat = (item.Category ?? "").Trim().ToLowerInvariant();

        // VAT-exempt categories
        if (cat is "seeds" or "fertilizer" or "produce")
            return false;

        // 12% VAT categories (pesticide, tools, fuel, packaging, supplies, etc.)
        if (cat is "pesticide" or "tools" or "fuel" or "packaging" or "supplies")
            return true;

        // Fallback for any unrecognized category
        return true;
    }

    private async Task LoadCustomersAsync()
    {
        customers.Clear();

        var dbCustomers = await DbContext.Customers
            .Where(c => c.BusinessId == currentBusinessId)
            .ToListAsync();

        if (dbCustomers.Count == 0)
        {
            dbCustomers = await DbContext.Customers.ToListAsync();
        }

        foreach (var c in dbCustomers)
        {
            var t = c.GetType();

            var statusVal = t.GetProperty("Status")?.GetValue(c)?.ToString();
            if (string.Equals(statusVal, "archived", StringComparison.OrdinalIgnoreCase))
                continue;

            var isArchivedProp = t.GetProperty("IsArchived");
            if (isArchivedProp != null && isArchivedProp.GetValue(c) is bool arch && arch)
                continue;

            var idProp = t.GetProperty("CustomerId") ?? t.GetProperty("Id");
            var nameProp = t.GetProperty("CustomerName")
                        ?? t.GetProperty("FullName")
                        ?? t.GetProperty("Name")
                        ?? t.GetProperty("BusinessName");
            var balProp = t.GetProperty("OutstandingBalance")
                       ?? t.GetProperty("Outstanding")
                       ?? t.GetProperty("Balance")
                       ?? t.GetProperty("AccountBalance");

            if (idProp != null && int.TryParse(idProp.GetValue(c)?.ToString(), out var id))
            {
                var name = nameProp?.GetValue(c)?.ToString();
                if (string.IsNullOrWhiteSpace(name))
                {
                    var fName = t.GetProperty("FName")?.GetValue(c)?.ToString() ?? "";
                    var lName = t.GetProperty("LName")?.GetValue(c)?.ToString() ?? "";
                    name = $"{fName} {lName}".Trim();
                }

                if (string.IsNullOrWhiteSpace(name))
                    name = $"Customer #{id}";

                decimal.TryParse(balProp?.GetValue(c)?.ToString(), NumberStyles.Any, Inv, out var bal);

                var typeOrDiscountText = string.Join(" ",
                    t.GetProperty("CustomerType")?.GetValue(c)?.ToString() ?? "",
                    t.GetProperty("Type")?.GetValue(c)?.ToString() ?? "",
                    t.GetProperty("Category")?.GetValue(c)?.ToString() ?? "",
                    t.GetProperty("Notes")?.GetValue(c)?.ToString() ?? "",
                    name
                ).ToLowerInvariant();

                var pwdOrSeniorFlag = typeOrDiscountText.Contains("senior")
                                   || typeOrDiscountText.Contains("pwd")
                                   || typeOrDiscountText.Contains("person with disability");

                customers.Add(new CustomerRec
                {
                    Id = id,
                    Entity = c,
                    Name = name.Trim(),
                    Balance = bal,
                    IsPwdOrSenior = pwdOrSeniorFlag
                });
            }
        }

        customers.Sort((a, b) => string.Compare(a.Name, b.Name, StringComparison.OrdinalIgnoreCase));
    }

    private async Task<int> GetNextSaleSequenceAsync()
    {
        var orders = await DbContext.SalesOrders.AsNoTracking().ToListAsync();
        var max = 0;
        foreach (var s in orders)
        {
            if (!string.IsNullOrWhiteSpace(s.ReferenceNumber) && s.ReferenceNumber.StartsWith("SO-", StringComparison.OrdinalIgnoreCase))
            {
                if (int.TryParse(s.ReferenceNumber.Substring(3), out var n))
                    max = Math.Max(max, n);
            }
            max = Math.Max(max, s.SaleId);
        }
        return max + 1;
    }

    List<ProduceCardItem> AvailableCatalog
    {
        get
        {
            var hasSearch = !string.IsNullOrWhiteSpace(produceSearch);
            IEnumerable<ProduceCardItem> query = catalog;

            if (!hasSearch)
            {
                if (mainTab == "inventory")
                {
                    query = query.Where(p => !p.IsFromHarvestRecord);
                    if (!string.IsNullOrEmpty(selectedInventoryCategory))
                        query = query.Where(p => string.Equals(p.Category, selectedInventoryCategory, StringComparison.OrdinalIgnoreCase));
                }
                else
                {
                    query = query.Where(p => p.IsFromHarvestRecord);
                    if (!string.IsNullOrEmpty(selectedHarvestProduct))
                        query = query.Where(p => string.Equals(p.Name.Trim(), selectedHarvestProduct.Trim(), StringComparison.OrdinalIgnoreCase));
                }
            }
            else
            {
                query = query.Where(p =>
                    p.Name.Contains(produceSearch, StringComparison.OrdinalIgnoreCase) ||
                    (p.ItemCode ?? "").Contains(produceSearch, StringComparison.OrdinalIgnoreCase) ||
                    p.Category.Contains(produceSearch, StringComparison.OrdinalIgnoreCase));
            }

            return query.ToList();
        }
    }

    // =====================================================================
    //  COMPUTATION
    //  Item prices are VAT-INCLUSIVE for taxable items.
    //
    //  Regular customer:
    //      vatable sales = price / 1.12, VAT = price - vatable sales
    //      exempt items are added as-is
    //      Total = vatable + VAT + exempt - discount
    //
    //  Senior / PWD:
    //      VAT is removed from taxable items (price / 1.12 becomes VAT-exempt sales)
    //      20% discount is computed on the VAT-exempt sales
    //      Total = exempt sales - discount
    // =====================================================================

    static decimal R2(decimal v) => Math.Round(v, 2, MidpointRounding.AwayFromZero);
    static decimal NetOfVat(decimal gross) => R2(gross / (1m + VatRate));
    static decimal LineAmt(decimal qty, decimal price) => R2(qty * price);
    static decimal LineTotal(SaleLine l) => LineAmt(l.Qty ?? 0, l.Price ?? 0);

    bool IsPwdOrSenior => isPwdOrSenior || (SelectedCustomer?.IsPwdOrSenior ?? false);

    // Price x qty of everything (VAT-inclusive for taxable items)
    decimal GrossSubtotal => lines.Sum(l => LineTotal(l));

    // Amounts BEFORE any discount
    decimal RawVatable => IsPwdOrSenior
        ? 0m
        : lines.Where(l => l.IsTaxable).Sum(l => NetOfVat(LineTotal(l)));

    decimal RawVat => IsPwdOrSenior
        ? 0m
        : lines.Where(l => l.IsTaxable).Sum(l => LineTotal(l) - NetOfVat(LineTotal(l)));

    decimal RawExempt => lines.Sum(l =>
        !l.IsTaxable ? LineTotal(l) : (IsPwdOrSenior ? NetOfVat(LineTotal(l)) : 0m));

    // VAT taken out for Senior/PWD
    decimal VatRemoved => IsPwdOrSenior
        ? lines.Where(l => l.IsTaxable).Sum(l => LineTotal(l) - NetOfVat(LineTotal(l)))
        : 0m;

    // What the customer would pay before any discount
    decimal BaseAmount => RawVatable + RawVat + RawExempt;

    decimal AutoSeniorPwdDiscount => IsPwdOrSenior ? R2(RawExempt * SeniorPwdRate) : 0m;

    // Auto discount (Senior/PWD) unless the cashier typed a manual amount
    decimal Discount => Math.Max(0m, manualDiscountEdited ? (discountInput ?? 0m) : AutoSeniorPwdDiscount);

    decimal Total => Math.Max(0m, R2(BaseAmount - Discount));

    // For a regular (non Senior/PWD) discount, the VAT base shrinks proportionally
    decimal DiscountFactor => (!IsPwdOrSenior && BaseAmount > 0m)
        ? Math.Max(0m, 1m - (Discount / BaseAmount))
        : 1m;

    decimal VatableSales => R2(RawVatable * DiscountFactor);
    decimal VatExemptSales => R2(RawExempt * DiscountFactor);
    decimal ComputedTax => IsPwdOrSenior ? 0m : Math.Max(0m, Total - VatableSales - VatExemptSales);

    decimal Paid => Math.Max(0m, paidInput ?? 0m);
    decimal Balance => Math.Max(0m, R2(Total - Paid));
    decimal Change => Math.Max(0m, R2(Paid - Total));

    string DiscountDisplay => manualDiscountEdited
        ? discountText
        : (AutoSeniorPwdDiscount > 0 ? AutoSeniorPwdDiscount.ToString("0.00", Inv) : "");

    string NextNo => "SO-" + saleSeq.ToString("0000");

    CustomerRec? SelectedCustomer => selectedCustomerId == null ? null : customers.FirstOrDefault(c => c.Id == selectedCustomerId);

    List<Stat> Stats => new()
    {
        new("ITEMS IN STOCK", catalog.Count(p => p.AvailableQty > 0).ToString(), "Ready for POS", "bi-grid-3x3-gap", ""),
        new("CUSTOMERS ON FILE", customers.Count.ToString(), "Active accounts", "bi-people", "stat-icon-leaf"),
        new("NEXT SALE NUMBER", NextNo, "Auto-generated", "bi-receipt", "stat-icon-earth"),
        new("SALE TOTAL", Peso(Total), Balance > 0 && Total > 0 ? Peso(Balance) + " balance" : "Fully paid", "bi-cash-coin", ""),
    };

    List<string> Errors
    {
        get
        {
            var list = new List<string>();
            if (lines.Count == 0) { list.Add("Select at least one item card to add to the sale."); return list; }

            foreach (var l in lines)
            {
                if ((l.Qty ?? 0) <= 0) list.Add(l.Name + ": enter a quantity greater than zero.");
                else if (LineQtyBad(l)) list.Add(l.Name + ": only " + Qty(OnHand(l)) + " " + l.Unit + " available.");
                if ((l.Price ?? 0) < 0) list.Add(l.Name + ": price can’t be negative.");
            }
            if (Discount > BaseAmount) list.Add("Discount can’t be more than the amount due.");
            if (Balance > 0 && SelectedCustomer == null)
                list.Add("Select a customer to leave a balance, or pay in full.");
            return list;
        }
    }

    static string Cap(string? s) => string.IsNullOrWhiteSpace(s) ? "" : char.ToUpper(s[0]) + s.Substring(1);
    static string Qty(decimal v) => v.ToString("#,##0.##", Inv);
    static string Peso(decimal v) => "₱" + v.ToString("N2", Inv);

    ProduceCardItem? Find(int itemId) => catalog.FirstOrDefault(p => p.ItemId == itemId);

    decimal OnHand(SaleLine l) => Find(l.ItemId)?.AvailableQty ?? 0;

    bool LineQtyBad(SaleLine l) => (l.Qty ?? 0) > OnHand(l);

    static string CustomerLabel(CustomerRec c)
    {
        var tag = c.IsPwdOrSenior ? " · PWD/Senior" : "";
        return c.Balance > 0 ? c.Name + tag + " · " + Peso(c.Balance) + " balance" : c.Name + tag;
    }

    void OnCustomerChanged(ChangeEventArgs e)
    {
        selectedCustomerId = int.TryParse(e.Value?.ToString(), out var id) ? id : null;
        if (SelectedCustomer?.IsPwdOrSenior == true)
            isPwdOrSenior = true;
    }

    void OnPwdSeniorChanged(ChangeEventArgs e)
    {
        isPwdOrSenior = e.Value is bool b && b;

        // go back to the automatic discount
        manualDiscountEdited = false;
        discountText = "";
        discountInput = null;
    }

    void OnManualDiscountInput(ChangeEventArgs e)
    {
        discountText = e.Value?.ToString() ?? "";

        // empty box = back to the automatic discount
        if (string.IsNullOrWhiteSpace(discountText))
        {
            manualDiscountEdited = false;
            discountInput = null;
            return;
        }

        manualDiscountEdited = true;
        discountInput = decimal.TryParse(discountText, NumberStyles.Any, Inv, out var val)
            ? Math.Max(0m, val)
            : 0m;
    }

    void AddProduceCard(ProduceCardItem p)
    {
        var existing = lines.FirstOrDefault(l => l.ItemId == p.ItemId);
        if (existing != null)
        {
            if ((existing.Qty ?? 0) < p.AvailableQty)
                existing.Qty = (existing.Qty ?? 0) + 1;
        }
        else if (p.AvailableQty > 0)
        {
            lines.Add(new SaleLine
            {
                ItemId = p.ItemId,
                Name = p.Name,
                Unit = p.Unit,
                ImageUrl = p.ImageUrl,
                Qty = 1,
                Price = p.SellingPrice,
                IsTaxable = p.IsTaxable
            });
        }
    }

    void RemoveLine(SaleLine l) => lines.Remove(l);

    void PayInFull() => paidInput = Total;

    void Clear()
    {
        lines.Clear();
        selectedCustomerId = null;
        isPwdOrSenior = false;
        manualDiscountEdited = false;
        discountText = "";
        discountInput = null;
        paidInput = null;
        method = "cash";
        showErrors = false;
    }

    async Task CompleteAsync()
    {
        showErrors = true;
        if (Errors.Count > 0 || isSaving) return;

        isSaving = true;
        SaleRec? saleRecord = null;
        try
        {
            var saleNo = NextNo;
            var saleDate = DateTime.Now;
            var servedBy = Auth.CurrentUserName ?? "";
            var custName = SelectedCustomer?.Name ?? WalkIn;
            var snapshotLines = lines.ToList();

            saleRecord = new SaleRec
            {
                No = saleNo,
                Date = saleDate,
                Branch = ActiveBranch,
                BranchAddress = BranchAddress,
                Customer = custName,
                By = servedBy,
                Method = method,
                IsPwdOrSenior = IsPwdOrSenior,
                Lines = snapshotLines.Select(l => new ReceiptLine
                {
                    Name = l.Name,
                    Unit = l.Unit,
                    Qty = l.Qty ?? 0,
                    Price = l.Price ?? 0,
                    IsTaxable = l.IsTaxable
                }).ToList(),
                Subtotal = GrossSubtotal,
                VatExemptSales = VatExemptSales,
                VatableSales = VatableSales,
                TaxAmount = ComputedTax,
                VatRemoved = VatRemoved,
                Discount = Discount,
                Total = Total,
                Paid = Paid,
                Balance = Balance,
                Change = Change
            };

            foreach (var l in snapshotLines)
            {
                var qtyToDeduct = l.Qty ?? 0;
                var dbItem = await DbContext.InventoryItems.FindAsync(l.ItemId);
                if (dbItem != null)
                {
                    dbItem.QuantityOnHand = Math.Max(0, dbItem.QuantityOnHand - qtyToDeduct);
                }
            }

            if (Balance > 0 && SelectedCustomer?.Entity != null)
            {
                var cType = SelectedCustomer.Entity.GetType();
                var balProp = cType.GetProperty("OutstandingBalance")
                           ?? cType.GetProperty("Outstanding")
                           ?? cType.GetProperty("Balance")
                           ?? cType.GetProperty("AccountBalance");
                if (balProp != null && balProp.CanWrite)
                {
                    var underlying = Nullable.GetUnderlyingType(balProp.PropertyType) ?? balProp.PropertyType;
                    var newBal = SelectedCustomer.Balance + Balance;
                    if (underlying == typeof(decimal))
                        balProp.SetValue(SelectedCustomer.Entity, newBal);
                    else if (underlying == typeof(double))
                        balProp.SetValue(SelectedCustomer.Entity, Convert.ToDouble(newBal, Inv));
                }
            }

            await TrySaveSalesOrderAsync(saleRecord, snapshotLines);

            await DbContext.SaveChangesAsync();

            Clear();
            await LoadDataAsync();

            lastSaleNo = saleNo;
            showSuccessModal = true;
            await InvokeAsync(StateHasChanged);

            await Task.Delay(1500);

            showSuccessModal = false;
            receipt = saleRecord;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            saleRecord = null;
            var errMsg = ex.InnerException?.Message ?? ex.Message;
            await ShowToast("Error completing sale: " + errMsg);
        }
        finally
        {
            isSaving = false;
        }

        // Print AFTER the sale is saved, so a printer problem never looks like a failed sale
        if (saleRecord != null)
        {
            await Task.Delay(150);
            await PrintReceiptAsync();
        }
    }

    async Task PrintReceiptAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("agriPrintReceipt", "receipt-print-area", ReceiptWidthMm);
        }
        catch (Exception ex)
        {
            await ShowToast("Print failed: " + ex.Message);
        }
    }

    private async Task TrySaveSalesOrderAsync(SaleRec saleRecord, List<SaleLine> snapshotLines)
    {
        var branchIdToSave = currentBranchId ?? 0L;
        if (branchIdToSave == 0L)
        {
            var firstBranch = await DbContext.Branches.FirstOrDefaultAsync(b => b.BusinessId == currentBusinessId);
            branchIdToSave = firstBranch?.BranchId ?? 0L;
        }

        var statusStr = saleRecord.Balance <= 0 ? "Paid" : (saleRecord.Paid > 0 ? "Partial" : "Unpaid");

        var orderEntity = new SalesOrder
        {
            BranchId = branchIdToSave,
            CustomerId = SelectedCustomer?.Id ?? 0,
            ReferenceNumber = saleRecord.No,
            SaleDate = saleRecord.Date,
            GrossAmount = saleRecord.Subtotal,
            DiscountAmount = saleRecord.Discount,
            TaxAmount = saleRecord.TaxAmount,
            NetAmount = saleRecord.Total,
            // the change given back is not part of the amount paid for the sale
            AmountPaid = Math.Min(saleRecord.Paid, saleRecord.Total),
            Status = statusStr
        };

        var orderType = orderEntity.GetType();
        var bizProp = orderType.GetProperty("BusinessId");
        if (bizProp != null && bizProp.CanWrite)
        {
            var uType = Nullable.GetUnderlyingType(bizProp.PropertyType) ?? bizProp.PropertyType;
            if (uType == typeof(long)) bizProp.SetValue(orderEntity, currentBusinessId);
            else if (uType == typeof(int)) bizProp.SetValue(orderEntity, (int)currentBusinessId);
        }

        DbContext.SalesOrders.Add(orderEntity);
        await DbContext.SaveChangesAsync();

        if (orderEntity.SaleId > 0)
        {
            foreach (var l in snapshotLines)
            {
                var qty = l.Qty ?? 0;
                var price = l.Price ?? 0;
                var lineTotal = LineAmt(qty, price);
                var lineTax = (!l.IsTaxable || saleRecord.IsPwdOrSenior)
                    ? 0m
                    : Math.Max(0m, lineTotal - NetOfVat(lineTotal));

                var salesItem = new SalesItem
                {
                    SaleId = orderEntity.SaleId,
                    ItemId = l.ItemId,
                    Unit = l.Unit,
                    Quantity = qty,
                    UnitPrice = price,
                    Subtotal = lineTotal
                };

                var itemType = salesItem.GetType();
                var taxFlagProp = itemType.GetProperty("IsTaxable");
                if (taxFlagProp != null && taxFlagProp.CanWrite)
                    taxFlagProp.SetValue(salesItem, l.IsTaxable);

                var taxAmtProp = itemType.GetProperty("TaxAmount");
                if (taxAmtProp != null && taxAmtProp.CanWrite)
                    taxAmtProp.SetValue(salesItem, lineTax);

                DbContext.SalesItems.Add(salesItem);
            }
        }
    }

    void CloseReceipt() => receipt = null;

    async Task ShowToast(string message)
    {
        toast = message;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(3000);
        toast = "";
        await InvokeAsync(StateHasChanged);
    }
}