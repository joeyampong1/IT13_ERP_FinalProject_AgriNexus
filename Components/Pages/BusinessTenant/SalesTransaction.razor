@page "/sales"
@using System.Collections
@using System.Globalization
@using System.Reflection
@using Microsoft.EntityFrameworkCore
@using AgriNexus.DataLayer
@using AgriNexus.DataLayer.Models
@inject AgriNexusDbContext DbContext
@inject AgriNexus.Services.AuthService Auth
@inject NavigationManager Nav

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <h2 class="page-title">Sales Transactions</h2>
        <p class="text-muted mb-0 page-sub">
            <i class="bi bi-building text-success me-1"></i><strong>@ActiveBranch</strong> · sales orders, sale items and pricing, payment status and order history.
        </p>
    </div>

    <div class="d-flex align-items-center gap-2 flex-wrap">
        @if (canSelectBranch)
        {
            <div class="dashboard-filter-wrap">
                <i class="bi bi-shop dashboard-filter-icon"></i>
                <select class="dashboard-filter-select" value="@selectedBranchIdStr" @onchange="OnBranchChanged" aria-label="Filter branch">
                    <option value="all">All Branches</option>
                    @foreach (var b in businessBranches)
                    {
                        <option value="@b.BranchId">@b.BranchName</option>
                    }
                </select>
                <i class="bi bi-chevron-down dashboard-filter-caret"></i>
            </div>
        }

        <div class="dashboard-filter-wrap">
            <i class="bi bi-funnel dashboard-filter-icon"></i>
            <select class="dashboard-filter-select" value="@selectedPeriod" @onchange="OnPeriodChanged" aria-label="Filter period">
                <option value="all">All Time</option>
                <option value="today">Today</option>
                <option value="week">This Week</option>
                <option value="month">This Month</option>
                <option value="year">This Year</option>
            </select>
            <i class="bi bi-chevron-down dashboard-filter-caret"></i>
        </div>
    </div>
</div>

<!-- STAT CARDS -->
<div class="row g-3 mb-4">
    @foreach (var s in Stats)
    {
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <span class="card-title">@s.Title</span>
                    <div class="stat-icon @s.IconClass"><i class="bi @s.Icon"></i></div>
                </div>
                <div class="mt-3">
                    <div class="card-value">@s.Value</div>
                    @if (!string.IsNullOrEmpty(s.Note))
                    {
                        <div class="text-muted small mt-1">@s.Note</div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- TOOLBAR -->
<div class="toolbar mb-3">
    <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="text" placeholder="Search sale no., customer or cashier..."
               @bind="searchText"
               @bind:event="oninput"
               @bind:after="ResetPagination" />
    </div>

    <div class="dashboard-filter-wrap">
        <i class="bi bi-wallet2 dashboard-filter-icon"></i>
        <select class="dashboard-filter-select" value="@statusFilter" @onchange="OnStatusChanged" aria-label="Filter payment status">
            <option value="">All payment statuses</option>
            <option value="unpaid">Unpaid</option>
            <option value="partial">Partial</option>
            <option value="paid">Fully paid</option>
        </select>
        <i class="bi bi-chevron-down dashboard-filter-caret"></i>
    </div>

    <span class="text-muted small">@Filtered.Count @(Filtered.Count == 1 ? "sale" : "sales") · @Peso(MonthValue) this month</span>

    <div class="d-flex gap-2 ms-auto flex-wrap">
        <button type="button" class="btn-outline-lg" @onclick="GoCollections">Collections</button>
        <button type="button" class="btn-solid shadow-sm" @onclick="GoNewSale"><i class="bi bi-cart"></i> New sale</button>
    </div>
</div>

@if (isLoading)
{
    <div class="panel">
        <div class="text-muted py-5 text-center">
            <div class="spinner-border spinner-border-sm text-success me-2" role="status"></div>
            Loading sales transactions...
        </div>
    </div>
}
else
{
    <!-- TABLE -->
    <div class="panel">
        <div class="table-wrap">
            <table class="table data-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Sale no.</th>
                        <th>Date</th>
                        <th>Customer</th>
                        @if (canSelectBranch && !effectiveBranchFilter.HasValue)
                        {
                            <th>Branch</th>
                        }
                        <th>Items</th>
                        <th>Total</th>
                        <th>Paid</th>
                        <th>Balance</th>
                        <th>Status</th>
                        <th>Order</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in PaginatedSales)
                    {
                        var st = PayStatus(s);
                        <tr class="row-click" @onclick="() => Open(s)">
                            <td class="fw-bold text-nowrap" style="color: #1B5E34;">@s.No</td>
                            <td class="text-nowrap">@s.Date.ToString("MMM d, yyyy", Inv)</td>
                            <td class="col-customer fw-medium" style="color: #0A2B1D;">@s.Customer</td>
                            @if (canSelectBranch && !effectiveBranchFilter.HasValue)
                            {
                                <td class="text-nowrap">@s.BranchName</td>
                            }
                            <td class="text-muted text-nowrap">@s.Items.Count @(s.Items.Count == 1 ? "line" : "lines")</td>
                            <td class="fw-semibold text-nowrap">@Peso(Total(s))</td>
                            <td class="text-nowrap">@Peso(Paid(s))</td>
                            <td class="text-nowrap fw-semibold @(Balance(s) > 0 ? "neg" : "")">@Peso(Balance(s))</td>
                            <td><span class="pill @PayClass(st)">@PayLabel(st)</span></td>
                            <td><span class="pill @(s.Voided ? "pill-red" : "pill-green")">@(s.Voided ? "Voided" : "Completed")</span></td>
                        </tr>
                    }
                    @if (Filtered.Count == 0)
                    {
                        <tr>
                            <td colspan="@((canSelectBranch && !effectiveBranchFilter.HasValue) ? 10 : 9)" class="text-center text-muted py-5">
                                No sales found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Filtered.Count > 0)
        {
            <div class="d-flex flex-wrap justify-content-between align-items-center p-3 border-top bg-white" style="flex-shrink: 0; border-color: #E2ECE6 !important; border-radius: 0 0 16px 16px;">
                <div class="text-muted small mb-2 mb-md-0">
                    Showing <span class="fw-bold" style="color: #0A2B1D;">@StartSale</span> - <span class="fw-bold" style="color: #0A2B1D;">@EndSale</span> of <span class="fw-bold" style="color: #0A2B1D;">@Filtered.Count</span> @(Filtered.Count == 1 ? "sale" : "sales")
                </div>

                <div class="d-flex gap-1 flex-wrap">
                    <button type="button" class="btn btn-sm btn-light border px-3 rounded-2 fw-medium" @onclick="PreviousPage" disabled="@(currentPage == 1)">
                        <i class="bi bi-chevron-left me-1"></i>Previous
                    </button>

                    @for (int p = 1; p <= TotalPages; p++)
                    {
                        var pageNumber = p;
                        <button type="button" class="btn btn-sm px-3 rounded-2 fw-bold @(currentPage == pageNumber ? "btn-new text-white shadow-sm" : "btn-light border text-dark")"
                                @onclick="() => GoToPage(pageNumber)">
                            @pageNumber
                        </button>
                    }

                    <button type="button" class="btn btn-sm btn-light border px-3 rounded-2 fw-medium" @onclick="NextPage" disabled="@(currentPage == TotalPages)">
                        Next<i class="bi bi-chevron-right ms-1"></i>
                    </button>
                </div>
            </div>
        }
    </div>
}

<!-- ======================= DETAIL DRAWER (slide from right) ======================= -->
@if (selected != null)
{
    var sale = selected;
    <div class="drawer-overlay @(closing ? "closing" : "")" @onclick="CloseDrawer"></div>
    <aside class="drawer @(closing ? "closing" : "")" role="dialog" aria-label="Sale details">
        <button type="button" class="drawer-close" @onclick="CloseDrawer" aria-label="Close"><i class="bi bi-x-circle"></i></button>

        <div class="drawer-body">
            <h4 class="drawer-title">@sale.No</h4>
            <div class="drawer-sub">@sale.Customer · @sale.BranchName · @sale.Date.ToString("MMM d, yyyy", Inv) · cashier @sale.Cashier</div>

            <div class="d-flex align-items-center gap-3 mt-3 mb-4 flex-wrap">
                <button type="button" class="btn-receipt" @onclick="() => showReceipt = true">
                    <i class="bi bi-receipt"></i> View receipt
                </button>

                @if (sale.Voided)
                {
                    <span class="pill pill-red">Voided</span>
                }
                else if (confirmVoid)
                {
                    <span class="confirm-text">Void this sale?</span>
                    <button type="button" class="btn-danger-sm" @onclick="VoidSale" disabled="@isSaving">Yes, void</button>
                    <button type="button" class="btn-plain-sm" @onclick="() => confirmVoid = false">Cancel</button>
                }
                else
                {
                    <button type="button" class="link-void" @onclick="() => confirmVoid = true">Void sale</button>
                }
            </div>

            <div class="section-title">Sale items and pricing</div>
            <div class="mini-wrap">
                <table class="table mini-table align-middle mb-0">
                    <thead><tr><th>Item</th><th>Qty</th><th>Unit price</th><th>Subtotal</th></tr></thead>
                    <tbody>
                        @foreach (var i in sale.Items)
                        {
                            <tr>
                                <td class="text-nowrap">@i.Name</td>
                                <td class="text-nowrap">@Qty(i.Qty) @i.Unit</td>
                                <td class="text-nowrap">@Peso(i.Price)</td>
                                <td class="text-nowrap">@Peso(i.Qty * i.Price)</td>
                            </tr>
                        }
                        @if (sale.Items.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-3">No line items recorded.</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="totals-box">
                <div class="row-line"><span>Subtotal</span><span>@Peso(Subtotal(sale))</span></div>
                <div class="row-line"><span>Discount</span><span>– @Peso(sale.Discount)</span></div>
                @if (sale.Tax > 0)
                {
                    <div class="row-line"><span>Tax</span><span>+ @Peso(sale.Tax)</span></div>
                }
                <hr />
                <div class="row-line bold"><span>Total</span><span>@Peso(Total(sale))</span></div>
                <div class="row-line"><span>Amount paid</span><span>@Peso(Paid(sale))</span></div>
                <div class="row-line bold"><span>Balance</span><span class="@(Balance(sale) > 0 ? "neg" : "")">@Peso(Balance(sale))</span></div>
            </div>

            <div class="section-title mt-4">Payment history</div>
            <div class="mini-wrap">
                <table class="table mini-table align-middle mb-0">
                    <thead><tr><th>Date</th><th>Method</th><th>Amount</th><th>Received by</th></tr></thead>
                    <tbody>
                        @foreach (var p in sale.Payments)
                        {
                            <tr>
                                <td class="text-nowrap">@p.Date.ToString("MMM d, yyyy", Inv)</td>
                                <td>@Cap(p.Method)</td>
                                <td class="text-nowrap">@Peso(p.Amount)</td>
                                <td class="text-nowrap">@p.ReceivedBy</td>
                            </tr>
                        }
                        @if (sale.Payments.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-3">No payments recorded yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </aside>
}

<!-- RECEIPT -->
@if (selected != null && showReceipt)
{
    var sale = selected;
    <div class="modal-overlay" @onclick="() => showReceipt = false">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h5 class="modal-heading mb-1">Receipt</h5>
                    <div class="modal-sub">@BusinessName · @sale.BranchName</div>
                </div>
                <button type="button" class="btn-close-x" @onclick="() => showReceipt = false" aria-label="Close"><i class="bi bi-x-lg"></i></button>
            </div>

            <div class="receipt-meta">
                <div><span>Sale no.</span><strong>@sale.No</strong></div>
                <div><span>Date</span><strong>@sale.Date.ToString("MMM d, yyyy", Inv)</strong></div>
                <div><span>Customer</span><strong>@sale.Customer</strong></div>
                <div><span>Cashier</span><strong>@sale.Cashier</strong></div>
            </div>

            <table class="table receipt-table align-middle mb-0">
                <thead><tr><th>Item</th><th class="text-end">Qty</th><th class="text-end">Price</th><th class="text-end">Subtotal</th></tr></thead>
                <tbody>
                    @foreach (var i in sale.Items)
                    {
                        <tr>
                            <td>@i.Name</td>
                            <td class="text-end text-nowrap">@Qty(i.Qty) @i.Unit</td>
                            <td class="text-end text-nowrap">@Peso(i.Price)</td>
                            <td class="text-end text-nowrap">@Peso(i.Qty * i.Price)</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="totals-box mt-3">
                <div class="row-line"><span>Subtotal</span><span>@Peso(Subtotal(sale))</span></div>
                <div class="row-line"><span>Discount</span><span>– @Peso(sale.Discount)</span></div>
                @if (sale.Tax > 0)
                {
                    <div class="row-line"><span>Tax</span><span>+ @Peso(sale.Tax)</span></div>
                }
                <hr />
                <div class="row-line bold"><span>Total</span><span>@Peso(Total(sale))</span></div>
                <div class="row-line"><span>Amount paid</span><span>@Peso(Paid(sale))</span></div>
                <div class="row-line bold"><span>Balance</span><span class="@(Balance(sale) > 0 ? "neg" : "")">@Peso(Balance(sale))</span></div>
            </div>

            <div class="d-flex justify-content-end mt-4">
                <button type="button" class="btn-save" @onclick="() => showReceipt = false">Done</button>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(toast))
{
    <div class="toast-note"><i class="bi bi-check-circle"></i> @toast</div>
}

@code {
    // ---------- MODELS ----------
    record ItemRec(string Name, string Unit, decimal Qty, decimal Price);
    record PayRec(DateTime Date, string Method, decimal Amount, string ReceivedBy);

    class SaleRec
    {
        public int SaleId { get; set; }
        public SalesOrder? OrderEntity { get; set; }
        public long BranchId { get; set; }
        public string BranchName { get; set; } = "";
        public string No { get; set; } = "";
        public DateTime Date { get; set; }
        public string Customer { get; set; } = "";
        public string Cashier { get; set; } = "";
        public decimal? ExplicitTotal { get; set; }
        public decimal? ExplicitPaid { get; set; }
        public decimal Discount { get; set; }
        public decimal Tax { get; set; }
        public bool Voided { get; set; }
        public List<ItemRec> Items { get; set; } = new();
        public List<PayRec> Payments { get; set; } = new();
    }

    record Stat(string Title, string Value, string Note, string Icon, string IconClass);

    static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    long currentBusinessId;
    long? assignedBranchId;
    bool canSelectBranch;
    string selectedBranchIdStr = "all";
    long? effectiveBranchFilter => canSelectBranch
        ? (long.TryParse(selectedBranchIdStr, out var bid) && bid > 0 ? bid : null)
        : assignedBranchId;

    string BusinessName = "AgriNexus";
    string ActiveBranch = "All Branches";

    bool isLoading = true;
    bool isSaving;
    string selectedPeriod = "all";
    string searchText = "";
    string statusFilter = "";
    string toast = "";
    SaleRec? selected;
    bool closing;
    bool confirmVoid;
    bool showReceipt;

    private int currentPage = 1;
    private int pageSize = 20;

    List<Branch> businessBranches = new();
    readonly Dictionary<long, string> branchNames = new();
    readonly Dictionary<int, string> customerNames = new();
    readonly List<SaleRec> allBusinessSales = new();

    string PeriodLabel => selectedPeriod switch
    {
        "today" => "Today",
        "week" => "This Week",
        "month" => "This Month",
        "year" => "This Year",
        _ => "All Time"
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ResolveTenantAndRoleScopeAsync();
            UpdateActiveBranchLabel();
            await LoadSalesDataAsync();
        }
        catch (Exception ex)
        {
            await ShowToast("Error loading sales: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ResolveTenantAndRoleScopeAsync()
    {
        User? currentUser = null;

        if (Auth.CurrentUserId > 0)
        {
            currentUser = await DbContext.Users
                .FirstOrDefaultAsync(u => u.UserId == Auth.CurrentUserId);
        }
        else if (!string.IsNullOrWhiteSpace(Auth.CurrentUserEmail))
        {
            var cleanEmail = Auth.CurrentUserEmail.Trim().ToLower();
            currentUser = await DbContext.Users
                .FirstOrDefaultAsync(u => u.Email != null && u.Email.ToLower() == cleanEmail);
        }
        else if (!string.IsNullOrWhiteSpace(Auth.CurrentUserName))
        {
            currentUser = await DbContext.Users
                .FirstOrDefaultAsync(u => (u.FName + " " + u.LName) == Auth.CurrentUserName
                                       || u.FName == Auth.CurrentUserName);
        }

        if (currentUser?.BusinessId != null)
        {
            currentBusinessId = currentUser.BusinessId.Value;
            assignedBranchId = currentUser.BranchId;
        }
        else
        {
            var firstBiz = await DbContext.Businesses.FirstOrDefaultAsync();
            if (firstBiz != null) currentBusinessId = firstBiz.BusinessId;
        }

        var biz = await DbContext.Businesses.FirstOrDefaultAsync(b => b.BusinessId == currentBusinessId);
        if (biz != null)
        {
            var bType = biz.GetType();
            var bName = bType.GetProperty("BusinessName")?.GetValue(biz)?.ToString()
                     ?? bType.GetProperty("Name")?.GetValue(biz)?.ToString();
            if (!string.IsNullOrWhiteSpace(bName)) BusinessName = bName.Trim();
        }

        var roleText = (currentUser?.Role ?? "").Trim().ToLowerInvariant();
        var isTenantOwnerOrAdmin = string.IsNullOrEmpty(roleText)
            || roleText.Contains("tenant")
            || roleText.Contains("owner")
            || roleText.Contains("admin")
            || roleText.Contains("superadmin")
            || roleText.Contains("director");

        canSelectBranch = isTenantOwnerOrAdmin || !assignedBranchId.HasValue;
        if (!canSelectBranch && assignedBranchId.HasValue)
        {
            selectedBranchIdStr = assignedBranchId.Value.ToString();
        }

        businessBranches = await DbContext.Branches
            .Where(b => b.BusinessId == currentBusinessId)
            .OrderBy(b => b.BranchName)
            .ToListAsync();

        branchNames.Clear();
        foreach (var b in businessBranches)
        {
            branchNames[b.BranchId] = b.BranchName;
        }
    }

    private void UpdateActiveBranchLabel()
    {
        if (!canSelectBranch && assignedBranchId.HasValue)
        {
            ActiveBranch = branchNames.TryGetValue(assignedBranchId.Value, out var bName)
                ? bName
                : "Assigned Branch";
            return;
        }

        if (effectiveBranchFilter.HasValue)
        {
            ActiveBranch = branchNames.TryGetValue(effectiveBranchFilter.Value, out var bName)
                ? bName
                : "Selected Branch";
            return;
        }

        ActiveBranch = businessBranches.Count == 1
            ? businessBranches[0].BranchName
            : "All Branches (Overall)";
    }

    private async Task LoadSalesDataAsync()
    {
        customerNames.Clear();
        allBusinessSales.Clear();

        var dbCustomers = await DbContext.Customers.ToListAsync();
        foreach (var c in dbCustomers)
        {
            var t = c.GetType();
            var bizVal = GetLongProp(t, c, "BusinessId");
            if (currentBusinessId > 0 && bizVal.HasValue && bizVal.Value > 0 && bizVal.Value != currentBusinessId)
                continue;

            var idObj = t.GetProperty("CustomerId")?.GetValue(c) ?? t.GetProperty("Id")?.GetValue(c);
            if (idObj != null && int.TryParse(idObj.ToString(), out var cid))
            {
                var name = t.GetProperty("CustomerName")?.GetValue(c)?.ToString()
                        ?? t.GetProperty("FullName")?.GetValue(c)?.ToString()
                        ?? t.GetProperty("Name")?.GetValue(c)?.ToString();

                if (string.IsNullOrWhiteSpace(name))
                {
                    var f = t.GetProperty("FName")?.GetValue(c)?.ToString() ?? "";
                    var l = t.GetProperty("LName")?.GetValue(c)?.ToString() ?? "";
                    name = $"{f} {l}".Trim();
                }

                customerNames[cid] = string.IsNullOrWhiteSpace(name) ? $"Customer #{cid}" : name.Trim();
            }
        }

        var branchIds = businessBranches.Select(b => b.BranchId).ToList();
        var fallbackBranchId = businessBranches.FirstOrDefault()?.BranchId ?? 0L;

        var orders = await DbContext.SalesOrders
            .Where(s => branchIds.Contains(s.BranchId) || s.BranchId == 0)
            .OrderByDescending(s => s.SaleDate)
            .ToListAsync();

        var itemsBySaleId = new Dictionary<int, List<ItemRec>>();
        var itemSetProp = DbContext.GetType().GetProperties(BindingFlags.Public | BindingFlags.Instance)
            .FirstOrDefault(p => p.Name.Equals("SalesOrderItems", StringComparison.OrdinalIgnoreCase)
                              || p.Name.Equals("SaleItems", StringComparison.OrdinalIgnoreCase)
                              || p.Name.Equals("OrderItems", StringComparison.OrdinalIgnoreCase));

        if (itemSetProp?.GetValue(DbContext) is IQueryable rawItemQuery)
        {
            var dbItems = await rawItemQuery.Cast<object>().ToListAsync();
            foreach (var it in dbItems)
            {
                var itType = it.GetType();
                var sId = (int)(GetLongProp(itType, it, "SaleId", "SalesOrderId", "OrderId") ?? 0);
                if (sId <= 0) continue;

                var itemName = itType.GetProperty("ProductName")?.GetValue(it)?.ToString()
                            ?? itType.GetProperty("ItemName")?.GetValue(it)?.ToString()
                            ?? itType.GetProperty("Name")?.GetValue(it)?.ToString()
                            ?? $"Item #{sId}";
                var unit = itType.GetProperty("Unit")?.GetValue(it)?.ToString()
                      ?? itType.GetProperty("Uom")?.GetValue(it)?.ToString()
                      ?? "kg";
                var qty = GetDecimalProp(itType, it, "Quantity", "Qty");
                var price = GetDecimalProp(itType, it, "UnitPrice", "Price");

                if (!itemsBySaleId.TryGetValue(sId, out var list))
                {
                    list = new List<ItemRec>();
                    itemsBySaleId[sId] = list;
                }
                list.Add(new ItemRec(itemName.Trim(), string.IsNullOrWhiteSpace(unit) ? "kg" : unit.Trim(), qty, price));
            }
        }

        var paymentsBySaleId = new Dictionary<int, List<PayRec>>();
        var paySetProp = DbContext.GetType().GetProperties(BindingFlags.Public | BindingFlags.Instance)
            .FirstOrDefault(p => p.Name.Equals("PaymentRecords", StringComparison.OrdinalIgnoreCase)
                              || p.Name.Equals("Payments", StringComparison.OrdinalIgnoreCase)
                              || p.Name.Equals("SalePayments", StringComparison.OrdinalIgnoreCase));

        if (paySetProp?.GetValue(DbContext) is IQueryable rawPayQuery)
        {
            var dbPays = await rawPayQuery.Cast<object>().ToListAsync();
            foreach (var p in dbPays)
            {
                var pt = p.GetType();
                if (GetBoolProp(pt, p, "IsVoided", "Voided")) continue;

                var pSaleId = (int)(GetLongProp(pt, p, "SaleId", "SalesOrderId", "OrderId") ?? 0);
                if (pSaleId <= 0) continue;

                var pDate = GetDateProp(pt, p, "PaymentDate", "Date", "CreatedAt") ?? DateTime.Today;
                var pMethod = (pt.GetProperty("PaymentMethod")?.GetValue(p)?.ToString()
                            ?? pt.GetProperty("Method")?.GetValue(p)?.ToString()
                            ?? "cash").Trim().ToLowerInvariant();
                var pAmt = GetDecimalProp(pt, p, "Amount", "AmountPaid", "PaidAmount");
                var pBy = pt.GetProperty("ReceivedBy")?.GetValue(p)?.ToString()
                       ?? pt.GetProperty("CreatedBy")?.GetValue(p)?.ToString()
                       ?? Auth.CurrentUserName ?? "";

                if (!paymentsBySaleId.TryGetValue(pSaleId, out var list))
                {
                    list = new List<PayRec>();
                    paymentsBySaleId[pSaleId] = list;
                }
                list.Add(new PayRec(pDate, string.IsNullOrWhiteSpace(pMethod) ? "cash" : pMethod, pAmt, pBy));
            }
        }

        foreach (var o in orders)
        {
            var oType = o.GetType();
            var oBiz = GetLongProp(oType, o, "BusinessId");
            if (currentBusinessId > 0 && oBiz.HasValue && oBiz.Value > 0 && oBiz.Value != currentBusinessId)
                continue;

            var resolvedBranchId = o.BranchId > 0 ? o.BranchId : fallbackBranchId;
            var resolvedBranchName = branchNames.TryGetValue(resolvedBranchId, out var bn)
                ? bn
                : (businessBranches.FirstOrDefault()?.BranchName ?? "Main Branch");

            var custLabel = o.CustomerId > 0 && customerNames.TryGetValue(o.CustomerId, out var cName)
                ? cName
                : "Walk-in customers";

            var cashierName = oType.GetProperty("CashierName")?.GetValue(o)?.ToString()
                           ?? oType.GetProperty("CreatedBy")?.GetValue(o)?.ToString()
                           ?? Auth.CurrentUserName ?? "POS";

            var isVoided = GetBoolProp(oType, o, "IsVoided", "Voided")
                        || string.Equals(o.Status, "Voided", StringComparison.OrdinalIgnoreCase);

            var rec = new SaleRec
            {
                SaleId = o.SaleId,
                OrderEntity = o,
                BranchId = resolvedBranchId,
                BranchName = resolvedBranchName,
                No = string.IsNullOrWhiteSpace(o.ReferenceNumber) ? $"SO-{o.SaleId:D4}" : o.ReferenceNumber.Trim(),
                Date = o.SaleDate,
                Customer = custLabel,
                Cashier = cashierName,
                Discount = Math.Max(0m, o.DiscountAmount),
                Tax = Math.Max(0m, o.TaxAmount),
                Voided = isVoided,
                ExplicitTotal = o.NetAmount > 0 ? o.NetAmount : null,
                ExplicitPaid = o.AmountPaid > 0 ? o.AmountPaid : null
            };

            if (itemsBySaleId.TryGetValue(o.SaleId, out var loadedItems))
            {
                rec.Items = loadedItems;
            }
            else if (oType.GetProperty("Items")?.GetValue(o) is IEnumerable navItems)
            {
                foreach (var it in navItems)
                {
                    if (it == null) continue;
                    var itType = it.GetType();
                    var itemName = itType.GetProperty("ProductName")?.GetValue(it)?.ToString()
                                ?? itType.GetProperty("ItemName")?.GetValue(it)?.ToString()
                                ?? itType.GetProperty("Name")?.GetValue(it)?.ToString()
                                ?? "Item";
                    var unit = itType.GetProperty("Unit")?.GetValue(it)?.ToString() ?? "kg";
                    var qty = GetDecimalProp(itType, it, "Quantity", "Qty");
                    var price = GetDecimalProp(itType, it, "UnitPrice", "Price");
                    rec.Items.Add(new ItemRec(itemName, unit, qty, price));
                }
            }

            if (paymentsBySaleId.TryGetValue(o.SaleId, out var loadedPays))
            {
                rec.Payments = loadedPays;
            }
            else if (o.AmountPaid > 0)
            {
                var mStr = oType.GetProperty("PaymentMethod")?.GetValue(o)?.ToString() ?? "cash";
                rec.Payments.Add(new PayRec(o.SaleDate, mStr.Trim().ToLowerInvariant(), o.AmountPaid, cashierName));
            }

            allBusinessSales.Add(rec);
        }
    }

    static long? GetLongProp(Type t, object obj, params string[] names)
    {
        foreach (var n in names)
        {
            var p = t.GetProperty(n, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
            if (p != null && long.TryParse(p.GetValue(obj)?.ToString(), out var v))
                return v;
        }
        return null;
    }

    static decimal GetDecimalProp(Type t, object obj, params string[] names)
    {
        foreach (var n in names)
        {
            var p = t.GetProperty(n, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
            if (p != null && decimal.TryParse(p.GetValue(obj)?.ToString(), NumberStyles.Any, Inv, out var v))
                return v;
        }
        return 0m;
    }

    static DateTime? GetDateProp(Type t, object obj, params string[] names)
    {
        foreach (var n in names)
        {
            var p = t.GetProperty(n, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
            if (p != null && p.GetValue(obj) is DateTime dt)
                return dt;
        }
        return null;
    }

    static bool GetBoolProp(Type t, object obj, params string[] names)
    {
        foreach (var n in names)
        {
            var p = t.GetProperty(n, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
            if (p != null && p.GetValue(obj) is bool b)
                return b;
        }
        return false;
    }

    bool MatchesScope(long branchId)
    {
        if (!canSelectBranch && assignedBranchId.HasValue)
            return branchId == assignedBranchId.Value;

        if (effectiveBranchFilter.HasValue)
            return branchId == effectiveBranchFilter.Value;

        return true;
    }

    bool IsInSelectedPeriod(DateTime date)
    {
        if (selectedPeriod == "all") return true;

        var d = date.Date;
        var today = DateTime.Today;

        return selectedPeriod switch
        {
            "today" => d == today,
            "week" => GetWeekStart(d) == GetWeekStart(today),
            "year" => d.Year == today.Year,
            _ => d.Year == today.Year && d.Month == today.Month,
        };
    }

    static DateTime GetWeekStart(DateTime date)
    {
        var diff = (7 + (date.DayOfWeek - DayOfWeek.Monday)) % 7;
        return date.AddDays(-diff).Date;
    }

    // ---------- COMPUTED ----------
    List<SaleRec> ScopedSales => allBusinessSales.Where(s => MatchesScope(s.BranchId)).ToList();
    List<SaleRec> PeriodSales => ScopedSales.Where(s => IsInSelectedPeriod(s.Date)).ToList();
    IEnumerable<SaleRec> Active => PeriodSales.Where(s => !s.Voided);

    List<SaleRec> Filtered => PeriodSales
        .Where(s => string.IsNullOrEmpty(statusFilter) || PayStatus(s) == statusFilter)
        .Where(s => string.IsNullOrWhiteSpace(searchText)
            || s.No.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || s.Customer.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || s.Cashier.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || s.BranchName.Contains(searchText, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(s => s.Date).ThenByDescending(s => s.No)
        .ToList();

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)Filtered.Count / pageSize));
    private int StartSale => Filtered.Count == 0 ? 0 : (currentPage - 1) * pageSize + 1;
    private int EndSale => Math.Min(currentPage * pageSize, Filtered.Count);
    private IEnumerable<SaleRec> PaginatedSales
    {
        get
        {
            if (currentPage > TotalPages) currentPage = TotalPages;
            if (currentPage < 1) currentPage = 1;
            return Filtered.Skip((currentPage - 1) * pageSize).Take(pageSize);
        }
    }

    private void GoToPage(int page) => currentPage = page;
    private void PreviousPage() { if (currentPage > 1) currentPage--; }
    private void NextPage() { if (currentPage < TotalPages) currentPage++; }
    private void ResetPagination() => currentPage = 1;

    decimal MonthValue
    {
        get
        {
            var t = DateTime.Today;
            return ScopedSales.Where(s => !s.Voided && s.Date.Year == t.Year && s.Date.Month == t.Month).Sum(Total);
        }
    }

    List<Stat> Stats
    {
        get
        {
            var periodList = PeriodSales;
            var activeList = Active.ToList();
            var withBalance = activeList.Count(s => Balance(s) > 0);
            var payCount = activeList.Sum(s => s.Payments.Count);
            return new()
            {
                new("TRANSACTIONS", periodList.Count.ToString(), periodList.Count(s => s.Voided) + " voided (" + PeriodLabel + ")", "bi-receipt", ""),
                new("SALES VALUE", Peso(activeList.Sum(Total)), PeriodLabel, "bi-graph-up", ""),
                new("COLLECTED", Peso(activeList.Sum(Paid)), payCount + (payCount == 1 ? " payment record" : " payment records"), "bi-cash-stack", ""),
                new("OUTSTANDING", Peso(activeList.Sum(Balance)), withBalance + (withBalance == 1 ? " with balance" : " with balance"), "bi-exclamation-circle", "stat-icon-warn"),
            };
        }
    }

    // ---------- HELPERS ----------
    static decimal Subtotal(SaleRec s)
    {
        if (s.Items.Count > 0) return s.Items.Sum(i => i.Qty * i.Price);
        if (s.ExplicitTotal.HasValue) return Math.Max(0m, s.ExplicitTotal.Value + s.Discount - s.Tax);
        return 0m;
    }

    static decimal Total(SaleRec s)
    {
        if (s.ExplicitTotal.HasValue && s.Items.Count == 0) return Math.Max(0m, s.ExplicitTotal.Value);
        return Math.Max(0m, Subtotal(s) - s.Discount + s.Tax);
    }

    static decimal Paid(SaleRec s)
    {
        if (s.Payments.Count > 0) return s.Payments.Sum(p => p.Amount);
        return Math.Max(0m, s.ExplicitPaid ?? 0m);
    }

    static decimal Balance(SaleRec s) => s.Voided ? 0m : Math.Max(0m, Total(s) - Paid(s));

    static string PayStatus(SaleRec s) => Balance(s) <= 0 ? "paid" : Paid(s) > 0 ? "partial" : "unpaid";

    static string PayLabel(string st) => st switch { "paid" => "Paid", "partial" => "Partial", _ => "Unpaid" };

    static string PayClass(string st) => st switch { "paid" => "pill-green", "partial" => "pill-yellow", _ => "pill-red" };

    static string Qty(decimal v) => v.ToString("#,##0.##", Inv);
    static string Peso(decimal v) => "₱" + v.ToString("N2", Inv);
    static string Cap(string s) => string.IsNullOrEmpty(s) ? s : char.ToUpper(s[0]) + s.Substring(1);

    // ---------- ACTIONS ----------
    async Task OnBranchChanged(ChangeEventArgs e)
    {
        if (!canSelectBranch) return;
        selectedBranchIdStr = e.Value?.ToString() ?? "all";
        ResetPagination();
        UpdateActiveBranchLabel();
        await InvokeAsync(StateHasChanged);
    }

    async Task OnPeriodChanged(ChangeEventArgs e)
    {
        selectedPeriod = e.Value?.ToString() ?? "all";
        ResetPagination();
        await InvokeAsync(StateHasChanged);
    }

    async Task OnStatusChanged(ChangeEventArgs e)
    {
        statusFilter = e.Value?.ToString() ?? "";
        ResetPagination();
        await InvokeAsync(StateHasChanged);
    }

    void GoNewSale() => Nav.NavigateTo("new-sale");
    void GoCollections() => Nav.NavigateTo("payments");

    void Open(SaleRec s)
    {
        selected = s;
        closing = false;
        confirmVoid = false;
        showReceipt = false;
    }

    async Task CloseDrawer()
    {
        if (closing) return;
        closing = true;
        showReceipt = false;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(240);
        selected = null;
        closing = false;
        confirmVoid = false;
        await InvokeAsync(StateHasChanged);
    }

    async Task VoidSale()
    {
        if (selected == null || isSaving) return;
        isSaving = true;
        try
        {
            selected.Voided = true;
            confirmVoid = false;

            if (selected.OrderEntity != null)
            {
                selected.OrderEntity.Status = "Voided";
                var oType = selected.OrderEntity.GetType();
                var isVoidedProp = oType.GetProperty("IsVoided", BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
                if (isVoidedProp != null && isVoidedProp.CanWrite && isVoidedProp.PropertyType == typeof(bool))
                {
                    isVoidedProp.SetValue(selected.OrderEntity, true);
                }
                await DbContext.SaveChangesAsync();
            }

            await ShowToast(selected.No + " was voided.");
        }
        finally
        {
            isSaving = false;
        }
    }

    async Task ShowToast(string message)
    {
        toast = message;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(3000);
        toast = "";
        await InvokeAsync(StateHasChanged);
    }
}