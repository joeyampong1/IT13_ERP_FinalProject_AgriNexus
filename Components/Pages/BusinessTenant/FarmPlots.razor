@code {
    record Stat(string Title, string Value, string Note, string Icon, string IconClass);

    class Viewport
    {
        public double W { get; set; }
        public double H { get; set; }
    }

    static readonly CultureInfo Inv = CultureInfo.InvariantCulture;
    static readonly string[] IrrigationOptions = { "rainfed", "drip", "canal", "sprinkler" };
    static readonly string[] PlotStatusOptions = { "Vacant", "Preparing", "Planted", "Harvesting", "Fallow" };

    long currentBusinessId;
    string businessName = "AgriNexus Farm Operations";

    List<Branch> branches = new();
    List<Farm> farms = new();
    List<Plot> plots = new();

    bool showArchivedFarms = false;
    string searchText = "";
    string toast = "";
    bool toastIsWarning = false;

    bool showFarmModal;
    bool showFarmErrors;
    bool isSaving;
    int? editingFarmId;
    int? openFarmMenuId;
    Farm farmForm = new();
    double? farmAreaInput;

    bool showFarmDetailsModal;
    Farm? selectedFarm;
    bool showPlotsInDetails;
    bool showArchivedPlotsInModal;

    bool showConfirmSaveFarmModal;
    bool showConfirmArchiveFarmModal;
    Farm? farmToArchive;

    bool showPlotModal;
    bool showPlotErrors;
    int? editingPlotId;
    Plot plotForm = new();
    double? plotAreaInput;

    bool showConfirmSavePlotModal;
    bool showConfirmArchivePlotModal;
    Plot? plotToArchive;

    private int currentPage = 1;
    private int pageSize = 5;
    private double menuTop;
    private double menuLeft;

    private List<Region> regions = new();
    private List<Province> provinces = new();
    private string selectedRegionCode = "";
    private string selectedProvinceCode = "";
    private string locationDetail = "";

private async Task OnRegionChanged()
{
    if (!string.IsNullOrEmpty(selectedRegionCode))
    {
        provinces = (await AddressProvider.GetProvincesByRegionCodeAsync(selectedRegionCode)).ToList();
    }
    else
    {
        provinces.Clear();
    }
    selectedProvinceCode = "";
}

protected override async Task OnInitializedAsync()
    {
        try
        {
            User? currentUser = null;

            if (Auth.CurrentUserId > 0)
            {
                currentUser = await DbContext.Users
                    .Include(u => u.Business)
                    .FirstOrDefaultAsync(u => u.UserId == Auth.CurrentUserId);
            }
            else if (!string.IsNullOrWhiteSpace(Auth.CurrentUserEmail))
            {
                var cleanEmail = Auth.CurrentUserEmail.Trim().ToLower();
                currentUser = await DbContext.Users
                    .Include(u => u.Business)
                    .FirstOrDefaultAsync(u => u.Email != null && u.Email.ToLower() == cleanEmail);
            }
            else if (!string.IsNullOrWhiteSpace(Auth.CurrentUserName))
            {
                currentUser = await DbContext.Users
                    .Include(u => u.Business)
                    .FirstOrDefaultAsync(u => (u.FName + " " + u.LName) == Auth.CurrentUserName
                                           || u.FName == Auth.CurrentUserName);
            }

            if (currentUser?.BusinessId != null)
            {
                currentBusinessId = currentUser.BusinessId.Value;
                if (currentUser.Business != null)
                {
                    businessName = currentUser.Business.BusinessName;
                }
            }
            else
            {
                var firstBiz = await DbContext.Businesses.FirstOrDefaultAsync();
                if (firstBiz != null)
                {
                    currentBusinessId = firstBiz.BusinessId;
                    businessName = firstBiz.BusinessName;
                }
            }

            regions = (await AddressProvider.GetRegionsAsync()).ToList();

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            toast = "Error loading page: " + ex.Message;
            toastIsWarning = true;
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            branches = await DbContext.Branches
                .Where(b => b.BusinessId == currentBusinessId)
                .OrderBy(b => b.BranchName)
                .ToListAsync();

            var branchIds = branches.Select(b => b.BranchId).ToList();

            farms = await DbContext.Farms
                .Where(f => branchIds.Contains(f.BranchId))
                .OrderBy(f => f.FarmId)
                .ToListAsync();

            var farmIds = farms.Select(f => f.FarmId).ToList();

            plots = await DbContext.Plots
                .Where(p => farmIds.Contains(p.FarmId))
                .OrderBy(p => p.PlotId)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            toast = "Database load error: " + ex.Message;
            toastIsWarning = true;
        }
    }

    List<Farm> FilteredFarms
    {
        get
        {
            var baseList = farms
                .Where(f =>
                {
                    var isArch = string.Equals(f.Status, "Archived", StringComparison.OrdinalIgnoreCase);
                    return showArchivedFarms ? isArch : !isArch;
                })
                .ToList();

            if (string.IsNullOrWhiteSpace(searchText))
                return baseList;

            return baseList.Where(f =>
                f.FarmName.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                || f.Location.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                || GetBranchName(f.BranchId).Contains(searchText, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)FilteredFarms.Count / pageSize));
    private int StartItem => FilteredFarms.Count == 0 ? 0 : (currentPage - 1) * pageSize + 1;
    private int EndItem => Math.Min(currentPage * pageSize, FilteredFarms.Count);
    private IEnumerable<Farm> PaginatedFarms => FilteredFarms.Skip((currentPage - 1) * pageSize).Take(pageSize);

    List<Stat> Stats
    {
        get
        {
            var activeFarms = farms.Where(f => !string.Equals(f.Status, "Archived", StringComparison.OrdinalIgnoreCase)).ToList();
            var totalArea = activeFarms.Sum(f => f.TotalArea);
            var activeFarmIds = activeFarms.Select(f => f.FarmId).ToHashSet();
            var activePlotsCount = plots.Count(p => activeFarmIds.Contains(p.FarmId) && !string.Equals(p.Status, "Archived", StringComparison.OrdinalIgnoreCase));

            return new()
            {
                new("TOTAL FARMS", activeFarms.Count.ToString(), $"Across {branches.Count} branch(es)", "bi-geo-alt", ""),
                new("TOTAL FARM AREA", totalArea.ToString("0.##", Inv) + " ha", "Combined active farm land", "bi-map", "stat-icon-leaf"),
                new("ACTIVE PLOTS", activePlotsCount.ToString(), "Across active farms", "bi-grid-1x2", "stat-icon-earth"),
            };
        }
    }

    bool FarmNameTaken => !string.IsNullOrWhiteSpace(farmForm.FarmName) &&
        farms.Any(f => f.FarmId != (editingFarmId ?? -1)
            && string.Equals(f.FarmName.Trim(), farmForm.FarmName.Trim(), StringComparison.OrdinalIgnoreCase));

    bool FarmAreaInvalid => !farmAreaInput.HasValue || farmAreaInput.Value <= 0;

    bool PlotNameTaken => !string.IsNullOrWhiteSpace(plotForm.PlotName) &&
        plots.Any(p => p.PlotId != (editingPlotId ?? -1)
            && p.FarmId == plotForm.FarmId
            && string.Equals(p.PlotName.Trim(), plotForm.PlotName.Trim(), StringComparison.OrdinalIgnoreCase));

    bool PlotAreaInvalid => !plotAreaInput.HasValue || plotAreaInput.Value <= 0;

    Farm? GetFarm(int farmId) => farms.FirstOrDefault(f => f.FarmId == farmId);

    string GetBranchName(long? branchId)
    {
        if (branchId == null) return "Unassigned";
        return branches.FirstOrDefault(b => b.BranchId == branchId)?.BranchName ?? "Unassigned";
    }

    static string Cap(string? s) => string.IsNullOrWhiteSpace(s) ? "" : char.ToUpper(s[0]) + s.Substring(1);

    private void GoToPage(int page) => currentPage = page;
    private void PreviousPage() { if (currentPage > 1) currentPage--; }
    private void NextPage() { if (currentPage < TotalPages) currentPage++; }
    private void ResetPagination() => currentPage = 1;

    private async Task ToggleFarmTab(bool archived)
    {
        showArchivedFarms = archived;
        currentPage = 1;
        openFarmMenuId = null;
        await Task.CompletedTask;
    }

    private async Task ToggleFarmMenuAsync(MouseEventArgs e, int farmId)
    {
        if (openFarmMenuId == farmId)
        {
            openFarmMenuId = null;
            return;
        }

        var target = farms.FirstOrDefault(x => x.FarmId == farmId);
        var isArch = target != null && string.Equals(target.Status, "Archived", StringComparison.OrdinalIgnoreCase);

        const double itemHeight = 42;
        const double padding = 16;
        const double menuWidth = 170;
        int itemCount = isArch ? 1 : 3;
        double menuHeight = (itemCount * itemHeight) + padding;

        var viewport = await JS.InvokeAsync<Viewport>("eval", "({ w: window.innerWidth, h: window.innerHeight })");

        menuLeft = Math.Min(e.ClientX - menuWidth + 20, viewport.W - menuWidth - 10);
        menuTop = (e.ClientY + menuHeight > viewport.H) ? e.ClientY - menuHeight - 5 : e.ClientY + 15;

        openFarmMenuId = farmId;
    }

    void CloseMenus() => openFarmMenuId = null;

    private string CapitalizeWords(string? input)
    {
        if (string.IsNullOrWhiteSpace(input)) return input ?? "";
        return CultureInfo.CurrentCulture.TextInfo.ToTitleCase(input.ToLower().Trim());
    }

    void OpenFarmDetails(Farm f)
    {
        selectedFarm = f;
        showPlotsInDetails = false;
        showArchivedPlotsInModal = false;
        showFarmDetailsModal = true;
    }

    void CloseFarmDetailsModal()
    {
        showFarmDetailsModal = false;
        selectedFarm = null;
        showPlotsInDetails = false;
    }

    void ToggleViewPlotsInModal() => showPlotsInDetails = !showPlotsInDetails;

void OpenNewFarm()
{
    openFarmMenuId = null;
    farmForm = new Farm
    {
        BranchId = branches.FirstOrDefault()?.BranchId ?? 0,
        AreaUnit = "Hectares",
        Status = "Active"
    };
    farmAreaInput = null;
    selectedRegionCode = "";
    selectedProvinceCode = "";
    provinces.Clear();
    locationDetail = "";
    editingFarmId = null;
    showFarmErrors = false;
    showFarmModal = true;
}

void OpenEditFarm(Farm f)
{
    showFarmDetailsModal = false;
    openFarmMenuId = null;
    farmForm = new Farm
    {
        FarmId = f.FarmId,
        BranchId = f.BranchId,
        FarmName = f.FarmName,
        Location = f.Location,
        TotalArea = f.TotalArea,
        AreaUnit = f.AreaUnit,
        Status = f.Status
    };
    farmAreaInput = (double)f.TotalArea;
    selectedRegionCode = "";
    selectedProvinceCode = "";
    provinces.Clear();
    locationDetail = f.Location ?? "";
    editingFarmId = f.FarmId;
    showFarmErrors = false;
    showFarmModal = true;
}

    void CloseFarmModal() => showFarmModal = false;

    void PromptSaveFarm()
    {
        showFarmErrors = true;
        if (string.IsNullOrWhiteSpace(farmForm.FarmName) || farmForm.BranchId <= 0 || FarmNameTaken || FarmAreaInvalid)
            return;

        showConfirmSaveFarmModal = true;
    }

    void CancelSaveFarmConfirm() => showConfirmSaveFarmModal = false;

async Task ConfirmSaveFarmAsync()
    {
        isSaving = true;
        try
        {
            var selectedProvName = provinces.FirstOrDefault(p => p.Code == selectedProvinceCode)?.Name;
            var cleanLocDetail = CapitalizeWords(locationDetail).Trim();
            var finalLocation = !string.IsNullOrWhiteSpace(selectedProvName) && !string.IsNullOrWhiteSpace(cleanLocDetail)
                ? $"{cleanLocDetail}, {selectedProvName}"
                : (!string.IsNullOrWhiteSpace(cleanLocDetail) ? cleanLocDetail : (selectedProvName ?? ""));

            var areaVal = Convert.ToDecimal(farmAreaInput ?? 0, Inv);
            if (editingFarmId == null)
            {
                var created = new Farm
                {
                    BranchId = farmForm.BranchId,
                    FarmName = farmForm.FarmName.Trim(),
                    Location = finalLocation,
                    TotalArea = areaVal,
                    AreaUnit = "Hectares",
                    Status = "Active"
                };
                DbContext.Farms.Add(created);
                await DbContext.SaveChangesAsync();
                await ShowToast("Farm registered successfully.");
            }
            else
            {
                var existing = await DbContext.Farms.FindAsync(editingFarmId.Value);
                if (existing != null)
                {
                    existing.FarmName = farmForm.FarmName.Trim();
                    existing.BranchId = farmForm.BranchId;
                    existing.Location = finalLocation;
                    existing.TotalArea = areaVal;
                    DbContext.Farms.Update(existing);
                    await DbContext.SaveChangesAsync();
                    await ShowToast("Farm details updated.");
                }
            }

            showConfirmSaveFarmModal = false;
            showFarmModal = false;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            await ShowToast("Error saving farm: " + ex.Message, isWarning: true);
        }
        finally
        {
            isSaving = false;
        }
    }

    void PromptArchiveFarm(Farm f)
    {
        openFarmMenuId = null;
        var hasActivePlots = plots.Any(p => p.FarmId == f.FarmId && !string.Equals(p.Status, "Archived", StringComparison.OrdinalIgnoreCase));
        if (hasActivePlots)
        {
            _ = ShowToast(f.FarmName + " still has active plots. Archive or reassign its plots first.", isWarning: true);
            return;
        }
        farmToArchive = f;
        showConfirmArchiveFarmModal = true;
    }

    void CancelArchiveFarmConfirm()
    {
        showConfirmArchiveFarmModal = false;
        farmToArchive = null;
    }

    async Task ConfirmArchiveFarmAsync()
    {
        if (farmToArchive == null) return;
        isSaving = true;
        try
        {
            var existing = await DbContext.Farms.FindAsync(farmToArchive.FarmId);
            if (existing != null)
            {
                existing.Status = "Archived";
                DbContext.Farms.Update(existing);
                await DbContext.SaveChangesAsync();
                await ShowToast($"{farmToArchive.FarmName} moved to Archived.");
            }

            showConfirmArchiveFarmModal = false;
            farmToArchive = null;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            await ShowToast("Error archiving farm: " + ex.Message, isWarning: true);
        }
        finally
        {
            isSaving = false;
        }
    }

    async Task RestoreFarmAsync(Farm f)
    {
        openFarmMenuId = null;
        var existing = await DbContext.Farms.FindAsync(f.FarmId);
        if (existing != null)
        {
            existing.Status = "Active";
            DbContext.Farms.Update(existing);
            await DbContext.SaveChangesAsync();
            await ShowToast($"{f.FarmName} restored.");
        }

        await LoadDataAsync();
    }

    // ---------- PLOT ACTIONS ----------
    void OpenNewPlotForFarm(Farm f)
    {
        openFarmMenuId = null;
        plotForm = new Plot
        {
            FarmId = f.FarmId,
            IrrigationType = "rainfed",
            Status = "Vacant"
        };
        plotAreaInput = null;
        editingPlotId = null;
        showPlotErrors = false;
        showPlotModal = true;
    }

    void OpenEditPlot(Plot p)
    {
        plotForm = new Plot
        {
            PlotId = p.PlotId,
            FarmId = p.FarmId,
            PlotName = p.PlotName,
            PlotArea = p.PlotArea,
            SoilType = p.SoilType,
            IrrigationType = string.IsNullOrWhiteSpace(p.IrrigationType) ? "rainfed" : p.IrrigationType,
            CurrentCrop = p.CurrentCrop,
            Status = p.Status
        };
        plotAreaInput = (double)p.PlotArea;
        editingPlotId = p.PlotId;
        showPlotErrors = false;
        showPlotModal = true;
    }

    void ClosePlotModal() => showPlotModal = false;

    void PromptSavePlot()
    {
        showPlotErrors = true;
        if (plotForm.FarmId <= 0 || string.IsNullOrWhiteSpace(plotForm.PlotName) || PlotNameTaken || PlotAreaInvalid)
            return;

        showConfirmSavePlotModal = true;
    }

    void CancelSavePlotConfirm() => showConfirmSavePlotModal = false;

    async Task ConfirmSavePlotAsync()
    {
        isSaving = true;
        try
        {
            plotForm.PlotName = plotForm.PlotName.Trim();
            plotForm.SoilType = (plotForm.SoilType ?? "").Trim();
            plotForm.PlotArea = Convert.ToDecimal(plotAreaInput ?? 0, Inv);

            if (editingPlotId == null)
            {
                var entity = new Plot
                {
                    FarmId = plotForm.FarmId,
                    PlotName = plotForm.PlotName,
                    PlotArea = plotForm.PlotArea,
                    SoilType = plotForm.SoilType,
                    IrrigationType = plotForm.IrrigationType,
                    CurrentCrop = "",
                    Status = plotForm.Status
                };
                DbContext.Plots.Add(entity);
                await DbContext.SaveChangesAsync();
                await ShowToast("Plot added successfully.");
            }
            else
            {
                var existing = await DbContext.Plots.FindAsync(editingPlotId.Value);
                if (existing != null)
                {
                    existing.PlotName = plotForm.PlotName;
                    existing.PlotArea = plotForm.PlotArea;
                    existing.SoilType = plotForm.SoilType;
                    existing.IrrigationType = plotForm.IrrigationType;
                    existing.Status = plotForm.Status;
                    DbContext.Plots.Update(existing);
                    await DbContext.SaveChangesAsync();
                    await ShowToast("Plot details updated.");
                }
            }

            showConfirmSavePlotModal = false;
            showPlotModal = false;
            showPlotsInDetails = true;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            await ShowToast("Error saving plot: " + ex.Message, isWarning: true);
        }
        finally
        {
            isSaving = false;
        }
    }

    void PromptArchivePlot(Plot p)
    {
        if (!string.IsNullOrWhiteSpace(p.CurrentCrop))
        {
            _ = ShowToast(p.PlotName + " still has an active crop cycle. Clear the cycle first before archiving.", isWarning: true);
            return;
        }
        plotToArchive = p;
        showConfirmArchivePlotModal = true;
    }

    void CancelArchivePlotConfirm()
    {
        showConfirmArchivePlotModal = false;
        plotToArchive = null;
    }

    async Task ConfirmArchivePlotAsync()
    {
        if (plotToArchive == null) return;
        isSaving = true;
        try
        {
            var existing = await DbContext.Plots.FindAsync(plotToArchive.PlotId);
            if (existing != null)
            {
                existing.Status = "Archived";
                DbContext.Plots.Update(existing);
                await DbContext.SaveChangesAsync();
                await ShowToast($"{plotToArchive.PlotName} moved to Archived.");
            }

            showConfirmArchivePlotModal = false;
            plotToArchive = null;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            await ShowToast("Error archiving plot: " + ex.Message, isWarning: true);
        }
        finally
        {
            isSaving = false;
        }
    }

    async Task RestorePlotAsync(Plot p)
    {
        var existing = await DbContext.Plots.FindAsync(p.PlotId);
        if (existing != null)
        {
            existing.Status = "Vacant";
            DbContext.Plots.Update(existing);
            await DbContext.SaveChangesAsync();
            await ShowToast($"{p.PlotName} restored.");
        }

        await LoadDataAsync();
    }

    async Task ShowToast(string message, bool isWarning = false)
    {
        toast = message;
        toastIsWarning = isWarning;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(3200);
        toast = "";
        await InvokeAsync(StateHasChanged);
    }
}