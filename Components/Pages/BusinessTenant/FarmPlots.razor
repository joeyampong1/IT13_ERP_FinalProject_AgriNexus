@page "/farms"
@layout MainLayout
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Web
@using AgriNexus.DataLayer
@using AgriNexus.DataLayer.Models
@inject AgriNexusDbContext DbContext
@inject AgriNexus.Services.AuthService Auth
@inject IJSRuntime JS
@using Russkyc.Addressess.Philippines
@using Russkyc.Addressess.Philippines.Entities

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="page-title">Farm and Plot Management</h2>
        <p class="text-muted mb-0 page-sub">
            <i class="bi bi-building text-success me-1"></i><strong>@businessName</strong> · manage farms, land area, and plots per farm.
        </p>
    </div>
    <span class="badge rounded-pill px-3 py-2 fw-semibold" style="background-color: #E8F3EC; color: #1B5E34; border: 1px solid #C6DFCE;">
        <i class="bi bi-map me-1"></i> Farm &amp; Plot Directory
    </span>
</div>

<!-- STAT CARDS -->
<div class="row g-3 mb-4">
    @foreach (var s in Stats)
    {
        <div class="col-12 col-md-4">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <span class="card-title">@s.Title</span>
                    <div class="stat-icon @s.IconClass"><i class="bi @s.Icon"></i></div>
                </div>
                <div class="mt-3">
                    <div class="card-value">@s.Value</div>
                    @if (!string.IsNullOrEmpty(s.Note))
                    {
                        <div class="text-muted small mt-1">@s.Note</div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- TOOLBAR WITH TABS -->
<div class="toolbar mb-3 d-flex flex-wrap align-items-center gap-3">

    <!-- ACTIVE / ARCHIVED FARM TABS -->
    <div class="btn-group shadow-sm" role="group" aria-label="Farm View Tabs">
        <input type="radio" class="btn-check" name="farmViewTabs" id="tabFarmActive" autocomplete="off"
               checked="@(!showArchivedFarms)" @onchange="() => ToggleFarmTab(false)">
        <label class="btn btn-outline-success fw-bold" for="tabFarmActive">
            <i class="bi bi-check-circle me-1"></i> Active
        </label>

        <input type="radio" class="btn-check" name="farmViewTabs" id="tabFarmArchived" autocomplete="off"
               checked="@showArchivedFarms" @onchange="() => ToggleFarmTab(true)">
        <label class="btn btn-outline-secondary fw-bold" for="tabFarmArchived">
            <i class="bi bi-archive me-1"></i> Archived
        </label>
    </div>

    <!-- SEARCH BOX -->
    <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="text" placeholder="Search farms or branches..."
               @bind="searchText"
               @bind:event="oninput"
               @bind:after="ResetPagination" />
    </div>

    <span class="badge rounded-pill px-3 py-2 fw-semibold count-label" style="background-color: #FFFFFF; color: #0A2B1D; border: 1px solid #E2ECE6;">
        <i class="bi bi-geo-alt me-1 text-success"></i>@FilteredFarms.Count @(FilteredFarms.Count == 1 ? "farm" : "farms")
    </span>

    <!-- NEW FARM BUTTON -->
    <button type="button" class="btn-new ms-auto shadow-sm" @onclick="OpenNewFarm">
        <i class="bi bi-plus-lg"></i> New farm
    </button>
</div>

<!-- FARMS TABLE -->
<div class="panel shadow-sm bg-white d-flex flex-column" style="border-radius: 16px; border: 1px solid #E2ECE6; max-height: calc(100vh - 280px); overflow: hidden;">

    <div class="table-responsive" style="flex-grow: 1; overflow-y: auto;">
        <table class="table table-hover align-middle mb-0 biz-table" style="width: 100%;">
            <thead style="position: sticky; top: 0; z-index: 1; background-color: #F7FAF8;">
                <tr>
                    <th class="text-muted small fw-bold text-uppercase py-3 px-4">Farm</th>
                    <th class="text-muted small fw-bold text-uppercase py-3">Branch</th>
                    <th class="text-muted small fw-bold text-uppercase py-3">Location</th>
                    <th class="text-muted small fw-bold text-uppercase py-3">Total Area</th>
                    <th class="text-muted small fw-bold text-uppercase py-3">Plots</th>
                    <th class="text-muted small fw-bold text-uppercase py-3">Status</th>
                    <th class="py-3"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in PaginatedFarms)
                {
                    var isArch = string.Equals(f.Status, "Archived", StringComparison.OrdinalIgnoreCase);
                    var plotCount = plots.Count(p => p.FarmId == f.FarmId && !string.Equals(p.Status, "Archived", StringComparison.OrdinalIgnoreCase));

                    <tr style="cursor: pointer;" @onclick="() => OpenFarmDetails(f)">
                        <td class="px-4">
                            <div class="d-flex align-items-center gap-3">
                                <div class="branch-avatar">
                                    <i class="bi bi-geo-alt"></i>
                                </div>
                                <div>
                                    <div class="fw-bold" style="color: #0A2B1D;">@f.FarmName</div>
                                    <div class="text-muted small mt-1">
                                        <span class="fw-semibold" style="color: #1B5E34;">Farm #@f.FarmId</span>
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td class="fw-semibold text-dark">@GetBranchName(f.BranchId)</td>
                        <td class="text-dark fw-medium">
                            @(string.IsNullOrWhiteSpace(f.Location) ? "—" : f.Location)
                        </td>
                        <td class="text-nowrap fw-semibold text-dark">
                            @f.TotalArea.ToString("0.##", Inv) @f.AreaUnit
                        </td>
                        <td class="fw-semibold text-dark">@plotCount</td>
                        <td>
                            <span class="pill @(isArch ? "pill-earth" : "pill-forest")">
                                <i class="bi @(isArch ? "bi-archive" : "bi-check-circle") me-1"></i>@Cap(f.Status)
                            </span>
                        </td>
                        <td class="text-end px-4 action-cell">
                            <button type="button" class="btn-dots"
                                    @onclick="(e) => ToggleFarmMenuAsync(e, f.FarmId)"
                                    @onclick:stopPropagation="true" aria-label="Actions">
                                <i class="bi bi-three-dots"></i>
                            </button>
                        </td>
                    </tr>
                }
                @if (FilteredFarms.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">
                            <i class="bi bi-inbox fs-3 d-block mb-2 opacity-50"></i>
                            @(showArchivedFarms ? "No archived farms found." : "No farms found.")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- PAGINATION FOOTER -->
    @if (FilteredFarms.Count > 0)
    {
        <div class="d-flex flex-wrap justify-content-between align-items-center p-3 border-top bg-white" style="flex-shrink: 0; border-color: #E2ECE6 !important; border-radius: 0 0 16px 16px;">
            <div class="text-muted small mb-2 mb-md-0">
                Showing <span class="fw-bold" style="color: #0A2B1D;">@StartItem</span> - <span class="fw-bold" style="color: #0A2B1D;">@EndItem</span> of <span class="fw-bold" style="color: #0A2B1D;">@FilteredFarms.Count</span> farms
            </div>

            <div class="d-flex gap-1">
                <button class="btn btn-sm btn-light border px-3 rounded-2 fw-medium" @onclick="PreviousPage" disabled="@(currentPage == 1)">
                    <i class="bi bi-chevron-left me-1"></i>Previous
                </button>

                @for (int i = 1; i <= TotalPages; i++)
                {
                    var pageNumber = i;
                    <button class="btn btn-sm px-3 rounded-2 fw-bold @(currentPage == pageNumber ? "btn-new text-white shadow-sm" : "btn-light border text-dark")"
                            @onclick="() => GoToPage(pageNumber)">
                        @pageNumber
                    </button>
                }

                <button class="btn btn-sm btn-light border px-3 rounded-2 fw-medium" @onclick="NextPage" disabled="@(currentPage == TotalPages)">
                    Next<i class="bi bi-chevron-right ms-1"></i>
                </button>
            </div>
        </div>
    }
</div>

<!-- FLOATING FARM ACTION MENU (Edit, + Plots, Archive / Restore) -->
@if (openFarmMenuId != null)
{
    var menuFarm = farms.FirstOrDefault(x => x.FarmId == openFarmMenuId);
    if (menuFarm != null)
    {
        var isArch = string.Equals(menuFarm.Status, "Archived", StringComparison.OrdinalIgnoreCase);

        <div class="menu-backdrop" @onclick="CloseMenus" @onclick:stopPropagation="true"></div>

        <div class="vertical-action-menu shadow-lg" style="top:@(menuTop)px; left:@(menuLeft)px;">
            @if (!isArch)
            {
                <button type="button" class="action-item"
                        @onclick="() => OpenEditFarm(menuFarm)"
                        @onclick:stopPropagation="true">
                    <i class="bi bi-pencil-square text-success"></i> Edit
                </button>
                <button type="button" class="action-item"
                        @onclick="() => OpenNewPlotForFarm(menuFarm)"
                        @onclick:stopPropagation="true">
                    <i class="bi bi-plus-lg text-success"></i> Plots
                </button>
                <button type="button" class="action-item text-earth"
                        @onclick="() => PromptArchiveFarm(menuFarm)"
                        @onclick:stopPropagation="true">
                    <i class="bi bi-archive"></i> Archive
                </button>
            }
            else
            {
                <button type="button" class="action-item text-success"
                        @onclick="() => RestoreFarmAsync(menuFarm)"
                        @onclick:stopPropagation="true">
                    <i class="bi bi-arrow-counterclockwise"></i> Restore
                </button>
            }
        </div>
    }
}

<!-- FARM DETAILS MODAL (WITH "VIEW PLOTS" BUTTON & PLOTS TABLE) -->
@if (showFarmDetailsModal && selectedFarm != null)
{
    var detBranch = GetBranchName(selectedFarm.BranchId);
    var detArch = string.Equals(selectedFarm.Status, "Archived", StringComparison.OrdinalIgnoreCase);
    var farmPlotsAll = plots.Where(p => p.FarmId == selectedFarm.FarmId).ToList();
    var farmPlotsActive = farmPlotsAll.Where(p => !string.Equals(p.Status, "Archived", StringComparison.OrdinalIgnoreCase)).ToList();
    var farmPlotsArchived = farmPlotsAll.Where(p => string.Equals(p.Status, "Archived", StringComparison.OrdinalIgnoreCase)).ToList();
    var displayedFarmPlots = showArchivedPlotsInModal ? farmPlotsArchived : farmPlotsActive;

    <div class="modal fade show d-block" style="background-color: rgba(10, 43, 29, 0.65); backdrop-filter: blur(5px); z-index: 1050;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-xl" @onclick:stopPropagation="true">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="modal-header border-0 p-4 d-flex justify-content-between align-items-center" style="background-color: #F4F7F5;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; background-color: #E8F3EC; color: #1B5E34;">
                            <i class="bi bi-geo-alt fs-4"></i>
                        </div>
                        <div>
                            <h4 class="modal-title fw-bolder mb-0" style="color: #0A2B1D;">@selectedFarm.FarmName</h4>
                            <span class="badge px-2 py-1 mt-1 rounded-pill" style="background-color: #FFFFFF; color: #1B5E34; border: 1px solid #C6DFCE;">
                                <i class="bi bi-shop me-1"></i>@detBranch
                            </span>
                        </div>
                    </div>
                    <button type="button" class="btn-close bg-white shadow-sm rounded-circle p-2" @onclick="CloseFarmDetailsModal" aria-label="Close" style="width: 32px; height: 32px;"></button>
                </div>

                <div class="modal-body p-4" style="max-height: 72vh; overflow-y: auto;">
                    <!-- Farm Info -->
                    <div class="mb-4">
                        <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                            <i class="bi bi-info-circle me-2 text-success"></i>Farm Details
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="text-muted small fw-bold text-uppercase">Location</label>
                                <p class="mb-0 fw-semibold fs-6 text-dark">
                                    @(string.IsNullOrWhiteSpace(selectedFarm.Location) ? "Not specified" : selectedFarm.Location)
                                </p>
                            </div>
                            <div class="col-md-4">
                                <label class="text-muted small fw-bold text-uppercase">Total Area</label>
                                <p class="mb-0 fw-semibold fs-6 text-dark">
                                    @selectedFarm.TotalArea.ToString("0.##", Inv) @selectedFarm.AreaUnit
                                </p>
                            </div>
                            <div class="col-md-4">
                                <label class="text-muted small fw-bold text-uppercase d-block mb-1">Status</label>
                                <span class="pill @(detArch ? "pill-earth" : "pill-forest")">
                                    <i class="bi @(detArch ? "bi-archive" : "bi-check-circle") me-1"></i>@Cap(selectedFarm.Status)
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Summary + View Plots Button -->
                    <div class="p-4 rounded-4 mb-4" style="background-color: #F7FAF8; border: 1px dashed #C6DFCE;">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 border-bottom pb-2">
                            <h6 class="text-uppercase text-muted fw-bold mb-0" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                                <i class="bi bi-grid-1x2 me-2 text-success"></i>Plots Summary
                            </h6>
                            <div class="d-flex gap-2">
                                @if (!detArch)
                                {
                                    <button type="button" class="btn btn-sm btn-light border fw-bold px-3 rounded-3" @onclick="() => OpenNewPlotForFarm(selectedFarm)">
                                        <i class="bi bi-plus-lg me-1 text-success"></i>Add Plot
                                    </button>
                                }
                                <button type="button" class="btn-save btn-sm px-3 rounded-3" @onclick="ToggleViewPlotsInModal">
                                    <i class="bi @(showPlotsInDetails ? "bi-eye-slash" : "bi-eye") me-1"></i>
                                    @(showPlotsInDetails ? "Hide Plots" : $"View Plots ({farmPlotsActive.Count})")
                                </button>
                            </div>
                        </div>

                        <div class="row g-3 text-center">
                            <div class="col-6">
                                <div class="p-3 bg-white rounded-3 border" style="border-color: #E2ECE6 !important;">
                                    <h4 class="fw-bolder mb-0" style="color: #1B5E34;">@farmPlotsActive.Count</h4>
                                    <small class="text-muted fw-medium">Active Plots</small>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 bg-white rounded-3 border" style="border-color: #E2ECE6 !important;">
                                    <h4 class="fw-bolder mb-0" style="color: #7A5230;">@farmPlotsArchived.Count</h4>
                                    <small class="text-muted fw-medium">Archived Plots</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- PLOTS TABLE INSIDE DETAILS MODAL (WHEN "VIEW PLOTS" IS CLICKED) -->
                    @if (showPlotsInDetails)
                    {
                        <div class="border rounded-4 p-3 bg-white" style="border-color: #E2ECE6 !important;">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                                <h6 class="fw-bold mb-0" style="color: #0A2B1D;">
                                    <i class="bi bi-map me-1 text-success"></i>Plots under @selectedFarm.FarmName
                                </h6>

                                <!-- ACTIVE / ARCHIVED PLOTS TABS -->
                                <div class="btn-group btn-group-sm" role="group" aria-label="Plot Status Tabs">
                                    <input type="radio" class="btn-check" name="modalPlotTabs" id="modalPlotActive" autocomplete="off"
                                           checked="@(!showArchivedPlotsInModal)" @onchange="() => showArchivedPlotsInModal = false">
                                    <label class="btn btn-outline-success fw-bold" for="modalPlotActive">
                                        <i class="bi bi-check-circle me-1"></i>Active (@farmPlotsActive.Count)
                                    </label>

                                    <input type="radio" class="btn-check" name="modalPlotTabs" id="modalPlotArchived" autocomplete="off"
                                           checked="@showArchivedPlotsInModal" @onchange="() => showArchivedPlotsInModal = true">
                                    <label class="btn btn-outline-secondary fw-bold" for="modalPlotArchived">
                                        <i class="bi bi-archive me-1"></i>Archived (@farmPlotsArchived.Count)
                                    </label>
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0 biz-table">
                                    <thead style="background-color: #F7FAF8;">
                                        <tr>
                                            <th class="text-muted small fw-bold text-uppercase py-2">Plot</th>
                                            <th class="text-muted small fw-bold text-uppercase py-2">Area</th>
                                            <th class="text-muted small fw-bold text-uppercase py-2">Irrigation</th>
                                            <th class="text-muted small fw-bold text-uppercase py-2">Current Crop</th>
                                            <th class="text-muted small fw-bold text-uppercase py-2">Status</th>
                                            <th class="text-end text-muted small fw-bold text-uppercase py-2">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in displayedFarmPlots)
                                        {
                                            var pArch = string.Equals(p.Status, "Archived", StringComparison.OrdinalIgnoreCase);
                                            <tr>
                                                <td>
                                                    <div class="fw-bold" style="color: #0A2B1D;">@p.PlotName</div>
                                                    <div class="text-muted small">@(string.IsNullOrWhiteSpace(p.SoilType) ? "—" : p.SoilType)</div>
                                                </td>
                                                <td class="fw-semibold text-dark">@p.PlotArea.ToString("0.##", Inv) @selectedFarm.AreaUnit</td>
                                                <td class="text-dark">@(string.IsNullOrWhiteSpace(p.IrrigationType) ? "—" : Cap(p.IrrigationType))</td>
                                                <td>
                                                    @if (!string.IsNullOrWhiteSpace(p.CurrentCrop))
                                                    {
                                                        <span class="fw-semibold text-dark">@p.CurrentCrop</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">No active cycle</span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="pill @(pArch ? "pill-earth" : "pill-forest")">
                                                        <i class="bi @(pArch ? "bi-archive" : "bi-check-circle") me-1"></i>@Cap(p.Status)
                                                    </span>
                                                </td>
                                                <td class="text-end">
                                                    <div class="d-inline-flex gap-1">
                                                        @if (!pArch)
                                                        {
                                                            <button type="button" class="btn btn-sm btn-light border rounded-2 fw-semibold"
                                                                    @onclick="() => OpenEditPlot(p)">
                                                                <i class="bi bi-pencil-square text-success me-1"></i>Edit
                                                            </button>
                                                            <button type="button" class="btn btn-sm btn-light border rounded-2 fw-semibold" style="color: #7A5230;"
                                                                    @onclick="() => PromptArchivePlot(p)">
                                                                <i class="bi bi-archive me-1"></i>Archive
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button type="button" class="btn btn-sm btn-light border rounded-2 fw-semibold text-success"
                                                                    @onclick="() => RestorePlotAsync(p)">
                                                                <i class="bi bi-arrow-counterclockwise me-1"></i>Restore
                                                            </button>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                        @if (displayedFarmPlots.Count == 0)
                                        {
                                            <tr>
                                                <td colspan="6" class="text-center text-muted py-4">
                                                    @(showArchivedPlotsInModal ? "No archived plots for this farm." : "No active plots for this farm.")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>

                <!-- Footer -->
                <div class="modal-footer border-0 p-4 d-flex justify-content-between" style="background-color: #F4F7F5;">
                    <button type="button" class="btn btn-light border fw-bold px-4 rounded-3 shadow-sm" @onclick="CloseFarmDetailsModal">Close</button>
                    @if (!detArch)
                    {
                        <button type="button" class="btn-save px-5 shadow-sm" @onclick="() => OpenEditFarm(selectedFarm)">
                            <i class="bi bi-pencil-square me-2"></i>Edit Farm
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- ADD / EDIT FARM MODAL -->
@if (showFarmModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(10, 43, 29, 0.65); backdrop-filter: blur(5px); z-index: 1050;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation="true">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

                <div class="modal-header border-0 p-4" style="background-color: #F4F7F5;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; background-color: #E8F3EC; color: #1B5E34;">
                            <i class="bi @(editingFarmId == null ? "bi-geo-alt" : "bi-pencil-square") fs-5"></i>
                        </div>
                        <div>
                            <h4 class="modal-title fw-bolder mb-0" style="color: #0A2B1D;">
                                @(editingFarmId == null ? "Register New Farm" : "Edit Farm Details")
                            </h4>
                            <p class="text-muted small mb-0">Fill in the farm information below to @(editingFarmId == null ? "create a new farm" : "update the farm").</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close bg-white shadow-sm rounded-circle p-2" @onclick="CloseFarmModal" aria-label="Close" style="width: 32px; height: 32px;"></button>
                </div>

                <div class="modal-body p-4" style="max-height: 70vh; overflow-y: auto;">
                    <form>
                        <div class="mb-4">
                            <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                                <i class="bi bi-geo-alt me-2 text-success"></i>Farm Identification
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Farm Name <span class="text-danger">*</span></label>
                                    <input class="form-control @(showFarmErrors && (string.IsNullOrWhiteSpace(farmForm.FarmName) || FarmNameTaken) ? "border-danger" : "")"
                                           placeholder="e.g. North Gate Farm"
                                           @bind="farmForm.FarmName"
                                           @bind:after="() => farmForm.FarmName = CapitalizeWords(farmForm.FarmName)" />
                                    @if (showFarmErrors && string.IsNullOrWhiteSpace(farmForm.FarmName))
                                    {
                                        <div class="err">Farm name is required.</div>
                                    }
                                    @if (showFarmErrors && FarmNameTaken)
                                    {
                                        <div class="err">This farm name is already used.</div>
                                    }
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Branch <span class="text-danger">*</span></label>
                                    <select class="form-select @(showFarmErrors && farmForm.BranchId <= 0 ? "border-danger" : "")" @bind="farmForm.BranchId">
                                        <option value="0">-- Select Branch --</option>
                                        @foreach (var b in branches)
                                        {
                                            <option value="@b.BranchId">@b.BranchName</option>
                                        }
                                    </select>
                                    @if (showFarmErrors && farmForm.BranchId <= 0)
                                    {
                                        <div class="err">Please select a branch.</div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="p-4 rounded-4" style="background-color: #F7FAF8; border: 1px dashed #C6DFCE;">
                            <h6 class="text-uppercase text-muted fw-bold mb-3 border-bottom pb-2" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                                <i class="bi bi-sliders me-2 text-success"></i>Location &amp; Land Area
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Total Area (ha) <span class="text-danger">*</span></label>
                                    <input type="number" min="0" step="0.1" class="form-control border-0 shadow-sm @(showFarmErrors && FarmAreaInvalid ? "border border-danger" : "")"
                                           @bind="farmAreaInput" />
                                    @if (showFarmErrors && FarmAreaInvalid)
                                    {
                                        <div class="err">Total area must be greater than 0.</div>
                                    }
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Region</label>
                                    <select class="form-select border-0 shadow-sm" @bind="selectedRegionCode" @bind:after="OnRegionChanged">
                                        <option value="">Select Region...</option>
                                        @foreach (var r in regions)
                                        {
                                            <option value="@r.Code">@r.Name</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Province</label>
                                    <select class="form-select border-0 shadow-sm" @bind="selectedProvinceCode">
                                        <option value="">Select Province...</option>
                                        @foreach (var p in provinces)
                                        {
                                            <option value="@p.Code">@p.Name</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-12 mt-3">
                                    <label class="form-label fw-bold small text-muted">Barangay / Sitio / Specific Location</label>
                                    <input class="form-control border-0 shadow-sm" placeholder="e.g. Barangay Labugon"
                                           @bind="locationDetail"
                                           @bind:after="() => locationDetail = CapitalizeWords(locationDetail)" />
                                </div>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="modal-footer border-0 p-4 d-flex justify-content-end gap-2" style="background-color: #F4F7F5;">
                    <button type="button" class="btn btn-light border fw-bold px-4 rounded-3 shadow-sm" @onclick="CloseFarmModal">Cancel</button>
                    <button type="button" class="btn-save px-5 shadow-sm" @onclick="PromptSaveFarm" disabled="@isSaving">
                        <i class="bi bi-check2 me-2"></i>
                        <span>@(editingFarmId == null ? "Save Farm" : "Update Farm")</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

