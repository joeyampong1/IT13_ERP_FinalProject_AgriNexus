@page "/farms"
@using System.Globalization

<div class="mb-4">
    <h2 class="page-title">Farm and Plot Management</h2>
    <p class="text-muted mb-0 page-sub">@ActiveBranch · total land, irrigation, soil and current crop per plot.</p>
</div>

<!-- STAT CARDS -->
<div class="row g-3 mb-4">
    @foreach (var s in Stats)
    {
        <div class="col-12 col-md-4">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <span class="card-title">@s.Title</span>
                    <div class="stat-icon @s.IconClass"><i class="bi @s.Icon"></i></div>
                </div>
                <div class="mt-3">
                    <div class="card-value">@s.Value</div>
                    <div class="text-muted small mt-1">@s.Note</div>
                </div>
            </div>
        </div>
    }
</div>

<!-- TOOLBAR -->
<div class="toolbar mb-3">
    <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="text" placeholder="Search plots..." @bind="searchText" @bind:event="oninput" />
    </div>
    <span class="text-muted small">@Filtered.Count @(Filtered.Count == 1 ? "plot" : "plots")</span>
    <button type="button" class="btn-new ms-auto" @onclick="OpenNew">
        <i class="bi bi-plus-lg"></i> New plot
    </button>
</div>

<!-- TABLE -->
<div class="panel">
    <div class="table-wrap">
        <table class="table data-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Plot</th>
                    <th>Branch</th>
                    <th>Area (ha)</th>
                    <th>Irrigation</th>
                    <th>Current crop</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Filtered)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@p.Name</div>
                            <div class="sub">@(string.IsNullOrWhiteSpace(p.Soil) ? "—" : p.Soil)</div>
                        </td>
                        <td>@p.Branch</td>
                        <td>@p.Area.ToString("0.##", Inv)</td>
                        <td>@Cap(p.Irrigation)</td>
                        <td>
                            @if (HasCrop(p))
                            {
                                <span>@p.Crop · @p.Variety</span>
                            }
                            else
                            {
                                <span class="muted">No active cycle</span>
                            }
                        </td>
                        <td><span class="pill @StatusClass(p.Status)">@Cap(p.Status)</span></td>
                        <td class="text-end action-cell">
                            <button type="button" class="btn-dots" @onclick="() => ToggleMenu(p.Id)" aria-label="Actions">
                                <i class="bi bi-three-dots"></i>
                            </button>
                            @if (openMenuId == p.Id)
                            {
                                <div class="menu-backdrop" @onclick="CloseMenu"></div>
                                <div class="row-menu">
                                    <button type="button" class="row-menu-item" @onclick="() => OpenEdit(p)">
                                        <i class="bi bi-pencil"></i> Edit
                                    </button>
                                    <button type="button" class="row-menu-item text-danger" @onclick="() => Delete(p)">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </div>
                            }
                        </td>
                    </tr>
                }
                @if (Filtered.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-5">No plots found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL -->
@if (showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <h5 class="modal-heading mb-0">@(editingId == null ? "New plot" : "Edit plot")</h5>
                <button type="button" class="btn-close-x" @onclick="CloseModal" aria-label="Close"><i class="bi bi-x-lg"></i></button>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Plot name <span class="req">*</span></label>
                    <input class="form-control @(showErrors && string.IsNullOrWhiteSpace(form.Name) ? "is-invalid" : "")" @bind="form.Name" />
                    @if (showErrors && string.IsNullOrWhiteSpace(form.Name))
                    {
                        <div class="err">Plot name is required.</div>
                    }
                    @if (showErrors && NameTaken)
                    {
                        <div class="err">This plot name is already used.</div>
                    }
                </div>
                <div class="col-md-6">
                    <label class="form-label">Area (hectares)</label>
                    <input type="number" min="0" step="0.1" class="form-control @(showErrors && AreaInvalid ? "is-invalid" : "")" @bind="areaInput" />
                    @if (showErrors && AreaInvalid)
                    {
                        <div class="err">Area can’t be negative.</div>
                    }
                </div>

                <div class="col-md-6">
                    <label class="form-label">Soil type</label>
                    <input class="form-control" placeholder="Clay loam" @bind="form.Soil" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Irrigation</label>
                    <select class="form-select" @bind="form.Irrigation">
                        @foreach (var i in IrrigationOptions)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Status</label>
                    <select class="form-select" @bind="form.Status">
                        @foreach (var s in StatusOptions)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Branch</label>
                    <select class="form-select" @bind="form.Branch">
                        @foreach (var b in branchNames)
                        {
                            <option value="@b">@b</option>
                        }
                    </select>
                </div>

                <div class="col-12">
                    <label class="form-label">Notes</label>
                    <textarea class="form-control" rows="3" @bind="form.Notes"></textarea>
                </div>
            </div>

            <div class="d-flex justify-content-end align-items-center gap-3 mt-4">
                <button type="button" class="btn-cancel" @onclick="CloseModal">Cancel</button>
                <button type="button" class="btn-save" @onclick="Save">Save</button>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(toast))
{
    <div class="toast-note"><i class="bi bi-info-circle-fill"></i> @toast</div>
}

@code {
    // ---------- MODELS ----------
    class PlotRec
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Soil { get; set; } = "";
        public string Branch { get; set; } = "";
        public double Area { get; set; }
        public string Irrigation { get; set; } = "rainfed";
        public string Crop { get; set; } = "";      // gikan sa Crop Planning module
        public string Variety { get; set; } = "";   // gikan sa Crop Planning module
        public string Status { get; set; } = "idle";
        public string Notes { get; set; } = "";

        public PlotRec Clone() => (PlotRec)MemberwiseClone();
    }

    record Stat(string Title, string Value, string Note, string Icon, string IconClass);

    static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    static readonly string[] IrrigationOptions = { "rainfed", "drip", "canal", "sprinkler" };
    static readonly string[] StatusOptions = { "idle", "preparing", "planted", "harvesting", "fallow" };

    // TODO: kuhaa gikan sa naka-login nga tenant ug sa Branches module
    const string ActiveBranch = "North Field Branch";
    readonly string[] branchNames = { "North Field Branch", "South Valley Branch", "Central Packing Branch" };

    // Temporary: gidaghanon sa crop cycles nga na-record (i-compute gikan sa Crop Planning kung naa na)
    const int CyclesRecorded = 5;

    // ---------- STATE ----------
    string searchText = "";
    string toast = "";
    bool showModal;
    bool showErrors;
    int? editingId;
    int? openMenuId;
    PlotRec form = new();
    double? areaInput;

    // ---------- TEMPORARY DATA (ilisi sa database later) ----------
    readonly List<PlotRec> plots = new()
    {
        new() { Id = 1, Name = "North Plot A",   Soil = "Clay loam",  Branch = "North Field Branch",     Area = 1.5, Irrigation = "drip",      Crop = "Rice",     Variety = "NSIC Rc222", Status = "planted" },
        new() { Id = 2, Name = "North Plot B",   Soil = "Loam",       Branch = "North Field Branch",     Area = 2,   Irrigation = "canal",     Crop = "Corn",     Variety = "Pioneer 30T80", Status = "planted" },
        new() { Id = 3, Name = "North Plot C",   Soil = "Sandy loam", Branch = "North Field Branch",     Area = 1.2, Irrigation = "sprinkler", Status = "preparing" },
        new() { Id = 4, Name = "South Plot D",   Soil = "Silt loam",  Branch = "South Valley Branch",    Area = 2.5, Irrigation = "rainfed",   Crop = "Cabbage",  Variety = "Scorpio",    Status = "planted" },
        new() { Id = 5, Name = "South Plot E",   Soil = "Clay",       Branch = "South Valley Branch",    Area = 1.8, Irrigation = "canal",     Crop = "Ampalaya", Variety = "Galaxy",     Status = "harvesting" },
        new() { Id = 6, Name = "Central Plot F", Soil = "Loam",       Branch = "Central Packing Branch", Area = 1,   Irrigation = "drip",      Status = "fallow" },
    };

    // ---------- COMPUTED ----------
    List<PlotRec> Filtered => string.IsNullOrWhiteSpace(searchText)
        ? plots
        : plots.Where(p =>
            p.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            p.Branch.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            p.Soil.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            p.Crop.Contains(searchText, StringComparison.OrdinalIgnoreCase)).ToList();

    List<Stat> Stats
    {
        get
        {
            var planted = plots.Count(p => p.Status == "planted");
            var totalHa = plots.Sum(p => p.Area);
            var active = plots.Count(p => p.Status == "planted" || p.Status == "harvesting");
            return new()
            {
                new("PLOTS", plots.Count.ToString(), planted + " currently planted", "bi-map", ""),
                new("TOTAL AREA", totalHa.ToString("0.##", Inv) + " ha", "Across managed plots", "bi-water", "stat-icon-plain"),
                new("ACTIVE CROP CYCLES", active.ToString(), CyclesRecorded + " cycles recorded", "bi-flower1", "stat-icon-plain"),
            };
        }
    }

    bool NameTaken => !string.IsNullOrWhiteSpace(form.Name) &&
        plots.Any(p => p.Id != (editingId ?? -1) &&
                       string.Equals(p.Name, form.Name.Trim(), StringComparison.OrdinalIgnoreCase));

    bool AreaInvalid => areaInput.HasValue && areaInput.Value < 0;

    static bool HasCrop(PlotRec p) => !string.IsNullOrWhiteSpace(p.Crop);

    static string Cap(string s) => string.IsNullOrEmpty(s) ? s : char.ToUpper(s[0]) + s.Substring(1);

    static string StatusClass(string s) => s switch
    {
        "preparing" or "harvesting" => "pill-yellow",
        "planted" => "pill-green",
        _ => "pill-gray"
    };

    // ---------- ACTIONS ----------
    void OpenNew()
    {
        form = new PlotRec { Irrigation = "rainfed", Status = "idle", Branch = ActiveBranch };
        areaInput = null;
        editingId = null;
        showErrors = false;
        showModal = true;
    }

    void OpenEdit(PlotRec p)
    {
        form = p.Clone();
        areaInput = p.Area;
        editingId = p.Id;
        showErrors = false;
        openMenuId = null;
        showModal = true;
    }

    void CloseModal() => showModal = false;

    void Save()
    {
        showErrors = true;
        if (string.IsNullOrWhiteSpace(form.Name) || NameTaken || AreaInvalid) return;

        form.Name = form.Name.Trim();
        form.Area = areaInput ?? 0;

        if (editingId == null)
        {
            form.Id = plots.Count == 0 ? 1 : plots.Max(p => p.Id) + 1;
            plots.Add(form);
        }
        else
        {
            var idx = plots.FindIndex(p => p.Id == editingId);
            if (idx >= 0)
            {
                // Ang crop ug variety gikan sa Crop Planning, dili sa modal
                form.Crop = plots[idx].Crop;
                form.Variety = plots[idx].Variety;
                plots[idx] = form;
            }
        }
        showModal = false;
    }

    async Task Delete(PlotRec p)
    {
        openMenuId = null;
        if (HasCrop(p))
        {
            await ShowToast(p.Name + " still has an active crop cycle. Close the cycle first before deleting the plot.");
            return;
        }
        plots.Remove(p);
    }

    void ToggleMenu(int id) => openMenuId = openMenuId == id ? null : id;
    void CloseMenu() => openMenuId = null;

    async Task ShowToast(string message)
    {
        toast = message;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(3500);
        toast = "";
        await InvokeAsync(StateHasChanged);
    }
}
