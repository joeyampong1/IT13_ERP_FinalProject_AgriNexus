@page "/expenses"
@using System.Globalization
@inject AgriNexus.Services.AuthService Auth

<div class="mb-4">
    <h2 class="page-title">Expense Management</h2>
    <p class="text-muted mb-0 page-sub">@ActiveBranch · operating costs by category, plot and status.</p>
</div>

<!-- STAT CARDS -->
<div class="row g-3 mb-4">
    @foreach (var s in Stats)
    {
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <span class="card-title">@s.Title</span>
                    <div class="stat-icon @s.IconClass"><i class="bi @s.Icon"></i></div>
                </div>
                <div class="mt-3">
                    <div class="card-value">@s.Value</div>
                    @if (!string.IsNullOrEmpty(s.Note))
                    {
                        <div class="text-muted small mt-1">@s.Note</div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- TOOLBAR -->
<div class="toolbar mb-3">
    <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="text" placeholder="Search expenses..." @bind="searchText" @bind:event="oninput" />
    </div>
    <span class="text-muted small">@Filtered.Count @(Filtered.Count == 1 ? "expense" : "expenses")</span>
    <button type="button" class="btn-new ms-auto" @onclick="OpenNew">
        <i class="bi bi-plus-lg"></i> New expense
    </button>
</div>

<!-- TABLE -->
<div class="panel">
    <div class="table-wrap">
        <table class="table data-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Description</th>
                    <th>Category</th>
                    <th>Amount</th>
                    <th>Paid<br />via</th>
                    <th>Recorded by</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Filtered)
                {
                    <tr>
                        <td class="col-date">@x.Date.ToString("MMM d, yyyy", Inv)</td>
                        <td class="col-desc">
                            <div class="fw-semibold">@x.Description</div>
                            <div class="sub">
                                @if (!string.IsNullOrWhiteSpace(x.Vendor))
                                {
                                    <span>@x.Vendor</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(x.Vendor) && !string.IsNullOrWhiteSpace(x.Plot))
                                {
                                    <span> · </span>
                                }
                                @if (!string.IsNullOrWhiteSpace(x.Plot))
                                {
                                    <span class="plot">@x.Plot</span>
                                }
                            </div>
                        </td>
                        <td>@Cap(x.Category)</td>
                        <td class="fw-medium text-nowrap">@Peso(x.Amount)</td>
                        <td>@Cap(x.Method)</td>
                        <td class="col-by">@(string.IsNullOrWhiteSpace(x.RecordedBy) ? "—" : x.RecordedBy)</td>
                        <td><span class="pill @StatusClass(x.Status)">@Cap(x.Status)</span></td>
                        <td class="text-end action-cell">
                            <button type="button" class="btn-dots" @onclick="() => ToggleMenu(x.Id)" aria-label="Actions">
                                <i class="bi bi-three-dots"></i>
                            </button>
                            @if (openMenuId == x.Id)
                            {
                                <div class="menu-backdrop" @onclick="CloseMenu"></div>
                                <div class="row-menu">
                                    <button type="button" class="row-menu-item" @onclick="() => OpenEdit(x)">
                                        <i class="bi bi-pencil"></i> Edit
                                    </button>
                                    <button type="button" class="row-menu-item" @onclick="() => Approve(x)">
                                        <i class="bi bi-check-circle"></i> Approve
                                    </button>
                                    <button type="button" class="row-menu-item" @onclick="() => MarkPaid(x)">
                                        <i class="bi bi-cash-coin"></i> Mark as paid
                                    </button>
                                    <button type="button" class="row-menu-item plain" @onclick="() => Reject(x)">
                                        Reject
                                    </button>
                                    <div class="menu-sep"></div>
                                    <button type="button" class="row-menu-item text-danger" @onclick="() => Delete(x)">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </div>
                            }
                        </td>
                    </tr>
                }
                @if (Filtered.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted py-5">No expenses found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL -->
@if (showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <h5 class="modal-heading mb-0">@(editingId == null ? "New expense" : "Edit expense")</h5>
                <button type="button" class="btn-close-x" @onclick="CloseModal" aria-label="Close"><i class="bi bi-x-lg"></i></button>
            </div>

            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label">Description <span class="req">*</span></label>
                    <input class="form-control @(showErrors && string.IsNullOrWhiteSpace(form.Description) ? "is-invalid" : "")" @bind="form.Description" />
                    @if (showErrors && string.IsNullOrWhiteSpace(form.Description))
                    {
                        <div class="err">Description is required.</div>
                    }
                </div>

                <div class="col-md-6">
                    <label class="form-label">Category</label>
                    <select class="form-select" @bind="form.Category">
                        <option value="">Select...</option>
                        @foreach (var c in CategoryOptions)
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Amount (₱) <span class="req">*</span></label>
                    <input type="number" min="0" step="0.01" class="form-control @(showErrors && AmountInvalid ? "is-invalid" : "")" @bind="amountInput" />
                    @if (showErrors && AmountInvalid)
                    {
                        <div class="err">Enter an amount greater than zero.</div>
                    }
                </div>

                <div class="col-md-6">
                    <label class="form-label">Date</label>
                    <input type="date" class="form-control" @bind="form.Date" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Payment method</label>
                    <select class="form-select" @bind="form.Method">
                        @foreach (var m in MethodOptions)
                        {
                            <option value="@m">@m</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Vendor / payee</label>
                    <input class="form-control" @bind="form.Vendor" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Charged to plot (optional)</label>
                    <input class="form-control" list="plotList" @bind="form.Plot" />
                    <datalist id="plotList">
                        @foreach (var p in plotOptions)
                        {
                            <option value="@p"></option>
                        }
                    </datalist>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Recorded by</label>
                    <input class="form-control" @bind="form.RecordedBy" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Status</label>
                    <select class="form-select" @bind="form.Status">
                        @foreach (var s in StatusOptions)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Branch</label>
                    <select class="form-select" @bind="form.Branch">
                        @foreach (var b in branchNames)
                        {
                            <option value="@b">@b</option>
                        }
                    </select>
                </div>
            </div>

            <div class="d-flex justify-content-end align-items-center gap-3 mt-4">
                <button type="button" class="btn-cancel" @onclick="CloseModal">Cancel</button>
                <button type="button" class="btn-save" @onclick="Save">Save</button>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(toast))
{
    <div class="toast-note @(toastWarn ? "warn" : "")">
        <i class="bi @(toastWarn ? "bi-info-circle-fill" : "bi-check-circle-fill")"></i> @toast
    </div>
}

@code {
    // ---------- MODELS ----------
    class ExpenseRec
    {
        public int Id { get; set; }
        public DateTime Date { get; set; } = DateTime.Today;
        public string Description { get; set; } = "";
        public string Vendor { get; set; } = "";
        public string Plot { get; set; } = "";
        public string Category { get; set; } = "";
        public decimal Amount { get; set; }
        public string Method { get; set; } = "cash";
        public string RecordedBy { get; set; } = "";
        public string Status { get; set; } = "pending";   // pending | approved | paid | rejected
        public string Branch { get; set; } = "";

        public ExpenseRec Clone() => (ExpenseRec)MemberwiseClone();
    }

    record Stat(string Title, string Value, string Note, string Icon, string IconClass);

    static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    static readonly string[] CategoryOptions = { "labor", "supplies", "fuel", "utilities", "transport", "equipment", "maintenance", "other" };
    static readonly string[] MethodOptions = { "cash", "gcash", "bank", "check" };
    static readonly string[] StatusOptions = { "pending", "approved", "paid", "rejected" };

    // TODO: kuhaa gikan sa naka-login nga tenant ug sa Branches / Farms & Plots modules
    const string ActiveBranch = "North Field Branch";
    readonly string[] branchNames = { "North Field Branch", "South Valley Branch", "Central Packing Branch" };
    readonly string[] plotOptions =
    {
        "North Plot A", "North Plot B", "North Plot C", "South Plot D", "South Plot E", "Central Plot F",
    };

    // ---------- STATE ----------
    string searchText = "";
    string toast = "";
    bool toastWarn;
    bool showModal;
    bool showErrors;
    int? editingId;
    int? openMenuId;
    ExpenseRec form = new();
    decimal? amountInput;

    // ---------- TEMPORARY DATA (ilisi sa database later) ----------
    // Ang order sa list parehas sa prototype. Ang bag-ong expense mo-gawas sa taas.
    readonly List<ExpenseRec> expenses = new()
    {
        new() { Id = 1,  Date = new(2026, 10, 21), Description = "Daily wages payout — ampalaya harvest crew", Vendor = "Farm workers payroll", Plot = "South Plot E", Category = "labor",       Amount = 8400,  Method = "cash", RecordedBy = "Marites Aquino",   Status = "paid",     Branch = "South Valley Branch" },
        new() { Id = 2,  Date = new(2026, 10, 18), Description = "Urea fertilizer purchase — 20 sacks",          Vendor = "Central Luzon Agri Supply", Category = "supplies",   Amount = 29000, Method = "bank", RecordedBy = "Bernardo Ocampo", Status = "approved", Branch = "North Field Branch" },
        new() { Id = 3,  Date = new(2026, 10, 20), Description = "Diesel for water pump and hauling truck",     Vendor = "Valley Fuel Station",       Category = "fuel",       Amount = 8500,  Method = "cash", RecordedBy = "Allan Mercado",   Status = "paid",     Branch = "North Field Branch" },
        new() { Id = 4,  Date = new(2026, 10, 5),  Description = "Daily wages payout — cabbage harvest crew",    Vendor = "Farm workers payroll", Plot = "South Plot D", Category = "labor",     Amount = 9600,  Method = "cash", RecordedBy = "Marites Aquino",   Status = "paid",     Branch = "South Valley Branch" },
        new() { Id = 5,  Date = new(2026, 6, 12),  Description = "Certified rice seeds — 60 kg",                Vendor = "Pioneer Seeds Depot", Plot = "North Plot A", Category = "supplies",   Amount = 3300,  Method = "cash", RecordedBy = "Allan Mercado",   Status = "paid",     Branch = "North Field Branch" },
        new() { Id = 6,  Date = new(2026, 10, 3),  Description = "Irrigation pump electricity — September",     Vendor = "Nueva Ecija Electric Coop", Category = "utilities",  Amount = 4600,  Method = "bank", RecordedBy = "Bernardo Ocampo", Status = "approved", Branch = "North Field Branch" },
        new() { Id = 7,  Date = new(2026, 10, 18), Description = "Delivery hauls to Cabanatuan market",         Vendor = "J&T Hauling Services",      Category = "transport",  Amount = 2800,  Method = "cash", RecordedBy = "Paolo Gutierrez", Status = "paid",     Branch = "North Field Branch" },
        new() { Id = 8,  Date = new(2026, 10, 14), Description = "Repair of knapsack sprayer nozzles",          Vendor = "FarmTech Machinery & Tools", Category = "equipment", Amount = 1250,  Method = "cash", RecordedBy = "Cristina Yabut",  Status = "pending",  Branch = "South Valley Branch" },

        // Mga entries nga wala makita sa screenshot (gi-balance aron mo-match ang totals)
        new() { Id = 9,  Date = new(2026, 10, 9),  Description = "Daily wages payout — packing and sorting crew", Vendor = "Farm workers payroll", Plot = "Central Plot F", Category = "labor", Amount = 3360, Method = "cash", RecordedBy = "Noel Bautista",   Status = "paid",     Branch = "Central Packing Branch" },
        new() { Id = 10, Date = new(2026, 9, 18),  Description = "Diesel for tractor — land preparation",       Vendor = "Valley Fuel Station", Plot = "North Plot C", Category = "fuel",       Amount = 3200,  Method = "cash", RecordedBy = "Allan Mercado",   Status = "paid",     Branch = "North Field Branch" },
        new() { Id = 11, Date = new(2026, 10, 8),  Description = "Irrigation service fee — third quarter",      Vendor = "Nueva Ecija Irrigators Association", Category = "utilities", Amount = 2400, Method = "bank", RecordedBy = "Bernardo Ocampo", Status = "approved", Branch = "North Field Branch" },
        new() { Id = 12, Date = new(2026, 10, 19), Description = "Canal clearing and dike repair",              Vendor = "Local labor contractor", Plot = "North Plot B", Category = "maintenance", Amount = 6500, Method = "cash", RecordedBy = "Ramon Delos Santos", Status = "approved", Branch = "North Field Branch" },
        new() { Id = 13, Date = new(2026, 10, 6),  Description = "Barangay clearance and business permit fees", Vendor = "Municipal Treasurer’s Office", Category = "other",     Amount = 1800,  Method = "cash", RecordedBy = "Noel Bautista",   Status = "approved", Branch = "Central Packing Branch" },
        new() { Id = 14, Date = new(2026, 10, 23), Description = "Insecticide and herbicide restock",           Vendor = "GreenShield Crop Protection", Category = "supplies", Amount = 9200,  Method = "bank", RecordedBy = "Cristina Yabut",  Status = "pending",  Branch = "South Valley Branch" },
        new() { Id = 15, Date = new(2026, 10, 23), Description = "Hand trowels and work gloves restock",       Vendor = "FarmTech Machinery & Tools", Category = "supplies", Amount = 2800,  Method = "cash", RecordedBy = "Ramon Delos Santos", Status = "pending", Branch = "North Field Branch" },
    };

    // ---------- COMPUTED ----------
    // Ang rejected dili apil sa totals
    IEnumerable<ExpenseRec> Counted => expenses.Where(x => x.Status != "rejected");

    List<ExpenseRec> Filtered => string.IsNullOrWhiteSpace(searchText)
        ? expenses
        : expenses.Where(x =>
            x.Description.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            x.Vendor.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            x.Plot.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            x.Category.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            x.RecordedBy.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            x.Status.Contains(searchText, StringComparison.OrdinalIgnoreCase)).ToList();

    List<Stat> Stats
    {
        get
        {
            var t = DateTime.Today;
            var month = Counted.Where(x => x.Date.Year == t.Year && x.Date.Month == t.Month).ToList();
            var pending = expenses.Where(x => x.Status == "pending").ToList();
            var paid = expenses.Count(x => x.Status == "paid");

            return new()
            {
                new("TOTAL RECORDED", Peso(Counted.Sum(x => x.Amount)), Counted.Count() + " entries", "bi-coin", ""),
                new("THIS MONTH", Peso(month.Sum(x => x.Amount)), month.Count + (month.Count == 1 ? " entry" : " entries"), "bi-graph-down-arrow", "stat-icon-plain"),
                new("AWAITING APPROVAL", pending.Count.ToString(), Peso(pending.Sum(x => x.Amount)), "bi-cash-stack", "stat-icon-warn"),
                new("PAID ENTRIES", paid.ToString(), "", "bi-check-circle", ""),
            };
        }
    }

    bool AmountInvalid => !amountInput.HasValue || amountInput.Value <= 0;

    // ---------- HELPERS ----------
    static string Peso(decimal v) => "₱" + v.ToString("N2", Inv);

    static string Cap(string s) => string.IsNullOrEmpty(s) ? s : char.ToUpper(s[0]) + s.Substring(1);

    static string StatusClass(string s) => s switch
    {
        "paid" or "approved" => "pill-green",
        "rejected" => "pill-red",
        _ => "pill-yellow"
    };

    // ---------- ACTIONS ----------
    void OpenNew()
    {
        form = new ExpenseRec
        {
            Date = DateTime.Today,
            Method = "cash",
            Status = "pending",
            Branch = ActiveBranch,
            RecordedBy = Auth.CurrentUserName ?? ""
        };
        amountInput = null;
        editingId = null;
        showErrors = false;
        showModal = true;
    }

    void OpenEdit(ExpenseRec x)
    {
        form = x.Clone();
        amountInput = x.Amount;
        editingId = x.Id;
        showErrors = false;
        openMenuId = null;
        showModal = true;
    }

    void CloseModal() => showModal = false;

    void Save()
    {
        showErrors = true;
        if (string.IsNullOrWhiteSpace(form.Description) || AmountInvalid) return;

        form.Description = form.Description.Trim();
        form.Amount = amountInput!.Value;
        if (string.IsNullOrWhiteSpace(form.Category)) form.Category = "other";
        if (string.IsNullOrWhiteSpace(form.RecordedBy)) form.RecordedBy = Auth.CurrentUserName ?? "";

        if (editingId == null)
        {
            form.Id = expenses.Count == 0 ? 1 : expenses.Max(x => x.Id) + 1;
            expenses.Insert(0, form);
        }
        else
        {
            var idx = expenses.FindIndex(x => x.Id == editingId);
            if (idx >= 0) expenses[idx] = form;
        }
        // TODO: i-save sa database ug i-log sa Audit Logs (Create / Update · Expenses)
        showModal = false;
    }

    async Task Approve(ExpenseRec x)
    {
        openMenuId = null;
        if (x.Status == "paid") { await ShowToast("This expense is already paid.", true); return; }
        if (x.Status == "approved") { await ShowToast("This expense is already approved.", true); return; }

        x.Status = "approved";
        // TODO: i-log sa Audit Logs (Approve · Expenses)
        await ShowToast("Expense approved.");
    }

    async Task MarkPaid(ExpenseRec x)
    {
        openMenuId = null;
        if (x.Status == "paid") { await ShowToast("This expense is already paid.", true); return; }
        if (x.Status == "rejected") { await ShowToast("Rejected expenses can’t be paid. Approve it first.", true); return; }

        x.Status = "paid";
        // TODO: kung cash, i-log ang gawas sa Cash Drawer; i-apil sa Production Costing ug Financial Reports
        await ShowToast("Marked as paid: " + Peso(x.Amount) + ".");
    }

    async Task Reject(ExpenseRec x)
    {
        openMenuId = null;
        if (x.Status == "paid") { await ShowToast("Paid expenses can’t be rejected.", true); return; }

        x.Status = "rejected";
        // TODO: i-log sa Audit Logs (Reject · Expenses)
        await ShowToast("Expense rejected. It no longer counts in the totals.");
    }

    async Task Delete(ExpenseRec x)
    {
        openMenuId = null;
        if (x.Status == "paid")
        {
            await ShowToast("Paid expenses are part of the financial records and can’t be deleted.", true);
            return;
        }

        expenses.Remove(x);
        await ShowToast("Expense removed.");
    }

    void ToggleMenu(int id) => openMenuId = openMenuId == id ? null : id;
    void CloseMenu() => openMenuId = null;

    async Task ShowToast(string message, bool warn = false)
    {
        toast = message;
        toastWarn = warn;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(3200);
        toast = "";
        await InvokeAsync(StateHasChanged);
    }
}