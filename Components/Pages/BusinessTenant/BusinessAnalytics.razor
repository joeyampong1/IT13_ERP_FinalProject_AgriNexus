@page "/financials"
@page "/business-analytics"
@using System.Globalization
@using System.Text

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <h2 class="page-title">Financial Reports</h2>
        <p class="text-muted mb-0 page-sub">@BusinessName · revenue, cost, estimated profitability and collection performance.</p>
    </div>
    <button type="button" class="btn-outline-lg" @onclick="() => showGen = !showGen">
        <i class="bi bi-file-earmark-bar-graph"></i> Generate report
    </button>
</div>

<!-- REPORT GENERATOR (gikan sa imong code) -->
@if (showGen)
{
    <div class="card-box gen-panel mb-4">
        <div class="panel-title mb-3"><i class="bi bi-file-earmark-bar-graph text-success me-2"></i>Generate business report</div>
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-3">
                <label class="form-label">Start date</label>
                <input type="date" class="form-control" @bind="startDate" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label">End date</label>
                <input type="date" class="form-control" @bind="endDate" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label">Report type</label>
                <select class="form-select" @bind="reportType">
                    <option>Profit &amp; Loss Summary</option>
                    <option>Branch Performance</option>
                    <option>Collections Report</option>
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label">Format</label>
                <div class="d-flex gap-2">
                    <select class="form-select" style="width:100px" @bind="format">
                        <option>PDF</option>
                        <option>Excel</option>
                    </select>
                    <button type="button" class="btn-generate flex-grow-1" @onclick="GenerateReport" disabled="@generating">
                        <i class="bi bi-download"></i> @(generating ? "Generating…" : "Generate")
                    </button>
                </div>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(genError))
        {
            <div class="err mt-2">@genError</div>
        }
    </div>
}

<!-- STAT CARDS -->
<div class="row g-3 mb-3">
    @foreach (var s in Stats)
    {
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <span class="card-title">@s.Title</span>
                    <div class="stat-icon @s.IconClass"><i class="bi @s.Icon"></i></div>
                </div>
                <div class="mt-3">
                    <div class="card-value">@s.Value</div>
                    <div class="text-muted small mt-1">@s.Note</div>
                </div>
            </div>
        </div>
    }
</div>

<!-- MINI KPIs (gikan sa imong code, karon computed) -->
<div class="row g-2 mb-4">
    @foreach (var k in MiniKpis)
    {
        <div class="col-6 col-md-3">
            <div class="mini-kpi-card">
                <span class="text-muted small fw-bold">@k.Label</span>
                <span class="fw-bold @k.Class">@k.Value</span>
            </div>
        </div>
    }
</div>

<!-- TABS -->
<div class="tabs mb-4">
    <button type="button" class="tab-btn @(activeTab == "revenue" ? "active" : "")" @onclick='() => activeTab = "revenue"'>Revenue &amp; profit</button>
    <button type="button" class="tab-btn @(activeTab == "profit" ? "active" : "")" @onclick='() => activeTab = "profit"'>Profit estimation</button>
    <button type="button" class="tab-btn @(activeTab == "collections" ? "active" : "")" @onclick='() => activeTab = "collections"'>Collections report</button>
</div>

<!-- ======================= REVENUE & PROFIT ======================= -->
@if (activeTab == "revenue")
{
    <div class="row g-3 mb-4">
        <div class="col-12 col-lg-8">
            <div class="card-box h-100">
                <div class="panel-title">Revenue, cost and profit</div>
                <div class="panel-sub">Last 6 months</div>

                <svg viewBox="0 0 640 300" class="w-100" style="max-height:340px" role="img" aria-label="Revenue, cost and profit">
                    @for (int i = 0; i <= 4; i++)
                    {
                        var y = 20 + i * 60;
                        var val = BarMax / 4 * (4 - i);
                        <g>
                            <line x1="62" x2="630" y1="@y" y2="@y" stroke="#E2E8F0" stroke-dasharray="3 4" />
                            <text x="52" y="@(y + 4)" text-anchor="end" font-size="11" fill="#64748B">@AxisLabel(val)</text>
                        </g>
                    }
                    @for (int i = 0; i < months.Count; i++)
                    {
                        var m = months[i];
                        var slot = 568.0 / months.Count;
                        var bw = slot * 0.27;
                        var gap = slot * 0.05;
                        var start = 62 + i * slot + (slot - (bw * 2 + gap)) / 2;
                        var hR = (double)m.Revenue / BarMax * 240;
                        var hE = (double)m.Expenses / BarMax * 240;
                        <g>
                            <rect x="@F(start)" y="@F(260 - hR)" width="@F(bw)" height="@F(hR)" rx="4" fill="#62A834" />
                            <rect x="@F(start + bw + gap)" y="@F(260 - hE)" width="@F(bw)" height="@F(hE)" rx="4" fill="#A86B4C" />
                            <text x="@F(62 + i * slot + slot / 2)" y="282" text-anchor="middle" font-size="11" fill="#475569">@m.Label</text>
                        </g>
                    }
                </svg>

                <div class="d-flex justify-content-center gap-3 small mt-1">
                    <span class="lg" style="color:#6FA82E"><span class="swatch" style="background:#62A834"></span>Revenue</span>
                    <span class="lg" style="color:#A86B4C"><span class="swatch" style="background:#A86B4C"></span>Expenses</span>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card-box h-100">
                <div class="panel-title">Profit trend</div>
                <div class="panel-sub">Estimated profit per month</div>

                <svg viewBox="0 0 400 300" class="w-100" style="max-height:340px" role="img" aria-label="Profit trend">
                    @for (int i = 0; i <= 4; i++)
                    {
                        var y = 20 + i * 60;
                        var val = ProfitMax - i * ProfitMax / 2;
                        <g>
                            <line x1="62" x2="390" y1="@y" y2="@y" stroke="#E2E8F0" stroke-dasharray="3 4" />
                            <text x="52" y="@(y + 4)" text-anchor="end" font-size="11" fill="#64748B">@AxisLabel(val)</text>
                        </g>
                    }
                    <path d="@SmoothPath(ProfitPoints)" fill="none" stroke="#206A3B" stroke-width="2.5" stroke-linecap="round" />
                    @for (int i = 0; i < ProfitPoints.Count; i++)
                    {
                        <g>
                            <circle cx="@F(ProfitPoints[i].X)" cy="@F(ProfitPoints[i].Y)" r="3.5" fill="#fff" stroke="#206A3B" stroke-width="2" />
                            <text x="@F(ProfitPoints[i].X)" y="282" text-anchor="middle" font-size="11" fill="#64748B">@months[i].Label</text>
                        </g>
                    }
                </svg>
            </div>
        </div>
    </div>

    <div class="panel mb-4">
        <div class="panel-head">
            <div class="panel-title">Monthly financial summary</div>
            <div class="panel-sub mb-0">Revenue, collections, cost and margin per month</div>
        </div>
        <div class="table-wrap">
            <table class="table data-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Month</th>
                        <th>Revenue</th>
                        <th>Collections</th>
                        <th>Expenses</th>
                        <th>Estimated profit</th>
                        <th>Margin</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in months)
                    {
                        <tr>
                            <td>@m.Label</td>
                            <td class="text-nowrap">@Peso(m.Revenue)</td>
                            <td class="text-nowrap">@Peso(m.Collections)</td>
                            <td class="text-nowrap">@Peso(m.Expenses)</td>
                            <td class="text-nowrap @(m.Profit < 0 ? "neg" : m.Profit > 0 ? "pos" : "")">@PesoSigned(m.Profit)</td>
                            <td>@m.Margin%</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- BRANCH PERFORMANCE (gikan sa imong code) -->
    <div class="card-box">
        <div class="panel-title">Branch performance</div>
        <div class="panel-sub">Sales per branch</div>

        <svg viewBox="0 0 640 250" class="w-100" style="max-height:240px" role="img" aria-label="Branch performance">
            @for (int i = 0; i < branches.Count; i++)
            {
                var b = branches[i];
                var slot = 640.0 / branches.Count;
                var x = i * slot + (slot - 80) / 2;
                var h = (double)b.Sales / BranchMax * 150;
                var y = 200 - h;
                <g>
                    <rect x="@F(x)" y="20" width="80" height="180" fill="#F1F5F9" rx="8" />
                    <rect x="@F(x)" y="@F(y)" width="80" height="@F(h)" fill="#62A834" rx="8" />
                    <text x="@F(x + 40)" y="@F(y - 8)" text-anchor="middle" font-size="12" fill="#1E293B" font-weight="700">@Short(b.Sales)</text>
                    <text x="@F(x + 40)" y="222" text-anchor="middle" font-size="12" fill="#64748B" font-weight="600">@b.Name</text>
                </g>
            }
        </svg>
    </div>
}

<!-- BAG-ONG DUNGAG NGA MGA GRAPHS -->
<div class="row g-3 mt-1 mb-4">
    <!-- Sales by Crop (Donut Chart) -->
    <div class="col-12 col-lg-4">
        <div class="card-box h-100">
            <div class="panel-title">Sales by Crop</div>
            <div class="panel-sub">Top harvest products</div>
            <div class="d-flex justify-content-center my-3 position-relative">
                <svg viewBox="0 0 200 200" width="190" height="190">
                    @{
                        double offsetCrop = 0;
                    }
                    @foreach (var c in CropSales)
                    {
                        var len = c.Value / TotalCropSales * Circ;
                        var dash = Math.Max(len - 4, 0.5);
                        <circle cx="100" cy="100" r="@Radius" fill="none" stroke="@c.Color" stroke-width="25"
                                stroke-dasharray="@($"{dash} {Circ - dash}")"
                                stroke-dashoffset="@(-offsetCrop)"
                                transform="rotate(-90 100 100)" />
                        offsetCrop += len;
                    }
                </svg>
                <div class="position-absolute top-50 start-50 translate-middle text-center">
                    <h4 class="fw-bold mb-0 text-dark">18.5k</h4>
                    <span class="text-muted" style="font-size: 0.75rem;">Total kg</span>
                </div>
            </div>
            <div class="d-flex flex-column gap-2 small fw-semibold mt-2">
                @foreach (var c in CropSales)
                {
                    <div class="d-flex justify-content-between align-items-center">
                        <span><span class="legend-dot" style="background:@c.Color"></span>@c.Label</span>
                        <span class="text-muted">@c.Value.ToString("N0") kg</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Harvest Yield Trend (Area Chart) -->
    <div class="col-12 col-lg-8">
        <div class="card-box h-100">
            <div class="panel-title">Harvest Yield Trend</div>
            <div class="panel-sub">Monthly kg harvested</div>
            <svg viewBox="0 0 600 250" class="w-100 mt-3" style="max-height: 240px;">
                <defs>
                    <linearGradient id="yieldGrad" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#62A834" stop-opacity="0.4" />
                        <stop offset="100%" stop-color="#62A834" stop-opacity="0" />
                    </linearGradient>
                </defs>
                <path d="M 50,200 L 150,170 L 250,120 L 350,150 L 450,80 L 550,50 L 550,230 L 50,230 Z" fill="url(#yieldGrad)" />
                <polyline points="50,200 150,170 250,120 350,150 450,80 550,50" fill="none" stroke="#62A834" stroke-width="4" stroke-linecap="round" />
                <g>
                    <circle cx="50" cy="200" r="5" fill="white" stroke="#62A834" stroke-width="3" />
                    <circle cx="150" cy="170" r="5" fill="white" stroke="#62A834" stroke-width="3" />
                    <circle cx="250" cy="120" r="5" fill="white" stroke="#62A834" stroke-width="3" />
                    <circle cx="350" cy="150" r="5" fill="white" stroke="#62A834" stroke-width="3" />
                    <circle cx="450" cy="80" r="5" fill="white" stroke="#62A834" stroke-width="3" />
                    <circle cx="550" cy="50" r="6" fill="#62A834" stroke="white" stroke-width="2" />
                </g>
                <g>
                    <text x="50" y="245" text-anchor="middle" font-size="11" fill="#64748B">Jan</text>
                    <text x="150" y="245" text-anchor="middle" font-size="11" fill="#64748B">Feb</text>
                    <text x="250" y="245" text-anchor="middle" font-size="11" fill="#64748B">Mar</text>
                    <text x="350" y="245" text-anchor="middle" font-size="11" fill="#64748B">Apr</text>
                    <text x="450" y="245" text-anchor="middle" font-size="11" fill="#64748B">May</text>
                    <text x="550" y="245" text-anchor="middle" font-size="11" fill="#64748B">Jun</text>
                </g>
            </svg>
        </div>
    </div>
</div>

<!-- ======================= PROFIT ESTIMATION ======================= -->
@if (activeTab == "profit")
{
    <div class="row g-3">
        <div class="col-12 col-lg-6">
            <div class="panel h-100">
                <div class="panel-head">
                    <div class="panel-title">Top customers by sales value</div>
                    <div class="panel-sub mb-0">Contribution to revenue</div>
                </div>
                <div class="table-wrap">
                    <table class="table data-table align-middle mb-0">
                        <thead><tr><th>Customer</th><th>Sales value</th><th>Share</th></tr></thead>
                        <tbody>
                            @foreach (var c in customers)
                            {
                                <tr>
                                    <td class="col-name">@c.Name</td>
                                    <td class="text-nowrap">@Peso(c.Value)</td>
                                    <td>@Share(c.Value, CustomerTotal)%</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="panel h-100">
                <div class="panel-head">
                    <div class="panel-title">Cost by category</div>
                    <div class="panel-sub mb-0">Operating cost allocation</div>
                </div>
                <div class="table-wrap">
                    <table class="table data-table align-middle mb-0">
                        <thead><tr><th>Category</th><th>Amount</th><th>Share</th></tr></thead>
                        <tbody>
                            @foreach (var c in costs)
                            {
                                <tr>
                                    <td class="col-name">@c.Name</td>
                                    <td class="text-nowrap">@Peso(c.Value)</td>
                                    <td>@Share(c.Value, CostTotal)%</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

<!-- ======================= COLLECTIONS REPORT ======================= -->
@if (activeTab == "collections")
{
    <div class="row g-3 mb-4">
        <div class="col-12 col-lg-4">
            <div class="card-box h-100">
                <div class="panel-title">Collections by method</div>
                <div class="panel-sub">Cash, GCash, bank and check</div>

                <div class="d-flex justify-content-center my-3">
                    <svg viewBox="0 0 200 200" width="220" height="220" role="img" aria-label="Collections by method">
                        @{
                            double offset = 0;
                        }
                        @foreach (var m in methods)
                        {
                            var len = (double)(m.Value / MethodTotal) * Circ;
                            var dash = Math.Max(len - 2, 0.5);
                            <circle cx="100" cy="100" r="@Radius" fill="none" stroke="@m.Color" stroke-width="30"
                                    stroke-dasharray="@F(dash) @F(Circ - dash)"
                                    stroke-dashoffset="@F(-offset)"
                                    transform="rotate(-90 100 100)" />
                            offset += len;
                        }
                    </svg>
                </div>

                <div class="d-flex justify-content-center gap-3 small text-muted flex-wrap">
                    @foreach (var m in methods.OrderBy(x => x.Order))
                    {
                        <span><span class="legend-dot" style="background:@m.Color"></span>@m.Name</span>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-8">
            <div class="panel h-100">
                <div class="panel-head">
                    <div class="panel-title">Sales and collection report</div>
                    <div class="panel-sub mb-0">Recorded by cashier</div>
                </div>
                <div class="table-wrap">
                    <table class="table data-table align-middle mb-0">
                        <thead><tr><th>Cashier</th><th>Collected</th><th>Payments</th></tr></thead>
                        <tbody>
                            @foreach (var c in cashiers)
                            {
                                <tr>
                                    <td>@c.Name</td>
                                    <td class="text-nowrap">@Peso(c.Collected)</td>
                                    <td>@c.Payments</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="panel">
        <div class="panel-head">
            <div class="panel-title">Outstanding receivables</div>
            <div class="panel-sub mb-0">Balances still to be collected, largest first</div>
        </div>
        <div class="table-wrap">
            <table class="table data-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Sale no.</th>
                        <th>Date</th>
                        <th>Customer</th>
                        <th>Total</th>
                        <th>Paid</th>
                        <th>Balance</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Receivables)
                    {
                        <tr>
                            <td class="text-nowrap">@r.No</td>
                            <td class="text-nowrap">@r.Date.ToString("MMM d, yyyy", Inv)</td>
                            <td class="col-name">@r.Customer</td>
                            <td class="text-nowrap">@Peso(r.Total)</td>
                            <td class="text-nowrap">@Peso(r.Paid)</td>
                            <td class="text-nowrap neg fw-medium">@Peso(r.Balance)</td>
                            <td><span class="pill @(r.Paid > 0 ? "pill-yellow" : "pill-red")">@(r.Paid > 0 ? "Partial" : "Unpaid")</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(toast))
{
    <div class="toast-note"><i class="bi bi-check-circle-fill"></i> @toast</div>
}

@code {
    // ---------- MODELS ----------
    record MonthRow(int Year, int Month, decimal Revenue, decimal Collections, decimal Expenses)
    {
        public string Label => new DateTime(Year, Month, 1).ToString("MMM", CultureInfo.InvariantCulture);
        public decimal Profit => Revenue - Expenses;
        public int Margin => Revenue <= 0 ? 0 : (int)Math.Round(Profit * 100 / Revenue, MidpointRounding.AwayFromZero);
    }

    record Stat(string Title, string Value, string Note, string Icon, string IconClass);
    record Kpi(string Label, string Value, string Class);
    record NamedAmt(string Name, decimal Value);
    record BranchAmt(string Name, decimal Sales);
    record MethodAmt(string Name, decimal Value, string Color, int Order);
    record CashierRow(string Name, decimal Collected, int Payments);
    record RecvRow(string No, DateTime Date, string Customer, decimal Total, decimal Paid)
    {
        public decimal Balance => Total - Paid;
    }

    static readonly CultureInfo Inv = CultureInfo.InvariantCulture;
    const double Radius = 70;
    static readonly double Circ = 2 * Math.PI * Radius;

    // TODO: kuhaa gikan sa naka-login nga tenant
    const string BusinessName = "Verdant Agri Ventures";

    // ---------- STATE ----------
    string activeTab = "revenue";
    bool showGen;
    bool generating;
    string toast = "";
    string genError = "";
    DateTime startDate = DateTime.Today.AddDays(-30);
    DateTime endDate = DateTime.Today;
    string reportType = "Profit & Loss Summary";
    string format = "PDF";

    // ---------- TEMPORARY DATA (ilisi sa database later) ----------
    // Total: revenue 123,280 · collections 92,120 · expenses 96,710
    readonly List<MonthRow> months = new()
    {
        new(2026, 6,  8800,  8800,  3300),
        new(2026, 7,  14000, 11300, 3200),
        new(2026, 8,  22920, 16920, 4200),
        new(2026, 9,  25140, 9680,  6500),
        new(2026, 10, 52420, 45420, 79510),
        new(2026, 11, 0,     0,     0),
    };

    // Total: 123,280
    readonly List<NamedAmt> customers = new()
    {
        new("Bayanihan Trading", 32800),
        new("Rural Bank Cooperative Store", 28860),
        new("Municipal Market Vendors", 20260),
        new("Barangay Nutrition Program", 18500),
        new("Verdant Fresh Retail", 15580),
        new("Walk-in customers", 7280),
    };

    // Total: 96,710
    readonly List<NamedAmt> costs = new()
    {
        new("Labor", 21360), new("Supplies", 44300), new("Fuel", 11700), new("Utilities", 7000),
        new("Transport", 2800), new("Equipment", 1250), new("Maintenance", 6500), new("Other", 1800),
    };

    // Total: 123,280 (mohaum sa Branch performance sa Business Dashboard)
    readonly List<BranchAmt> branches = new()
    {
        new("North Field", 50680), new("South Valley", 55300), new("Central Packing", 17300),
    };

    // Total: 92,120 (mohaum sa Payments & Collections)
    readonly List<MethodAmt> methods = new()
    {
        new("Cash", 38100, "#206A3B", 1),
        new("Gcash", 30000, "#92D050", 3),
        new("Bank", 24020, "#62A834", 2),
    };

    readonly List<CashierRow> cashiers = new()
    {
        new("Noel Bautista", 9400, 2),
        new("Paolo Gutierrez", 47980, 7),
        new("Jhoanna Reyes", 34740, 5),
    };

    readonly List<RecvRow> receivables = new()
    {
        new("SO-0006", new(2026, 9, 2),  "Bayanihan Trading",            12900, 5000),
        new("SO-0008", new(2026, 9, 27), "Municipal Market Vendors",      7560, 0),
        new("SO-0010", new(2026, 10, 12), "Rural Bank Cooperative Store", 13860, 6860),
        new("SO-0004", new(2026, 8, 5),  "Rural Bank Cooperative Store", 15000, 9000),
        new("SO-0003", new(2026, 7, 19), "Verdant Fresh Retail",          5700, 3000),
    };

    // Constants hangtod naa na ang ubang modules
    const int ExpenseEntries = 15;
    const int TotalWorkers = 9;
    const string TopCrop = "Rice";

    // ---------- COMPUTED ----------
    decimal TotalRevenue => months.Sum(m => m.Revenue);
    decimal TotalExpenses => months.Sum(m => m.Expenses);
    decimal TotalProfit => TotalRevenue - TotalExpenses;
    decimal CustomerTotal => customers.Sum(c => c.Value);
    decimal CostTotal => costs.Sum(c => c.Value);
    decimal MethodTotal => Math.Max(1, methods.Sum(m => m.Value));
    double BranchMax => Math.Max(10000, Math.Ceiling((double)branches.Max(b => b.Sales) / 10000) * 10000);

    List<RecvRow> Receivables => receivables.OrderByDescending(r => r.Balance).ToList();

    List<Stat> Stats
    {
        get
        {
            var t = DateTime.Today;
            var m = months.FirstOrDefault(x => x.Year == t.Year && x.Month == t.Month);
            var rev = m?.Revenue ?? 0;
            var exp = m?.Expenses ?? 0;
            var profit = rev - exp;
            var margin = rev <= 0 ? 0 : (int)Math.Round(profit * 100 / rev, MidpointRounding.AwayFromZero);

            return new()
            {
                new("REVENUE THIS MONTH", Peso(rev), t.ToString("MMMM yyyy", Inv), "bi-graph-up-arrow", ""),
                new("COST THIS MONTH", Peso(exp), ExpenseEntries + " expense entries", "bi-coin", "stat-icon-plain"),
                new("ESTIMATED PROFIT", PesoSigned(profit), margin + "% margin", "bi-piggy-bank", "stat-icon-plain"),
                new("RECEIVABLES", Peso(receivables.Sum(r => r.Balance)), receivables.Count + " sales with balance", "bi-cash-stack", "stat-icon-warn"),
            };
        }
    }

    // Mini KPIs: ROI = profit ÷ expenses
    List<Kpi> MiniKpis => new()
    {
        new("ROI", (TotalExpenses <= 0 ? 0 : TotalProfit * 100 / TotalExpenses).ToString("0.0", Inv) + "%", TotalProfit >= 0 ? "text-success" : "text-danger"),
        new("Active Branches", branches.Count.ToString(), "text-dark"),
        new("Top Crop", TopCrop, "text-dark"),
        new("Total Workers", TotalWorkers.ToString(), "text-dark"),
    };

    // Bar chart axis (i-round up sa 20K)
    double BarMax => Math.Max(20000, Math.Ceiling((double)months.Max(m => Math.Max(m.Revenue, m.Expenses)) / 20000) * 20000);

    // Profit chart axis (±, i-round up sa 15K)
    double ProfitMax => Math.Max(15000, Math.Ceiling((double)months.Max(m => Math.Abs(m.Profit)) / 15000) * 15000);

    List<(double X, double Y)> ProfitPoints
    {
        get
        {
            var list = new List<(double, double)>();
            var step = 316.0 / Math.Max(1, months.Count - 1);
            for (int i = 0; i < months.Count; i++)
                list.Add((70 + i * step, 140 - (double)months[i].Profit / ProfitMax * 120));
            return list;
        }
    }

    // ---------- HELPERS ----------
    static string F(double d) => d.ToString("0.##", Inv);
    static string Peso(decimal v) => "₱" + v.ToString("N2", Inv);
    static string PesoSigned(decimal v) => v < 0 ? "-₱" + (-v).ToString("N2", Inv) : Peso(v);
    static string Short(decimal v) => v >= 1000 ? "₱" + (v / 1000).ToString("0.#", Inv) + "K" : "₱" + v.ToString("0", Inv);

    static string AxisLabel(double v) =>
        v == 0 ? "₱0" : (v < 0 ? "-₱" : "₱") + (Math.Abs(v) / 1000).ToString("0", Inv) + "K";

    static int Share(decimal value, decimal total) =>
        total <= 0 ? 0 : (int)Math.Round(value * 100 / total, MidpointRounding.AwayFromZero);

    // Smooth curve (Catmull-Rom -> cubic bezier)
    static string SmoothPath(List<(double X, double Y)> p)
    {
        if (p.Count == 0) return "";
        var sb = new StringBuilder();
        sb.Append("M ").Append(F(p[0].X)).Append(' ').Append(F(p[0].Y));
        for (int i = 0; i < p.Count - 1; i++)
        {
            var p0 = i > 0 ? p[i - 1] : p[i];
            var p1 = p[i];
            var p2 = p[i + 1];
            var p3 = i + 2 < p.Count ? p[i + 2] : p[i + 1];
            var c1x = p1.X + (p2.X - p0.X) / 6;
            var c1y = p1.Y + (p2.Y - p0.Y) / 6;
            var c2x = p2.X - (p3.X - p1.X) / 6;
            var c2y = p2.Y - (p3.Y - p1.Y) / 6;
            sb.Append(" C ").Append(F(c1x)).Append(' ').Append(F(c1y))
              .Append(", ").Append(F(c2x)).Append(' ').Append(F(c2y))
              .Append(", ").Append(F(p2.X)).Append(' ').Append(F(p2.Y));
        }
        return sb.ToString();
    }

    // ---------- ACTIONS ----------
    async Task GenerateReport()
    {
        genError = "";
        if (endDate < startDate)
        {
            genError = "End date can’t be earlier than the start date.";
            return;
        }

        generating = true;
        await Task.Delay(1200);
        // TODO: himoa ang tinuod nga PDF / Excel gikan sa data sa napiling petsa ug report type
        generating = false;

        toast = reportType + " (" + format + ") for " + startDate.ToString("MMM d", Inv) + " – " + endDate.ToString("MMM d, yyyy", Inv) + " is ready.";
        await InvokeAsync(StateHasChanged);
        await Task.Delay(3500);
        toast = "";
        await InvokeAsync(StateHasChanged);
    }

