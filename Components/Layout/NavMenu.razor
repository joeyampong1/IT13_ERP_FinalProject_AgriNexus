@inject AgriNexus.Services.AuthService Auth
@inject AgriNexus.Services.RolePermissionService PermissionService
@inject NavigationManager Nav
@implements IDisposable

<!-- Brand / Logo -->
<div class="navbar-brand">
    <img src="images/AgriNexus_finalogo.png" alt="AgriNexus" class="brand-logo" />
    <div class="d-flex flex-column w-100 justify-content-center">
        <span class="brand-title">
            <span style="color: #FFFFFF;">Agri</span><span class="brand-nexus">Nexus</span>
        </span>
        <span class="brand-subtitle">Enterprise Resource Planning</span>
    </div>
</div>

<!-- User Profile Box (Clickable to /profile) -->
<NavLink href="/profile" class="user-profile-box text-decoration-none d-block" title="View & Edit Profile">
    <div class="profile-label">SIGNED IN AS</div>
    <div class="profile-name">@Auth.CurrentUserName</div>
    <div class="profile-role">
        <i class="bi bi-shield-lock shield-leaf"></i>
        <span>@Auth.AccessLevel</span>
    </div>
</NavLink>

<!-- Scrollable Navigation Area -->
<div class="nav-scrollable">
    <nav class="flex-column">

        <!-- ========================================== -->
        <!-- OVERVIEW (Dynamic Dashboard per Role)      -->
        <!-- ========================================== -->
        @if (Auth.CurrentRole == AgriNexus.Services.UserRole.SuperAdmin
          || Auth.CurrentRole == AgriNexus.Services.UserRole.TenantAdmin
          || CanAccess("dashboard"))
        {
            <div class="nav-section-title">OVERVIEW</div>
            <div class="nav-item">
                @if (Auth.CurrentRole == AgriNexus.Services.UserRole.SuperAdmin)
                {
                    <NavLink class="nav-link" href="/dashboard" Match="NavLinkMatch.All"><i class="bi bi-grid"></i> <span>Dashboard</span></NavLink>
                }
                else if (Auth.CurrentRole == AgriNexus.Services.UserRole.TenantAdmin)
                {
                    <NavLink class="nav-link" href="/business-dashboard" Match="NavLinkMatch.All"><i class="bi bi-grid"></i> <span>Dashboard</span></NavLink>
                }
                else if (Auth.CurrentRole == AgriNexus.Services.UserRole.BranchManager)
                {
                    <NavLink class="nav-link" href="/branch-dashboard" Match="NavLinkMatch.All"><i class="bi bi-grid"></i> <span>Dashboard</span></NavLink>
                }
                else if (Auth.CurrentRole == AgriNexus.Services.UserRole.InventoryOfficer)
                {
                    <NavLink class="nav-link" href="/inventory-dashboard" Match="NavLinkMatch.All"><i class="bi bi-grid"></i> <span>Dashboard</span></NavLink>
                }
                else if (Auth.CurrentRole == AgriNexus.Services.UserRole.LaborOfficer)
                {
                    <NavLink class="nav-link" href="/labor-harvest-dashboard" Match="NavLinkMatch.All"><i class="bi bi-grid"></i> <span>Dashboard</span></NavLink>
                }
                else if (Auth.CurrentRole == AgriNexus.Services.UserRole.SalesOfficer)
                {
                    <NavLink class="nav-link" href="/sales-cashier-dashboard" Match="NavLinkMatch.All"><i class="bi bi-grid"></i> <span>Dashboard</span></NavLink>
                }
                else if (Auth.CurrentRole == AgriNexus.Services.UserRole.Accountant)
                {
                    <NavLink class="nav-link" href="/finance-dashboard" Match="NavLinkMatch.All"><i class="bi bi-grid"></i> <span>Dashboard</span></NavLink>
                }
                else
                {
                    <NavLink class="nav-link" href="/dashboard" Match="NavLinkMatch.All"><i class="bi bi-grid"></i> <span>Dashboard</span></NavLink>
                }
            </div>
        }

        <!-- ========================================== -->
        <!-- 1. SUPER ADMIN                             -->
        <!-- ========================================== -->
        @if (Auth.CurrentRole == AgriNexus.Services.UserRole.SuperAdmin)
        {
            var platformRoutes = new[] { "/businesses", "/subscription-plans", "/subscriptions", "/audit-logs", "/sync-backup", "/reports" };
            var platformOpen = IsGroupExpanded("platform", platformRoutes);

            <div class="nav-group @(platformOpen ? "is-open" : "")">
                <button type="button" class="nav-group-toggle @(HasActiveRoute(platformRoutes) ? "has-active" : "")"
                        @onclick='() => ToggleGroup("platform", platformRoutes)'>
                    <i class="bi bi-buildings group-icon"></i>
                    <span>Platform</span>
                    <i class="bi bi-chevron-right group-chevron"></i>
                </button>
                @if (platformOpen)
                {
                    <div class="nav-group-items">
                        <div class="nav-item"><NavLink class="nav-link" href="/businesses"><i class="bi bi-buildings"></i> <span>Businesses / Tenants</span></NavLink></div>
                        <div class="nav-item"><NavLink class="nav-link" href="/subscription-plans"><i class="bi bi-wallet2"></i> <span>Subscription Plans</span></NavLink></div>
                        <div class="nav-item"><NavLink class="nav-link" href="/subscriptions"><i class="bi bi-arrow-repeat"></i> <span>Subscriptions</span></NavLink></div>
                        <div class="nav-item"><NavLink class="nav-link" href="/audit-logs"><i class="bi bi-journal-text"></i> <span>Audit Logs</span></NavLink></div>
                        <div class="nav-item"><NavLink class="nav-link" href="/sync-backup"><i class="bi bi-cloud-arrow-up"></i> <span>Sync &amp; Backup</span></NavLink></div>
                        <div class="nav-item"><NavLink class="nav-link" href="/reports"><i class="bi bi-bar-chart-line"></i> <span>Reports &amp; Analytics</span></NavLink></div>
                    </div>
                }
            </div>
        }

        <!-- ========================================== -->
        <!-- 2. TENANT ADMIN (Full Business Access)     -->
        <!-- ========================================== -->
        @if (Auth.CurrentRole == AgriNexus.Services.UserRole.TenantAdmin)
        {
            var bizRoutes = new[] { "/branches", "/staff", "/my-subscription", "/tenant-reports", "/business-settings" };
            var bizOpen = IsGroupExpanded("business", bizRoutes);

            var farmRoutes = new[] { "/farms", "/crops" };
            var farmOpen = IsGroupExpanded("farm", farmRoutes);

            var invRoutes = new[] { "/inventory", "/stock", "/suppliers" };
            var invOpen = IsGroupExpanded("inventory", invRoutes);

            var laborRoutes = new[] { "/workers", "/assignments", "/attendance", "/harvest" };
            var laborOpen = IsGroupExpanded("labor", laborRoutes);

            var salesRoutes = new[] { "/new-sale", "/sales", "/customers", "/payments", "/cash-drawer" };
            var salesOpen = IsGroupExpanded("sales", salesRoutes);

            var finRoutes = new[] { "/expenses", "/costing" };
            var finOpen = IsGroupExpanded("finance", finRoutes);

            var repRoutes = new[] { "/business-analytics" };
            var repOpen = IsGroupExpanded("reports", repRoutes);

            <div class="nav-group @(bizOpen ? "is-open" : "")">
                <button type="button" class="nav-group-toggle @(HasActiveRoute(bizRoutes) ? "has-active" : "")"
                        @onclick='() => ToggleGroup("business", bizRoutes)'>
                    <i class="bi bi-briefcase group-icon"></i>
                    <span>Business</span>
                    <i class="bi bi-chevron-right group-chevron"></i>
                </button>
                @if (bizOpen)
                {
                    <div class="nav-group-items">
                        <div class="nav-item"><NavLink class="nav-link" href="/branches"><i class="bi bi-shop"></i> <span>Branches</span></NavLink></div>
                        <div class="nav-item"><NavLink class="nav-link" href="/staff"><i class="bi bi-people"></i> <span>Staff &amp; Permissions</span></NavLink></div>
                        <div class="nav-item"><NavLink class="nav-link" href="/my-subscription"><i class="bi bi-credit-card"></i> <span>My Subscription</span></NavLink></div>
                        <div class="nav-item"><NavLink class="nav-link" href="/tenant-reports"><i class="bi bi-bar-chart"></i> <span>Consolidated Reports</span></NavLink></div>
                        <div class="nav-item"><NavLink class="nav-link" href="/business-settings"><i class="bi bi-gear"></i> <span>Business Settings</span></NavLink></div>
                    </div>
                }
            </div>

            <div class="nav-group @(farmOpen ? "is-open" : "")">
                <button type="button" class="nav-group-toggle @(HasActiveRoute(farmRoutes) ? "has-active" : "")"
                        @onclick='() => ToggleGroup("farm", farmRoutes)'>
                    <i class="bi bi-tree group-icon"></i>
                    <span>Farm Operations</span>
                    <i class="bi bi-chevron-right group-chevron"></i>
                </button>
                @if (farmOpen)
                {
                    <div class="nav-group-items">
                        <div class="nav-item"><NavLink class="nav-link" href="/farms"><i class="bi bi-map"></i> <span>Farms &amp; Plots</span></NavLink></div>
                        <div class="nav-item"><NavLink class="nav-link" href="/crops"><i class="bi bi-flower1"></i> <span>Crop Planning</span></NavLink></div>
                    </div>
                }
            </div>

            <div class="nav-group @(invOpen ? "is-open" : "")">
                <button type="button" class="nav-group-toggle @(HasActiveRoute(invRoutes) ? "has-active" : "")"
                        @onclick='() => ToggleGroup("inventory", invRoutes)'>
                    <i class="bi bi-box-seam group-icon"></i>
                    <span>Inventory</span>
                    <i class="bi bi-chevron-right group-chevron"></i>
                </button>
                @if (invOpen)
                {
                    <div class="nav-group-items">
                        <div class="nav-item"><NavLink class="nav-link" href="/inventory"><i class="bi bi-box-seam"></i> <span>Inventory</span></NavLink></div>
                        <div class="nav-item"><NavLink class="nav-link" href="/stock"><i class="bi bi-arrow-left-right"></i> <span>Stock Movements</span></NavLink></div>
                        <div class="nav-item"><NavLink class="nav-link" href="/suppliers"><i class="bi bi-truck"></i> <span>Suppliers</span></NavLink></div>
                    </div>
                }
            </div>

            <div class="nav-group @(laborOpen ? "is-open" : "")">
                <button type="button" class="nav-group-toggle @(HasActiveRoute(laborRoutes) ? "has-active" : "")"
                        @onclick='() => ToggleGroup("labor", laborRoutes)'>
                    <i class="bi bi-person-workspace group-icon"></i>
                    <span>Labor &amp; Harvest</span>
                    <i class="bi bi-chevron-right group-chevron"></i>
                </button>
                @if (laborOpen)
                {
                    <div class="nav-group-items">
                        <div class="nav-item"><NavLink class="nav-link" href="/workers"><i class="bi bi-person-badge"></i> <span>Workers</span></NavLink></div>
                        <div class="nav-item"><NavLink class="nav-link" href="/assignments"><i class="bi bi-clipboard-check"></i> <span>Work Assignments</span></NavLink></div>
                        <div class="nav-item"><NavLink class="nav-link" href="/attendance"><i class="bi bi-clock-history"></i> <span>Attendance &amp; Logs</span></NavLink></div>
                        <div class="nav-item"><NavLink class="nav-link" href="/harvest"><i class="bi bi-basket"></i> <span>Harvest Recording</span></NavLink></div>
                    </div>
                }
            </div>

            <div class="nav-group @(salesOpen ? "is-open" : "")">
                <button type="button" class="nav-group-toggle @(HasActiveRoute(salesRoutes) ? "has-active" : "")"
                        @onclick='() => ToggleGroup("sales", salesRoutes)'>
                    <i class="bi bi-cart3 group-icon"></i>
                    <span>Sales &amp; Cashier</span>
                    <i class="bi bi-chevron-right group-chevron"></i>
                </button>
                @if (salesOpen)
                {
                    <div class="nav-group-items">
                        <div class="nav-item"><NavLink class="nav-link" href="/new-sale"><i class="bi bi-cart-plus"></i> <span>New Sale</span></NavLink></div>
                        <div class="nav-item"><NavLink class="nav-link" href="/sales"><i class="bi bi-receipt"></i> <span>Sales Transactions</span></NavLink></div>
                        <div class="nav-item"><NavLink class="nav-link" href="/customers"><i class="bi bi-person"></i> <span>Customers</span></NavLink></div>
                        <div class="nav-item"><NavLink class="nav-link" href="/payments"><i class="bi bi-cash-coin"></i> <span>Payments &amp; Collections</span></NavLink></div>
                        <div class="nav-item"><NavLink class="nav-link" href="/cash-drawer"><i class="bi bi-cash-stack"></i> <span>Cash Drawer</span></NavLink></div>
                    </div>
                }
            </div>

            <div class="nav-group @(finOpen ? "is-open" : "")">
                <button type="button" class="nav-group-toggle @(HasActiveRoute(finRoutes) ? "has-active" : "")"
                        @onclick='() => ToggleGroup("finance", finRoutes)'>
                    <i class="bi bi-wallet2 group-icon"></i>
                    <span>Finance</span>
                    <i class="bi bi-chevron-right group-chevron"></i>
                </button>
                @if (finOpen)
                {
                    <div class="nav-group-items">
                        <div class="nav-item"><NavLink class="nav-link" href="/expenses"><i class="bi bi-wallet"></i> <span>Expenses</span></NavLink></div>
                        <div class="nav-item"><NavLink class="nav-link" href="/costing"><i class="bi bi-layers"></i> <span>Production Costing</span></NavLink></div>
                    </div>
                }
            </div>

            <div class="nav-group @(repOpen ? "is-open" : "")">
                <button type="button" class="nav-group-toggle @(HasActiveRoute(repRoutes) ? "has-active" : "")"
                        @onclick='() => ToggleGroup("reports", repRoutes)'>
                    <i class="bi bi-graph-up-arrow group-icon"></i>
                    <span>Reports &amp; Analytics</span>
                    <i class="bi bi-chevron-right group-chevron"></i>
                </button>
                @if (repOpen)
                {
                    <div class="nav-group-items">
                        <div class="nav-item"><NavLink class="nav-link" href="/business-analytics"><i class="bi bi-graph-up"></i> <span>Reports &amp; Analytics</span></NavLink></div>
                    </div>
                }
            </div>
        }

        <!-- ========================================== -->
        <!-- 3. STAFF ROLES (Dynamic Permissions)       -->
        <!-- ========================================== -->
        @if (IsStaffRole)
        {
            @if (CanAccessAny("branches", "staff", "subscription", "consolidated-reports", "business-settings"))
            {
                var sBizRoutes = new[] { "/branches", "/staff", "/my-subscription", "/tenant-reports", "/business-settings" };
                var sBizOpen = IsGroupExpanded("s_business", sBizRoutes);

                <div class="nav-group @(sBizOpen ? "is-open" : "")">
                    <button type="button" class="nav-group-toggle @(HasActiveRoute(sBizRoutes) ? "has-active" : "")"
                            @onclick='() => ToggleGroup("s_business", sBizRoutes)'>
                        <i class="bi bi-briefcase group-icon"></i>
                        <span>Business</span>
                        <i class="bi bi-chevron-right group-chevron"></i>
                    </button>
                    @if (sBizOpen)
                    {
                        <div class="nav-group-items">
                            @if (CanAccess("branches"))
                            {
                                <div class="nav-item"><NavLink class="nav-link" href="/branches"><i class="bi bi-shop"></i> <span>Branches</span></NavLink></div>
                            }
                            @if (CanAccess("staff"))
                            {
                                <div class="nav-item"><NavLink class="nav-link" href="/staff"><i class="bi bi-people"></i> <span>Staff &amp; Permissions</span></NavLink></div>
                            }
                            @if (CanAccess("subscription"))
                            {
                                <div class="nav-item"><NavLink class="nav-link" href="/my-subscription"><i class="bi bi-credit-card"></i> <span>My Subscription</span></NavLink></div>
                            }
                            @if (CanAccess("consolidated-reports"))
                            {
                                <div class="nav-item"><NavLink class="nav-link" href="/tenant-reports"><i class="bi bi-bar-chart"></i> <span>Consolidated Reports</span></NavLink></div>
                            }
                            @if (CanAccess("business-settings"))
                            {
                                <div class="nav-item"><NavLink class="nav-link" href="/business-settings"><i class="bi bi-gear"></i> <span>Business Settings</span></NavLink></div>
                            }
                        </div>
                    }
                </div>
            }

            @if (CanAccessAny("farms-plots", "crop-planning"))
            {
                var sFarmRoutes = new[] { "/farms", "/crops" };
                var sFarmOpen = IsGroupExpanded("s_farm", sFarmRoutes);

                <div class="nav-group @(sFarmOpen ? "is-open" : "")">
                    <button type="button" class="nav-group-toggle @(HasActiveRoute(sFarmRoutes) ? "has-active" : "")"
                            @onclick='() => ToggleGroup("s_farm", sFarmRoutes)'>
                        <i class="bi bi-tree group-icon"></i>
                        <span>Farm Operations</span>
                        <i class="bi bi-chevron-right group-chevron"></i>
                    </button>
                    @if (sFarmOpen)
                    {
                        <div class="nav-group-items">
                            @if (CanAccess("farms-plots"))
                            {
                                <div class="nav-item"><NavLink class="nav-link" href="/farms"><i class="bi bi-map"></i> <span>Farms &amp; Plots</span></NavLink></div>
                            }
                            @if (CanAccess("crop-planning"))
                            {
                                <div class="nav-item"><NavLink class="nav-link" href="/crops"><i class="bi bi-flower1"></i> <span>Crop Planning</span></NavLink></div>
                            }
                        </div>
                    }
                </div>
            }

            @if (CanAccessAny("inventory", "stock-movements", "suppliers"))
            {
                var sInvRoutes = new[] { "/inventory", "/stock", "/suppliers" };
                var sInvOpen = IsGroupExpanded("s_inventory", sInvRoutes);

                <div class="nav-group @(sInvOpen ? "is-open" : "")">
                    <button type="button" class="nav-group-toggle @(HasActiveRoute(sInvRoutes) ? "has-active" : "")"
                            @onclick='() => ToggleGroup("s_inventory", sInvRoutes)'>
                        <i class="bi bi-box-seam group-icon"></i>
                        <span>Inventory</span>
                        <i class="bi bi-chevron-right group-chevron"></i>
                    </button>
                    @if (sInvOpen)
                    {
                        <div class="nav-group-items">
                            @if (CanAccess("inventory"))
                            {
                                <div class="nav-item"><NavLink class="nav-link" href="/inventory"><i class="bi bi-box-seam"></i> <span>Inventory</span></NavLink></div>
                            }
                            @if (CanAccess("stock-movements"))
                            {
                                <div class="nav-item"><NavLink class="nav-link" href="/stock"><i class="bi bi-arrow-left-right"></i> <span>Stock Movements</span></NavLink></div>
                            }
                            @if (CanAccess("suppliers"))
                            {
                                <div class="nav-item"><NavLink class="nav-link" href="/suppliers"><i class="bi bi-truck"></i> <span>Suppliers</span></NavLink></div>
                            }
                        </div>
                    }
                </div>
            }

            @if (CanAccessAny("workers", "work-assignments", "attendance-logs", "harvest-recording"))
            {
                var sLaborRoutes = new[] { "/workers", "/assignments", "/attendance", "/harvest" };
                var sLaborOpen = IsGroupExpanded("s_labor", sLaborRoutes);

                <div class="nav-group @(sLaborOpen ? "is-open" : "")">
                    <button type="button" class="nav-group-toggle @(HasActiveRoute(sLaborRoutes) ? "has-active" : "")"
                            @onclick='() => ToggleGroup("s_labor", sLaborRoutes)'>
                        <i class="bi bi-person-workspace group-icon"></i>
                        <span>Labor &amp; Harvest</span>
                        <i class="bi bi-chevron-right group-chevron"></i>
                    </button>
                    @if (sLaborOpen)
                    {
                        <div class="nav-group-items">
                            @if (CanAccess("workers"))
                            {
                                <div class="nav-item"><NavLink class="nav-link" href="/workers"><i class="bi bi-person-badge"></i> <span>Workers</span></NavLink></div>
                            }
                            @if (CanAccess("work-assignments"))
                            {
                                <div class="nav-item"><NavLink class="nav-link" href="/assignments"><i class="bi bi-clipboard-check"></i> <span>Work Assignments</span></NavLink></div>
                            }
                            @if (CanAccess("attendance-logs"))
                            {
                                <div class="nav-item"><NavLink class="nav-link" href="/attendance"><i class="bi bi-clock-history"></i> <span>Attendance &amp; Logs</span></NavLink></div>
                            }
                            @if (CanAccess("harvest-recording"))
                            {
                                <div class="nav-item"><NavLink class="nav-link" href="/harvest"><i class="bi bi-basket"></i> <span>Harvest Recording</span></NavLink></div>
                            }
                        </div>
                    }
                </div>
            }

            @if (CanAccessAny("new-sale", "sales-transactions", "customers", "payments-collections", "cash-drawer"))
            {
                var sSalesRoutes = new[] { "/new-sale", "/sales", "/customers", "/payments", "/cash-drawer" };
                var sSalesOpen = IsGroupExpanded("s_sales", sSalesRoutes);

                <div class="nav-group @(sSalesOpen ? "is-open" : "")">
                    <button type="button" class="nav-group-toggle @(HasActiveRoute(sSalesRoutes) ? "has-active" : "")"
                            @onclick='() => ToggleGroup("s_sales", sSalesRoutes)'>
                        <i class="bi bi-cart3 group-icon"></i>
                        <span>Sales &amp; Cashier</span>
                        <i class="bi bi-chevron-right group-chevron"></i>
                    </button>
                    @if (sSalesOpen)
                    {
                        <div class="nav-group-items">
                            @if (CanAccess("new-sale"))
                            {
                                <div class="nav-item"><NavLink class="nav-link" href="/new-sale"><i class="bi bi-cart-plus"></i> <span>New Sale</span></NavLink></div>
                            }
                            @if (CanAccess("sales-transactions"))
                            {
                                <div class="nav-item"><NavLink class="nav-link" href="/sales"><i class="bi bi-receipt"></i> <span>Sales Transactions</span></NavLink></div>
                            }
                            @if (CanAccess("customers"))
                            {
                                <div class="nav-item"><NavLink class="nav-link" href="/customers"><i class="bi bi-person"></i> <span>Customers</span></NavLink></div>
                            }
                            @if (CanAccess("payments-collections"))
                            {
                                <div class="nav-item"><NavLink class="nav-link" href="/payments"><i class="bi bi-cash-coin"></i> <span>Payments &amp; Collections</span></NavLink></div>
                            }
                            @if (CanAccess("cash-drawer"))
                            {
                                <div class="nav-item"><NavLink class="nav-link" href="/cash-drawer"><i class="bi bi-cash-stack"></i> <span>Cash Drawer</span></NavLink></div>
                            }
                        </div>
                    }
                </div>
            }

            @if (CanAccessAny("expenses", "production-costing", "financial-audit-trail"))
            {
                var sFinRoutes = new[] { "/expenses", "/costing", "/audit" };
                var sFinOpen = IsGroupExpanded("s_finance", sFinRoutes);

                <div class="nav-group @(sFinOpen ? "is-open" : "")">
                    <button type="button" class="nav-group-toggle @(HasActiveRoute(sFinRoutes) ? "has-active" : "")"
                            @onclick='() => ToggleGroup("s_finance", sFinRoutes)'>
                        <i class="bi bi-wallet2 group-icon"></i>
                        <span>Finance</span>
                        <i class="bi bi-chevron-right group-chevron"></i>
                    </button>
                    @if (sFinOpen)
                    {
                        <div class="nav-group-items">
                            @if (CanAccess("expenses"))
                            {
                                <div class="nav-item"><NavLink class="nav-link" href="/expenses"><i class="bi bi-wallet"></i> <span>Expenses</span></NavLink></div>
                            }
                            @if (CanAccess("production-costing"))
                            {
                                <div class="nav-item"><NavLink class="nav-link" href="/costing"><i class="bi bi-layers"></i> <span>Production Costing</span></NavLink></div>
                            }
                            @if (CanAccess("financial-audit-trail"))
                            {
                                <div class="nav-item"><NavLink class="nav-link" href="/audit"><i class="bi bi-shield-check"></i> <span>Financial Audit Trail</span></NavLink></div>
                            }
                        </div>
                    }
                </div>
            }

            @if (CanAccess("financial-reports"))
            {
                var sRepRoutes = new[] { "/finance-analytics" };
                var sRepOpen = IsGroupExpanded("s_reports", sRepRoutes);

                <div class="nav-group @(sRepOpen ? "is-open" : "")">
                    <button type="button" class="nav-group-toggle @(HasActiveRoute(sRepRoutes) ? "has-active" : "")"
                            @onclick='() => ToggleGroup("s_reports", sRepRoutes)'>
                        <i class="bi bi-graph-up-arrow group-icon"></i>
                        <span>Reports &amp; Analytics</span>
                        <i class="bi bi-chevron-right group-chevron"></i>
                    </button>
                    @if (sRepOpen)
                    {
                        <div class="nav-group-items">
                            <div class="nav-item"><NavLink class="nav-link" href="/finance-analytics"><i class="bi bi-graph-up"></i> <span>Reports &amp; Analytics</span></NavLink></div>
                        </div>
                    }
