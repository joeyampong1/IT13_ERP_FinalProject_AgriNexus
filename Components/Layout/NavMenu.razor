        <!-- ========================================== -->
        <!-- 7. ACCOUNTANT / FINANCE OFFICER            -->
        <!-- ========================================== -->
        @if (Auth.CurrentRole == AgriNexus.Services.UserRole.Accountant)
        {
            <div class="nav-section-title">INVENTORY</div>
            <div class="nav-item"><NavLink class="nav-link" href="/stock"><i class="bi bi-arrow-left-right"></i> <span>Stock Movements</span></NavLink></div>

            <div class="nav-section-title">LABOR & HARVEST</div>
            <div class="nav-item"><NavLink class="nav-link" href="/attendance"><i class="bi bi-clock-history"></i> <span>Attendance & Logs</span></NavLink></div>

            <div class="nav-section-title">SALES & CASHIER</div>
            <div class="nav-item"><NavLink class="nav-link" href="/sales"><i class="bi bi-receipt"></i> <span>Sales Transactions</span></NavLink></div>
            <div class="nav-item"><NavLink class="nav-link" href="/payments"><i class="bi bi-cash-coin"></i> <span>Payments & Collections</span></NavLink></div>

            <div class="nav-section-title">FINANCE</div>
            <div class="nav-item"><NavLink class="nav-link" href="/expenses"><i class="bi bi-wallet"></i> <span>Expenses</span></NavLink></div>
            <div class="nav-item"><NavLink class="nav-link" href="/costing"><i class="bi bi-layers"></i> <span>Production Costing</span></NavLink></div>
            <div class="nav-item"><NavLink class="nav-link" href="/financials"><i class="bi bi-pie-chart"></i> <span>Financial Reports</span></NavLink></div>
