@code {
    private readonly Dictionary<string, bool> manualStates = new();
    private string lastTrackedPath = "";

    private bool IsStaffRole =>
        Auth.CurrentRole != AgriNexus.Services.UserRole.SuperAdmin &&
        Auth.CurrentRole != AgriNexus.Services.UserRole.TenantAdmin;

    private bool CanAccess(string moduleKey) =>
        PermissionService.HasAccess(Auth.CurrentRole.ToString(), moduleKey);

    private bool CanAccessAny(params string[] moduleKeys) =>
        moduleKeys.Any(k => PermissionService.HasAccess(Auth.CurrentRole.ToString(), k));

    private string CurrentPath()
    {
        var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Trim('/');
        return path == "/" ? "/dashboard" : path;
    }

    private bool HasActiveRoute(string[] routes)
    {
        var current = CurrentPath();
        return routes.Any(r => string.Equals(current, r, StringComparison.OrdinalIgnoreCase));
    }

    private void SyncRouteExpansion()
    {
        var current = CurrentPath();
        if (string.Equals(current, lastTrackedPath, StringComparison.OrdinalIgnoreCase))
            return;

        lastTrackedPath = current;

        // Pag-balhin og route, i-open ang group nga naay active page
        foreach (var g in AllRouteGroups)
        {
            if (g.Routes.Any(r => string.Equals(current, r, StringComparison.OrdinalIgnoreCase)))
            {
                manualStates[g.Key] = true;
            }
        }
    }

    private bool IsGroupExpanded(string key, string[] routes)
    {
        SyncRouteExpansion();

        if (manualStates.TryGetValue(key, out var isOpen))
            return isOpen;

        return HasActiveRoute(routes);
    }

    private void ToggleGroup(string key, string[] routes)
    {
        var currentState = IsGroupExpanded(key, routes);
        manualStates[key] = !currentState;
        StateHasChanged();
    }

    private record RouteGroupDef(string Key, string[] Routes);

    private static readonly RouteGroupDef[] AllRouteGroups =
    {
        new("platform", new[] { "/businesses", "/subscription-plans", "/subscriptions", "/audit-logs", "/sync-backup", "/reports" }),
        new("business", new[] { "/branches", "/staff", "/my-subscription", "/tenant-reports", "/business-settings" }),
        new("farm", new[] { "/farms", "/crops" }),
        new("inventory", new[] { "/inventory", "/stock", "/suppliers" }),
        new("labor", new[] { "/workers", "/assignments", "/attendance", "/harvest" }),
        new("sales", new[] { "/new-sale", "/sales", "/customers", "/payments", "/cash-drawer" }),
        new("finance", new[] { "/expenses", "/costing" }),
        new("reports", new[] { "/business-analytics" }),
        new("s_business", new[] { "/branches", "/staff", "/my-subscription", "/tenant-reports", "/business-settings" }),
        new("s_farm", new[] { "/farms", "/crops" }),
        new("s_inventory", new[] { "/inventory", "/stock", "/suppliers" }),
        new("s_labor", new[] { "/workers", "/assignments", "/attendance", "/harvest" }),
        new("s_sales", new[] { "/new-sale", "/sales", "/customers", "/payments", "/cash-drawer" }),
        new("s_finance", new[] { "/expenses", "/costing", "/audit" }),
        new("s_reports", new[] { "/finance-analytics" }),
    };

    protected override void OnInitialized()
    {
        PermissionService.OnPermissionsChanged += HandlePermissionsChanged;
        Nav.LocationChanged += HandleLocationChanged;
        SyncRouteExpansion();
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        SyncRouteExpansion();
        InvokeAsync(StateHasChanged);
    }

    private void HandlePermissionsChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        PermissionService.OnPermissionsChanged -= HandlePermissionsChanged;
        Nav.LocationChanged -= HandleLocationChanged;
    }
}