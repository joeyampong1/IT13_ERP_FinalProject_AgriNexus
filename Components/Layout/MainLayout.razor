@inherits LayoutComponentBase
@inject AgriNexus.Services.AuthService Auth
@inject NavigationManager NavManager
@inject IJSRuntime JS
@implements IDisposable

<div class="page">
    <!-- Sidebar Container -->
    <div class="sidebar">
        <NavMenu />
    </div>

    <!-- Main Content Area -->
    <main>
        <!-- Top Header Bar -->
        <div class="top-row px-4">
            <!-- Left side sa header -->
            <div class="d-flex align-items-center gap-3 gap-md-4">

                <!-- 1. Dynamic Welcome Greeting -->
                <div class="d-flex flex-column lh-sm d-none d-lg-block">
                    <span class="text-muted" style="font-size: 0.75rem; font-weight: 500;">Welcome back,</span>
                    <span class="fw-bold" style="color: #0A2B1D; font-size: 1rem; letter-spacing: -0.3px;">
                        @Auth.CurrentUserName
                    </span>
                </div>

                <div class="vr d-none d-lg-block opacity-25" style="color: #94A3B8;"></div>

                <!-- 2. Sync Status Indicator -->
                <div class="sync-pill @GetSyncClass()">
                    <i class="bi @GetSyncIcon() @(syncStatus == SyncStatus.Syncing ? "spin" : "")"></i>
                    <span class="d-none d-sm-inline">@GetSyncText()</span>
                </div>

                <div class="vr d-none d-sm-block opacity-25" style="color: #94A3B8;"></div>

                <!-- 3. Current Date -->
                <span class="text-muted small fw-medium d-none d-md-flex align-items-center gap-2">
                    <i class="bi bi-calendar3" style="color: #1B5E34;"></i> @DateTime.Now.ToString("MMMM dd, yyyy")
                </span>

            </div>

            <!-- Right side sa header (User Dropdown) -->
            <div class="user-menu">
                <!-- Dropdown Button -->
                <button class="user-menu-btn shadow-sm" @onclick="ToggleDropdown">
                    <i class="bi bi-person-circle fs-5" style="color: #1B5E34;"></i>
                    <span class="fw-semibold d-none d-sm-inline" style="color: #0A2B1D;">@Auth.CurrentUserName</span>
                    <i class="bi bi-chevron-down small text-muted ms-auto @(showDropdown ? "rot" : "")"></i>
                </button>

                <!-- Dropdown Menu -->
                @if (showDropdown)
                {
                    <div class="user-menu-backdrop" @onclick="CloseDropdown"></div>

                    <div class="user-menu-list">
                        <button class="user-menu-item" @onclick="GoToProfile">
                            <i class="bi bi-person-circle" style="color: #1B5E34;"></i>
                            <span>My Profile</span>
                        </button>

                        <button class="user-menu-item" @onclick="GoToSettings">
                            <i class="bi bi-gear" style="color: #1B5E34;"></i>
                            <span>Settings</span>
                        </button>

                        <div class="user-menu-sep"></div>

                        <button class="user-menu-item text-danger" @onclick="HandleLogout">
                            <i class="bi bi-box-arrow-right"></i>
                            <span>Logout</span>
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- Content Body -->
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    // --- DROPDOWN STATE ---
    private bool showDropdown = false;

    private void ToggleDropdown() => showDropdown = !showDropdown;
    private void CloseDropdown() => showDropdown = false;

    private void HandleLogout()
    {
        showDropdown = false;
        Auth.Logout();
        NavManager.NavigateTo("/login");
    }

    private void GoToSettings()
    {
        CloseDropdown();
        NavManager.NavigateTo("/settings");
    }

    private void GoToProfile()
    {
        CloseDropdown();
        NavManager.NavigateTo("/profile");
    }

    // --- SYNC STATUS LOGIC ---
    public enum SyncStatus { Synced, Syncing, Offline }
    private SyncStatus syncStatus = SyncStatus.Synced;
    private System.Threading.Timer? _syncTimer;

    protected override void OnInitialized()
    {
        _syncTimer = new System.Threading.Timer(async _ =>
        {
            syncStatus = SyncStatus.Syncing;
            await InvokeAsync(StateHasChanged);

            await Task.Delay(3000);
            syncStatus = SyncStatus.Synced;
            await InvokeAsync(StateHasChanged);

        }, null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(20));
    }

    private string GetSyncClass() => syncStatus switch
    {
        SyncStatus.Synced => "sync-synced",
        SyncStatus.Syncing => "sync-syncing",
        SyncStatus.Offline => "sync-offline",
        _ => "sync-synced"
    };

    private string GetSyncIcon() => syncStatus switch
    {
        SyncStatus.Synced => "bi-cloud-check-fill",
        SyncStatus.Syncing => "bi-arrow-repeat",
        SyncStatus.Offline => "bi-wifi-off",
        _ => "bi-cloud-check-fill"
    };

    private string GetSyncText() => syncStatus switch
    {
        SyncStatus.Synced => "Cloud Synced",
        SyncStatus.Syncing => "Syncing...",
        SyncStatus.Offline => "Offline Mode",
        _ => "Cloud Synced"
    };

    public void Dispose()
    {
        _syncTimer?.Dispose();
    }
}